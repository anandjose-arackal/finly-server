<?xml version="1.0" encoding="UTF-8"?>
<ENVELOPE>
   <HEADER>
      <TALLYREQUEST>Import Data</TALLYREQUEST>
   </HEADER>
   <BODY>
      <IMPORTDATA>
         <REQUESTDESC>
            <REPORTNAME>Vouchers</REPORTNAME>
            <STATICVARIABLES>
               <SVCURRENTCOMPANY><%= html_escape configuration.company_name %></SVCURRENTCOMPANY>
            </STATICVARIABLES>
         </REQUESTDESC>
         <REQUESTDATA>
            <TALLYMESSAGE xmlns:UDF="TallyUDF">
            <% processor_group_mappings.each do |mapping| %>
              <% if mapping.user.gl_config&.dig(:name).blank? %>
                <% raise "GL Config is not configured for the user" %>
              <% end %>
               <VOUCHER VCHTYPE="Payment" ACTION="Create">
                 <VOUCHERTYPENAME>Payment</VOUCHERTYPENAME>
                 <DATE><%= mapping.created_at.strftime('%Y%m%d') %></DATE>
                 <NARRATION></NARRATION>
                 <EFFECTIVEDATE><%= mapping.created_at.strftime('%Y%m%d') %></EFFECTIVEDATE>
                 <ALLLEDGERENTRIES.LIST>
                    <LEDGERNAME><%= html_escape mapping.user.gl_config[:name] %></LEDGERNAME>
                    <REMOVEZEROENTRIES>No</REMOVEZEROENTRIES>
                    <ISDEEMEDPOSITIVE>Yes</ISDEEMEDPOSITIVE>
                    <LEDGERFROMITEM>No</LEDGERFROMITEM>
                    <AMOUNT>-<%= mapping.amount.value %></AMOUNT>
                 </ALLLEDGERENTRIES.LIST>
                 <ALLLEDGERENTRIES.LIST>
                    <LEDGERNAME>HDFC BANK LTD (CC A/C. 02272790000303)</LEDGERNAME>
                    <REMOVEZEROENTRIES>No</REMOVEZEROENTRIES>
                    <ISDEEMEDPOSITIVE>No</ISDEEMEDPOSITIVE>
                    <LEDGERFROMITEM>No</LEDGERFROMITEM>
                    <AMOUNT><%= mapping.amount.value %></AMOUNT>
                 </ALLLEDGERENTRIES.LIST>
              </VOUCHER>
            <% end %>
            </TALLYMESSAGE>
         </REQUESTDATA>
      </IMPORTDATA>
   </BODY>
</ENVELOPE>