<?xml version="1.0" encoding="UTF-8"?>
<ENVELOPE>
   <HEADER>
      <TALLYREQUEST>Import Data</TALLYREQUEST>
   </HEADER>
   <BODY>
      <IMPORTDATA>
         <REQUESTDESC>
            <REPORTNAME>Vouchers</REPORTNAME>
            <STATICVARIABLES>
               <SVCURRENTCOMPANY><%= html_escape configuration.company_name %></SVCURRENTCOMPANY>
            </STATICVARIABLES>
         </REQUESTDESC>
         <REQUESTDATA>
            <TALLYMESSAGE xmlns:UDF="TallyUDF">
            <% expenses.each do |expense| %>
              <% if expense.user.gl_config&.dig(:name).blank? %>
                <% raise "GL Config is not configured for the user" %>
              <% end %>
               <VOUCHER VCHTYPE="Journal" ACTION="Create">
                 <VOUCHERTYPENAME>Journal</VOUCHERTYPENAME>
                 <DATE><%= configuration.date_for(expense) %></DATE>
                 <NARRATION><%= html_escape "#{expense.merchant_name(simple: true)} - #{expense.user.name}" %></NARRATION>
                 <EFFECTIVEDATE><%= configuration.date_for(expense) %></EFFECTIVEDATE>
                 <ALLLEDGERENTRIES.LIST>
                    <LEDGERNAME><%= html_escape expense.category.gl_name %></LEDGERNAME>
                    <REMOVEZEROENTRIES>No</REMOVEZEROENTRIES>
                    <ISDEEMEDPOSITIVE>Yes</ISDEEMEDPOSITIVE>
                    <LEDGERFROMITEM>No</LEDGERFROMITEM>
                    <AMOUNT>-<%= expense.amount.value %></AMOUNT>
                 </ALLLEDGERENTRIES.LIST>
                 <ALLLEDGERENTRIES.LIST>
                    <LEDGERNAME><%= html_escape expense.user.gl_config[:name] %></LEDGERNAME>
                    <REMOVEZEROENTRIES>No</REMOVEZEROENTRIES>
                    <ISDEEMEDPOSITIVE>No</ISDEEMEDPOSITIVE>
                    <LEDGERFROMITEM>No</LEDGERFROMITEM>
                    <AMOUNT><%= expense.amount.value %></AMOUNT>
                 </ALLLEDGERENTRIES.LIST>
              </VOUCHER>
            <% end %>
            </TALLYMESSAGE>
         </REQUESTDATA>
      </IMPORTDATA>
   </BODY>
</ENVELOPE>