<?xml version="1.0" encoding="UTF-8"?>
<ENVELOPE>
   <HEADER>
      <TALLYREQUEST>Import Data</TALLYREQUEST>
   </HEADER>
   <BODY>
      <IMPORTDATA>
         <REQUESTDESC>
            <REPORTNAME>Vouchers</REPORTNAME>
            <STATICVARIABLES>
               <SVCURRENTCOMPANY><%= html_escape configuration.company_name %></SVCURRENTCOMPANY>
            </STATICVARIABLES>
         </REQUESTDESC>
         <REQUESTDATA>
            <TALLYMESSAGE xmlns:UDF="TallyUDF">
            <% reports = {} %>
            <% expenses.reimbursable.each do |expense| %>
              <% if expense.user.gl_config&.dig(:name).blank? %>
                <% raise 'GL Config is not configured for the user' %>
              <% end %>
              <% expense_gl_code = html_escape expense.category.gl_name %>
              <% reports[expense.report_id] = {date: configuration.date_for(expense), user: html_escape(expense.user.gl_config[:name]), ledgers: {}, total_amount: 0} if reports[expense.report_id].nil? %>
              <% if reports[expense.report_id][:ledgers][expense_gl_code].nil? %>
                <% reports[expense.report_id][:ledgers][expense_gl_code] = {amount: 0} %>
              <% end %>
              <% reports[expense.report_id][:ledgers][expense_gl_code][:amount] += expense.amount.INR %>
              <% reports[expense.report_id][:total_amount] += expense.amount.INR %>
            <% end %>
            <% if reports.present? %>
            <% reports.each do |report_id, details| %>
              <VOUCHER VCHTYPE="Journal" ACTION="Create">
                 <VOUCHERTYPENAME>Journal</VOUCHERTYPENAME>
                 <DATE><%= details[:date] %></DATE>
                 <NARRATION></NARRATION>
                 <EFFECTIVEDATE><%= details[:date] %></EFFECTIVEDATE>
            <% details[:ledgers].each do |name, ledger| %>
                 <ALLLEDGERENTRIES.LIST>
                    <LEDGERNAME><%= html_escape name %></LEDGERNAME>
                    <REMOVEZEROENTRIES>No</REMOVEZEROENTRIES>
                    <ISDEEMEDPOSITIVE>Yes</ISDEEMEDPOSITIVE>
                    <LEDGERFROMITEM>No</LEDGERFROMITEM>
                    <AMOUNT>-<%= ledger[:amount] %></AMOUNT>
                 </ALLLEDGERENTRIES.LIST>
            <% end %>
                 <ALLLEDGERENTRIES.LIST>
                    <LEDGERNAME><%= details[:user] %></LEDGERNAME>
                    <REMOVEZEROENTRIES>No</REMOVEZEROENTRIES>
                    <ISDEEMEDPOSITIVE>No</ISDEEMEDPOSITIVE>
                    <LEDGERFROMITEM>No</LEDGERFROMITEM>
                    <AMOUNT><%= details[:total_amount] %></AMOUNT>
                 </ALLLEDGERENTRIES.LIST>
              </VOUCHER>
            <% end %>
            <% end %>
            </TALLYMESSAGE>
         </REQUESTDATA>
      </IMPORTDATA>
   </BODY>
</ENVELOPE>