<ENVELOPE>
  <% expenses.each do |expense| %>
  <DSPVCHDATE><%= expense.date.strftime('%-d-%-m-%Y') %>></DSPVCHDATE>
  <DSPVCHLEDACCOUNT><%= expense.category.name %></DSPVCHLEDACCOUNT>
  <NAMEFIELD></NAMEFIELD>
  <INFOFIELD></INFOFIELD>
  <DSPVCHTYPE>Pymt</DSPVCHTYPE>
  <DSPVCHDRAMT></DSPVCHDRAMT>
  <DSPVCHCRAMT><%= number_with_precision(expense.amount.value, precision: 2) %></DSPVCHCRAMT>
  <DSPEXPLVCHNUMBER></DSPEXPLVCHNUMBER>
  <% end %>
</ENVELOPE>
