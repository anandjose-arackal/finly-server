<script>

  $('#people_filter_type > li ').click(function () {
    $('#people_filter_type > li').removeClass();
    $(this).addClass('activeMembers');
  });

  $('[data-switch]').on('click', function (e) {
    var $page = $('#listOfUsers'),
        blockToShow = e.currentTarget.getAttribute('data-switch');

    // Hide all children.
    $page.children().hide();

    // And show the requested component.
    $page.children(blockToShow).show();

  });

  $(document).ready(function () {


    $("#checkAllApprovedReports").change(function () {
      $("input:checkbox[class=checkboxSettle]").prop('checked', $(this).prop("checked"));
    });

    $("#checkAllApprovedReports").change(function () {
      $("input:checkbox[class=checkboxReimburse]").prop('checked', $(this).prop("checked"));
    });

    $("#checkAllReports").change(function () {
      $("input:checkbox[class=checkboxAllReports]").prop('checked', $(this).prop("checked"));
    });


    $('#settleDebtModal ,#reimburseModal').on('hidden.bs.modal', function () {
      restoreModal();
      $('input:checkbox').removeAttr('checked');
      $('textarea').val('');
    })

  });


  function showConfirmReimbursement() {

    if ($("#listOfApprovedReports input:checkbox:checked").length > 0) {
      $('#reimbursementMainScreen').hide();
      $('#confirmReimbursement').show();
      $('.modal-header i').show();

    } else {

      alert(' SHow toast to select approved reports to reimburse');

    }


  }

  function showConfirmSettlement() {

    $('#settlementMainScreen').hide();
    $('#confirmSettlement').show();
    $('.modal-header i').show();

  }

  function restoreModal() {

    $('#settlementMainScreen').show();
    $('#confirmSettlement').hide();

    $('#reimbursementMainScreen').show();
    $('#confirmReimbursement').hide();

    $('.modal-header i').hide();


  }

  function reimburseReport() {

    $('#reimburseModal').modal('show');
    $('#reimbursementMainScreen').hide();
    $('#confirmReimbursement').show();

  }

  function settleReport() {
    $('#settleDebtModal').modal('show');
    $('#settlementMainScreen').hide();
    $('#confirmSettlement').show();
  }

</script>