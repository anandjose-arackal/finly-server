<form data-remote data-turboboost method="get" id="allFilters" action="<%= request.path %>">
  <div id="showPreviousFilters">
    < % param = get_old_filters(params) %>
    < % param.each do |item| %>
        < %= render partial: 'shared/applied_filter_item', locals: {item: item} %>
    < % end %>
  </div>
  < %= render 'settlement_filter' %>
</form>
