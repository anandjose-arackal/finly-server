<div class="modal-dialog" role="document" style="width: 60%; margin-top: 60px;">
  <div class="modal-content">
    <div class="modal-header">
      <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
      <h4 class="modal-title">Activate Employee</h4>
    </div>
    <div class="modal-body">
      <div class="row no-margin">
        <form>
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

          <div class="form-group">
            <label class="control-label" style="display: block;">Mobile Number</label>
            <input id="user_mobile_number" class="form-control otp" type="number" name="user[mobile_number]" style="width: 50%;" value="<%= @pending_user.mobile_number %>" readonly>
          </div>

          <div class="verification" disabled="disabled">
            <div class="form-group">
              <label class="control-label" style="display: block;">One Time Password:</label>
              <input id="user_otp" class="form-control otp" type="number" name="otp" style="width: 50%;">
              <button class="btn btn-default resend-otp" disabled="disabled">Resend OTP In: <span>00:00</span></button>
            </div>

            <div class="form-group text-center">
              <button class="btn btn-primary btn-verify">Verify</button>
            </div>  

          </div>
          

        </form>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript">
  
  $(document).ready(function(){
    Timer = {
      initialize: function(){
        this.button = $(".resend-otp");
        this.time = 10;
        this.startTimer();
      },
      
      startTimer: function(){
        $(this.button).html("Resend OTP In: <span>00:00</span>").removeClass("btn-success").addClass('btn-default')
        _this = this;
        this.time = 60;
        this.timer = setInterval(function(){
          $(_this.button).attr('disabled', 'disabled');
          // console.log("Time is", _this.time);
          if(_this.time === 0){
            _this.showResend();
          }
          if(_this.time.toString().length == 1){
            $(_this.button).find('span').text("00:0" + _this.time.toString());
          } else {
            $(_this.button).find('span').text("00:" + _this.time.toString());
          }
          _this.time = _this.time - 1;
        }, 1000);
      },

      showResend: function(){
        _this = this;
        $(_this.button).attr('disabled', false).html("Resend OTP").addClass('btn-success');
        clearInterval(_this.timer);
      },

      disableVerification: function(){
        // $("")
      }
    }

    Timer.initialize();

    $(".resend-otp").on('click', function(e){
      e.preventDefault();
      $.ajax({
        url: "<%= resend_otp_path %>",
        dataType: "JSON",
        type: "POST",
        data: {
          authenticity_token: $("#authenticity_token").val()
        },
        success: function(res){
          console.log("Success", res);
          Timer.startTimer();

        },
        error: function(err){
          console.log("Error", err)
        }
      })
    });

