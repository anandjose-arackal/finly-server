
<form id="newUserRegistration" action="<%= pending_invite_accept_path(pending_invite_id: @pending_user.id) %>" method="post" data-remote='true'>

  <input name="_method" type="hidden" value="patch">
  <input name="authenticity_token" value="<%= form_authenticity_token%>" type="hidden">
  <input name="user[invitation_token]" type="hidden" value="<%=params[:invitation_token]%>">
  <input name="type" type="hidden" value="accept">

    <div style="width: 600px;padding: 20px 40px 40px 80px; background-color: white; margin:30px auto;border: 1px solid #d8d8d8">

      <div>
        <h4 style="color: #465c8b; font-weight: 300; font-size: 20px">Welcome To Finly Expenses! </h4>
      </div>
      


      <label style="font-weight: 500">Company Name: </label>
      <div>
        <input type="text" class="form-control" name="user[company_name]" value="<%= @pending_user.company_name %>" disabled>
      </div>

      <label style="font-weight: 500">Email: </label>
      <div>
        <input type="text" class="form-control" name="user[email]" value="<%= @pending_user.email %>" disabled>
      </div>

      <label style="font-weight: 500">Password: </label>
      <div>
        <input type="password" class="form-control" name="user[password]">
      </div>
      <label style="font-weight: 500">Confirm Password: </label>
      <div>
        <input type="password" class="form-control" name="user[password_confirmation]">
      </div>
      <label style="font-weight: 500">Mobile Number: </label>
      <div>
        <div class="input-group" style="width: 80%;">
          <span class="input-group-addon" id="basic-addon1">+91</span>
          <input type="number" class="form-control" name="user[mobile_number]">
        </div>
      </div>

      <!-- <h4>User Details</h4> -->
      <div style="width: 80%;">
        <hr />
      </div>

      <label style="font-weight: 500">First Name: </label>
      <div>
        <input type="text" class="form-control" name="user[first_name]" value="">
      </div>

      <label style="font-weight: 500">Middle Name(Optional): </label>
      <div>
        <input type="text" class="form-control" name="user[maiden_name]" value="">
      </div>

      <label style="font-weight: 500">Last Name: </label>
      <div>
        <input type="text" class="form-control" name="user[last_name]" value="">
      </div>

      

      <label style="font-weight: 500">Date of Birth:</label>
      <div>
        <input type="text" class="datepicker form-control" name="user[profile_attributes][date_of_birth]">
      </div>

      <label style="font-weight: 500">Gender:</label>
      <div>
        <label style="margin-right: 20px; margin-top: 0;">
          <input type="radio" name="user[profile_attributes][gender]" value="m" style="display: inline;">&nbsp;Male
        </label>
        <label style="margin-top: 0;">
          <input type="radio" name="user[profile_attributes][gender]" value="f" style="display: inline;">&nbsp;Female
        </label>
      </div>

      <label style="font-weight: 500">Address Line 1:</label>
      <div>
        <input type="text" class="form-control" name="user[profile_attributes][address_1]">
      </div>

      <label style="font-weight: 500">Address Line 2:</label>
      <div>
        <input type="text" class="form-control" name="user[profile_attributes][address_2]">
      </div>

      <label style="font-weight: 500">City:</label>
      <div>
        <input type="text" class="form-control" name="user[profile_attributes][city]">
      </div>

      <label style="font-weight: 500">State:</label>
      <div>
        <select class="form-control" name="user[profile_attributes][state]">
          <% @states.each do |state| %>
            <option value="<%= state.id %>"><%= state.name %></option>
          <% end %>
        </select>
      </div>

      <label style="font-weight: 500">Pin Code:</label>
      <div>
        <input type="text" class="form-control" name="user[profile_attributes][pin_code]">
      </div>

      <div>
        <button id="submitButton" style="border-radius: 1px; height: 40px"> SUBMIT</button>
      </div>

    </div>

</form>

<style>
  label {
    margin-top: 20px;
  }

  input.form-control , select.form-control{
    padding: 5px;
    width: 80%;
    /*background-color: #eff8f3;*/
    outline: 1px solid transparent;
  }

  #submitButton {

    margin-top: 20px;
    color: white;
    font-size: 11px;
    width: 135px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 500;
    height: 45px;
    text-align: center;
    cursor: pointer;
    border-radius: 2px;
    background-color: #93c178;
    border: 1px solid transparent;

  }
  input[type=password]{
    height: 32px;
    width: 80%;
    padding: 10px;
  }

  .topbarContainer{
    display: none;
  }

</style>

<script type="text/javascript">
  $(document).ready(function(){
    $(".datepicker").datepicker({dateFormat: "yy-mm-dd"});
  })

  snapNotify = function(obj) {
    var color, container, message, messages, results, type;
    console.log(obj);
    results = [];
    for (type in obj) {
      messages = obj[type];
      switch (type) {
        case 'error':
          color = 'red';
          container = 'ohsnap-priority';
          break;
        case 'success':
          color = 'green';
          container = 'ohsnap';
          break;
        case 'failure':
          ({
            color: 'orange'
          });
          container = 'ohsnap-priority';
          break;
        case 'message':
          ({
            color: 'blue'
          });
          container = 'ohsnap';
          break;
        case 'notice':
          ({
            color: 'blue'
          });
          container = 'ohsnap';
          break;
        default:
          ({
            color: 'blue'
          });
          container = 'ohsnap';
      }
      if (messages.length) {
        results.push((function() {
          var i, len, results1;
          results1 = [];
          for (i = 0, len = messages.length; i < len; i++) {
            message = messages[i];
            results1.push(ohSnap(message, {
              color: color,
              'duration': '6000'
              // 'container-id': container
            }));
          }
          return results1;
        })());
      } else {
        results.push(void 0);
      }
    }
    return results;
  };

  $('#newUserRegistration').submit(function(){
    $.ajax({
      url: $('#newUserRegistration').attr('action'),
      type: 'PATCH',
      data: $('#newUserRegistration').serialize(),
      success: function(res){
        console.log('form submitted.', res);
        snapNotify(res.messages);
      }
    });
    return false;
  });
</script>