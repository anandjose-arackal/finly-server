<body style="background-color: #465c8b;padding: 30px 0 30px 0">

<form id="newUserRegistration" action="<%= pending_invite_path(@pending_user) %>" method="post">

  <input name="_method" type="hidden" value="patch">
  <input name="authenticity_token" value="<%= form_authenticity_token%>" type="hidden">
  <input name="user[invitation_token]" type="hidden" value="<%=params[:invitation_token]%>">

    <div style="width: 600px;padding: 20px 40px 40px 80px; background-color: white; margin:30px auto;border: 1px solid #d8d8d8">

      <div>
        <h4 style="color: #465c8b; font-weight: 300; font-size: 20px">Welcome To Finly Expenses! </h4>
      </div>
      <label style="margin-top: 20px; font-weight: 500">Name: </label>
      <div>
        <input type="text" style="background-color: white" name="user[name]">
      </div>


      <label style="font-weight: 500">Company Name: </label>
      <div>
        <input type="text" name="user[company_name]" value="<%= @pending_user.company_name %>" readonly>
      </div>
      <label style="font-weight: 500">Email: </label>
      <div>
        <input type="text" name="user[email]" value="<%= @pending_user.email %>" readonly>
      </div>
      <label style="font-weight: 500">Password: </label>
      <div>
        <input type="password" name="user[password]">
      </div>
      <label style="font-weight: 500">Confirm Password: </label>
      <div>
        <input type="password" name="user[password_confirmation]">
      </div>
      <label style="font-weight: 500">Mobile Number : </label>
      <div>
        <input type="number" name="user[mobile_number]">
      </div>

      <div>
        <button id="submitButton" style="border-radius: 1px; height: 40px"> SUBMIT</button>
      </div>

    </div>

</form>

</body>

<style>
  label {
    margin-top: 20px;
  }

  input {
    padding: 5px;
    width: 80%;
    background-color: #eff8f3;
    outline: 1px solid transparent;
  }

  #submitButton {

    margin-top: 20px;
    color: white;
    font-size: 11px;
    width: 135px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 500;
    height: 45px;
    text-align: center;
    cursor: pointer;
    border-radius: 2px;
    background-color: #93c178;
    border: 1px solid transparent;

  }
  input[type=password] {
    height: 32px;
    width: 80%;
    padding: 10px;
  }


  .topbarContainer{
    display: none;
  }


</style>
