<% url = edit_pending_invite_url(id: @token) %>
<% content_for :body do %>
    <div class="primary block center" style="background-color: white; text-align: center;">
    <br>
    <p style="line-height: 160%; margin: 0 0 20px 0;"><%= "#{@user.name} has invited you to join #{@user.company.name}'s Finly account." %></p>
    <p style="line-height: 160%; margin: 0 0 20px 0;">
      <a style="background-color: #374F76; border: none; color: white; display: inline-block; font-size: 14px;
          font-weight: 700; letter-spacing: 1px; padding: 13px 25px; text-decoration: none;
          text-transform: uppercase;"
         href="<%= "#{url}" %>"
         class="primaryButton">Create Account</a>
    </p>
    <p style="line-height: 160%; margin: 0 0 20px 0;">
      Or click the link below:<br>
      <a style="border: none; color: #374F76; text-decoration: none;" href="<%= "#{url}" %>"><%= "#{url}" %></a>
    </p>
    <br>
    <% if @note %>
        <div class="welcomeNote" style="background-color: #FBFBFD; border-bottom: 1px solid #efefef; border-top: 1px solid #efefef; margin-top: 20px; padding: 30px;">
          <%== @note %><br><br>
          <span class="name" style="font-weight: 700; margin-top: 14px;">- <%= @user.name %></span>
        </div>
        <br>
        <br><br>
    <% end %>
    <p style="color: #999999; line-height: 160%; margin: 0 0 20px 0;">That's it - say goodbye to expense reports
      forever!</p>
    <p style="color: #999999; line-height: 160%; margin: 0 0 20px 0;">Finly is the easiest way to get
      reimbursed by <%= @user.company.name %> for company expenses you incur. In just a few seconds, you can submit expenses
      from your phone or computer, then sit back and wait for the money to hit your bank account.</p>
    </div>
    </div>
<% end %>

<%= render 'application_mailer/template' %>