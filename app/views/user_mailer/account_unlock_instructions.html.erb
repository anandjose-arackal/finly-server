<% url = unlock_url(@user, unlock_token: @token) %>
<% content_for :body do %>
    <div class="primary block center" style="background-color: white; text-align: center;">
      <br>

      <p style="line-height: 160%; margin: 0 0 20px 0;">Your account has been locked due to an excessive number of unsuccessful sign in attempts.</p>
      <br>
      <p style="line-height: 160%; margin: 0 0 20px 0;">Click the button below to unlock your account</p>
      <p style="line-height: 160%; margin: 0 0 20px 0;">
        <a style="background-color: #374F76; border: none; color: white; display: inline-block; font-size: 14px;
            font-weight: 700; letter-spacing: 1px; padding: 13px 25px; text-decoration: none;
            text-transform: uppercase;"
           href="<%= "#{url}" %>" class="primaryButton">Unlock Account</a>
      </p>

      <p style="line-height: 160%; margin: 0 0 20px 0;">
        Or click the link below:<br>
        <a style="border: none; color: #374F76; text-decoration: none;" href="<%= "#{url}" %>"><%= "#{url}" %></a>
      </p>
      <br>
    </div>

<% end %>

<%= render 'application_mailer/template' %>