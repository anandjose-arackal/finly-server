  <form data-remote data-turboboost method="post" action="<%= %>">
    <input name="authenticity_token" value="<%= form_authenticity_token %>" hidden="hidden">
    <input class="inputWorkEmail" name="register[email]" type="text" placeholder="Work Email">
    <button id="addComment" class="requestDemo" type="submit">Request Early Access</button>
  </form>


  <footer id="footer">
    <ul id="">
      <div >
        <li>
          <a href="#" style="float: left;text-decoration: none; font-size: 11px; font-weight: 600; padding: 24px 10px; color: white; ">OUR
            PRODUCT</a>
        </li>
        <li>
          <a href="<%= about_url %>" style="float: left; text-decoration: none; font-size: 11px;font-weight: 600; padding: 24px 10px; color: white">ABOUT
            US</a>
        </li>
        <li>
          <a href="<%= %>" style="float: left;text-decoration: none; font-size: 11px;font-weight: 600; padding: 24px 10px; color: white">JOBS</a>
        </li>
        <li>
          <a href="<%= %>" style="float: left;text-decoration: none; font-size: 11px;font-weight: 600; padding: 24px 10px; color: white">HELP
          </a></li>
        <li>
          <a href="<%= %>" style="float: left;text-decoration: none; font-size: 11px;font-weight: 600; padding: 24px 10px; color: white">PRIVACY
          </a></li>
      </div>

    </ul>
    <div style="letter-spacing: 2px;float: right; color: #93c178;font-size: 28px; font-family: 'Bree Serif', serif; margin-top: 10px; margin-right: 80px">
      Finly
      <p style="font-size: 12px;
          font-weight: 300;
          color: wheat;">  &#169; 2016 Jouska, Pvt. Tech. Ltd.</p>
    </div>
  </footer>
</div>
</body>
<style>

  .topbarContainer .topbar {
    background-color: #46568b;
    border: none;
  }

  .inputWorkEmail {
    border-radius: 1px;
    border: 1px solid #d8d8d8;
    width: 250px;
    margin: 10px 5px 0 0;
    height: 40px;
    padding: 10px;
  }

  .requestDemo {
    border: 1px solid #d8d8d8;
    color: #555;
    background-color: #f7ef6a;
    border-radius: 2px;
    margin: 10px 5px 0 0;
    height: 40px;
    padding: 10px;
    cursor: pointer;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 500;
    -moz-transition: background-color 200ms ease;
    -webkit-transition: background-color 200ms ease;
    transition: background-color 200ms ease;
  }

  #footer {
    width: 100%;
    min-height: 110px;
    border: none;
  }

  .navbar-brand {
    font-weight: 800;
    padding: 15px 15px !important;
    font-size: 32px;
    float: left;
  }

  #headerNavigation a {
    color: white !important;
  }

  h5 {
    font-weight: 200;
    font-size: 26px;
    color: #46568b;
    letter-spacing: -1px;
    margin-left: 20px;
    font-family: 'Bree Serif', serif;

  }

  h3 {
    font-size: 2.8em;
    color: black;
    font-family: 'Bree Serif', serif;

  }

  #featuresDiv p {
    font-size: 16px;
    font-weight: 300;
    color: black;
    margin-left: 20px;
    text-align: justify;
  }

  hr {
    border-top: 1px solid #d8d8d8;
  }

  img {
    height: 70px;
    width: 70px;
    margin-top: 20px;
  }

  section {
    margin-top: 10px;
  }

  .row {
    margin-top: 10px;
  }


</style>