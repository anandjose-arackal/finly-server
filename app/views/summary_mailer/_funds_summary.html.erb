<table style="width: 94%; margin: auto; border: 1px solid #dcdcdc; border-collapse: collapse;">
  <% @data.summary.each do |key, value| %>
      <tr>
        <td style="padding: 15px; border: 1px solid #dcdcdc; font-family: Helvetica, Arial, sans-serif;"><%= key.upcase %></td>
        <td style="padding: 15px; border: 1px solid #dcdcdc; font-family: Helvetica, Arial, sans-serif;">&#8377;<%= value %></td>
      </tr>
  <% end %>
</table><br>