<% content_for :body do %>
    <h3> Please find attached the KYC documents for company <%= @company.name%> </h3>
    <br/>
    <p> The documents attached herewith are: </p>

    <% @documents.each_with_index do |doc, index| %>
        <h5><%= index +1 %>. <%= doc.humanize %></h5>
        <h5> Document uploaded time: <%= @company_kyc.send("#{doc}_updated_at")%> </h5>
    <% end %>

    <p>Company Name: <%= @company.name %></p>
    <p>Version of Agreed UpPrepaid Card Agreement: <%= @agreement_track.agreement.version %></p>
    <p>Agreement uploaded date: <%= @agreement_track.agreement.created_at %></p>
    <p>Timestamp of agreement acceptance: <%= @agreement_track.created_at%></p>
    <p>Login Credential: <%= @company.users.point_of_contact.first.email || @company.users.point_of_contact.first.mobile_number %></p>
    <p>IP Address: <%=@agreement_track.ip_address%></p>

    <br/>
<% end %>

<%= render 'application_mailer/template' %>