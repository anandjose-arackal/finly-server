
<div class="row" style="background-color: white !important;">
  <div class="col-md-6 col-md-offset-3" style="min-height: 20px">

    <h3>Company: <%=@result.company.name%></h3>

    <form accept-charset="UTF-8" id="newCompanyForm" action="<%= superadmin_company_path(@result.company.id) %>" method="post">
      <input name="utf8" type="hidden" value="&#x2713;"/>
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      <input name="_method" type="hidden" value="patch">

      <h3>Company Details</h3>

      <p>Company Name: </p>
      <input class="form-control" type="text" name="company[name]" placeholder="Name" title="Company name" value="<%=@result.company.name%>">

      <br/><br/>

      <input class="form-control" type="text" name="company[itz_cash_property_attributes][d_code]" placeholder="D Code" title="Company D-Code" value="<%=@result.company.d_code%>">

      <br/><br/>

      <div>
        <button id="submitButton" class="btn-default" style="border-radius: 1px; height: 40px"> UPDATE</button>
      </div>

    </form>

    <br/><br/>

    <button class="btn btn-sm btn-warning btn-import-employees" onclick="showInviteModal()">Import Employees</button>

    <br/><br/>

    <button class="btn btn-sm btn-warning btn-import-employees" onclick="location.href='<%=new_superadmin_company_user_path(@result.company.id)%>'">Add New Employee</button>

    <br/><br/>

    <!-- todo - have to add the list of users with respective links to thadmindmin show pages -->
    <% @result.company.users.filter_state(1).each do |user| %>
        <%= link_to user.name, superadmin_company_user_path(@result.company, user) %>

        <hr class="listDivider">

    <% end %>

  </div>
</div>

<!-- import modal -->

<div class="modal fade" tabindex="-1" role="dialog" id="modal-import-employees" data-backdrop="true">
  <div class="modal-dialog" role="document" style="width: 40%; margin-top: 113px;">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title">Invite Employees by Importing Excel File</h4>
      </div>
      <div class="modal-body" style="padding-top: 0;">
        <div class="row no-margin">
          <div class="col-sm-12 text-right">
            <a href="/common/files/sample_import format_superadmin.xls" class="btn btn-warning btn-sm">Download Template</a>
          </div>
        </div>

        <div class="row no-margin">
          <div class="col-sm-12">
            <form id="form-import-employees" enctype="multipart/form-data" action="/superadmin_import.csv" data-remote="true">
              <input type="hidden" name="_type" value="POST">
              <input type="hidden" name="authenticity_token">

              <input class="form-control" style="border: none;box-shadow: none;padding: 0;" type="file" accept=".csv, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel" name="file">
              <div class="form-group text-center">
                <input type="submit" value="Upload" class="btn btn-sm btn-success"/>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>

  $(document).ready(function(){
    $(".datepicker").datepicker({
      dateFormat: "dd-mm-yy",
      changeMonth: true,
      changeYear: true,
      yearRange: "-100:+0"
    })
  });

  function showInviteModal()
  {
    $('#modal-import-employees').modal('show');
  }

</script>