<!DOCTYPE html>
<html>
<head>
  <title>Procure Document</title>
  <%= stylesheet_link_tag "http://netdna.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.css", media: "all", "data-turbolinks-track" => true %>
</head>
<body>
<div class="containers document-header-container overflow-hidden">
  <div class="vendor-details">
    <div class="vendor-company-logo">
      <img src="<%= @company.configuration.logo.url(:thumb) %>" width="150" height="auto">
    </div>
    <div class="vendor-address">
      <!--<span class="company-name font-size-14 bold"><%#= @result.purchase_order.location.name %></span>-->
      <span class="address-line-1"></span>
      <span class="address-line-2">
        <%#= @result.purchase_order.location.address %>
        Business Office:<br/>
        DLF Corporate Park,<br/>
        Ground Floor, Tower 3A, <br />
        DLF City, Phase III,<br />
        M.G. Road, Gurgaon, 122001<br />
        CIN 074900HR2009PTC053732

      </span>
    </div>
  </div>
  <div class="document-details">
    <div class="document-type">
      <span>Purchase Order</span>
    </div>
    <div class="document-details">
      <span class="block">
          <span class="title">PO Number</span>
          <span class="value"><%= @result.purchase_order.po_number %></span>
        </span>
      <span class="block">
          <span class="title">Document Date</span>
          <span class="value"><%= @result.purchase_order.created_at.strftime "%b-%d-%Y" %></span>
        </span>
      <span class="block">
          <span class="title">Due Date</span>
          <span class="value"><%= @result.purchase_order.delivery_date&.strftime "%b-%d-%Y" %></span>
        </span>
      <span class="block">
          <span class="title">Payment Term</span>
          <span class="value"><%= @result.purchase_order.payment_term&.name %></span>
        </span>
    </div>
  </div>
</div>
<div class="containers customer-details-container overflow-hidden">
  <div class="customer-details wd-33">
    <div class="main-title width-fit-content">Vendor Details</div>
    <table class="table-customer-details" style="margin-right: 10px;">
      <tbody>
      <tr>
        <td class="table-title">Name</td>
        <td class="table-value"><%= @result.purchase_order.vendor.display_name %></td>
      </tr>
      <tr>
        <td class="table-title">Mobile</td>
        <td class="table-value"><%= @result.purchase_order.vendor.mobile_number %></td>
      </tr>
      <tr>
        <td class="table-title">PAN Number</td>
        <td class="table-value"><%= @result.purchase_order.vendor.pan %></td>
      </tr>
      <tr>
        <td class="table-title">GSTIN</td>
        <td class="table-value"><%= @result.purchase_order.vendor.gst %></td>
      </tr>
      </tbody>
    </table>
    <!-- <span class="block">
        <span class="title">Name</span>
        <span class="value"><%= @result.purchase_order.vendor.name %></span>
      </span>
    <span class="block">
        <span class="title">Mobile</span>
        <span class="value"><%= @result.purchase_order.vendor.mobile_number %></span>
      </span>
    <span class="block">
        <span class="title">PAN Number</span>
        <span class="value"><%= @result.purchase_order.vendor.pan %></span>
      </span>
    <span class="block">
        <span class="title">GSTIN</span>
        <span class="value"><%= @result.purchase_order.vendor.gst %></span>
      </span> -->
  </div>
  <div class="billing-address wd-33">
    <div class="main-title width-fit-content">Billing Address</div>
    <table class="table-locations" style="margin-right: 10px;">
      <tbody>
      <tr>
        <td colspan="2" class="table-title"><%= @result.purchase_order.location.name %></td>
      </tr>
      <tr>
        <td colspan="2" class="table-value" style="padding-left: 0 !important;">
          <% if @result.purchase_order.billing_address.present? %>
            <%= simple_format @result.purchase_order.billing_address, {}, wrapper_tag: "div" %>
          <% else %>
            <%= @result.purchase_order.location.address %>
          <% end %>
        </td>
      </tr>
      <tr>
        <td class="table-title">GST Number :</td>
        <td class="table-value"><%= @result.purchase_order.location.gstin %></td>
      </tr>
      <tr>
        <td class="table-title">PAN Number :</td>
        <td class="table-value"><%= @result.purchase_order.location.pan %></td>
      </tr>
      </tbody>
    </table>
    <!-- <div class="address">
      <span class="address-line-1 mg-bottom-5"><%= @result.purchase_order.location.name %></span>
      <span class="address-line-2 mg-bottom-5"><%= @result.purchase_order.location.address %></span>
      <span class="city mg-bottom-5">GSTIN No : &nbsp; <%= @result.purchase_order.location.gstin %></span>
      <span class="state mg-bottom-5">PAN Card : &nbsp; <%= @result.purchase_order.location.pan %></span>
    </div> -->
  </div>
  <div class="shipping-address wd-33">
    <div class="main-title width-fit-content">Shipping Address</div>
    <table class="table-locations">
      <tbody>
      <tr>
        <td colspan="2" class="table-title"><%= @result.purchase_order.delivery_location.name %></td>
      </tr>
      <tr>
        <td colspan="2" class="table-value" style="padding-left: 0 !important;">
          <% if @result.purchase_order.shipping_address.present? %>
            <%= simple_format @result.purchase_order.shipping_address, {}, wrapper_tag: "div" %>
          <% else %>
            <%= @result.purchase_order.delivery_location.address %>
          <% end %>
        </td>
      </tr>
      <tr>
        <td class="table-title">GST Number :</td>
        <td class="table-value"><%= @result.purchase_order.delivery_location.gstin %></td>
      </tr>
      <tr>
        <td class="table-title">PAN Number :</td>
        <td class="table-value"><%= @result.purchase_order.delivery_location.pan %></td>
      </tr>
      </tbody>
    </table>
  </div>
</div>

