<div class="containers document-line-items-container overflow-hidden">
  <div class="main-title width-fit-content">Items</div>
  <table class="table-document-items">
    <thead>
    <tr>
      <th style="width: 25px;">#</th>
      <th>Product Description</th>
      <th>Comment</th>
      <th>Quantity</th>
      <th>Rate</th>
      <th>Discount</th>
      <th>Tax</th>
      <th>Total</th>
    </tr>
    </thead>
    <tbody>
    <% @result.purchase_order.items.each_with_index do |item, index| %>
      <tr>
        <td><%= index + 1 %></td>
        <td><%= item.description %></td>
        <td><%= item.comment %></td>
        <td><%= item.quantity %></td>
        <td><i class="fa fa-inr"><%= item.rate %></td>
        <td><i class="fa fa-inr"><%= item.discount_amount&.value %></td>
        <td><i class="fa fa-inr"><%= item.tax_amount&.value %></td>
        <td><i class="fa fa-inr"><%= item.total_amount&.value %></td>
      </tr>
    <% end %>
    </tbody>
  </table>
  <table class="table-document-items-summary" style="page-break-inside: avoid;">
    <tbody>
    <tr>
      <td>Total</td>
      <td><i class="fa fa-inr"><%= @result.purchase_order.total_before_tax&.value %></td>
    </tr>
    <tr>
      <td>Discount</td>
      <td><i class="fa fa-inr"><%= @result.purchase_order.discount_amount&.value %></td>
    </tr>
    <tr>
      <td>Tax</td>
      <td><i class="fa fa-inr"><%= @result.purchase_order.tax_amount&.value %></td>
    </tr>
    <tr>
      <td>Balance Due</td>
      <td><i class="fa fa-inr"><%= @result.purchase_order.balance_amount&.value %></td>
    </tr>
    </tbody>
  </table>
</div>
<!-- <div class="footer">
  <p>Generated by Finly Spend Management - https://www.finly.io</p>
</div> -->
<!--<div class="page-break"></div>-->

<div class="terms">
  <div class="main-title width-fit-content">Terms & Conditions</div>
  <div class="term-text">
    <%= simple_format @result.purchase_order.procurement_term_text, {}, wrapper_tag: "div" %>
  </div>
</div>

<div class="approval-flow">
  <ul>
    <% approved_users = [] %>
    <% @result.purchase_order.trails.printable_trails.only_approve.each do |trail| %>
      <% if trail.action_id == TrailAction.id_for(:approve) && trail.action_user_id.present? %>
        <% unless approved_users.include?(trail.action_user) %>
          <% approved_users.push(trail.action_user) %>
          <li>
            <div class="text center" style="font-size: 13px; color: #454545;"><%= trail.action_user.name %></div>
            <div class="text-center" style="font-size: 12px; color: #888;">
              <%= trail.action_user.profile.signature_title.present? ? trail.action_user.profile.signature_title : "Approved" %>
            </div>
          </li>
        <% end %>
      <% end %>
    <% end %>
  </ul>
</div>
</body>
</html>

