<div class="company-logo" style="width: 100%;">
  <p style="display: inline-block; width: 50%; vertical-align: middle;margin: 0;"><span style="padding: 5px 10px; background: #eee;"><%= @invoice.outward_invoice_type.name.humanize %></span></p><!--
  --><p style="display: inline-block; width: 50%; vertical-align: middle; text-align: right; margin: 0;">
  <img src="<%= @invoice.company.collect_company_detail.company_logo.url(:thumb) %>" style="height: 75px; margin: 0;">
</p>
</div>

<hr style="margin: 0; border: none; border-bottom: 1px solid #3f3b5f;">

<div class="company-info">
  <div style="width: 50%; display: inline-block; margin-top: 35px;">
    <div class="address-title">
      Invoice Details : <br>
    </div>
    <div class="customer-block">

      <div class="invoice-number">
        <span class="fixed-span">  Invoice Number  &nbsp;  </span> <span><b><%= @invoice.invoice_number%></b></span>
      </div>
      <!--<div class="invoice-number">-->
      <!--<span> <b> Invoice Details : &nbsp; </b> </span> <span>KA-12368763471-1238</span>-->
      <!--</div>-->
      <div class="invoice-date">
        <span class="fixed-span">  Invoice Date  &nbsp;  </span> <span><b><%= @invoice.date%></b></span>
      </div>
      <!--<div class="order-number">-->
      <!--<span> <b> Order Number : &nbsp; </b> </span> <span>407-213879821-213</span>-->
      <!--</div>-->
      <div class="order-date">
        <span class="fixed-span">  Due Date  &nbsp;  </span> <span><b><%= @invoice.due_date%> </b></span>
      </div>
    </div>
  </div><!--
  --><div class="company-address"  style="display: inline-block; width: 50%; text-align: right; vertical-align: top; font-size: 13px; margin: 0; margin-top: 10px;">
  <% if @invoice.location.present? %>
    <% if @invoice.location.gstin.present? %>
      GSTIN: <%= @invoice.location.gstin %><br />
    <% end %>
  <% else %>
    <% if @invoice.company.collect_company_detail.gst.present? %>
      GSTIN: <%= @invoice.company.collect_company_detail.gst %><br />
    <% end %>
  <% end %>
  <%= @invoice.company.name %>
  <% if @invoice.location.present? %>
    <%= simple_format @invoice.location.address, {}, wrapper_tag: "div" %>
  <% else %>
    <%= simple_format @invoice.company.collect_company_detail.address, {}, wrapper_tag: "div" %>
  <% end %>
</div>
</div>

<div class="float-container address-block" style="margin-top: 20px;">
  <div class="customer-details-block" style="display: inline-block; width: 40%; vertical-align: top;">
    <div class="address-title">
      Customer Details : <br>
    </div>
    <div class="customer-block">

      <div class="invoice-care-of-name">
        <span class="fixed-span">  Name  &nbsp; </span> <span><b><%= @invoice.customer.name %></b></span>
      </div>
      <!--<div class="invoice-number">-->
      <!--<span> <b> Invoice Number : &nbsp; </b> </span> <span>6589798746</span>-->
      <!--</div>-->
      <% if @invoice.mobile_number.present? %>
      <div class="invoice-number">
        <span class="fixed-span">  Mobile  &nbsp;  </span> <span><b><%= @invoice.mobile_number%></b></span>
      </div>
      <% end %>
      <div class="invoice-number">
        <span class="fixed-span">  Invoice Date  &nbsp;  </span> <span><b><%= @invoice.date %></b></span>
      </div>
      <% if @invoice.customer.pan.present? %>
        <div class="pan-no">
          <span class="fixed-span">  PAN Number  &nbsp;  </span> <span><b><%= @invoice.customer.pan%></b></span>
        </div>
      <% end %>
      <% if @invoice.customer.gst.present? %>
        <div class="gst-registered">
          <span class="fixed-span">  GSTIN  &nbsp;  </span> <span><b><%= @invoice.customer.gst%></b></span>
        </div>
      <% end %>
    </div>
  </div><!--
