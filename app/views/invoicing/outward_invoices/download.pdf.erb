</div>


</div>

<% show_hsn_sac = false %>
<% @invoice.invoice_items.each do |item| %>
  <% if item.hsn_sac.present? %>
    <% show_hsn_sac = true; break; %>
  <% end %>
<% end %>


<% if @invoice.inclusive_of_taxes %>
  <div style="width: calc(100% - 10px); height: auto; overflow: hidden;font-size: 12px; color: #7b7b7b; font-weight: 300; margin-top: 10px; margin-left: 10px; ">
    <span style="color: darkred;">* &nbsp;&nbsp;</span> Inclusive of taxes
  </div>
<% end %>

<div class="item-details-table" style="overflow-x: auto; margin-top: 30px;">

  <table class="line-items-table" style="width: 100%; border-collapse: collapse !important;">
    <thead style="background-color: #eee; color: rgba(25,51,113,1); color: black;">
    <tr>
      <th scope="col" style="width: 20px; text-align: left; ">#</th>
      <th scope="col" style="text-align: left; ">Name/Description</th>
      <% if @invoice.invoice_items_custom_field_configuration_ids.present? %>
        <% @invoice.invoice_items_custom_field_configuration_ids.each do |fc_id| %>
          <th scope="col" style="text-align: left; "><%= FieldConfiguration.find_by(id: fc_id)&.field_name %></th>
        <% end %>
      <% end %>
      <% if show_hsn_sac %>
        <th scope="col" style="text-align: left; ">HSN/SAC</th>
      <% end %>
      <th scope="col" style="text-align: center; ">Quantity</th>
      <th scope="col" style="text-align: right; ">Rate</th>
      <th scope="col" style="text-align: right; ">Amount</th>
      <th scope="col" style="text-align: right; ">Discount</th>
      <th scope="col" style="text-align: right "><%= @invoice.gst_type_id == 1 ? "IGST" : "CGST + SGST" %></th>
      <th scope="col" style="text-align: right; " colspan="2">Total</th>
    </tr>
    </thead>
    <tbody>
    <% @invoice.invoice_items.each_with_index do |item, index| %>
      <tr>
        <td style="padding: 5px; text-align: left; font-size: 11px; " scope="row"><%= (index + 1) %></td>
        <td style="padding: 5px; text-align: left; font-size: 11px; "><%= item.description %><br/><span style="color: #787878;"><%= item.item_info %></span></td>
        <% if @invoice.invoice_items_custom_field_configuration_ids.present? %>
          <% @invoice.invoice_items_custom_field_configuration_ids.each do |fc_id| %>
            <td style="padding: 5px; text-align: left; font-size: 11px; "><%= item.custom_fields.with_field_configuration_ids(fc_id).first&.value&.value %></td>
          <% end %>
        <% end %>
        <% if show_hsn_sac %>
          <td style="padding: 5px; text-align: left; font-size: 11px; "><%= item.hsn_sac%></td>
        <% end %>
        <td style="padding: 5px; text-align: center; font-size: 11px; "><%= item.quantity%></td>
        <td style="padding: 5px; text-align: right; font-size: 11px; ">INR<%= item.rate %></td>
        <td style="padding: 5px; text-align: right; font-size: 11px; ">INR<%= item.amount&.value%></td>
        <td style="padding: 5px; text-align: right; font-size: 11px; "><%= item.discount %>%</td>
        <td style="padding: 5px; text-align: right; font-size: 11px; "><%= item.tax %>%</td>
        <td style="padding: 5px; text-align: right; font-size: 11px; ">INR<%= item.net_amount&.value%></td>
      </tr>
    <% end %>
    <tr>
      <% if show_hsn_sac %>
        <td colspan="6" style="border: none;"></td>
      <% else %>
        <td colspan="5" style="border: none;"></td>
      <% end %>
      <td style="padding: 5px; border: none !important; text-align: right; font-size: 12px; " class="line-items-title" colspan="2">Total </td>
      <td style="padding: 5px; border: none !important; text-align: right;; font-size: 12px; " class="line-items-data line-items-total" colspan="1">INR<%= @invoice.line_items_net_total.to_f.round(2) %></td>
    </tr>
    <% if @invoice.discount_amount&.value > 0 %>
      <tr>
        <% if show_hsn_sac %>
          <td colspan="6" style="border: none;"></td>
        <% else %>
          <td colspan="5" style="border: none;"></td>
        <% end %>
        <td style="padding: 5px; border: none !important; text-align: right; font-size: 12px; " class="line-items-title" colspan="2">Discount </td>
        <td style="padding: 5px; border: none !important; text-align: right;; font-size: 12px; " class="line-items-data line-items-discount" colspan="1">INR<%= @invoice.discount_amount&.value.to_f.round(2) %></td>
      </tr>
    <% end %>
    <% if @invoice.tax_amount&.value > 0 %>
      <tr>
        <% if show_hsn_sac %>
          <td colspan="6" style="border: none;"></td>
        <% else %>
          <td colspan="5" style="border: none;"></td>
        <% end %>
        <td style="padding: 5px; border: none !important; text-align: right; font-size: 12px; " class=" line-items-title" colspan="2">Tax </td>
        <td style="padding: 5px; border: none !important; text-align: right;; font-size: 12px; " class="line-items-data line-items-tax" colspan="1">INR<%= @invoice.tax_amount&.value.to_f.round(2) %></td>
      </tr>
    <% end %>
    <!--<tr>-->
    <!--<th class="plain" colspan="6"></th>-->
    <!--<td style="padding: 5px; border: none !important; text-align: right;; font-size: 11px; " class="plain line-items-title" colspan="2">TDS :</td>-->
    <!--<td style="padding: 5px; border: none !important; text-align: right;; font-size: 11px; " class="plain line-items-data line-items-tds" colspan="2">INR67</td>-->
    <!--</tr>-->
    <% if @invoice.advance_amount&.value > 0 %>
      <tr>
        <% if show_hsn_sac %>
          <td colspan="6" style="border: none;"></td>
        <% else %>
          <td colspan="5" style="border: none;"></td>
        <% end %>
        <td style="padding: 5px; border: none !important; text-align: right; font-size: 12px; " class=" line-items-title" colspan="2">Advance Payment </td>
        <td style="padding: 5px; border: none !important; text-align: right;; font-size: 12px; " class="line-items-data line-items-advance-payment" colspan="1">INR<%= @invoice.advance_amount&.value.to_f.round(2) %></td>
      </tr>
    <% end %>
    <% if @invoice.freight_amount&.value > 0 %>
      <tr>
        <% if show_hsn_sac %>
          <td colspan="6" style="border: none;"></td>
        <% else %>
          <td colspan="5" style="border: none;"></td>
        <% end %>
        <td style="padding: 5px; border: none !important; text-align: right; font-size: 12px; " class="line-items-title" colspan="2">Freight </td>
        <td style="padding: 5px; border: none !important; text-align: right;; font-size: 12px; " class="line-items-data line-items-freight" colspan="1">INR<%= @invoice.freight_amount&.value.to_f.round(2) %></td>
      </tr>
    <% end %>
    <tr>
      <% if show_hsn_sac %>
        <td colspan="6" style="border: none;"></td>
      <% else %>
        <td colspan="5" style="border: none;"></td>
      <% end %>
      <td style="padding: 5px; border: none !important; text-align: right; font-size: 12px; " class="line-items-title" colspan="2">Roundoff </td>
      <td style="padding: 5px; border: none !important; text-align: right;; font-size: 12px; " class="line-items-data line-items-roundoff" colspan="1">INR<%= @invoice.roundoff_amount.to_f.round(2) %></td>
    </tr>
    <% if @invoice.partially_paid? || @invoice.paid? || @invoice.saved? || @invoice.unpaid? %>
      <tr>
        <% if show_hsn_sac %>
          <td colspan="6" style="border: none;"></td>
        <% else %>
          <td colspan="5" style="border: none;"></td>
        <% end %>
        <td style="padding: 5px; border: none !important; text-align: right; font-size: 12px; " class="line-items-title" colspan="2">Balance Due </td>
        <td style="padding: 5px; border: none !important; text-align: right;; font-size: 12px; " class="line-items-data line-items-balance-due" colspan="1">INR<%= @invoice.balance_due&.value.to_f.round(2) %></td>
      </tr>
    <% end %>
    </tbody>
  </table>

</div>

<% if @invoice.virtual_account.present? %>
  <div style="display: inline-block; width: 33.33%; margin-top: 20px; font-size: 11px; background: #eee; padding: 10px;">
    <div class="address-title">
      Bank Details : <br>
    </div>
    <div class="invoice-number">
      <span class="fixed-span-big">Bank Names  &nbsp;  </span> <span><b>Yes Bank</b></span>
    </div>
    <div class="invoice-number">
      <span class="fixed-span-big">Account Number  &nbsp;  </span> <span><b><%= @invoice.virtual_account.account_number %></b></span>
    </div>
    <div class="invoice-number">
      <span class="fixed-span-big">IFSC Code  &nbsp;  </span> <span><b><%= @invoice.virtual_account.ifsc %></b></span>
    </div>
  </div>
<% end %>

<% if @invoice.customer_memo.present? %>
<div class="customer-notes" style="margin-top: 20px;">
  <div class="address-title" style="color: #5f5f5f;">
    Notes: <br>
  </div>
  <%= simple_format @invoice.customer_memo, {}, wrapper_tag: "p" %>
</div>
<% end %>

<div class="invoice-terms" style="margin-top: 15px;">
  <div class="address-title">
    Terms &amp; Conditions: <br>
  </div>
  <p>Errors and omissions excepted (if any) leading to discrepancies in amount or tax collected shall be recoverable from the END USER at a later date through an additional invoice. </p>
  <% if @invoice.terms.present? %>
    <%= simple_format @invoice.terms, {}, wrapper_tag: "p" %>
  <% end %>
</div>

