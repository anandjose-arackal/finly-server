<!DOCTYPE html>
<html>
<head>

  <title>Invoicing System</title>
</head>
<body>

<div class="first-container">

  <div class="invoice-title container-fluid">
    <span> <b> INVOICE </b> </span>
  </div>

  <% if @invoice.cancelled? %>
  <!-- Add your own logic when to display this cancelled invoice image -->
  <div style="width: 100%; height: auto; overflow: hidden;text-align: center;">

    <%= wicked_pdf_image_tag('/common/images/cancelled-dark.png', style: "width: 200px; height: auto;") %>
    <!--<img src='/home/aditya26381/dev/work/finly-web/public/common/images/cancelled-dark.png' style="width: 200px; height: auto;">-->

  </div>
  <% end %>
  <!--  -->

  <div class="float-container">
    <div class=" company-name company-address">
      <b> <%= @invoice.company.name %> </b>
    </div>
    <div class="company-details-container">
      <div class="company-address-line-one company-address">
        <%= @invoice.company.collect_company_detail&.address %>
      <!--</div>-->
      <!--<div class="company-address-line-two company-address">-->
        <!--Bengaluru, Karnataka.-->
      <!--</div>-->
      <!--<div class="company-pin-code company-address">-->
        <!--PIN : 590095-->
      <!--</div>-->
    </div>

    <div class="company-logo-container">
      <img src="/home/aditya26381/dev/work/finly-web/public/common/images/company_logo.png" class="company-logo">
    </div>
  </div>

</div>
<div class="first-container">

  <div style="width: 50%; height: auto; float: left;">

    <div class="address-title">
      Invoice Details : <br>
    </div>
    <div class="customer-block">

      <div class="invoice-number">
        <span class="fixed-span">  Invoice Number  &nbsp;  </span> <span><b><%= @invoice.invoice_number%></b></span>
      </div>
      <!--<div class="invoice-number">-->
      <!--<span> <b> Invoice Details : &nbsp; </b> </span> <span>KA-12368763471-1238</span>-->
      <!--</div>-->
      <div class="invoice-date">
        <span class="fixed-span">  Invoice Date  &nbsp;  </span> <span><b><%= @invoice.date%></b></span>
      </div>
      <!--<div class="order-number">-->
      <!--<span> <b> Order Number : &nbsp; </b> </span> <span>407-213879821-213</span>-->
      <!--</div>-->
      <div class="order-date">
        <span class="fixed-span">  Due Date  &nbsp;  </span> <span><b><%= @invoice.due_date%> </b></span>
      </div>
    </div>

  </div>

  <div style="width: 50%; float: left; height: auto; text-align: right;">
    <!-- Write a if else logic which displays the image only if the invoice has status as 'cancelled' -->
  </div>


</div>

<div class="float-container address-block">

  <div class="customer-details-block three-columns-float">
    <div class="address-title">
      Customer Details : <br>
    </div>
    <div class="customer-block">

      <div class="invoice-care-of-name">
        <span class="fixed-span">  C/O  &nbsp; </span> <span><b><%= @invoice.customer.name %></b></span>
      </div>
      <!--<div class="invoice-number">-->
      <!--<span> <b> Invoice Number : &nbsp; </b> </span> <span>6589798746</span>-->
      <!--</div>-->
      <div class="invoice-number">
        <span class="fixed-span">  Mobile  &nbsp;  </span> <span><b><%= @invoice.mobile_number%></b></span>
      </div>
      <div class="invoice-number">
        <span class="fixed-span">  Invoice Date  &nbsp;  </span> <span><b><%= @invoice.date %></b></span>
      </div>
      <% if @invoice.customer.pan.present? %>
          <div class="pan-no">
            <span class="fixed-span">  PAN Number  &nbsp;  </span> <span><b><%= @invoice.customer.pan%></b></span>
          </div>
      <% end %>
      <% if @invoice.customer.gst.present? %>
          <div class="gst-registered">
            <span class="fixed-span">  GSTIN  &nbsp;  </span> <span><b><%= @invoice.customer.gst%></b></span>
          </div>
      <% end %>



    </div>

  </div>

  <div class="billing-address-block boxes three-columns-float">
    <div class="address-title">
      Billing Address : <br>
    </div>
    <div class="billing-details-block">
      <div class="shipping-customer-name">
        <% @invoice.customer.name %>
      </div>
      <% address = @invoice.billing_address.split("\n") %>
      <% address.each do |addr| %>
          <div class="address-line billing-address">
            <%= addr %>
          </div>
      <% end %>
      <!--<div class="billing-address-line-two billing-address">-->
      <!---->
      <!--</div>-->
      <!--<div class="billing-pin-code billing-address">-->
      <!---->
      <!--</div>-->
    </div>
  </div>

  <div class="shipping-address-block boxes three-columns-float">
    <div class="address-title">
      Shipping Address : <br>
    </div>
    <div class="shipping-details-block">
      <div class="shipping-customer-name">
        <% @invoice.customer.name %>
      </div>
      <% address = @invoice.shipping_address.split("\n") %>
      <% address.each do |addr| %>
          <div class="address-line billing-address">
            <%= addr %>
          </div>
      <% end %>
      <!--<div class="shipping-address-line-two shipping-address">-->
      <!--Bengaluru, Karnataka.-->
      <!--</div>-->
      <!--<div class="shipping-pin-code shipping-address">-->
      <!--PIN : 590095-->
      <!--</div>-->
    </div>
  </div>

  <% if @invoice.virtual_account.present? %>
      <div style="font-size: 11px; width: 100%; height: auto; text-align: left; overflow: hidden; margin-top: 80px;">
        <div class="address-title">
          Invoice Payment : <br>
        </div>

        <div class="invoice-number">
          <span class="fixed-span-big">Account Number  &nbsp;  </span> <span><b><%= @invoice.virtual_account.account_number %></b></span>
        </div>
        <div class="invoice-number">
          <span class="fixed-span-big">IFSC Code  &nbsp;  </span> <span><b><%= @invoice.virtual_account.ifsc %></b></span>
        </div>


      </div>
  <% end %>

</div>

<% if @invoice.inclusive_of_taxes %>
  <div style="width: calc(100% - 10px); height: auto; overflow: hidden;font-size: 12px; color: #7b7b7b; font-weight: 300; margin-top: 10px; margin-left: 10px; ">
    <span style="color: darkred;">* &nbsp;&nbsp;</span> Inclusive of taxes
  </div>
<% end %>

<div class="item-details-table" style="overflow-x: auto; margin: 10px; width: calc(100% - 20px); margin-top: 0;">

  <table class="line-items-table" style="width: 100%;border-collapse: collapse;margin: 1% auto;margin-bottom: 1%;">
    <thead style="background-color: rgba(201,209,226,1); color: rgba(25,51,113,1); color: black;">
    <tr>
      <th scope="col" style="width: 20px;font-weight: 300;padding: 5px; border: none !important; text-align: left; font-size: 11px; ">#</th>
      <th scope="col" style="padding: 5px;font-weight: 300; border: none !important; text-align: left; font-size: 11px; ">Name/Description</th>
      <th scope="col" style="padding: 5px;font-weight: 300; border: none !important; text-align: left; font-size: 11px; ">HSN/SAC</th>
      <th scope="col" style="padding: 5px;font-weight: 300; border: none !important; text-align: left; font-size: 11px; ">Quantity</th>
      <th scope="col" style="padding: 5px;font-weight: 300; border: none !important; text-align: left; font-size: 11px; ">Rate</th>
      <th scope="col" style="padding: 5px;font-weight: 300; border: none !important; text-align: left; font-size: 11px; ">Amount</th>
      <th scope="col" style="padding: 5px;font-weight: 300; border: none !important; text-align: left; font-size: 11px; ">Discount</th>
      <th scope="col" style="padding: 5px;font-weight: 300; border: none !important; text-align: left; font-size: 11px; "><%= @invoice.gst_type_id == 1 ? "IGST" : "CGST + SGST" %></th>
      <th scope="col" style="padding: 5px;font-weight: 300; border: none !important; text-align: left; font-size: 11px; " colspan="2">Total</th>
    </tr>
    </thead>
    <tbody>
    <% @invoice.invoice_items.each do |item| %>
        <tr>
          <th style="padding: 5px; border: none !important; text-align: left; font-size: 11px; " scope="row">2</th>
          <td style="padding: 5px; border: none !important; text-align: left; font-size: 11px; "><%= item.description%></td>
          <td style="padding: 5px; border: none !important; text-align: left; font-size: 11px; "><%= item.hsn_sac%></td>
          <td style="padding: 5px; border: none !important; text-align: left; font-size: 11px; "><%= item.quantity%></td>
          <td style="padding: 5px; border: none !important; text-align: left; font-size: 11px; ">INR <%= item.rate %></td>
          <td style="padding: 5px; border: none !important; text-align: left; font-size: 11px; ">INR <%= item.amount&.value%></td>
          <td style="padding: 5px; border: none !important; text-align: left; font-size: 11px; ">INR <%= item.discount_amount&.value %></td>
          <td style="padding: 5px; border: none !important; text-align: left; font-size: 11px; ">INR <%= item.tax_amount&.value %></td>
          <td style="padding: 5px; border: none !important; text-align: left; font-size: 11px; ">INR <%= item.net_amount&.value%></td>
        </tr>
    <% end %>
    <tr>
      <th colspan="6"></th>
      <td style="padding: 5px; border: none !important; text-align: right; font-size: 14px; " class="line-items-title" colspan="2">Total </td>
      <td style="padding: 5px; border: none !important; text-align: left; font-size: 14px; " class="line-items-data line-items-total" colspan="1">INR <%= @invoice.line_items_net_total%></td>
    </tr>
    <% if @invoice.discount_amount&.value > 0 %>
    <tr>
      <th colspan="6"></th>
      <td style="padding: 5px; border: none !important; text-align: right; font-size: 14px; " class="line-items-title" colspan="2">Discount </td>
      <td style="padding: 5px; border: none !important; text-align: left; font-size: 14px; " class="line-items-data line-items-discount" colspan="1">INR <%= @invoice.discount_amount&.value%></td>
    </tr>
    <% end %>
    <% if @invoice.tax_amount&.value > 0 %>
    <tr>
      <th colspan="6"></th>
      <td style="padding: 5px; border: none !important; text-align: right; font-size: 14px; " class=" line-items-title" colspan="2">Tax </td>
      <td style="padding: 5px; border: none !important; text-align: left; font-size: 14px; " class="line-items-data line-items-tax" colspan="1">INR <%= @invoice.tax_amount&.value%></td>
    </tr>
    <% end %>
    <!--<tr>-->
    <!--<th class="plain" colspan="6"></th>-->
    <!--<td style="padding: 5px; border: none !important; text-align: left; font-size: 11px; " class="plain line-items-title" colspan="2">TDS :</td>-->
    <!--<td style="padding: 5px; border: none !important; text-align: left; font-size: 11px; " class="plain line-items-data line-items-tds" colspan="2">INR 67</td>-->
    <!--</tr>-->
    <% if @invoice.advance_amount&.value > 0 %>
    <tr>
      <th colspan="6"></th>
      <td style="padding: 5px; border: none !important; text-align: right; font-size: 14px; " class=" line-items-title" colspan="2">Advance Payment </td>
      <td style="padding: 5px; border: none !important; text-align: left; font-size: 14px; " class="line-items-data line-items-advance-payment" colspan="1">INR <%= @invoice.advance_amount&.value%></td>
    </tr>
    <% end %>
    <% if @invoice.freight_amount&.value > 0 %>
    <tr>
      <th colspan="6"></th>
      <td style="padding: 5px; border: none !important; text-align: right; font-size: 14px; " class="line-items-title" colspan="2">Freight </td>
      <td style="padding: 5px; border: none !important; text-align: left; font-size: 14px; " class="line-items-data line-items-freight" colspan="1">INR <%= @invoice.freight_amount&.value %></td>
    </tr>
    <% end %>
    <tr>
      <th colspan="6"></th>
      <td style="padding: 5px; border: none !important; text-align: right; font-size: 14px; " class="line-items-title" colspan="2">Roundoff </td>
      <td style="padding: 5px; border: none !important; text-align: left; font-size: 14px; " class="line-items-data line-items-roundoff" colspan="1">INR <%= @invoice.roundoff_amount%></td>
    </tr>
    <% if @invoice.partially_paid? || @invoice.closed? || @invoice.saved? %>
    <tr>
      <th colspan="6" ></th>
      <td style="padding: 5px; border: none !important; text-align: right; font-size: 14px; " class="line-items-title" colspan="2">Balance Due </td>
      <td style="padding: 5px; border: none !important; text-align: left; font-size: 14px; " class="line-items-data line-items-balance-due" colspan="1">INR <%= @invoice.balance_due&.value %></td>
    </tr>
    <% end %>
    </tbody>
  </table>

</div>

<!-- <div class="legal-statement" id="legalcopy">
  <p class="legal">Designed By <span style="font-weight: bold;">Finly</span>, With  <span style="color: red; font-weight: bold; font-size: 18px;"> &hearts;</span>  In <span style="font-weight: bold;">Bangalore, India.</span>

  </p>
</div> -->



</body>
</html>

