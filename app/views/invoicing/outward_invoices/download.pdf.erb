<!DOCTYPE html>
<html>
<head>

  <title>Invoicing System</title>
</head>
<body>

<div class="first-container">

  <div class="invoice-title container-fluid">
    <span> <b> INVOICE </b> </span>
  </div>

  <div class="float-container">
    <div class=" company-name company-address">
      <b> Finly Spend and Expense Management </b>,
    </div>
    <div class="company-details-container">
      <div class="company-address-line-one company-address">
        3rd Floor, Salarpuria Towers 1, Koramangala,
      </div>
      <div class="company-address-line-two company-address">
        Bengaluru, Karnataka.
      </div>
      <div class="company-pin-code company-address">
        PIN : 590095
      </div>


    </div>

    <div class="company-logo-container">
      <img src="company_logo.png" class="company-logo">
    </div>
  </div>

</div>
<div class="first-container">
  <div class="address-title">
    Invoice Details : <br>
  </div>
  <div class="customer-block">

    <div class="invoice-number">
      <span> <b> Invoice Number : &nbsp; </b> </span> <span><%= @result.invoice.invoice_number%></span>
    </div>
    <!--<div class="invoice-number">-->
      <!--<span> <b> Invoice Details : &nbsp; </b> </span> <span>KA-12368763471-1238</span>-->
    <!--</div>-->
    <div class="invoice-date">
      <span> <b> Invoice Date : &nbsp; </b> </span> <span><%= @result.invoice.date%></span>
    </div>
    <!--<div class="order-number">-->
      <!--<span> <b> Order Number : &nbsp; </b> </span> <span>407-213879821-213</span>-->
    <!--</div>-->
    <div class="order-date">
      <span> <b> Due Date : &nbsp; </b> </span> <span><%= @result.invoice.due_date%></span>
    </div>
    <% if @result.invoice.customer.pan.present? %>
      <div class="pan-no">
        <span> <b> PAN Number : &nbsp; </b> </span> <span><%= @result.invoice.customer.pan%></span>
      </div>
    <% end %>
    <% if @result.invoice.customer.gst.present? %>
      <div class="gst-registered">
        <span> <b> GST Registration Number : &nbsp; </b> </span> <span><%= @result.invoice.customer.gst%></span>
      </div>
    <% end %>
  </div>

</div>

<div class="float-container address-block">

  <div class="customer-details-block three-columns-float">
    <div class="address-title">
      Customer Details : <br>
    </div>
    <div class="customer-block">

      <div class="invoice-care-of-name">
        <span> <b> C/O : &nbsp; </b></span> <span><%= @result.invoice.customer.name %></span>
      </div>
      <!--<div class="invoice-number">-->
        <!--<span> <b> Invoice Number : &nbsp; </b> </span> <span>6589798746</span>-->
      <!--</div>-->
      <div class="invoice-number">
        <span> <b> Mobile : &nbsp; </b> </span> <span><%= @result.invoice.mobile_number%></span>
      </div>
      <div class="invoice-number">
        <span> <b> Invoice Date : &nbsp; </b> </span> <span><%= @result.invoice.date %></span>
      </div>

      <div style="width: 100%; height: auto; overflow: hidden; width: calc(100% - 10px);  margin-right: 10px; margin-top: 10px; border: 1px solid #c4c4c4; border-left: none !important; padding-top: 5px; padding-bottom: 5px;">
        <% if @result.invoice.virtual_account.present? %>
          <div class="invoice-number">
            <span> <b> Invoice Payment Account : &nbsp; </b> </span> <span><%= @result.invoice.virtual_account.account_number %></span>
          </div>
          <div class="invoice-number">
            <span> <b> Invoice Payment IFSC : &nbsp; </b> </span> <span><%= @result.invoice.virtual_account.ifsc %></span>
          </div>
        <% end %>

      </div>

    </div>

  </div>

  <div class="billing-address-block boxes three-columns-float">
    <div class="address-title">
      Billing Address : <br>
    </div>
    <div class="billing-details-block">
      <div class="shipping-customer-name">
        <% @result.invoice.customer.name %>
      </div>
      <% address = @result.invoice.billing_address.split("\n") %>
      <% address.each do |addr| %>
        <div class="address-line billing-address">
          <%= addr %>
        </div>
      <% end %>
      <!--<div class="billing-address-line-two billing-address">-->
        <!---->
      <!--</div>-->
      <!--<div class="billing-pin-code billing-address">-->
        <!---->
      <!--</div>-->
    </div>
  </div>

  <div class="shipping-address-block boxes three-columns-float">
    <div class="address-title">
      Shipping Address : <br>
    </div>
    <div class="shipping-details-block">
      <div class="shipping-customer-name">
        <% @result.invoice.customer.name %>
      </div>
      <% address = @result.invoice.shipping_address.split("\n") %>
      <% address.each do |addr| %>
          <div class="address-line billing-address">
            <%= addr %>
          </div>
      <% end %>
      <!--<div class="shipping-address-line-two shipping-address">-->
        <!--Bengaluru, Karnataka.-->
      <!--</div>-->
      <!--<div class="shipping-pin-code shipping-address">-->
        <!--PIN : 590095-->
      <!--</div>-->
    </div>
  </div>

</div>

<div class="item-details-table" style="overflow-x: auto; margin: 10px; width: calc(100% - 20px); margin-top: 0;">

  <table class="line-items-table" style="width: 100%;border-collapse: collapse;margin: 1% auto;margin-bottom: 1%;">
    <thead>
    <tr>
      <th scope="col" style="width: 20px; background: white; color: black; font-weight: bold;padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; ">#</th>
      <th scope="col" style="background: white; color: black; font-weight: bold;padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; ">Name/Description</th>
      <th scope="col" style="background: white; color: black; font-weight: bold;padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; ">Category</th>
      <th scope="col" style="background: white; color: black; font-weight: bold;padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; ">HSN/SAC</th>
      <th scope="col" style="background: white; color: black; font-weight: bold;padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; ">Quantity</th>
      <th scope="col" style="background: white; color: black; font-weight: bold;padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; ">Rate</th>
      <th scope="col" style="background: white; color: black; font-weight: bold;padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; ">Amount</th>
      <th scope="col" style="background: white; color: black; font-weight: bold;padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; ">Discount</th>
      <th scope="col" style="background: white; color: black; font-weight: bold;padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; "><%= @result.invoice.gst_type_id == 1 ? "IGST" : "CGST + SGST" %></th>
      <th scope="col" style="background: white; color: black; font-weight: bold;padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; " colspan="2">Total</th>
    </tr>
    </thead>
    <tbody>
    <% @result.invoice.invoice_items.each do |item| %>
      <tr>
        <th style="padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; " scope="row">2</th>
        <td style="padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; "><%= item.description%></td>
        <td style="padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; "><%=item.category&.name%></td>
        <td style="padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; "><%= item.hsn_sac%></td>
        <td style="padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; "><%= item.quantity%></td>
        <td style="padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; ">INR <%= item.rate %></td>
        <td style="padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; ">INR <%= item.amount&.value%></td>
        <td style="padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; ">INR <%= item.discount_amount&.value %></td>
        <td style="padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; ">INR <%= item.tax_amount&.value %></td>
        <td style="padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; ">INR <%= item.net_amount&.value%></td>
      </tr>
    <% end %>
    <tr>
      <th class="plain" colspan="6"></th>
      <td style="padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; " class="plain line-items-title" colspan="2">Total :</td>
      <td style="padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; " class="plain line-items-data line-items-total" colspan="2">INR <%= @result.invoice.line_items_net_total%></td>
    </tr>
    <tr>
      <th class="plain" colspan="6"></th>
      <td style="padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; " class="plain line-items-title" colspan="2">Discount :</td>
      <td style="padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; " class="plain line-items-data line-items-discount" colspan="2">INR <%= @result.invoice.discount_amount&.value%></td>
    </tr>
    <tr>
      <th class="plain" colspan="6"></th>
      <td style="padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; " class="plain line-items-title" colspan="2">TAX :</td>
      <td style="padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; " class="plain line-items-data line-items-tax" colspan="2">INR <%= @result.invoice.tax_amount&.value%></td>
    </tr>
    <!--<tr>-->
      <!--<th class="plain" colspan="6"></th>-->
      <!--<td style="padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; " class="plain line-items-title" colspan="2">TDS :</td>-->
      <!--<td style="padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; " class="plain line-items-data line-items-tds" colspan="2">INR 67</td>-->
    <!--</tr>-->
    <tr>
      <th class="plain" colspan="6"></th>
      <td style="padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; " class="plain line-items-title" colspan="2">Advance Payment :</td>
      <td style="padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; " class="plain line-items-data line-items-advance-payment" colspan="2">INR <%= @result.invoice.advance_amount&.value%></td>
    </tr>
    <tr>
      <th class="plain" colspan="6"></th>
      <td style="padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; " class="plain line-items-title" colspan="2">Freight :</td>
      <td style="padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; " class="plain line-items-data line-items-freight" colspan="2">INR <%= @result.invoice.freight_amount&.value %></td>
    </tr>
    <tr>
      <th class="plain" colspan="6"></th>
      <td style="padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; " class="plain line-items-title" colspan="2">Roundoff :</td>
      <td style="padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; " class="plain line-items-data line-items-roundoff" colspan="2">INR <%= @result.invoice.roundoff_amount%></td>
    </tr>
    <tr>
      <th class="plain" colspan="6" ></th>
      <td style="padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; " class="plain line-items-title" colspan="2">Balance Due :</td>
      <td style="padding: 5px; border: 1px solid #ccc; text-align: left; font-size: 11px; " class="plain line-items-data line-items-balance-due" colspan="2">INR <%= @result.invoice.balance_due&.value %></td>
    </tr>
    </tbody>
  </table>

</div>

<div class="legal-statement" id="legalcopy">
  <p class="legal"><strong>Thank you for your business! </strong>
  <!--Payment is expected within 31 days; please process this invoice within that time. There will be a 5% interest charge per month on late invoices. Terms and condition are subject to market risks.-->
  </p>
</div>



</body>
</html>

<style type="text/css">

  #legalcopy
  {
    margin-top: 5%;
    margin-bottom: 1%;
    text-align: center;
    font-size: 12px;

  }

  .line-items-title
  {
    font-weight: bolder;
    border: 1px solid #ccc !important;
    color:#000000c9;
  }

  .line-items-data
  {
    font-weight: bold;
    border: 1px solid #ccc !important;
    color:black;
    text-align: right;
  }

  .plain
  {
    border: none;
    background-color: white;
  }

  .avoidBreak {
    border: 2px solid;
    page-break-inside:avoid;
  }

  .float-container
  {
    width: 100%;
    display: inline-block;
  }

  .three-columns-float
  {
    width: 33.3%;
    float: left;
  }

  .address-block
  {
    margin: 10px;
    width: calc(100% - 20px);
  }

  .address-title
  {
    font-size: 15px;
    font-weight: bold;
    margin-bottom: 10px;
  }

  .company-details-container
  {
    float: left;
    width: calc(100% - 500px);
  }

  .item-totals-block-title
  {
    float: left;
    width: 200px;
    font-weight: bolder;
    color: #443636;
  }

  .item-totals-block-data
  {
    float: left;
    width: calc(100%-200px);
    font-weight: bold;
  }

  .company-logo-container
  {
    float: left;
    width: 500px;
    text-align: right;
    margin-top: -25px;
  }

  .company-logo
  {
    width: 50%;
    height: 50%;

  }

  .first-container
  {
    margin: 10px;
    width: calc(100% - 20px);
  }

  .company-name
  {
    font-size: 18px;
  }

  body
  {
    font-family: 'Roboto',sans-serif;
  }
  .invoice-title
  {
    background-color: black;
    color: white;
    border-radius: 6px;
    box-shadow: 0 0 10px #C4C4C4;
    font-size: 18px;
    letter-spacing: 0px;
    margin-bottom: 2.5%;
    text-align: center;
    padding: 0.1%;
    padding-top: 0.2%;
    padding-bottom: 0.2%;
  }

  .billing-details-block
  {
    font-size: 11px;
  }

  .company-details-container
  {
    font-size: 11px;
  }

  .shipping-details-block
  {
    font-size: 11px;
  }

  .customer-block
  {
    font-size: 11px;
  }

  .address-line
  {
    width:175px;
  }
</style>
