<table style="width: 94%; margin: auto; border: 1px solid #dcdcdc; border-collapse: collapse;">
  <tr style="background-color: #dcdcdc;">
    <td style="padding: 15px; font-family: Helvetica, Arial, sans-serif;">NAME</td>
    <td style="padding: 15px; font-family: Helvetica, Arial, sans-serif;">ACCOUNT NUMBER</td>
    <td style="padding: 15px; font-family: Helvetica, Arial, sans-serif;">IFSC</td>
    <td style="padding: 15px; font-family: Helvetica, Arial, sans-serif;">AMOUNT</td>
    <% if [NotifierType.id_for(:bank_payment_request_credit_confirm)].include?(@data.event_id) %>
      <td style="padding: 15px; font-family: Helvetica, Arial, sans-serif;">COMMENTS</td>
    <% end %>
  </tr>
    <% @data.bank_payment_request.payment_order.payments.each do |payment| %>
        <tr>
          <td style="padding: 15px; border: 1px solid #dcdcdc; font-family: Helvetica, Arial, sans-serif;"><%=payment.receiving_account.name%></td>
          <td style="padding: 15px; border: 1px solid #dcdcdc; font-family: Helvetica, Arial, sans-serif;"><%=payment.receiving_account.account_number %></td>
          <td style="padding: 15px; border: 1px solid #dcdcdc; font-family: Helvetica, Arial, sans-serif;"><%=payment.receiving_account.ifsc%></td>
          <td style="padding: 15px; border: 1px solid #dcdcdc; font-family: Helvetica, Arial, sans-serif;">&#8377;<%=payment.amount_value%></td>
        </tr>
    <% end %>
</table><br>
