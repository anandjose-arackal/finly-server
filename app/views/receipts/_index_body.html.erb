<div id="receiptsParent">
  <form data-remote data-turboboost enctype="multipart/form-data" action="<%= receipts_path %>" hidden="hidden" method="post">
    <input name="authenticity_token" value="<%= form_authenticity_token %>">
    <input class="form-control" id="receiptSelectFile" type="file" name="receipt[image]" accept=".png,.jpg,.pdf,.jpeg" onchange="submitFile()"/>
    <input id="receiptSubmitFile" type="submit" name="commit" value="Submit" class="btn btn-primary"/>
  </form>

  <% if @receipts.blank? %>
      <div id="uploadReceiptsButton" onclick="selectFile()" style="cursor: pointer">
        <div style="background-color: white; margin: 0 auto;border-style: dashed; border-color:#a0a0a0; border-width: 1px ; text-align: center;color: #a0a0a0">

          <button class="fa fa-arrow-circle-up" style="background-color: transparent; border: none;outline: none;font-size: 50px; margin-top: 45px; opacity: 0.5;cursor: pointer" onchange="readFile(this)"></button>
          <p style="margin-bottom: 45px"> Upload a Receipt </p>
        </div>
      </div>
  <% else %>
      <div style="text-align: left">
        <button class="abaButton" style="margin-left: 15px;" onclick="selectFile()">Add Receipt</button>
      </div>
  <% end %>
  </body>
  <div id="receiptRows">

    <% @receipts.each do |receipt| %>

        <form data-remote data-turboboost data-confirm="Are you sure?" id="deleteReceipt<%= receipt.id %>" method="post" action="<%= receipt_path(receipt) %>"></form>
        <form data-remote data-turboboost id="saveReceiptNote<%= receipt.id %>" method="post" onsubmit="hideLayout('saveNoteParent<%= receipt.id %>')" action="<%= receipt_add_note_path(receipt) %>"></form>
        <input name="authenticity_token" value="<%= form_authenticity_token %>" type="hidden" form="deleteReceipt<%= receipt.id %>">
        <input name="_method" type="hidden" value="delete" form="deleteReceipt<%= receipt.id %>"/>
        <input name="authenticity_token" value="<%= receipt.id %>" type="hidden" form="saveReceiptNote<%= %>">
        <input name="_method" type="hidden" value="patch" form="saveReceiptNote<%= receipt.id %>"/>

        <div class="col-md-4" style="width:350px;margin-top:30px;">
          <div style="border: 1px solid #d8d8d8;background-color:white;">
            <a target="_blank" style="height: 300px; width: 100%;display: flex;align-items: center;justify-content: center;" href="<%= "#{request.protocol}#{request.host_with_port}#{receipt.image.url}" %>">
              <img src="<%= %>" style="background-color: white;max-height:100%;max-width:96%;">
            </a>

            <div style="padding: 20px; background-color: white;border-top: 1px solid #d8d8d8">
              <p style="font-weight: 600;">Uploaded Receipt</p>

              <p style="color: #a0a0a0; line-height: 30%; font-size: 12px"><%= receipt.created_at.strftime("%d %b %Y") %></p>
              <input id="expenseNoteText<%= receipt.id %>" type="text" style="resize: none;margin-top: 10px; width: 100%;padding: 5px;" placeholder="Note" onclick="showLayout('saveNoteParent<%= receipt.id %>')" name="receipt[note]" form="saveReceiptNote<%= receipt.id %>" value="<%= receipt.note %>">

              <div style="margin-top: 10px" id="saveNoteParent<%= receipt.id %>">
                <button class="abaButton" style="width: 35%" form="saveReceiptNote<%= receipt.id %>">SAVE</button>
                <button class="abaButton" onclick="hideLayout('saveNoteParent<%= receipt.id %>')" style="width: 35%;background-color: #f5f5f5; border: 1px solid #d8d8d8; color: #555; margin-left:10px">CANCEL</button>
              </div>
              <hr>
              <button class="grey-button" style="margin-left: 0;width: 55%; background-color: #f5f5f5; border: 1px solid #d8d8d8; color: #555" onclick="createExpense('<%= receipt.id %>','<%= receipt.image%>','<%= receipt.note%>')">EXPENSE</button>
              <button form="deleteReceipt<%= receipt.id %>" class="grey-button" style="background-color: #f5f5f5;border: 1px solid #d8d8d8;width: 25%;float: right;
                  border-radius: 1px;">
                <span class="fa fa-close" style="font-size: 16px;color: #555"></span>
              </button>
            </div>
          </div>
        </div>

    <% end %>
  </div>

  <div class="modal fade" id="newExpense" role="dialog" style="margin-top: 5%;">
    <div class="modal-dialog modal-md" style="background-color: white">

      <form data-remote data-turboboost id="expenseForm" method="post" style="background: white;" action="<%= expense_from_receipt_path %>">

        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <input type="text" hidden="hidden" name="expense[receipt_id]" id="receiptId"/>


        <div style="width: 100%;margin: 0 auto;display: block; max-width: 940px;">
          <div style="height: 70px; background-color: white;width: 640px ">
            <p style="color: #a0a0a0; font-weight: 500; display: inline-block;vertical-align: middle; line-height: 70px;margin-left: 24px ">
              EDIT EXPENSE </p>
            <button type="submit" id="sendBtn" class="green-button" style="margin-right: 5px">Send</button>
            <button type="reset" form="" class="grey-button" id="cancelBtn" onclick="cancelExpense()">Cancel</button>
          </div>
          <div id="splitHeader" style="float: left;width: 640px;
              margin: 0px;
              display: inline-block;
              background-color: #465c8b;" class="row">
            <div class="col-md-8">
              <div id="uppertone" style="border-bottom: 1px solid #465c8b;
                  margin-top: 10px ;
                  padding: 0px ;
                  margin-bottom: 10px;">
                <p style="float: left;margin-left: 24px;font-size: 36px; color: white">&#8377</p>
                <input id="currency" type="text" name="expense[amount]" placeholder="0.00" style="border:none; margin-left: 1px; font-size: 34px;width: 70%  ;color: white ; background-color: #465c8b;outline: none" onkeypress='validate(event)'>
                <hr id="upperhr">
                <div>
                  <p style="color: #eeeeee; margin-left: 24px;font-size: 14px; font-weight: 700;float: left;opacity: 0.7">MERCHANT:</p>
                  <input type="text" name="expense[merchant]" style="border:none; margin-left: 23px; width: 60%; font-size: 14px ;color: black ; background-color: white;outline: none">
                </div>
              </div>
            </div>
            <div class="col-md-4" style="padding:5px 5px 5px 0">
              <div id="receiptUpload" style="float: right ;height: 135px;width: 130px;margin: 0;display: flex;align-items: center;justify-content: center;">
                <img id="receiptImage" style="max-width: 100%; max-height: 100%">
              </div>
            </div>

          </div>


          <div id="split">


            <div class="splitSections">
              <p class="splitSideHeader">CATEGORY:</p>
              <select name="expense[category_id]" id="newExpenseCategory">
                <% current_company.active_categories.each do |cat| %>
                    <option value="<%= cat.id %>"><%= cat.name %></option>
                <% end %>
              </select>

            </div>

            <div class="splitSections">
              <p class="splitSideHeader">NOTE:</p>
              <textarea id="expenseNote" name="expense[note]" placeholder="ADD NOTE" style="border: none;font-size: 14px ;color: #2E2F30 ; background-color: white;border-radius: 1px; line-height: normal !important; width: 60%; margin-left: 80px "></textarea>

            </div>

            <div class="splitSections">
              <p class="splitSideHeader">DATE:</p>
              <input id="date" type="date" name="expense[date]" width="40%" style="font-size: 14px;color: #2E2F30;background-color: white;border-radius: 1px;line-height: normal !important;width: 60%;margin-left: 80px;border: none;">

            </div>

          </div>

        </div>

      </form>
    </div>
  </div>


  <div class="modal fade" id="deleteExpense" role="dialog" style="margin-top: 5%; ">
    <div class="modal-dialog modal-md">
      <div class="modal-content" style="border-radius: 1px">
        <div class="modal-header" style="background-color: #e9e9e9 ">
          <button type="button" class="close" style="opacity: 0.7" data-dismiss="modal">&times;</button>
          <h4 class="modal-title" style="text-align: center; font-weight: 400;border-bottom: #d8d8d8">Delete this
            Expense</h4>
        </div>
        <form data-remote data-turboboost id="deleteExpenseButton" method="post">
          <input name="_method" type="hidden" value="delete"/>
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
          <div class="modal-body" style=" padding-left: 40px;padding-right: 40px">
            <p>Are you sure you want to delete this expense?</p>
            <button class="sendButton" type="submit">YES</button>
            <button class="sendButton" onclick="closeDeleteModal()" style="background: #cccccc;color: #2E2F30">NEVERMIND</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>