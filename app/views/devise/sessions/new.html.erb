<% provide(:title, "Finly: Log In") %>

<!--Navigation bar-->
<nav class="navbar navbar-default navbar-fixed-top" style="background-color: #061735; border: none;">
  <div class="container">
    <div class="navbar-header">
    <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#myNavbar">
      <span class="icon-bar"></span>
      <span class="icon-bar"></span>
      <span class="icon-bar"></span>
    </button>
    <a class="navbar-brand" href="/">
      <img src="/common/images/logos/logo_xs.png" class="img-responsive" style="height: 28px;display: inline;margin-right: 10px;">
      <img src="/common/images/logos/itzcash_w.png" class="img-responsive" style="height: 31px;display: inline;">
    </a>
    </div>
    <div class="collapse navbar-collapse" id="myNavbar">
    <ul class="nav navbar-nav navbar-right">
      <li><a href="/">Home</a></li>
      <li><a href="/about">About</a></li>
      <!-- <li><a href="#courses">Resources</a></li>
      <li><a href="#pricing">FAQ</a></li>
      <li><a href="#" data-target="#login" data-toggle="modal">Blog</a></li> -->
      <li class="active"><a href="#">Login to Finly</a></li>
    </ul>
    </div>
  </div>
</nav>
<!--/ Navigation bar-->

<div class="brand-logo" style="width: 300px; margin-left: auto; margin-right: auto; margin-bottom: 20px; margin-top: 50px;">
  <img src="<%= image_url('/common/images/logos/logo_lg.png') %>" style="width: 100%;">
</div>

<div class="container no-padding" style="padding-bottom: 20px;">
  
  <div class="row no-margin">
    <div class="login-container mh-340">
      <span class="login-box-top"></span>

      <div class="step-lookup steps-login" data-height-class="mh-340">
        <div class="user-image">
          <img src="<%= image_url('/common/images/profile_pic.png') %>" class="img img-circle">
        </div>
        <form action="<%= lookup_path %>" id="form-lookup">
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

          <div class="form-group">
            <label class="control-label">Email / 10 Digit Mobile Number</label>
            <input type="text" name="email_mobile" placeholder="Email ID or Mobile Number" class="form-control">
          </div>

          <div class="form-group">
            <input id="btn-lookup-username" type="submit" value="Proceed" class="btn-block btn btn-success btn-sm" />

            <p class="text-right" style="margin-top: 5px;"><a class="a-forgot-password" href="#">Forgot Password?</a></p>
          </div>
        </form>  
      </div>

      <div class="step-password steps-login" data-height-class="mh-390">
        <div class="user-image">
          <i class="fa fa-arrow-left" data-back-to="step-lookup"></i>
          <img src="<%= image_url('/common/images/profile_pic.png') %>" class="img img-circle">
        </div>
        <form action="<%= user_session_path %>" method="post" id="form-login">
          <div class="template-data">

          </div>
          
          <div class="form-group">
            <label class="control-label">Password</label>
            <p class="text-right" style="display: inline-block; float: right;"><a href="#" class="a-forgot-password">Forgot Password?</a></p>
            <input type="password" name="user[password]" placeholder="" class="form-control">
          </div>

          <div class="form-group">
            <input id="btn-lookup-username" type="submit" value="Login" class="btn-block btn btn-success btn-sm" />
          </div>
        </form>  
      </div>

      <div class="step-reset-password-options steps-login" data-height-class="mh-455">
        <div class="user-image">
          <i class="fa fa-arrow-left" data-back-to="step-lookup"></i>
          <img src="<%= image_url('/common/images/profile_pic.png') %>" class="img img-circle">
        </div>

        <form action="<%= lookup_path %>" id="form-init-reset-password">

          <div class="template-data">
            <label>Please Select Email or Mobile to Recover Your Password</label>
          </div>


          <ul class="nav nav-tabs nav-justified">
            <li role="presentation" class="active"><a href="#reset-by-mobile" aria-controls="reset-by-mobile" role="tab" data-toggle="tab">Mobile</a></li>
            <li role="presentation"><a href="#reset-by-email" aria-controls="reset-by-email" role="tab" data-toggle="tab">Email</a></li>
          </ul>

          <div class="tab-content">
            <div class="tab-pane active" id="reset-by-mobile" data-reset-by="mobile">
              <div class="form-group">
                <label class="control-label">Mobile Number</label>
                <input class="form-control" type="number" value="" name="user[mobile_number]" />
              </div>

              <div class="form-group">
                <input class="btn btn-sm btn-block btn-success" type="submit" value="Proceed" />
              </div>
            </div>

            <div class="tab-pane" id="reset-by-email" data-reset-by="email">
              <div class="form-group">
                <label class="control-label">Email</label>
                <input class="form-control" type="text" value="" name="user[email]" />
              </div>
              <div class="form-group">
                <input class="btn btn-sm btn-block btn-success btn-reset-password-email" type="submit" value="Send Password Reset Link" />
              </div>
            </div>
          </div>
        </form>  
      </div> 

      <div class="step-verify-registration steps-login" data-height-class="mh-438">
        <div class="user-image">
          <i class="fa fa-arrow-left" data-back-to="step-lookup"></i>
          <img src="<%= image_url('/common/images/profile_pic.png') %>" class="img img-circle">
        </div>
        <form action="<%= verify_user_otp_path %>" method="post" id="form-verify-user-otp">
          <div class="template-data">
            <h5>You need to verify your mobile number before you proceed</h5>
          </div>
          
          <div class="form-group">
            <div class="row no-margin">
              
              <div class="col-xs-12 no-padding"><label class="control-label">Your Mobile Number:</label></div>

              <div class="col-xs-7 no-padding" style="padding-right: 10px">
                <input type="number" readonly="readonly" name="mobile_number" value="" class="form-control">
                <!-- <input type="hidden" name="mobile_number" value="" /> -->
              </div>
              <div class="col-xs-5 no-padding"><button class="btn btn-sm btn-warning btn-block btn-send-otp" data-url="<%= send_verification_otp_path %>">Send OTP</button></div>
            </div>
          </div>

          <div class="form-group">
            <div class="row no-margin">
              <div class="col-xs-12 no-padding"><label class="control-label">OTP:</label></div>

              <div class="col-xs-7 no-padding" style="padding-right: 10px">
                <input type="number" name="otp" value="" class="input-otp form-control">
              </div>
              <div class="col-xs-5 no-padding"><button disabled="disabled" class="btn btn-sm btn-warning btn-block btn-resend-otp hidden" data-url="<%= send_verification_otp_path %>">Resend</button></div>  
            </div>
          </div>

          <div class="form-group">
            <input type="submit" disabled="disabled" value="Verify Mobile" class="btn-block btn btn-success btn-sm btn-verify-otp" />
          </div>
        </form>  
      </div>

      <div class="step-reset-password steps-login" data-height-class="mh-405">
        <div class="user-image">
          <img src="<%= image_url('/common/images/profile_pic.png') %>" class="img img-circle">
        </div>
        <form action="<%= set_password_path %>" method="post" id="form-reset-password">
          <div class="template-data">
            <div class="form-group">
              <input type="hidden" name="user[mobile_number]" />
            </div>


          </div>
          
          <div class="form-group">
            <label class="control-label">Set Your New Password:</label>
            <input type="password" name="user[password]" class="form-control" />
          </div>

          <div class="form-group">
            <label class="control-label">Re-enter New Password:</label>
            <input type="password" name="user[password_confirmation]" class="form-control"/>
          </div>

          <div class="form-group">
            <input type="submit" value="Set New Password & Login" class="btn btn-block btn-success btn-small" />
          </div>
        </form>
      </div>
    </div>
    <div class="text-center" style="margin-top: 40px;">
      <span style="color: white;margin-right: 7px;font-size: 16px;">In partnership with </span><img style="height: 60px;margin-top: -10px;" src="/common/images/logos/itzcash_w.png">
    </div>
  </div>

  
</div>
<%= render 'shared/login_footer' %>

<!--Modal Demo-->
<div class="modal fade" id="modal-request-demo" role="dialog">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">&times;</button>
        <h4 class="modal-title text-center form-title">Request For a Demo</h4>
      </div>
      <div class="modal-body">
        <div class="row">
          <div class="col-sm-12">
            <form class="form-horizontal form-request-demo">
              <input name="authenticity_token" value="<%= form_authenticity_token %>" hidden="hidden">
              <fieldset>

                <!-- Text input-->
                <div class="form-group">
                  <label class="col-md-4 control-label" for="name">Name</label>  
                  <div class="col-md-4">
                  <input id="name" name="preview[name]" placeholder="Your Name" class="form-control input-md" type="text">
                    
                  </div>
                </div>

                <!-- Text input-->
                <div class="form-group">
                  <label class="col-md-4 control-label" for="email">Email</label>  
                  <div class="col-md-4">
                  <input id="email" name="preview[email]" placeholder="Your Work Email" class="form-control input-md" type="text">
                    
                  </div>
                </div>

                <!-- Text input-->
                <div class="form-group">
                  <label class="col-md-4 control-label" for="phonenumber">Mobile Number</label>  
                  <div class="col-md-4">
                  <input id="phonenumber" name="preview[phone_number]" placeholder="Your Contact Number" class="form-control input-md" type="text">
                    
                  </div>
                </div>

                <!-- Text input-->
                <div class="form-group">
                  <label class="col-md-4 control-label" for="company_name">Company Name</label>  
                  <div class="col-md-4">
                  <input id="company_name" name="preview[company]" placeholder="Your Company" class="form-control input-md" type="text">
                    
                  </div>
                </div>

                <!-- Button -->
                <div class="form-group">
                  <label class="col-md-4 control-label" for="submit"></label>
                  <div class="col-md-4">
                    <button id="submit" name="submit" class="btn btn-primary">Request For Demo</button>
                  </div>
                </div>

              </fieldset>
            </form>
 
          </div>
        </div>
      </div>
    </div> 
  </div>
</div>
<!--/ Modal box-->


