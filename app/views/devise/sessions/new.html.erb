<% provide(:title, "Finly: Log In") %>
<img src="<%= image_url('/common/images/logos/logo_md.png') %>">

<div class="container-fluid">
  
  <div class="row no-margin">
    <div class="login-container">
      <div class="step-lookup">
        <div class="user-image">
          <img src="<%= image_url('/common/images/profile_pic.png') %>" class="img img-circle">
        </div>
        <form action="<%= user_lookup_path %>" method="post" id="form-lookup">
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

          <div class="form-group">
            <input type="text" name="user[email_mobile]" placeholder="Email ID or Mobile Number" class="form-control">
          </div>

          <div class="form-group">
            <input id="btn-lookup-username" type="submit" value="Proceed" class="btn-block btn btn-success btn-sm" />
          </div>
        </form>  
      </div>
    </div>
  </div>
</div>


<style type="text/css">

</style>

<script type="text/javascript">
  
</script>