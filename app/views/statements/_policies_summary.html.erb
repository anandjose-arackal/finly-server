<table class="table table-striped" style="border: 1px solid #ddd;">
  <thead>
    <tr>
      <td>#</td>
      <td>Policy</td>
      <td>Amount</td>
    </tr>
  </thead>

  <tbody>
    <% @result.items.each_with_index do |policy, index| %>
    <tr>
      <td><%= index + 1 %></td>
      <% policy.each do |k, v| %>
      <td><%= k.name ? k.name : "None" %></td>
      <td><%= v %></td>
      <% end %>
    </tr>
    <% end %>
  </tbody>
</table>