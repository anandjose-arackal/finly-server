<div class="row no-margin" id="company-statements">
  <div class="section-card">
    <div class="row no-margin section-header">
      <div class="col-sm-12 company-statements-navbar">
        <ul class="navbar-nav nav">
          <li style="margin-top: 15px; margin-right: 10px;">
            <span>From</span>
          </li>
          <li style="margin-top: 10px;">
            <input type="text" class="form-control datepicker filter-date-statements filter-date-from" style="width: 100%;" value="<%= (Date.today - 30.days).strftime('%d-%m-%Y') %>" readonly/>
            <span class="fa fa-calendar input-icon "></span> 
          </li>
          <li class="divider-vertical"></li>

          <li style="margin-top: 15px; margin-right: 10px;">
            <span>To</span>
          </li>
          <li style="margin-top: 10px;">
            <input type="text" class="form-control datepicker filter-date-statements filter-date-to" style="width: 100%;" value="<%= Date.today.strftime('%d-%m-%Y') %>" readonly/>
            <span class="fa fa-calendar input-icon "></span> 
          </li>
        </ul>
        <ul class="nav navbar-right navbar-nav company-statements-types">
          <li class="active"><a href="#" data-statements-type="company_summary">Company Statements Summary</a></li>    
          <li><a href="#" data-statements-type="policies_summary">Policies Summary</a></li>    
        </ul>   
      </div>
    </div>

    <div class="row no-margin" style="margin-top: 15px;">
      <div class="col-sm-12 company-summary-container">
        <%= render partial: 'company_summary' %>
      </div>
    </div>
  </div> 
</div>