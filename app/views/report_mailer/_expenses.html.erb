<!--Starting with a closing div so the body div is closed and this expense comes outside the box(below)-->
</div>

<div style="background-color:white;border:1px solid #ddd;margin:0 auto 20px auto;text-align:left;width:480px">
  <% @expenses.each do |expense| %>
      <%= render 'circle_style' %>
      <div style="border-bottom:none;padding:20px 20px;border-bottom:1px solid #ddd;">

        <div style="border-radius:42px;float:left;min-height:42px;margin:0;max-height:42px;max-width:42px;overflow:hidden;width:42px">
          <div id="roundcircle_1" class="col-md-1" style=""><span class="roundCircle"><%= @user.name.first[0] %></span>
          </div>
        </div>
        <div style="margin:0 0 0 56px">
          <div style="font-size:12px;font-weight:bold"><%= @user.name %></div>
          <div style="color:#000000;font-size:15px;font-weight:bold">
            <a href="" style="border:none;color:#000000;font-size:15px;font-weight:bold;text-decoration:none" target="_blank">&#8377;<%= expense.amount %>
              <span style="color:#333;font-weight:normal">- </span><%= expense.merchant %></a>
          </div>
          <div style="color:#aaa;font-size:12px;padding-top:3px">
            <a href="" style="border:none;color:#aaa;font-size:12px;padding-top:3px;text-decoration:none" target="_blank"><%= expense.date %></a>
            <a href="" style="border:none;color:#aaa;font-size:12px;padding-top:3px;text-decoration:none" target="_blank"><%= expense.category.name %></a>
          </div>
        </div>
      </div>
  <% end %>

</div>