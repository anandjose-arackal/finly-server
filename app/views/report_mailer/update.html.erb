<% content_for :body do %>
    <p style="line-height:160%;margin:0 0 20px 0">
      <%= @body_title %>
    </p>
    <p style="line-height:160%;margin:0 0 20px 0">
      <%= @message %>
    </p>

    <div class="primary block center" style="background-color: white; text-align: center;">
      <p style="line-height:160%;margin:0 0 20px 0">

        <a href="<%= external_url_view_report_url(id: @report.id) %>" style="background-color:#594DA8;border:none;color:white;display:inline-block;font-size:14px;font-weight:700;letter-spacing:1px;padding:13px 25px;text-decoration:none;text-transform:uppercase" target="_blank">View
          Report</a>

      </p>
    </div>
<% end %>

<%= render 'application_mailer/template' %>