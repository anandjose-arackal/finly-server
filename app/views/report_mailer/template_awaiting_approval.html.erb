<% content_for :body do %>
  <head>
    <title>@data.action_name</title>
  </head>
  <body style="background-color: #f3f3f3; height: auto;">
  <div style="height: 80px; width: 100%; margin: auto; background-color: #2980b9; color: white; display: table;">
    <p style="font-size: 22px; display: table-cell; vertical-align: middle; padding-left: 3%;"><%=@data.action_name%></p>
  </div>
  <div style="width: 100%; height: auto; margin: auto; background-color: white;">

    <% if @data.report_awaiting_approvals.present? %>
      <div style="text-align: left;">Reports awaiting approvals</div>
      <table style="width: 100%;">
        <thead>
        <tr>
          <% @data.report_awaiting_approval_columns.each do |column_name| %>
            <th><%= column_name %></th>
          <% end %>
        </tr>
        </thead>
        <tbody>
        <% @data.report_awaiting_approval_column_values.each do |column_values| %>
          <tr>
            <% column_values.each do |value| %>
              <td><%= value %></td>
            <% end %>
          </tr>
        <% end %>
        </tbody>
      </table>
    <% end %>
    <br>

  </div>
  </body>
<% end %>

<%= render 'application_mailer/template' %>