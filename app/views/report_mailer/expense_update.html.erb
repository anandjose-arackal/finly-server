<% content_for :body do %>
    <p style="line-height: 160%; margin: 0 0 20px 0;"><%= @body_title %></p>
    <p style="line-height: 160%; margin: 0 0 20px 0;"><%= @message %></p>

    <p style="line-height: 160%; margin: 0 0 20px 0;">
      <a href="<%= external_url_view_report_url(id: @report.id) %>" style="border: none; text-decoration: none;">Comment
        on report</a>
    </p>
    <% if @user.id == @expense.user_id %>
        <div class="primary block center" style="background-color: white; text-align: center;">
          <p style="line-height:160%;margin:0 0 20px 0">
            <a href="<%= external_url_view_report_url(id: @report.id) %>"
               style="background-color:#0187d0;border:none;color:white;display:inline-block;font-size:14px;font-weight:700;
                   letter-spacing:1px;padding:13px 25px;text-decoration:none;text-transform:uppercase" target="_blank">
              Review Expense</a>
          </p>
        </div>
    <% end %>
    <%= render 'expense' %>

<% end %>

<%= render 'application_mailer/template' %>