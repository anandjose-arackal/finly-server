<% content_for :body do %>
    <p style="line-height:160%;margin:0 0 20px 0">
      <%= raw(@data.body) %>
    </p>

    <div class="primary block center" style="background-color: white; text-align: center;">
      <p style="line-height:160%;margin:0 0 20px 0">
        <a href="<%= external_url_report_path(id: @data.report.id) %>" style="background-color:#0187d0;border:none;color:white;display:inline-block;font-size:14px;font-weight:700;letter-spacing:1px;padding:13px 25px;text-decoration:none;text-transform:uppercase" target="_blank"><%= @data.button_name %></a>
      </p>
    </div>
<% end %>

<%= render 'application_mailer/template' %>