<% content_for :body do %>
    <head>
      <title><%=@data.action_name%></title>
    </head>
    <body style="background-color: #f3f3f3; height: auto;">
      <div style="height: 80px; width: 100%; margin: auto; background-color: #2980b9; color: white; display: table;">
        <p style="font-size: 22px; display: table-cell; vertical-align: middle; padding-left: 3%;"><%=@data.action_name%></p>
      </div>
      <div style="width: 100%; height: auto; margin: auto; background-color: white;">
        <!--<p style="font-size: 20px; padding-top: 3%; margin-top: 0px; margin-left: 3%;"><span style="color: #2980b9;">Abhinash1354@gmail.com</span> has shared 'New Expense Report' with you.</p>-->
        <p style="font-size: 17px; margin-left: 3%;text-align: left"><%=@data.body_val.html_safe%></p>
        <br>

        <% if @data.event_id == NotifierType.id_for(:report_comment) %>
            <div style="height: 50px; width: 96.5%; margin: auto; display: table; border-left: 2px solid #dcdcdc;">
              <p style="display: table-cell; vertical-align: middle; padding-left: 3%;text-align: left"><%=@data.comment_body%></p>
            </div><br>
        <% end %>

        <div style="text-align: center;">
          <button style="height: 33px; width: 100px; background-color: #3adb76; color: white; border: none; font-size: 16px;" href="<%=external_url_report_url(id: @data.report.id)%>">View Report</button>
        </div>
        <!-- <h3>Report Total:<span>&#8377;</span></h3> -->
        <% unless @data.event_id == NotifierType.id_for(:report_comment) %>
        <div style="text-align: right; padding-right: 3%;">
          <label style="font-size: 20px; font-weight: bold;">Report Total&nbsp;:&nbsp;&#8377;<%= @data.report.total_amount%></label>
        </div>
        <% end %>
        <br>

        <% if @data.event_id == NotifierType.id_for(:report_comment)%>
        <!-- do nothing -->
        <% elsif @data.event_id == NotifierType.id_for(:report_expense_reject) %>
        <%= render 'rejected_expense' %>
        <% else %>
        <%= render 'expenses' %>
        <% end %>

        <p style="font-size: 17px; margin-left: 3%;">A PDF copy of the report has been attached.</p>
      </div>
    </body>
<% end %>

<%= render 'application_mailer/template' %>