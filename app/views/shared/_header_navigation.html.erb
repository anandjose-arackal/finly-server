<% if logged_in? %>
    <% if is_admin_view %>
        <li class="<%= 'active' if current_page?(reports_path(view: 'admin')) %>">
          <a href="<%= root_path + "#reports/params={\"view\":\"admin\"}" %>" style="text-decoration: none; font-size: 12px;font-weight: 500;color: rgba(255,255,255,0.66)  ">Company
            Reports</a>
        </li>
        <li class="<%= 'active' if current_page?(users_path(view: 'admin')) %>">
          <a href="<%= root_path + "#employees/params={\"view\":\"admin\"}" %>" style="text-decoration: none; font-size: 12px;font-weight: 500;color: rgba(255,255,255,0.66)  ">Company
            Employees</a>
        </li>
        <li class="<%= 'active' if current_page?(settlements_path(view: 'admin')) %>">
          <a href="<%= root_path + "#settlements/params={\"view\":\"admin\"}" %>" style="text-decoration: none; font-size: 12px;font-weight: 500;color: rgba(255,255,255,0.66)  ">Company
            Settlements</a>
        </li>
    <% elsif is_finance_view %>
        <li class="<%= 'active' if current_page?(reports_path(view: 'finance')) %>">
          <a href="<%= root_path + "#reports/params={\"view\":\"finance_manager\"}" %>" style="text-decoration: none; font-size: 12px;font-weight: 500;color: rgba(255,255,255,0.66)  ">Reports</a>
        </li>
        <li class="<%= 'active' if current_page?(users_path(view: 'finance')) %>">
          <a href="<%= root_path + "#employees/params={\"view\":\"finance_manager\"}" %>" style="text-decoration: none; font-size: 12px;font-weight: 500;color: rgba(255,255,255,0.66)  ">Employees</a>
        </li>
        <li class="<%= 'active' if current_page?(settlements_path(view: 'finance')) %>">
          <a href="<%= root_path + "#settlements/params={\"view\":\"finance_manager\"}" %>" style="text-decoration: none; font-size: 12px;font-weight: 500;color: rgba(255,255,255,0.66)  ">Settlements</a>
        </li>
    <% elsif is_manager_view %>
        <li class="<%= 'active' if current_page?(reports_path(view: 'manager')) %>">
          <a href="<%= root_path + "#reports/params={\"view\":\"manager\"}" %>" style="text-decoration: none; font-size: 12px;font-weight: 500;color: rgba(255,255,255,0.66)  ">Reports</a>
        </li>
        <li class="<%= 'active' if current_page?(users_path(view: 'manager')) %>">
          <a href="<%= root_path + "#employees/params={\"view\":\"manager\"}" %>" style="text-decoration: none; font-size: 12px;font-weight: 500;color: rgba(255,255,255,0.66)  ">Employees</a>
        </li>
    <% elsif is_personal_view %>
        <li class="<%= 'active' if current_page?(expenses_path) %>">
          <a href="<%= root_path + "#expenses" %>" style="text-decoration: none; font-size: 12px;font-weight: 500;color: rgba(255,255,255,0.66)  ">Expenses</a>
        </li>
        <li class="<%= 'active' if current_page?(reports_path) %>">
          <a href="<%= root_path + "#reports" %>" style="text-decoration: none; font-size: 12px;font-weight: 500;color: rgba(255,255,255,0.66)  ">Reports</a>
        </li>
        <li class="<%= 'active' if current_page?(receipts_path) %>">
          <a href="<%= root_path + "#receipts" %>" style="text-decoration: none; font-size: 12px;font-weight: 500;color: rgba(255,255,255,0.66)  ">Receipts</a>
        </li>
         <li class="<%= 'active' if current_page?(settlements_path(id: current_user.id)) %>">
          <a href="<%= root_path + "#settlements/#{current_user.id}" %>" style="text-decoration: none; font-size: 12px;font-weight: 500;color: rgba(255,255,255,0.66)  ">Settlements</a>
        </li>
    <% end %>
<% else %>
      <li class="<%= 'active' if current_page?(root_path) %>">
        <a href="<%= root_path %>" style="">Home</a>
      </li>
      <li class="<%= 'active' if current_page?(about_path) %>">
        <a href="<%= about_path %>" style="">About</a>
      </li>
      <li class="<%= 'active' if current_page?(new_user_session_path) %>">
        <a href="<%= new_user_session_path %>" style="">Log In</a>
      </li>
<% end %>