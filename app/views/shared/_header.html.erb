<script>

  $('html').click(function (event) {
    var $trigger = $(".topButton");
    if ($trigger !== event.target && !$trigger.has(event.target).length) {
      $("#viewToggleDropdown").hide();
    }
  });

  function showDropDown() {
    $("#viewToggleDropdown").toggle();
  }


  function scrollToFeatures() {
    $('html,body').animate({
          scrollTop: ($("#featuresDiv").offset().top - 60)
        },
        'slow');
  }

</script>