<% messages =  snap_flash_without %>
<%messages.each do |message| %>
<% if message[:text].is_a?(Array)%>
<% Array(message[:text]).each do |m| %>
noty({text: '<%= m %>', type: '<%= message[:type] %>'});
<%end%>
<%else%>
noty({text: '<%= message[:text] %>', type: '<%= message[:type] %>'});
<%end%>
<%end%>