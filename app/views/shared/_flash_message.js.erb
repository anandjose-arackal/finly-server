<% messages =  snap_flash_without %>
<%messages.each do |message| %>
<% if message[:message].is_a?(Array)%>
<% Array(message[:message]).each do |m| %>
ohSnap('<%= m %>', {color: '<%= message[:color] %>', duration: '7000'});
<%end%>
<%else%>
ohSnap('<%= message[:message] %>', {color: '<%= message[:color] %>', duration: '7000'});
<%end%>
<%end%>
