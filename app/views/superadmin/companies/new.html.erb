
<div class="row">
  <div class="col-md-6 col-md-offset-3" style="min-height: 20px">

    <form accept-charset="UTF-8" id="newCompanyForm" action="<%= superadmin_companies_path %>" method="post">
      <input name="utf8" type="hidden" value="&#x2713;"/>
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

      <h3>Company Details</h3>

      <p>Company Name: </p>
      <input type="text" name="company[name]" placeholder="Name" title="Company name">

      <input type="text" name="company[d_code]" placeholder="D Code" title="Company D-Code">

      <hr class="listDivider">

      <h3>Admin Details</h3>

        <div style="width: 600px;padding: 20px 40px 40px 80px; background-color: white; margin:30px auto;border: 1px solid #d8d8d8">

          <label style="font-weight: 500">Email: </label>
          <div>
            <input type="text" class="form-control" name="user[email]" >
          </div>

          <label style="font-weight: 500">Password: </label>
          <div>
            <input type="password" class="form-control user-password" name="user[password]">
          </div>
          <label style="font-weight: 500">Confirm Password: </label>
          <div>
            <input type="password" class="form-control" name="user[password_confirmation]">
          </div>
          <label style="font-weight: 500">Mobile Number: </label>
          <div>
            <div class="input-group" style="width: 80%;">
              <span class="input-group-addon" id="basic-addon1">+91</span>

              <input type="number" class="form-control" name="user[mobile_number]">

            </div>
          </div>

          <!-- <h4>User Details</h4> -->
          <div style="width: 80%;">
            <hr />
          </div>

          <label style="font-weight: 500">First Name: </label>
          <div>
            <input type="text" class="form-control" name="user[first_name]">
          </div>

          <label style="font-weight: 500">Middle Name(Optional): </label>
          <div>
            <input type="text" class="form-control" name="user[maiden_name]" value="">
          </div>

          <label style="font-weight: 500">Last Name: </label>
          <div>
            <input type="text" class="form-control" name="user[last_name]">
          </div>

          <label style="font-weight: 500">Date of Birth:</label>
          <div>
            <input type="text" class="datepicker form-control" name="user[profile_attributes][date_of_birth]">
          </div>

          <label style="font-weight: 500">Gender:</label>
          <div>
            <label style="margin-right: 20px; margin-top: 0;">
              <input type="radio" name="user[profile_attributes][gender]"
                     value="m" style="display: inline;">&nbsp;Male
            </label>
            <label style="margin-top: 0;">
              <input type="radio" name="user[profile_attributes][gender]"
                     value="f" style="display: inline;">&nbsp;Female
            </label>
          </div>

          <label style="font-weight: 500">Address Line 1:</label>
          <div>
            <input type="text" class="form-control" name="user[profile_attributes][address_1]">
          </div>

          <label style="font-weight: 500">Address Line 2:</label>
          <div>
            <input type="text" class="form-control" name="user[profile_attributes][address_2]">
          </div>

          <label style="font-weight: 500">City:</label>
          <div>
            <input type="text" class="form-control" name="user[profile_attributes][city]">
          </div>

          <label style="font-weight: 500">State:</label>
          <div>
            <select class="form-control" name="user[profile_attributes][state_id]">
              <% @states.each do |state| %>
                  <option value="<%= state[:code] %>"><%= state[:name] %></option>
              <% end %>
            </select>
          </div>

          <label style="font-weight: 500">Pin Code:</label>
          <div>
            <input type="text" class="form-control" name="user[profile_attributes][pin_code]">
          </div>

          <div>
            <button id="submitButton" style="border-radius: 1px; height: 40px"> SUBMIT</button>
          </div>

        </div>

    </form>

  </div>
</div>

<script>
  $(document).ready(function(){
    $(".datepicker").datepicker({
      dateFormat: "dd-mm-yy",
      changeMonth: true,
      changeYear: true,
      yearRange: "-100:+0"
    })
  });

</script>