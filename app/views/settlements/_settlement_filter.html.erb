
<!-- Full List -->

<ul id="firstList" style="margin-top: 110px">
  <li class="firstListItem">
    <span id="firstSpanItem" onclick="showFilterList()" class="fa fa-close"></span><a data-turbolinks="false" id="listHeader" href="#">Filter</a>
  </li>

  <% if params["filter_status"].blank? %>
      <li><a id="status" href="#" data-turbolinks="false">Status</a></li>
  <% end %>
  <% if params["filter_balance"].blank? || params["filter_balance"]["value"].blank? %>
      <li><a id="amount" href="#" data-turbolinks="false">Amount</a></li>
  <% end %>
  <% if is_admin_view %>
      <% if params["filter_user_id"].blank? %>
          <li><a id="user" href="#" data-turbolinks="false">User</a></li>
      <% end %>
      <% if params["filter_manager_id"].blank? %>
          <li><a id="manager" href="#" data-turbolinks="false">Manager</a></li>
      <% end %>
  <% end %>
  <% if params["filter_sort"].blank? %>
      <li><a id="sortby" href="#" data-turbolinks="false">Sort</a></li>
  <% end %>


</ul>


<div id="subFilter">


  <!-- Status Filter -->

  <% if params["filter_status"].blank? %>
      <ul id="statusFilterList" class="filterList">
        <li class="firstListItem" target="columnHeader"><i onclick="backButton()" class="fa fa-chevron-left"></i>
          <span id="firstSpanItem" onclick="showFilterList()" class="fa fa-close"></span><a data-turbolinks="false" id="listHeader" href="#">Status</a>
        </li>

        <select name="filter_status" class="selectors" style=" margin-top: 15px;">
          <option style="display:none" value="" selected="selected"></option>
          <option value="company_owes_user">Company owes user</option>
          <option value="user_owes_company">User owes company</option>
          <option value="settled">Settled</option>
        </select>

        <hr class="listDivider">

    <input type="submit" class="green-button" id="applyFiltersBtn" value="Apply Filter">

      </ul>
  <% end %>

  <!-- Balance Filter -->
  <% if params["filter_balance"].blank? || params["filter_balance"]["value"].blank? %>
      <ul id="amountFilterList" class="filterList">
        <li class="firstListItem" target="columnHeader"><i onclick="backButton()" class="fa fa-chevron-left"></i>
          <span id="firstSpanItem" onclick="showFilterList()" class="fa fa-close"></span><a data-turbolinks="false" id="listHeader" href="#">Balance</a>
        </li>

        <select name="filter_balance[type]" class="selectors" style=" margin-top: 15px;">
          <option style="display:none" value="" selected="selected"></option>
          <option value="lt">Less Than</option>
          <option value="eq">Equal To</option>
          <option value="gt">Greater Than</option>
        </select>


        <input type="text" name="filter_balance[value]" class=" filterInput" style="margin: 10px 20px 10px 20px;" placeholder="0.00">

        <input type="submit" class="green-button" id="applyFiltersBtn" value="Apply Filter">

      </ul>
  <% end %>
  <!-- User Filter  -->

  <% if current_user.admin? || current_user.manager? %>
      <% if params["filter_user_id"].blank? %>
          <ul id="userFilterList" class="filterList">
            <li class="firstListItem" target="columnHeader"><i onclick="backButton()" class="fa fa-chevron-left"></i>
              <span id="firstSpanItem" onclick="showFilterList()" class="fa fa-close"></span><a data-turbolinks="false" id="listHeader" href="#">User</a>
            </li>

            <div id="ui-widgetUser" style="padding-top: 12px;">
              <select id="combobox" name="filter_user_id" style="">
                <option value="" selected="selected">Select user...</option>
                <% @users.each do |user| %>
                    <option value="<%= user.id %>"><%= user.name %></option>
                <% end %>
              </select>
            </div>


            <hr class="listDivider">

        <input type="submit" class="green-button" id="applyFiltersBtn" value="Apply Filter">

          </ul>
      <% end %>
  <% end %>

  <!-- Manager Filter  -->
  <% if current_user.admin? %>
      <% if params["filter_manager_id"].blank? %>
          <ul id="managerFilterList" class="filterList">
            <li class="firstListItem" target="columnHeader"><i onclick="backButton()" class="fa fa-chevron-left"></i>
              <span id="firstSpanItem" onclick="showFilterList()" class="fa fa-close"></span><a data-turbolinks="false" id="listHeader" href="#">Manager</a>
            </li>

            <div id="ui-widgetManager" style="padding-top: 12px">
              <select id="combobox2" name="filter_manager_id">
                <option value="" selected="selected">Select user...</option>
                <% if @managers.present? %>
                    <% @managers.each do |manager| %>
                        <option value="<%= manager.id %>"><%= manager.name %></option>
                    <% end %>
                <% end %>
              </select>
            </div>

            <hr class="listDivider">

        <input type="submit" class="green-button" id="applyFiltersBtn" value="Apply Filter">

          </ul>
      <% end %>
  <% end %>

  <!-- Sort By -->
  <!-- todo implement sort_by for settlements -->

  <ul id="sortFilterList" class="filterList">
    <li class="firstListItem" target="columnHeader"><i onclick="backButton()" class="fa fa-chevron-left"></i>
      <span id="firstSpanItem" onclick="showFilterList()" class="fa fa-close"></span><a data-turbolinks="false" id="listHeader" href="#">Sort
      By</a>
    </li>

    <p id="sortFilterPara2" class="filterText">
      Range:</p>
    <select id="sortFilterSelect" name="filter_sort" style="padding-left: 0" class="selectors">
      <option value="" selected="selected">Select Order</option>
      <option value="desc">Descending</option>
      <option value="asc">Ascending</option>
    </select>

      <input type="submit" class="green-button" id="applyFiltersBtn" value="Apply Filter">

  </ul>

</div>