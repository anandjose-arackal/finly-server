<script>

  $('#people_filter_type > li ').click(function () {
    $('#people_filter_type > li').removeClass();
    $(this).addClass('activeMembers');
  });

  $('[data-switch]').on('click', function (e) {
//    var $page = $('#listOfUsers'),
//        blockToShow = e.currentTarget.getAttribute('data-switch');


    if (e.currentTarget.getAttribute('data-value') == "paymentHistory") {
      $('input#view_to_load').val("payments");
      $("form#change_view").submit();
      $('#bulkReimburseSection').hide();
      $('.checkboxAllReports').hide();
      $('#checkAllReports').hide();
    } else if (e.currentTarget.getAttribute('data-value') == "approved") {
      $('input#view_to_load').val("approved");
      $('form#change_view').submit();

      $('#bulkReimburseSection').show();
      $('.checkboxAllReports').show();
      $('#checkAllReports').show();

    } else if (e.currentTarget.getAttribute('data-value') == "reimbursed") {
      $('input#view_to_load').val('reimbursed');
      $('form#change_view').submit();
      $('#bulkReimburseSection').hide();
      $('.checkboxAllReports').hide();
      $('#checkAllReports').hide();
    } else if (e.currentTarget.getAttribute('data-value') == "closed") {
      $('input#view_to_load').val('closed');
      $('form#change_view').submit();
      $('#bulkReimburseSection').hide();
      $('.checkboxAllReports').hide();
      $('#checkAllReports').hide();
    }

//    // Hide all children.
//    $page.children().hide();
//
//    // And show the requested component.
//    $page.children(blockToShow).show();


  });

  $(document).ready(function () {

//    $('#bulkReimburseSection').hide();


    $("#checkAllSettledReports, #checkAllApprovedReports").change(function () {
      $("input:checkbox[class=checkboxSettle]").prop('checked', $(this).prop("checked"));
      $("input:checkbox[class=checkboxReimburse]").prop('checked', $(this).prop("checked"));
    });

    $("#checkAllReports").change(function () {
      $("input:checkbox[class=checkboxApproved]").prop('checked', $(this).prop("checked"));
    });

    $(".checkboxReimburse").change(function () {
      var tbodyVar = $(this).closest('tbody');

      var selectedReportTotal = parseInt(0);

      $('> tr', tbodyVar).each(function () {


        if ($(this).find('.checkboxReimburse').is(':checked')) {

          selectedReportTotal += parseFloat($(this).find('.reimburseAmount').html());

        }

      });

      $('#selectedReportTotal').text(selectedReportTotal);
      $('#approvedSettlementAmount').text(selectedReportTotal);

    });


    $('#settleDebtModal ,#reimburseModal').on('hidden.bs.modal', function () {
      restoreModal();
      $('input:checkbox').removeAttr('checked');
      $('textarea').val('');
    })

  });

  function reimburse() {
    var ids = null;
    var amount = null;
    <% if @reports.present? %>
    ids = "<%= @reports.first[:report].id %>"
    amount = "<%= @reports.first[:total_amount] %>"
    <% end %>
    $('input#reimburseReportIds').val(ids);
    $('input#reimbursementAmount').val(amount);
    $('form#addReimbursementForm').submit();
  }

  function settle() {
    var ids = null;
    var amount = null;
    <% if @reports.present? %>
    ids = "<%= @reports.first[:report].id %>"
    amount = "<%= @reports.first[:total_amount] %>"
    <% end %>
    $('input#settleReportIds').val(ids);
    $('input#settlementAmount').val(amount);
    $('form#addSettlementForm').submit();
  }


  function showConfirmReimbursement() {


    if ($("#listOfApprovedReports input:checkbox:checked").length > 0) {

      var reimbursementAmount = parseFloat($('#selectedReportTotal').html());


      $('#reimbursementMainScreen').hide();
      $('#confirmReimbursement').show();

      $('#finalReimbursementAmount').text(reimbursementAmount);

      $('.modal-header i').show();
    } else {
      alert(' Show toast to select approved reports to reimburse');
    }
  }

  function showConfirmSettlement() {

    var settlementAmount = parseFloat($('#approvedSettlementAmount').html());

    $('#settlementMainScreen').hide();
    $('#confirmSettlement').show();

    $('#finalSettlementAmount').text(settlementAmount);

    $('.modal-header i').show();

  }

  function restoreModal() {

    $('#settlementMainScreen').show();
    $('#confirmSettlement').hide();

    $('#reimbursementMainScreen').show();
    $('#confirmReimbursement').hide();

    $('.modal-header i').hide();
  }


  function reimburseReport() {

    $('#reimburseModal').modal('show');
    $('#reimbursementMainScreen').hide();
    $('#confirmReimbursement').show();

  }

  function settleReport() {
    $('#settleDebtModal').modal('show');
    $('#settlementMainScreen').hide();
    $('#confirmSettlement').show();
  }

  function submitReimbursementRequest() {

  }

</script>