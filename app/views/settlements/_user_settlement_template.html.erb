<body id="user_settlement">
<div id="employeeSettlement">
  <div>
    <p>SETTLEMENT FOR <%= @user.name %></p>
    <button onclick="redirectBack()" class="grey-button">Back</button>
  </div>
</div>


<div id="summary">
  <section style="float: left;
      width: 750px;
      background: white;
      border: 1px solid #d8d8d8;
      padding: 30px;">
    <label style="width: 50%;font-family: 'Roboto Condensed', sans-serif; font-size: 17px;">
      Pending Reimbursement

    </label>

    <label style="font-family: 'Roboto Condensed', sans-serif; font-size: 17px;">Cash In
      <% if not is_personal_view %>
          <span><%= @user.name %>'s</span>
      <% end %>
      Hand</label>

    <section>
      <span style="width: 50%;
          display: inline-block;">&#8377 <span><%= @user.balance_sheet.pending_reimbursement.value %></span></span>
      <span style="
      display: inline-block;">&#8377 <span><%= @user.balance_sheet.cash_in_hand.value %></span></span>
    </section>

    <section style="margin-top: 15px">
      <span style="width: 50%;
          display: inline-block;">
    <% if not is_personal_view %>
      <button class="green-button" data-toggle="modal" data-target="#reimburseModal" style=" background-color: #465c8b;
          color: white;
          padding: 5px 10px 5px 10px;
          letter-spacing: 1px;
          border: 1px solid; width: 150px ">REIMBURSE
      </button>
    <% end %>
        </span>
      <span>
    <% if not is_personal_view %>
      <button class="green-button" data-toggle="modal" data-target="#settleDebtModal" style=" background-color: #465c8b;
          color: white;
          padding: 5px 10px 5px 10px;
          letter-spacing: 1px;
          border: 1px solid;width: 150px  ">SETTLE DEBT
      </button>
    <% end %>
      </span>
    </section>
  </section>
  <section style="  margin-right: 85px;
      float: right;
      font-weight: 500;
  ">
    <% if not is_personal_view %>
        <button data-toggle="modal" data-target="#add_payment_modal" class="green-button" style="padding: 10px;
            width: 135px;">ADD PAYMENT
        </button>
        <button style="display: none">QUICK LOAD CARD</button>
    <% end %>
  </section>
</div>

<form data-remote data-turboboost  id="change_view" action="<%= settlement_partial_path(load_params id: params[:id]) %>" method="post">
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  <input id="view_to_load" name="view_to_load" type="hidden" value=""/>
</form>

<%= render 'details' %>

</div>

</body>


<!-- Modal-->
<div class="modal fade" id="add_payment_modal" role="dialog" style="margin-top: 5%; ">
  <div class="modal-dialog modal-md">
    <div class="modal-content" style="border-radius: 1px">
      <div class="modal-header" style="background-color: #e9e9e9 ">
        <button type="button" class="close" style="opacity: 0.7" data-dismiss="modal">&times;</button>
        <h4 class="modal-title" style="text-align: center; font-weight: 400;border-bottom: #d8d8d8">New
          Settlement</h4>
      </div>
      <form data-remote data-turboboost id="settlementModalForm" method="post"  action="<%= settlement_add_payment_path(load_params id: params[:id]) %>">
        <input name="authenticity_token" value="<%= form_authenticity_token %>" type="hidden">

        <div class="modal-body" style=" padding-left: 40px;padding-right: 40px">

          <label style="margin-top: 8px">Amount</label>
          <input name="payment[amount]" id="settlementAmount" type="text" onkeypress='return event.charCode >= 48 && event.charCode <= 57' class="form-control" style="margin-top: 4px; border-radius: 1px">
          <label style="margin-top: 8px">Date</label>

          <input type="date" name="payment[date]" class="form-control date-picker" min="'2000-01-01'" max="'2020-01-01'" name="" style="margin-top: 4px;border-radius: 1px">
          <label style="margin-top: 8px">Note</label>

          <textarea id="modalInputComment" name="payment[note]" class="form-control" name="" placeholder="Write a note..." style="margin-top: 4px; border-radius: 1px;resize: vertical"></textarea>


          <label class="radio-inline" style="margin-left: 36px">
            <input type="radio" name="payment[payment_type]" value="<%= PaymentType.id_for(:advance) %>" checked="checked">Cash
            advance
          </label>

          <div style="margin-top: 16px">
            <label class="radio-inline">
              <input type="radio" name="payment[payment_type]" value="<%= PaymentType.id_for(:debt_clearance) %>">Debt
              Clearance
            </label>
          </div>

          <button id="addNewPayment" class="green-button" style="margin-top: 28px;margin-top: 28px;
              background-color: #465c8b;padding: 10px;
              width: 180px;" type="submit">Add
            New
            Payment
          </button>
        </div>
      </form>

    </div>
  </div>
</div>


