<div class="row no-margin procurement-document fs-12">
  <div class="col col-xs-12 header-container">
    <div class="col col-xs-8 no-padding company-details">
      <div class="col col-xs-12 no-padding logo">
        <img src="<%=@company.configuration.logo.url(:thumb) %>" width="120" height="auto">
      </div>
      <div class="col col-xs-12 no-padding address fs-12 mg-top-5">
        <br>
        <div class="mg-botm-8"><b><%= @company.configuration.legal_entity_name %></b></div>
        <div class="font-light-gray mg-botm-8">Business Office :</div>
        <div class="font-light-gray col-xs-8">
          <%= simple_format @company.configuration.address, {}, wrapper_tag: "div" %>
        </div>
      </div>
    </div>
    <div class="col col-xs-4 no-padding document-details text-right">
      <div class="col col-xs-12 no-padding document-type">
        PURCHASE ORDER
      </div>
      <div class="col col-xs-12 no-padding table-document-details">
        <table class="table table-responsive">
          <tbody>
          <tr>
            <td class="font-light-gray">PO Number</td>
            <td class="font-dark-gray"><%= @result.purchase_order.po_number %></td>
          </tr>
          <tr>
            <td class="font-light-gray">PO Date</td>
            <td class="font-dark-gray"><%= @result.purchase_order.created_at.strftime "%b-%d-%Y" %></td>
          </tr>
          <tr>
            <td class="font-light-gray">Expected Delivery Date</td>
            <td class="font-dark-gray"><%= @result.purchase_order.delivery_date&.strftime "%b-%d-%Y" %></td>
          </tr>
          <tr>
            <td class="font-light-gray">Payment Term</td>
            <td class="font-dark-gray"><%= @result.purchase_order.payment_term&.description %></td>
          </tr>
          </tbody>
        </table>
      </div>
    </div>
    <% if @result.purchase_order.company.configuration.show_custom_fields_in_pdf && !@result.purchase_order.forms_enabled %>
      <% field_configurations = FieldConfiguration.with_id(@result.purchase_order.custom_fields.pluck(:field_configuration_id)) %>
      <% if field_configurations.present? && field_configurations.pluck(:printable).include?(true) %>
        <div class="col col-xs-12 no-padding">
          <% @result.purchase_order.custom_fields.each do |custom_field| %>
            <% if custom_field.field_configuration.printable %>
              <div class="col col-xs-3 no-padding mg-botm-8">
                <div class="col col-xs-12 no-padding font-light-gray mg-botm-2"><%= custom_field.field_configuration.field_name %></div>
                <div class="col col-xs-12 no-padding font-dark-gray">
                  <% if custom_field.value_type == 'FieldDropDownSelection' %>
                    <%= custom_field.value.value.name %>
                  <% else %>
                    <%= custom_field.value&.value || '--' %>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>
    <!-- <div class="col col-xs-12 no-padding">
      <p class="text-center"><%= @result.purchase_order&.procurement&.note %></p>
    </div> -->
  </div>

  <% if @result.purchase_order.gstin_location&.address&.blank? %>

    <div class="col col-xs-12 no-padding body-container">
      <div class="col col-xs-4 vendor-details">
        <h4 class="section-title">Vendor Details</h4>
        <div class="col col-xs-12 no-padding mg-botm-8">
          <div class="col col-xs-12 no-padding font-light-gray mg-botm-2">Name</div>
          <div class="col col-xs-12 no-padding font-dark-gray"><%= @result.purchase_order.vendor.display_name %></div>
          <% if @result.purchase_order.vendor.trade_name.present? && (@result.purchase_order.vendor.display_name&.strip != @result.purchase_order.vendor.trade_name&.strip) %>
            <div class="col col-xs-12 no-padding font-dark-gray"><%= @result.purchase_order.vendor.trade_name %></div>
          <% end %>
        </div>
        <% if @result.purchase_order.vendor_country_id.to_i == Country.id_for("India") %>
          <div class="col col-xs-12 no-padding mg-botm-8">
            <div class="col col-xs-12 no-padding font-light-gray mg-botm-2">PAN Number</div>
            <div class="col col-xs-12 no-padding font-dark-gray"><%= @result.purchase_order.vendor.pan %></div>
          </div>
          <div class="col col-xs-12 no-padding">
            <div class="col col-xs-12 no-padding font-light-gray mg-botm-2">GSTIN</div>
            <div class="col col-xs-12 no-padding font-dark-gray"><%= @result.purchase_order.gstin_location&.gstin %></div>
          </div>
        <% end %>
        <div class="col col-xs-12 no-padding">
          <div class="col col-xs-12 no-padding font-light-gray mg-botm-2">Point of Contact</div>
          <div class="col col-xs-12 no-padding font-dark-gray"><%= @result.purchase_order&.vendor_poc_name %></div>
        </div>
        <div class="col col-xs-12 no-padding mg-botm-8">
          <div class="col col-xs-12 no-padding font-light-gray mg-botm-2">Email</div>
          <div class="col col-xs-12 no-padding font-dark-gray"><%= @result.purchase_order.vendor_poc_email.present? ? @result.purchase_order.vendor_poc_email : "--" %></div>
        </div>
        <div class="col col-xs-12 no-padding mg-botm-8">
          <div class="col col-xs-12 no-padding font-light-gray mg-botm-2">Mobile Number</div>
          <div class="col col-xs-12 no-padding font-dark-gray"><%= @result.purchase_order&.vendor_poc_mobile_number.present? ? @result.purchase_order&.vendor_poc_mobile_number : "--" %></div>
        </div>
        <div class="col col-xs-12 no-padding">
          <div class="col col-xs-12 no-padding font-light-gray mg-botm-2">Location</div>
          <div class="col col-xs-12 no-padding font-dark-gray"><%= "#{@result.purchase_order&.gstin_location&.location} - #{@result.purchase_order&.gstin_location&.state&.name}" %></div>
        </div>
      </div>
      <div class="col col-xs-4 billing-address">
        <h4 class="section-title">Buyer Billing Address</h4>
        <div class="col col-xs-12 no-padding font-dark-gray mg-botm-8">
          <%= @result.purchase_order.company.configuration.legal_entity_name %>
        </div>
        <div class="col col-xs-12 no-padding font-light-gray mg-botm-8">
          <% if @result.purchase_order.billing_address.present? %>
            <%= simple_format @result.purchase_order.billing_address, {}, wrapper_tag: "div" %>
          <% else %>
            <%= @result.purchase_order.location&.address %>
          <% end %>
        </div>
        <div class="col col-xs-12 no-padding mg-botm-8">
          <div class="col col-xs-12 no-padding font-light-gray mg-botm-2">GST Number</div>
          <div class="col col-xs-12 no-padding font-dark-gray"><%= @result.purchase_order.location&.gstin %></div>
        </div>
        <div class="col col-xs-12 no-padding">
          <div class="col col-xs-12 no-padding font-light-gray mg-botm-2">PAN Number</div>
          <div class="col col-xs-12 no-padding font-dark-gray"><%= @result.purchase_order.location&.pan %></div>
        </div>
      </div>
      <div class="col col-xs-4 shipping-address">
        <h4 class="section-title">Buyer Shipping Address</h4>
        <div class="col col-xs-12 no-padding font-dark-gray mg-botm-8">
          <%= @result.purchase_order.company.configuration.legal_entity_name %>
        </div>
        <div class="col col-xs-12 no-padding font-light-gray mg-botm-8">
          <% if @result.purchase_order.shipping_address.present? %>
              <%= simple_format @result.purchase_order.shipping_address, {}, wrapper_tag: "div" %>
          <% else %>
              <%= @result.purchase_order.delivery_location.address %>
          <% end %>
        </div>
        <div class="col col-xs-12 no-padding mg-botm-8">
          <div class="col col-xs-12 no-padding font-light-gray mg-botm-2">GST Number</div>
          <div class="col col-xs-12 no-padding font-dark-gray"><%= @result.purchase_order.delivery_location&.gstin %></div>
        </div>
        <div class="col col-xs-12 no-padding">
          <div class="col col-xs-12 no-padding font-light-gray mg-botm-2">PAN Number</div>
          <div class="col col-xs-12 no-padding font-dark-gray"><%= @result.purchase_order.delivery_location&.pan %></div>
        </div>
      </div>
    </div><br> <br>

  <% else %>  

    <div class="col col-xs-12 no-padding body-container">
      <div class="col col-xs-3 vendor-details">
        <h4 class="section-title">Vendor Details</h4>
        <div class="col col-xs-12 no-padding mg-botm-8">
          <div class="col col-xs-12 no-padding font-light-gray mg-botm-2">Name</div>
          <div class="col col-xs-12 no-padding font-dark-gray"><%= @result.purchase_order.vendor.display_name %></div>
          <% if @result.purchase_order.vendor.trade_name.present? && (@result.purchase_order.vendor.display_name&.strip != @result.purchase_order.vendor.trade_name&.strip) %>
            <div class="col col-xs-12 no-padding font-dark-gray"><%= @result.purchase_order.vendor.trade_name %></div>
          <% end %>
        </div>
        <% if @result.purchase_order.vendor_country_id.to_i == Country.id_for("India") %>
          <div class="col col-xs-12 no-padding mg-botm-8">
            <div class="col col-xs-12 no-padding font-light-gray mg-botm-2">PAN Number</div>
            <div class="col col-xs-12 no-padding font-dark-gray"><%= @result.purchase_order.vendor.pan %></div>
          </div>
          <div class="col col-xs-12 no-padding">
            <div class="col col-xs-12 no-padding font-light-gray mg-botm-2">GSTIN</div>
            <div class="col col-xs-12 no-padding font-dark-gray"><%= @result.purchase_order.gstin_location&.gstin %></div>
          </div>
        <% end %>
        <div class="col col-xs-12 no-padding">
          <div class="col col-xs-12 no-padding font-light-gray mg-botm-2">Point of Contact</div>
          <div class="col col-xs-12 no-padding font-dark-gray"><%= @result.purchase_order&.vendor_poc_name %></div>
        </div>
        <div class="col col-xs-12 no-padding mg-botm-8">
          <div class="col col-xs-12 no-padding font-light-gray mg-botm-2">Email</div>
          <div class="col col-xs-12 no-padding font-dark-gray"><%= @result.purchase_order.vendor_poc_email.present? ? @result.purchase_order.vendor_poc_email : "--" %></div>
        </div>
        <div class="col col-xs-12 no-padding mg-botm-8">
          <div class="col col-xs-12 no-padding font-light-gray mg-botm-2">Mobile Number</div>
          <div class="col col-xs-12 no-padding font-dark-gray"><%= @result.purchase_order&.vendor_poc_mobile_number.present? ? @result.purchase_order&.vendor_poc_mobile_number : "" %></div>
        </div>
        <div class="col col-xs-12 no-padding">
          <div class="col col-xs-12 no-padding font-light-gray mg-botm-2">Location</div>
          <div class="col col-xs-12 no-padding font-dark-gray"><%= "#{@result.purchase_order&.gstin_location&.location} - #{@result.purchase_order&.gstin_location&.state&.name}" %></div>
        </div>
      </div>
      <div class="col col-xs-3 vendor-address">
        <h4 class="section-title">Vendor Address</h4>
        <div class="col col-xs-12 no-padding mg-botm-8">
          <div class="col col-xs-12 no-padding font-dark-gray"><%= @result.purchase_order.vendor.business_name %></div>
          <% if @result.purchase_order.vendor.trade_name.present? && (@result.purchase_order.vendor.business_name&.strip != @result.purchase_order.vendor.trade_name&.strip) %>
            <div class="col col-xs-12 no-padding font-dark-gray"><%= @result.purchase_order.vendor.trade_name %></div>
          <% end %>
        </div>
        <div class="col col-xs-12 no-padding mg-botm-8">
          <div class="col col-xs-12 no-padding font-light-gray mg-botm-8"><%= @result.purchase_order.gstin_location&.address %></div>
        </div>
        <% if @result.purchase_order.vendor_country_id.to_i == Country.id_for("India") %>
        <div class="col col-xs-12 no-padding">
          <div class="col col-xs-12 no-padding font-light-gray mg-botm-2">GST Number</div>
          <div class="col col-xs-12 no-padding font-dark-gray"><%= @result.purchase_order.gstin_location&.gstin %></div>
        </div>
        <div class="col col-xs-12 no-padding mg-botm-8">
          <div class="col col-xs-12 no-padding font-light-gray mg-botm-2">PAN Number</div>
          <div class="col col-xs-12 no-padding font-dark-gray"><%= @result.purchase_order.vendor.pan %></div>
        </div>
        <% end %>
      </div>
      <div class="col col-xs-3 billing-address">
        <h4 class="section-title">Buyer Billing Address</h4>
        <div class="col col-xs-12 no-padding font-dark-gray mg-botm-8">
          <%= @result.purchase_order.company.configuration.legal_entity_name %>
        </div>
        <div class="col col-xs-12 no-padding font-light-gray mg-botm-8">
          <% if @result.purchase_order.billing_address.present? %>
            <%= simple_format @result.purchase_order.billing_address, {}, wrapper_tag: "div" %>
          <% else %>
            <%= @result.purchase_order.location&.address %>
          <% end %>
        </div>
        <% if @result.purchase_order.vendor_country_id.to_i == Country.id_for("India") %>
        <div class="col col-xs-12 no-padding mg-botm-8">
          <div class="col col-xs-12 no-padding font-light-gray mg-botm-2">GST Number</div>
          <div class="col col-xs-12 no-padding font-dark-gray"><%= @result.purchase_order.location&.gstin %></div>
        </div>
        <div class="col col-xs-12 no-padding">
          <div class="col col-xs-12 no-padding font-light-gray mg-botm-2">PAN Number</div>
          <div class="col col-xs-12 no-padding font-dark-gray"><%= @result.purchase_order.location&.pan %></div>
        </div>
        <% end %>
      </div>
      <div class="col col-xs-3 shipping-address">
        <h4 class="section-title">Buyer Shipping Address</h4>
        <div class="col col-xs-12 no-padding font-dark-gray mg-botm-8">
          <%= @result.purchase_order.company.configuration.legal_entity_name %>
        </div>
        <div class="col col-xs-12 no-padding font-light-gray mg-botm-8">
          <% if @result.purchase_order.shipping_address.present? %>
              <%= simple_format @result.purchase_order.shipping_address, {}, wrapper_tag: "div" %>
          <% else %>
              <%= @result.purchase_order.delivery_location.address %>
          <% end %>
        </div>
        <% if @result.purchase_order.vendor_country_id.to_i == Country.id_for("India") %>
        <div class="col col-xs-12 no-padding mg-botm-8">
          <div class="col col-xs-12 no-padding font-light-gray mg-botm-2">GST Number</div>
          <div class="col col-xs-12 no-padding font-dark-gray"><%= @result.purchase_order.delivery_location&.gstin %></div>
        </div>
        <div class="col col-xs-12 no-padding">
          <div class="col col-xs-12 no-padding font-light-gray mg-botm-2">PAN Number</div>
          <div class="col col-xs-12 no-padding font-dark-gray"><%= @result.purchase_order.delivery_location&.pan %></div>
        </div>
        <% end %>
      </div>
    </div><br> <br>

  <% end %>
  <div class="col col-xs-12 line-items-container mg-top-5" style="padding-top: 25px">
    <div class="col col-xs-12 no-padding">
      <table class="table table-responsive table-document-items po-container">
        <thead class="po-header">
        <tr>
          <th style="width: 25px;">#</th>
          <th style="min-width: 140px;">Name/Description</th>
          <th>Comment</th>
          <th class="text-center">Qty</th>
          <th class="text-center">HSN SAC</th>
          <th class="text-center">Unit of Measurement</th>
          <th class="text-right">Rate</th>
          <th class="text-right">Discount</th>
          <th class="text-right">Tax
          <% if @result.purchase_order.gst_type_id == GstType.id_for(:cgst_sgst)%>
            (SGST + CGST)
          <% else %>
            (IGST)
          <% end %>
          </th>
          <th class="text-right">Tax Percentage</th>
          <th class="text-right">Total</th>
        </tr>
        </thead>
        <tbody class="po-body">
        <% @result.purchase_order.items.each_with_index do |item, index| %>
          <tr>
            <td class="font-light-gray"><%= index + 1 %></td>
            <td class="font-dark-gray fw-bold"><%= item.description %></td>
            <td class="font-light-gray"><div><%= item.comment %></div></td>
            <td class="text-center font-light-gray"><%= item.quantity %></td>
            <td class="text-center font-light-gray"><%= item.hsn_sac %></td>
            <td class="text-center font-light-gray"><%= item.unit_of_measurement %></td>
            <td class="text-right currency"><i class='fa fa-<%= @result.purchase_order.base_currency.country_code.downcase %>'></i><%= number_with_delimiter(item.rate, delimiter_pattern: /(\d+?)(?=(\d\d)+(\d)(?!\d))/) %></td>
            <td class="text-right currency"><i class='fa fa-<%= @result.purchase_order.base_currency.country_code.downcase %>'></i><%= number_with_delimiter(item.discount_amount&.value&.to_d.round(2), delimiter_pattern: /(\d+?)(?=(\d\d)+(\d)(?!\d))/) rescue 0 %></td>
            <td class="text-right currency"><i class='fa fa-<%= @result.purchase_order.base_currency.country_code.downcase %>'></i><%= number_with_delimiter(item.tax_amount&.value&.to_d.round(2), delimiter_pattern: /(\d+?)(?=(\d\d)+(\d)(?!\d))/) rescue 0 %></td>
            <td> <%= number_with_delimiter(item.tax&.to_d.round(2), delimiter_pattern: /(\d+?)(?=(\d\d)+(\d)(?!\d))/)  rescue 0 %> %</td>
            <td class="text-right fw-bold currency"><i class='fa fa-<%= @result.purchase_order.base_currency.country_code.downcase %>'></i><%= number_with_delimiter(item.total_amount&.value&.to_d.round(2), delimiter_pattern: /(\d+?)(?=(\d\d)+(\d)(?!\d))/) rescue 0 %></td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
    <div class="col col-xs-12 no-padding">
      <div class="col col-xs-8 no-padding">
        <% if @result.purchase_order.base_currency_id == Currency.id_for('INR')%>
          <div class="amount_in_words">
            <b>Net Total Amount in Words:</b> <%= AmountUtils.to_words(@result.purchase_order.balance_amount&.value&.to_d.round(2), @result.purchase_order.base_currency.country_code).titleize %>
        </div>
        <% end %>
        <% if @result.taxes_applicable_flag %>
          <div class="taxes_as_applicable" style="vertical-align: bottom;">
            *Taxes as Applicable
          </div>
        <% end %>
      </div>
      <div class="col col-xs-4 no-padding">
        <table class="table table-responsive table-document-items-summary fs-12">
          <tbody>
          <tr>
            <td class="font-light-gray text-left">Total</td>
            <td class="font-dark-gray text-right currency"><i class='fa fa-<%= @result.purchase_order.base_currency.country_code.downcase %>'></i><%= number_with_delimiter((@result.purchase_order.total_before_tax&.value + @result.purchase_order.discount_amount&.value).round(2), delimiter_pattern: /(\d+?)(?=(\d\d)+(\d)(?!\d))/) rescue 0 %></td>
          </tr>
          <tr>
            <td class="font-light-gray text-left">Discount</td>
            <td class="font-dark-gray text-right currency"><i class='fa fa-<%= @result.purchase_order.base_currency.country_code.downcase %>'></i><%= number_with_delimiter(@result.purchase_order.discount_amount&.value&.to_d.round(2), delimiter_pattern: /(\d+?)(?=(\d\d)+(\d)(?!\d))/) rescue 0 %></td>
          </tr>
          <tr>
            <% if @result.taxes_applicable_flag %>
              <td class="font-light-gray text-left">Tax*
              <% if @result.purchase_order.gst_type_id == GstType.id_for(:cgst_sgst) %>
                  (SGST + CGST)
              <% else %>
                  (IGST)
              <% end %>
              </td>
            <% else %>
              <td class="font-light-gray text-left">Tax
              <% if @result.purchase_order.gst_type_id == GstType.id_for(:cgst_sgst) %>
                  (SGST + CGST)
              <% else %>
                  (IGST)
              <% end %>
              </td>
            <% end %>
            <td class="font-dark-gray text-right currency"><i class='fa fa-<%= @result.purchase_order.base_currency.country_code.downcase %>'></i><%= number_with_delimiter(@result.purchase_order.tax_amount&.value&.to_d.round(2), delimiter_pattern: /(\d+?)(?=(\d\d)+(\d)(?!\d))/) rescue 0 %></td>
          </tr>
          <% if @result.purchase_order.advance_amount_required %>
            <tr>
              <td class="font-light-gray text-left">Advance Amount</td>
              <td class="font-dark-gray text-right currency"><i class='fa fa-<%= @result.purchase_order.base_currency.country_code.downcase %>'></i><% if @result.purchase_order.forms_enabled %><%= number_with_delimiter(@result.purchase_order.po_requested_advance_amount.to_f, delimiter_pattern: /(\d+?)(?=(\d\d)+(\d)(?!\d))/) rescue 0 %><% else %><%= number_with_delimiter(@result.purchase_order.advance_amount&.value&.to_d.round(2), delimiter_pattern: /(\d+?)(?=(\d\d)+(\d)(?!\d))/) rescue 0 %><% end %></td>
            </tr>
          <% end %>
          <tr>
            <td class="font-light-gray text-left">Net Total</td>
            <td class="font-dark-gray text-right currency"><i class='fa fa-<%= @result.purchase_order.base_currency.country_code.downcase %>'></i><%if @result.purchase_order.forms_enabled %><%= number_with_delimiter(@result.purchase_order.po_balance_due.to_f, delimiter_pattern: /(\d+?)(?=(\d\d)+(\d)(?!\d))/) rescue 0 %><%else %><%= number_with_delimiter(@result.purchase_order.balance_amount&.value&.to_d, delimiter_pattern: /(\d+?)(?=(\d\d)+(\d)(?!\d))/) rescue 0 %><%end %></td>
          </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <% unless @result.purchase_order.note.blank? %>
    <div class="col col-xs-12 notes-container mg-top-5">
      <h4 class="section-title">Note to Vendor</h4>
      <div class="col col-xs-12 no-padding term-text font-light-gray mg-top-5 mg-botm-8">
        <% if @result.purchase_order.note.blank? %>
          <%= simple_format "<i>Empty </i>", {}, wrapper_tag: "div" %>
        <% else %>
          <%= simple_format @result.purchase_order.note, {}, wrapper_tag: "div" %>
        <% end %>
      </div>
    </div>
  <% end %>
  <% unless @result.purchase_order.vendor_note.blank? %>
    <div class="col col-xs-12 notes-container mg-top-5">
      <h4 class="section-title">Vendor Note</h4>
      <div class="col col-xs-12 no-padding term-text font-light-gray mg-top-5 mg-botm-8">
        <% if @result.purchase_order.vendor_note.blank? %>
          <%= simple_format "<i>Empty </i>", {}, wrapper_tag: "div" %>
        <% else %>
          <%= simple_format @result.purchase_order.vendor_note, {}, wrapper_tag: "div" %>
        <% end %>
      </div>
    </div>
  <% end %>
  <div class="text-center font-dark-small" style="margin-top: 50%; padding-top: 80%">
    Please refer the next page for the terms and conditions
  </div>
  <p style="page-break-after:always;"></p>

  <div class="col col-xs-12 terms-and-conditions-container mg-top-5">
    <h4 class="terms-condition-tittle">Terms and Conditions</h4>
    <div class="col col-xs-12 no-padding term-text font-light-gray mg-top-5 mg-botm-8">
      <div><%= @result.purchase_order&.procurement_term_text&.html_safe %></div>
    </div>
    <div class="col col-xs-12 no-padding approval-flow mg-top-5 mg-botm-8">
      <% if (@company.configuration.show_po_approved_trail) %>
        <ul>
          <% approved_users = [] %>
          <% @result.purchase_order.trails.printable_trails.only_approve.each do |trail| %>
            <% if trail.action_id == TrailAction.id_for(:approve) && trail.action_user_id.present? %>
              <% unless approved_users.include?(trail.action_user) %>
                <% approved_users.push(trail.action_user) %>
                <li>
                  <div class="text center font-light-gray"><%= trail.action_user.name %></div>
                  <div class="text-center font-dark-gray">
                    <%= trail.action_user.profile.signature_title.present? ? trail.action_user.profile.signature_title : "Approved" %>
                  </div>
                </li>
              <% end %>
            <% end %>
          <% end %>
        </ul>
        <ul>
          <li>
            <div class="text center font-light-gray"><%= @result.purchase_order.user.name %></div>
            <div class="text-center font-dark-gray">
              <%= "Initiated By" %>
            </div>
          </li>
        </ul>
      <% end %>
    </div>
  </div>
</div>

