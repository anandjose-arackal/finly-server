
  <style>
    table {
      table-layout: fixed;
      border-collapse: collapse;
    }

    table#tbl-name td,
    table#tbl-name tr{
      height: 17.5pt;
    }
    table#tbl-expanses,
    table#tbl-expanses td,
    table#tbl-expanses th,
    table#tbl-expanses tr{
      border: 1.0pt solid black;
    }
    th{
      background: #99CCFF;
      font-weight: 100;
      font-family: Sans-Serif;
    }

    td {
      overflow-wrap: break-word;
      text-align: justify;
      text-justify: inter-word;
      font-size: 11.0pt;
      font-weight: 700;
      font-family: Garamond, serif;
    }

    .image_with_text {
      border: 1px black;
      height: 300px;
    }

  </style>
<div class="container-fluid" style="font-family: Arial, sans-serif;">

  <div class="row">
    <div style="float: right">
      <% url = report.user.company.configuration.logo.url %>
      <img src=<%=url%> class="img-responsive" style="height: 50px; width:100px; display: inline;float: right">
    </div>
    <div style="text-align: center; font-size: 16.0pt">
      Learning Links foundation
    </div>
    <div style="text-align:center; color: blue;  font-size: 16.0pt; font-weight: 700">
      Petty Cash Register
    </div>
    <% report_custom_fields = report.custom_fields %>
    <% expenses = report.expenses %>
    <table id="tbl-name" style="width:300px">
      <tr>
        <td width="25%">Name:</td>
        <td><%= report.user.name %></td>
      </tr>
      <tr>
        <td width="25%">Location:</td>
        <td><%=  %></td>
      </tr>
      <tr>
        <td width="25%">Period:</td>
        <td> </td>
      </tr>
      <tr></tr>
    </table>
    <div class="col-sm-12">
      <table id="tbl-expanses">
        <thead class="custom-border">
          <tr>
            <th> Petty Cash Slip No</th>
            <th> Bill No</th>
            <th> Bill Date</th>
            <th> Project Code</th>
            <th> Activity Code</th>
            <th> Description of activity & expenses</th>
            <th> Nature of exp</th>
            <th> Amount </th>
          </tr>
        </thead>
        <tbody>
          <% row_number = 0 %>
          <% expenses.each do |expense| %>
            <tr>
              <td><%= row_number +=1 %></td>
              <td></td>
              <td><%= expense.date %></td>
              <td><%= report_custom_fields.with_field_key("project_name").first&.string_value   %></td>
              <td><%= report_custom_fields.with_field_key("activity_code").first&.string_value  %></td>
              <td><%= expense.note %></td>
              <td><%= expense.category&.name %></td>
              <td><%= expense.amount_value %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="6"></td>
            <td> Total Expanse</td>
            <td> <%= report.total_amount%></td>
          </tr>
        </tfoot>
      </table>
    </div>
    <table>
      <tr  style="height:35.0pt">
      </tr>
      <tr  style="height:13.0pt">
        <td style="border-bottom: 1px solid black"></td>
        <td colspan="2"></td>
        <td style="border-bottom: 1px solid black"></td>
        <td></td>
      </tr>
      <tr height="19" style="height:14.0pt">
        <td height="14" width="300">Preparer</td>
        <td width="88" style="width:66pt"><span style="mso-spacerun:yes">&nbsp;&nbsp;</span></td>
        <td width="140" style="width:185pt">&nbsp;</td>
        <td width="300" >Approver</td>
        <td width="108" style="width:316pt">&nbsp;</td>
      </tr>
    </table>
  </div>
</div>

