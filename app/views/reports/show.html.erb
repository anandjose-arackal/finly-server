<% provide(:title, 'Finly Report') %>
<body id="show_report">
<div id="container">
  <%= render 'reports/report_show' %>
</div>
</body>

<style>

  .topbarContainer {
    visibility: hidden;
  }


</style>
<script>

  $.clearInput = function () {
    var existingExpenses = $('form#existingExpensesList');
    existingExpenses.find('input[type=text], input[type=date], input[type=number], input[type=email], textarea, select').val('');
//    existingExpenses.submit();
  };

  $('#closeAddExistingExpenseModal').on('click', function () {
    $.clearInput();
  });

  $(document).ready(function () {

    $('[data-toggle="popover"]').popover({
      placement: 'top',
      trigger: 'hover',
      html: true
    });

    $(document).on("turboboost:success", function (e, flash) {
      $('#commentTextAreaEditModal').val('');
    });

//    $('form#existingExpensesList').submit();

    //setup before functions
    var typingTimer;                //timer identifier
    var doneTypingInterval = 1000;  //time in ms, 1 second for example
    var $input = $('#filterMerchant');

    //on keyup, start the countdown
    $input.on('keyup', function () {
      clearTimeout(typingTimer);
      typingTimer = setTimeout(doneTyping, doneTypingInterval);
    });

    //on keydown, clear the countdown
    $input.on('keydown', function () {
      clearTimeout(typingTimer);
    });

    //user is "finished typing," do something
    function doneTyping() {
      //do something
      $('form#existingExpensesList').submit();
    }

  });

  function editExpense() {


    $('#hiddenExpenseMerchant').val($('#expenseMerchant').val());
    $('#hiddenNote').val($('#note').val());
    $('#hiddenDate').val($('#date').val());
    $('#hiddenCategory').val($('#category').val());
    $('#hiddenExpenseAmount').val($('#expenseAmount').val());


    var switchExpenseOneReadOnly = $('.switchExpenseOneReadOnly')
    switchExpenseOneReadOnly.prop('readonly', false);
    switchExpenseOneReadOnly.css("background", "white");


    $('.switchExpenseTwo').show();

    $('#editEditExpense').hide();

    $('.switchExpenseOne').hide();
    $('#receiptEditPencil').hide();
    $('#submittedExpense').hide();

    if ($('#noReceiptText').is(":visible")) {
      $('#noReceiptText').hide();
      $('#receiptRemove').hide();
      $('#hiddenExpenseReceipt').attr("src", "");

      $('#viewReceiptUpload').show();
      $('#viewReceiptUpload').height($('#commenter').height() * 4.5);
    }
    else {
      $('#hiddenExpenseReceipt').attr("src", $('#expenseReceipt').attr('src'));
      $('#receiptRemove').show();
    }
  }

  $('#editableExpenseDetail').on('hidden.bs.modal', function (e) {
    $('input.expenseDetailInput')
        .find("input,textarea,select")
        .val('')
        .end()
        .find("input[type=checkbox], input[type=radio]")
        .prop("checked", "")
        .end();

    closeExpense();

  })

  $('#updateNameModal').on('hidden.bs.modal', function (e) {
    $(this)
        .find("textarea")
        .val('')
        .end();

  })

  function closeExpense() {


    $('#expenseMerchant').val($('#hiddenExpenseMerchant').val());
    $('#note').val($('#hiddenNote').val());
    $('#date').val($('#hiddenDate').val());
    $('#category').val($('#hiddenCategory').val());
    $('#expenseAmount').val($('#hiddenExpenseAmount').val());
    $('#viewReceiptSelectFileText').val("");


    <% if is_admin_view || is_manager_view %>
    /*
    <% unless @report.approved? %>
     $('#submittedExpense').show();
    <% end %>*/
    <% end %>

    if ($('#hiddenExpenseReceipt').attr('src') != "") {
      $('#expenseReceipt').attr("src", $('#hiddenExpenseReceipt').attr('src'));
      $('#hiddenExpenseReceipt').attr('src', "");
      $('#expenseReceipt').show();
      $('#expenseReceiptHref').show();
    } else {
      $('#noReceiptText').show();
      $('#expenseReceipt').attr("src", "");
      $('#viewReceiptSelectFile').val("");
      $('#viewReceiptSelectFileText').val("");

      $('#expenseReceipt').hide();
      $('#expenseReceiptHref').hide();

    }

    $('.switchExpenseOneReadOnly').prop('readonly', true);
    $('.switchExpenseOneReadOnly').css("background", "#f8f8f8");


    $('#editedExpenses').hide();
    $('#editEditExpense').show();

    $('.switchExpenseTwo').hide();

    $('.switchExpenseOne').show();

    $('#receiptEditPencil').show();

    $('#receiptRemove').hide();
    $('#viewReceiptUpload').hide();

  }

  function removeReceipt() {
    var imageElement = $('img#expenseReceipt');
    imageElement.attr("src", "");

    imageElement.hide();
    $('#expenseReceiptHref').hide();
    $('#receiptRemove').hide();
    $('#viewReceiptUpload').show();
    $('#viewReceiptSelectFileText').val("nil");

    $('#viewReceiptUpload').height($('#commenter').height() * 4.5);


  }

  function showDenyModal(id) {
    $('#denyCommentInput').val('');
    $('#denyModal').modal('show');
    document.getElementById("denyExpenseButtonForm").action = "/admin/expenses/" + id + "/review";
  }

  function closeDenyModal() {
    $('#denyModal').modal('hide');
  }

  function approveAll(ids) {
    if (ids != null && ids.length > 0) {
      for (var i = 0; i < ids.length; i++) {
        document.getElementById('approveButton' + ids[i]).className = "btn active";
      }
      $('#statusText').text('Closed');
      $('#approveAllButton').hide();
      $('#allReviewingCompleted').modal('show');
    }
  }

  function showExistingExpensesModal() {
    $('form#existingExpensesList').submit();
    $('#addExistingExpenseModal').modal('show');
  }

  function showNewExpense() {
    $('#newExpenseModal').modal('show');
  }

  function cancelExpense() {
    $('.clearInput').find("input,textarea,select").val('').end();

    $('#newExpenseModal').modal('hide');
  }
//  function redirectBack() {
//    Turbolinks.visit('< %= ej reports_path(load_params) %>')
//  }

  function makeHeaderEditable() {
    $('#updateNameModal').modal('show');

    $('#modalInputName').val("<%= @report.name %>");
  }

  function validate(evt) {
    var theEvent = evt || window.event;
    var key = theEvent.keyCode || theEvent.which;
    key = String.fromCharCode(key);
    var regex = /[0-9]|\./;
    if (!regex.test(key)) {
      theEvent.returnValue = false;
      if (theEvent.preventDefault) theEvent.preventDefault();
    }
  }

  function setDate(element) {
    if (element == null)
      return;
    var val = element.valueAsDate;
    if (val == null) {
      $('form#existingExpensesList').submit();
      console.log("submitting Form");
      return;
    }
    var day = val.getDate();
    var month = val.getMonth();
    var year = val.getFullYear();
    console.log("date : " + day + " - " + month + " - " + year);
    if (day != null && month != null && year != null) {
      $('form#existingExpensesList').submit();
      console.log("submitting Form");
    }
  }

  function closeEditForm() {
    $('#expenseDetailsColumn').show();

  }

  $("#checkAll").change(function () {
    $("input:checkbox").prop('checked', $(this).prop("checked"));
    makeButtonVisible();
  });

  function makeButtonVisible() {

    if ($("input:checkbox:checked").length > 0) {
      $('#addExpenseButton').show();
    }
    else {
      $('#addExpenseButton').hide();
    }
  }

  function openEditableExpenseModal(id, merchant, amount, note, date, dateVal, category, categoryId, receipt, receiptUrl, expense_blocks, budget_blocks, expense_warnings, budget_warnings) {


    $('#editableExpenseDetail').modal('show');

    switch (status) {
      case "2":
        $('#approvedBtn').show();
        $('#denyBtn').show();
        break;
      case "3":
        $('#deniedBtn').show();
        $('#approveBtn').show();
        break;
      default:
        $('#approveBtn').show();
        $('#denyBtn').show();
    }

    $('div#blockingViolationHeader').hide();
    $('div#warningViolationHeader').hide();

    if (!(jQuery.isEmptyObject(blocks)) || !(jQuery.isEmptyObject(warnings))) {

      $('#policyViolationsExpenseDetail').show();
      if (!(jQuery.isEmptyObject(blocks))) {
        $('div#blockingViolationHeader').show();
        $('p#blockingViolationsList').html(blocks);
      }
      if (!(jQuery.isEmptyObject(warnings))) {
        $('div#warningViolationHeader').show();
        $('p#warningViolationsList').html(warnings);
      }
    }
    else {
      $('#policyViolationsExpenseDetail').hide();
    }

    $('#expenseReceiptHref').height($('#commenter').height() * 4.5);
    $('#expenseMerchant').val(merchant);
    $('#date').val(date);
    $('#editExpenseDate').val(dateVal);

    var imageElement = $('img#expenseReceipt');

    if (receiptUrl == "/assets/original/missing.png") {

      $('#noReceiptText').show();
      $('#noReceiptText').height($('#commenter').height() * 4.5);
      imageElement.hide();
      $('#expenseReceiptHref').hide();
    } else {
      $('#noReceiptText').hide();
      imageElement.attr("src", receipt);
      imageElement.show();
      $('#expenseReceiptHref').show();
    }


    $('#note').val(note);

    $('#category').val(category);
    $('#editExpenseCategory').val(categoryId);
    $('#expenseAmount').val(amount);
//    document.getElementById("editExpenseForm").action = getExpensePath(id);
  }

  function createReportFromSelectedExpenses() {
    var array = []
    $("input:checkbox[name=expenses_id]:checked").each(function () {
      array.push($(this).val());
    });
    $('#createReportExpenseIds').val(array);
    $('form#createReportFromExpenses').submit();
  }

  /*
   function getExpensePath(id) {
  <% if is_admin_view || is_manager_view%>
   return "/admin/expenses/" + id;
  <%else%>
   return "<%="/users/#{current_user.id}/expenses/"%>" + id;
  <%end%>
   }
   */

  function readFile(input) {

    if (input.files && input.files[0]) {
      var reader = new FileReader();

      reader.onload = function (e) {
        var result = e.target.result;
        if (result != null) {
          $('#receiptImage').attr('src', result);
          $('#noReceiptForAddExpense').hide();
          $('#attachedReceipt').show()
        } else {
          $('#noReceiptForAddExpense').show();
          $('#attachedReceipt').hide()
        }
        // add array length as second parameter

      };

      reader.readAsDataURL(input.files[0]);
      globalFilesVariable = input.files;

    }

  }

  function selectFile() {
    $("#receiptSelectFile").click();
  }

  function selectFileForView() {
    $("#viewReceiptSelectFile").click();
  }

  function readFileForView(input) {

    if (input.files && input.files[0]) {
      var reader = new FileReader();

      reader.onload = function (e) {
        var result = e.target.result;
        if (result != null) {

          $('#expenseReceipt').attr('src', result);
          $('#viewReceiptUpload').hide();
          $('#expenseReceipt').show()
          $('#expenseReceiptHref').show();
          $('#receiptRemove').show()
        } else {
          $('#expenseReceipt').attr('src', "");
          $('#viewReceiptUpload').show();
          $('#expenseReceipt').hide()
          $('#expenseReceiptHref').hide();
        }
        // add array length as second parameter
        result = null;
      };

      reader.readAsDataURL(input.files[0]);
      globalFilesVariable = input.files;

    }

  }

</script>