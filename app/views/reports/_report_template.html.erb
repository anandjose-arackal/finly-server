<body id="reports">

<%= render 'shared/lower_header' %>

<form data-remote data-turboboost id="allReportsFilters" action="" method="get">
  <!-- applied filters -->
  <div id="showPreviousFilters" style="min-height: 20px;">
    <% param = parse_params # i.e get filters for expenses              %>
    <% if param.present? %>
        <% param.each do |item| %>
            <%= render partial: 'shared/applied_filter_item', locals: {item: item} %>
        <% end %>
    <% end %>
  </div>
</form>

<div class="row" style="margin-top: 120px; padding-left: 20%; padding-right: 12.5%; margin-bottom: 40px">

  <div class="col-sm-8" style="border: 1px solid #d8d8d8;background-color: #CFE8DA">
    <div>
      <div id="headerTitle" style="background-color: #CFE8DA;border-bottom: 1px solid #d8d8d8; padding-top: 5px; padding-bottom: 5px">
      </div>
      <div style="background-color: white">

        <div class="row" style="background-color: white;border-bottom: 2px solid #d8d8d8;">
          <form data-remote data-turboboost action="<%= reports_path %>" method="get">
            <% params.each do |key, value| %>
                <% if key.start_with?('filter') && key != 'filter_search' %>
                    <input type="text" hidden="hidden" name="<%= key %>" value="<%= value %>">
                <% end %>
            <% end %>

          </form>
        </div>
      </div>
      <div id="my-posts">
        <%= yield :reports %>
      </div>
      <!--<div id="infinite-scrolling" style="display: none">-->
        <%= will_paginate @reports if @reports.present? %>
      <!--</div>-->


      <script>

        function changeBackground(element) {
          $(element).css('background-color', 'rgb(255, 255, 187)');
        }

      </script>


    </div>

  </div>
  <div class="col-sm-4">
    <form data-remote data-turboboost action="<%= reports_path(load_params) %>" method="post">
      <input name="authenticity_token" value="<%= form_authenticity_token %>" hidden="hidden">
      <% if is_personal_view %>
          <button class="invite" type="submit">
            CREATE NEW REPORT
          </button>
      <% end %>
    </form>

    <!--  <div class="navblock" style=" < % unless is_personal_view %> margin-top: 0
        < % end %>">-->
    <div class="navblock" style="margin-top: 0">
      <p class="listHeaders">Date Submitted</p>

      <form data-remote data-turboboost id="filterForm" action="<%= reports_path %>" method="get" style="background-color: white">
        <input type="text" hidden="hidden" name="view" value="<%= params[:view] if params[:view].present? %>" style="font-size: 14px;margin-right: 30px;border: 1px solid #d8d8d8;float: right;color: #2E2F30;padding: 3px;background-color: white;border-radius: 1px;line-height: normal !important;width: 60%;">

        <div style="padding: 16px 0 8px 16px;"><label style="font-weight: 400;margin-top: 3px">From</label>
          <input id="dateFrom" type="date" name="filter_date[from]" value="<%= params[:filter_date][:from] if params[:filter_date] && params[:filter_date][:from] %>" onchange="setDate(this)" value="" style="font-size: 14px;float: right;border: 1px solid #d8d8d8;margin-right: 30px;color: #2E2F30;padding: 3px;background-color: beige;border-radius: 1px;line-height: normal !important;width: 60%;">
        </div>
        <div style="padding: 8px 0 16px 16px"><label style="font-weight: 400; margin-top: 3px">To</label>
          <input id="dateTo" type="date" name="filter_date[to]" value="<%= params[:filter_date][:to] if params[:filter_date] && params[:filter_date][:to] %>" onchange="setDate(this)" style="font-size: 14px;margin-right: 30px;border: 1px solid #d8d8d8;float: right;color: #2E2F30;padding: 3px;background-color: beige;border-radius: 1px;line-height: normal !important;width: 60%;">
        </div>
        <input id="filterStatus" type="text" hidden="hidden" name="filter_status" value="" style="font-size: 14px;margin-right: 30px;border: 1px solid #d8d8d8;float: right;color: #2E2F30;padding: 3px;background-color: white;border-radius: 1px;line-height: normal !important;width: 60%;">
      </form>
    </div>

    <div class="navblock">
      <p class="listHeaders">STATUS</p>
      <% if is_personal_view %>
          <div class="listOptions" id="unsubmittedReportsSelector" onclick="reloadPageWithStatus(<%= ReportStatus.open_id %>)">
            Open
            <span class="listOptionsNumbers"><%= @counts[:open] %></span>
          </div>
      <% end %>
      <div class="listOptions" id="submittedReportsSelector" onclick="reloadPageWithStatus(<%= ReportStatus.processing_id %>)">
        Processing
        <span class="listOptionsNumbers"><%= @counts[:processing] %></span>
      </div>
      <div class="listOptions" id="approvedReportsSelector" onclick="reloadPageWithStatus(<%= ReportStatus.approved_id %>)">
        Approved
        <span class="listOptionsNumbers"><%= @counts[:approved] %></span>
      </div>
      <div class="listOptions" id="rejectedReportsSelector" onclick="reloadPageWithStatus(<%= ReportStatus.rejected_id %>)">
        Rejected
        <span class="listOptionsNumbers"><%= @counts[:rejected] %></span>
      </div>
      <div class="listOptions" id="retractedReportsSelector" onclick="reloadPageWithStatus(<%= ReportStatus.retracted_id %>)">
        Retracted
        <span class="listOptionsNumbers"><%= @counts[:retracted] %></span>
      </div>
      <div class="listOptions" id="retractedReportsSelector" onclick="reloadPageWithStatus(<%= ReportStatus.reimbursed_id %>)">
        Reimbursed
        <span class="listOptionsNumbers"><%= @counts[:reimbursed] %></span>
      </div>
      <div class="listOptions" id="retractedReportsSelector" onclick="reloadPageWithStatus(<%= ReportStatus.reimbursement_confirmed_id %>)">
        Reimbursement Confirmed
        <span class="listOptionsNumbers"><%= @counts[:reimbursement_confirmed] %></span>
      </div>
      <div class="listOptions" id="allReportsSelector" onclick="reloadPageWithStatus(null)"> All
        <span class="listOptionsNumbers"><%= @counts[:closed] %></span>
      </div>
    </div>

  </div>

</div>

</body>

<script>

  $(document).ready(function () {
    /*

     < % if  params[:filter_status] == "0"%>
     $('#unsubmittedReportsSelector').css("background", "#FFFFBB")
     $('#headerTitle').text('UNSUBMITTED');
     < % elsif   params[:filter_status] == "1"%>
     $('#submittedReportsSelector').css("background", "#FFFFBB")
     $('#headerTitle').text('SUBMITTED');
     < % elsif   params[:filter_status] == "2"%>
     $('#closedReportsSelector').css("background", "#FFFFBB")
     $('#headerTitle').text('CLOSED');
     < % elsif   params[:filter_status] == "3"%>
     $('#reopenedReportsSelector').css("background", "#FFFFBB")
     $('#headerTitle').text('REOPENED');
     < % else %>
     $('#headerTitle').text('ALL');
     $('#allReportsSelector').css("background", "#FFFFBB")
     < % end %>
     */


  });


  function showList() {
    document.getElementById("myDropdown").classList.toggle("show");
  }

  function setDate(element) {
    if (element == null)
      return;
    var val = element.valueAsDate;
    if (val == null) {
      $('form#filterForm').submit();
      return;
    }
    var day = val.getDate();
    var month = val.getMonth();
    var year = val.getFullYear();
    console.log("date : " + day + " - " + month + " - " + year);
    if (day != null && month != null && year != null) {
      $('form#filterForm').submit();
    }
  }

  function reloadPageWithStatus(id) {
    $('#filterStatus').val(id);
    $('form#filterForm').submit();
  }

  function loadNewReport() {
    /*   Turbolinks.visit("< %= new_user_report_path(current_user) %>")
     */

  }

  function closeFilter(id) {
    var div = $('#' + id);
    div.attr('form', "");
    div.remove();
    $('#allReportsFilters').submit()
  }


</script>
