<div id="reportExpenseDetailsReviewButtons<%= expense.id %>">
  <form data-remote="" data-turboboost="" id="approveExpenseButtonForm" method="post">
    <input name="_method" type="hidden" value="put">
    <input name="authenticity_token" value="FJ8XYKjXWRS+/PTfjX2fowMIn84+/VIi/3mNYJxmdXmqgLLkkSHJ2liPVYbs44XmQsM5rsEND6DLdlV8rc4MXQ==" hidden="hidden">
    <input name="status" type="number" value="2" hidden="hidden">
    <% if !expense.approved? %>

        <button id="approvedBtn" style="background-color: #93c178;color: white;">Approved</button>
    <% else %>
        <button type="submit" id="approveBtn">Approve</button>
    <% end %>

    <% if !expense.denied? %>
        <button id="deniedBtn" style="background-color: indianred ;color: white;">Denied</button>
    <% else %>
        <button type="submit" id="denyBtn" onclick="showDenyModal(<%=expense.id%>)">Deny</button>
    <% end %>
  </form>
</div>