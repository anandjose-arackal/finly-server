<% if @views[:delete] %>
    <!--DELETE REPORT-->
    <form data-remote data-turboboost data-confirm="Are you sure you want to delete this report? No expense will be deleted in the process." action="<%= report_path(report_id: @report.id) %>" method="post">
      <input name="_method" type="hidden" value="delete"/>
      <input name="authenticity_token" value="<%= form_authenticity_token %>" hidden="hidden">
      <button type="submit" class="righButtons" style="margin-left: 10px">DELETE</button>
    </form>
<% end %>

<!--EXPORT AS CSV-->
<button onclick="location.href='<%= ej export_report_path(report_id: @report.id, view: params[:view],:format => :csv)%>'" class="righButtons" style="margin-left: 10px">
  EXPORT CSV
</button>

<!--EXPORT AS XLS-->
<button onclick="location.href='<%= ej export_report_path(report_id: @report.id, view: params[:view],:format => :xls)%>'" class="righButtons" style="margin-left: 10px">
  EXPORT XLS
</button>

<!--EXPORT AS PDF-->
<button onclick="location.href='<%= ej export_report_path(report_id: @report.id, view: params[:view],:format => :pdf)%>'" class="righButtons" style="margin-left: 10px">
