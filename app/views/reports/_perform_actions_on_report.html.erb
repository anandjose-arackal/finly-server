<% if @views[:add_expenses] %>
    <!--ADD NEW EXPENSE-->
    <button class="righButtons" style="margin-left: 10px; margin-top: 2px;" onclick="showNewExpense()"> ADD NEW EXPENSE
    </button>

    <!--ADD EXISTING EXPENSE-->
    <button class="righButtons" onclick="showExistingExpensesModal()" style="margin-left: 10px"> ADD EXISTING EXPENSE
    </button>
<% end %>

<% if @views[:retract] %>
    <!--RETRACT REPORT-->
    <form data-remote data-turboboost data-confirm="Are you sure you want to retract this report?" action="<%= report_retract_path(@report, view: params[:view]) %>" method="post">
      <input name="_method" type="hidden" value="patch"/>
      <input name="authenticity_token" value="<%= form_authenticity_token %>" hidden="hidden">
      <button type="submit" class="righButtons" style="margin-left: 10px"> RETRACT REPORT</button>
    </form>
<% end %>

