<% @violations_found = false %>
<% @block_violations = false %>
<% if @policy %>
    <% @violation_messages.each do |key, value| %>
        <% @violations_found = true unless (value['expense_warning'].blank? && value['expense_blocking'].blank? && value['budget_warning'].blank? && value['budget_blocking'].blank?) %>
        <% @block_violations = true unless (value['expense_blocking'].blank? && value['budget_blocking'].blank?) %>
    <% end %>
<% end %>
<div id="container">
  <div id="newReport">
    <div style="height: 70px; background-color: white;">
      <p style="color: #a0a0a0; font-weight: 500; display: inline-block;vertical-align: middle; line-height: 70px;margin-left: 9.5%;letter-spacing: 1px ">REPORT</p>
      <button onclick="redirectBack()" class="grey-button" id="cancelBtn">Back</button>
      <% if (@report.open? || @report.retracted? || @report.rejected?) && is_personal_view %>
          <button
          <% if @block_violations %>
          disabled style="background-color: #f9f9f9;color: #999;border: 1px solid #dfdfdf;"
          <% end %>
          type="submit" form="submitform" id="sendBtn" class="green-button">Submit
          </button>

          <form data-remote data-turboboost data-confirm="Are you sure you want to submit the report?
        <% if @violations_found %>
            <br /><br /> <b>This report contains policy violations. Your manager will be able to see the same before approval.<b>
        <% end %>
        " id="submitform" action="<%= report_submit_path(report_id: @report.id, view: params[:view]) %>" method="post">
            <input name="_method" type="hidden" value="patch"/>
            <input name="authenticity_token" value="<%= form_authenticity_token %>" hidden="hidden">
          </form>
      <% end %>
    </div>
  </div>

  <% if @violations_found %>
      <div style="margin-top: 100px;
          width: 1070px;
          background: mistyrose;
          padding: 20px;
          margin-left: 95px;<% unless is_personal_view %> margin-left: 150px; width: 1045px;
          <% end %> ">
        <% if is_personal_view %>
            <% if @report.processing? %>
                <b style="color: indianred">Report submitted with violations.</b>
            <% elsif @report.open? || @report.retracted? %>
                Policy violations detected in the report. Please correct the expenses marked with a badge.
                <b style="color: indianred;">You will not be able to submit reports with blocking violations.</b>
            <% end %>
        <% else %>
            Policy violations detected in the report. The violating expenses are marked with a badge.
        <% end %>
      </div>

  <% end %>

  <div class="reportDiv" style="<% if !@violations_found %> margin-top: 100px;<% end %><% unless is_personal_view %>margin-left: 150px;
    <% end %>">
    <button id="statusText" style="cursor: default;background-color: #374F76; border-radius: 18px; color: white; padding: 4px 23px 4px 23px; font-size: 12px; border-color: transparent">
      <%= @status %>
    </button>
    <label style="margin-left: 20px">ID: </label> <span> <%= @report.id %> </span>

    <% unless @policies.blank? %>
        <label style="float: right;margin-top: 5px"> Report Policy:
          <% if is_personal_view && !@report.processing? && !@report.approved? %>
              <form id="applyPolicyForm" data-remote data-turboboost action="<%= report_assign_policy_path(@report) %>" method="post" style="display: inline-block">
                <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                <select name="report[policy_id]" onchange="$('form#applyPolicyForm').submit();" class="selectors" style="padding-top: 10px; width: 155px">
                  <option value="nil"
                          <% if @policy.nil? %> selected="selected"
                          <% end %>
                          >None
                  </option>
                  <% @policies.each do |policy| %>
                      <option value="<%= policy.id %>"
                              <% if policy == @policy %>
                              selected="selected"
                              <% end %>
                              ><%= policy.name %></option>
                  <% end %>
                </select>
              </form>
          <% else %>
              <% if @policy %>
                  <%= @policy.name %>
              <% else %>
                  None
              <% end %>
          <% end %>
        </label>

    <% end %>

    <div>
      <%= render 'reports/info' %>
      <%= render 'reports/list_of_expenses' %>

    </div>

    <hr style="
    border-top: 1px solid #d8d8d8;
    ">

    <h3 style="color: #5d6e73; font-size: 16px">Report History & Comments</h3>

    <%= render 'reports/comments' %>

    <hr style="
    border-top: 1px solid #d8d8d8;
    ">

    <h3 style="color: #5d6e73; font-size: 16px; display: inline-block;margin-top: 0">Receipt Thumbnails </h3>

    <%= render 'reports/receipt_thumbnails' %>

  </div>

  <div style="margin-top: 30px;<% if !@violations_found %>margin-top: 100px;
    <% end %>">
    <%= render 'reports/perform_actions_on_report' %>
    <!--< %= render 'reports/manager_report_options' %>-->
  </div>


  <div class="modal fade" id="denyModal" role="dialog" style="margin-top: 5%; ">
    <div class="modal-dialog modal-md">
      <div class="modal-content">
        <div class="modal-header">
          <button type="button" class="close" style="opacity: 0.7" data-dismiss="modal">&times;</button>
          <h4 class="modal-title" style="text-align: center; font-weight: 400;border-bottom: #d8d8d8">Deny this
            Expense</h4>
        </div>

        <form onsubmit="closeDenyModal();" id="denyExpenseButtonForm" method="post">
          <input name="_method" type="hidden" value="put"/>
          <input name="authenticity_token" value="<%= form_authenticity_token %>" hidden="hidden">
          <input name="status" type="number" value="-1" hidden="hidden">

          <div class="modal-body" style=" padding-left: 40px;padding-right: 40px">
            <p>Are you sure you want to deny this expense?</p>

            <div>
              <input id="denyCommentInput" class="form-control" style="border-radius: 1px" type="text" name="comment" placeholder="Optional Note">
            </div>
            <div style="text-align: right">
              <button class="sendButton" onclick="closeDenyModal();" form="" style="background: #cccccc;color: #2E2F30">NEVERMIND</button>
              <button style="margin-left: 30px" class="sendButton" type="submit">Deny</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="modal fade" id="allReviewingCompleted" role="dialog" style="margin-top: 5%; ">
    <div class="modal-dialog modal-md">
      <div class="modal-content" style="border-radius: 1px">
        <div class="modal-header" style="background-color: #e9e9e9 ">
          <button type="button" class="close" style="opacity: 0.7" data-dismiss="modal">&times;</button>
          <h4 class="modal-title" style="text-align: center; font-weight: 400;border-bottom: #d8d8d8">Close this
            Report?</h4>
        </div>

        <div class="modal-body" style=" padding-left: 40px;padding-right: 40px">
          <p>All expenses have been reviewed. Would you like to close this report?</p>

          <div style="text-align: right">
            <button class="sendButton" onclick="$('#allReviewingCompleted').modal('hide');" form="" style="background: #cccccc;color: #2E2F30">STAY
              ON THIS PAGE
            </button>
            <button style="margin-left: 30px" class="sendButton" onclick="redirectBack()">CLOSE REPORT</button>
          </div>
        </div>
      </div>
    </div>
  </div>


  <div class="modal fade" id="updateNameModal" role="dialog" style="margin-top: 5%; ">
    <div class="modal-dialog modal-md">
      <div class="modal-c ontent" style="border-radius: 1px">
        <div class="modal-header" style="background-color: #e9e9e9 ">
          <button type="button" class="close" style="opacity: 0.7" data-dismiss="modal">&times;</button>
          <h4 class="modal-title" style="text-align: center; font-weight: 400;border-bottom: #d8d8d8">Rename Report</h4>
        </div>
        <div class="modal-body" style=" padding-left: 40px;padding-right: 40px; background-color: white">

          <form data-remote data-turboboost id="updateNameForm" action="<%= report_path(@report, view: params[:view]) %>" method="post">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <input name="_method" type="hidden" value="patch"/>
            <textarea name="report[name]" id="modalInputName" class="form-control" placeholder="Name"><%= @report.name %></textarea>
            <input type="submit" class="sendButton" value="SAVE">
          </form>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="editableExpenseDetail" role="dialog">
    <div class="modal-dialog modal-lg">
      <div class="modal-content" style="border-radius: 1px">
        <div class="modal-header" style="background-color: #e9e9e9 ">

          <button type="button" class="close" style="opacity: 0.7" data-dismiss="modal">&times;</button>
          <div id="submittedExpense" style="<%  if @report.approved? %> display:none;
            <% end %>">
            <% if is_admin_view || is_manager_view %>
                <div style="width: 250px;float: right;margin-right: 20px">
                  <form data-remote="" data-turboboost="" id="approveExpenseButtonForm" method="post">
                    <input name="_method" type="hidden" value="put">
                  </form>
                </div>
            <% end %>
          </div>
          <h4 class="modal-title" style="text-align: center; font-weight: 400;border-bottom: #d8d8d8">Expense
            Details</h4>
        </div>

        <div id="policyViolationsExpenseDetail" style="padding: 10px 30px 0px 70px;
            display: none">
          <h4>Policy violations</h4>

          <div id="blockingViolationHeader" style="background: lightpink;padding-left: 15px; padding-top: 10px;display:none">
            <span><h6><b>Blocking Violations: </b><br></h6></span>

            <p id="blockingViolationsList">
            </p>
          </div>
          <div id="warningViolationHeader" style="background: lightgoldenrodyellow;padding-left: 15px;display:none">
            <span><h6><br><b>Warning Violations: </b><br></h6></span>

            <p id="warningViolationsList">
            </p>
          </div>
        </div>
        <div class="modal-body row" style=" padding: 25px;">

          <form data-remote data-turboboost accept-charset="UTF-8" enctype="multipart/form-data" id="editExpenseForm" method="post">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <input name="_method" type="hidden" id="hiddenPatchCall" value="patch"/>
            <input type="text" class="expenseDetailInput" name="expense[receipt]" id="viewReceiptSelectFileText" style="display:none"/>
            <input type="file" class="expenseDetailInput" name="expense[receipt]" id="viewReceiptSelectFile" style="display:none" accept=".png, .jpg,.pdf, .jpeg" onclick="this.value=null;" onchange="readFileForView(this)"/>
          </form>

          <div class="col-md-8" id="expenseDetailsColumn" style="background-color: white; border-right: 1px solid #d8d8d8">


            <section id="expenseSectionDetail">

              <ol id="expenseSectionDetailList" style="list-style-type:none;">
                <li class="merchantRow">
                  <label class="expenseDetailLabel ">Merchant</label>
                  <input name="expense[merchant]" form="editExpenseForm" id="expenseMerchant" class="expenseDetailInput switchExpenseOneReadOnly" type="text" placeholder="Merchant Name" maxlength="255" tabindex="1"
                         readonly>
                  <input type="text" hidden="hidden" id="hiddenExpenseMerchant"/>

                </li>
                <li>
                  <label class="expenseDetailLabel">Note</label>
                  <input name="expense[note]" form="editExpenseForm" id="note" class="expenseDetailInput switchExpenseOneReadOnly" type=" text" class="short" tabindex="1"
                         readonly>
                  <input type="text" hidden="hidden" id="hiddenNote"/>

                </li>
                <li>
                  <label class="expenseDetailLabel">Date</label>
                  <input id="date" class="expenseDetailInput switchExpenseOne" style="width: 160px" type=" text" tabindex="1"
                         readonly>
                  <input name="expense[date]" form="editExpenseForm" id="editExpenseDate" type="date" class="expenseDetailInput switchExpenseTwo" style="display: none;width: 160px;background-color: white">
                  <input type="text" hidden="hidden" id="hiddenDate"/>

                </li>

                <li>
                  <label class="expenseDetailLabel">Total</label>
                  <span style="color: #818990; font-size: 15px">&#8377</span>
                  <input name="expense[amount]" form="editExpenseForm" id="expenseAmount" class="expenseDetailInput switchExpenseOneReadOnly" style="width: 147px; " type=" text" class="short" tabindex="1"
                         readonly>
                  <input type="text" hidden="hidden" id="hiddenExpenseAmount"/>

                </li>

                <li>
                  <label class="expenseDetailLabel">Category</label>
                  <input id="category" class="expenseDetailInput switchExpenseOne" type=" text" class="short" tabindex="1"
                         readonly>
                  <input type="text" hidden="hidden" id="hiddenCategory"/>

                  <select form="editExpenseForm" name="expense[category_id]" id="editExpenseCategory" class="switchExpenseTwo" style="display: none; width: 400px">
                    <% current_company.categories.each do |cat| %>
                        <option value="<%= cat.id %>"><%= cat.name %></option>
                    <% end %>
                  </select>
                </li>


              </ol>

              <div style="display:none">
                <p id="expenseID"></p>
              </div>

              <input type="text" hidden="hidden" id="expenseDetailsCategoryId" form="allFilters"/>


              <div id="approvedExpense" style="display:none"></div>
              <div id="declinedExpense" style="display:none"></div>

              <div id="editedExpenses" class="switchExpenseTwo" style="display: none">
                <button form="editExpenseForm" id="saveEditExpense" class="editExpenseButton" style="background-color: #93c178;
                    color: white;
                " type="submit">SAVE
                </button>
                <button id="cancelEditExpense" class="editExpenseButton" style="background-color: #f9f9f9;
                    color: #999;
                    border: 1px solid #dfdfdf;" onclick="closeExpense()">CANCEL
                </button>
              </div>

              <% unless @report.processing? || @report.approved? %>
                  <button id="editEditExpense" class="editExpenseButton" style="background-color: #475D8B;
                      color: white; <%  if @report.approved? %> display:none; <% end %>
                  " onclick="editExpense()">EDIT
                  </button>
              <% end %>

            </section>


            <div class="row" style="padding: 18px;<%  if @report.approved? %>  padding-top: 0; <% end %>margin-top: 5px">
              <hr style="margin-left: 40px;<%  unless @report.approved? %>  margin-top: 30px; <% end %>
                  border-top: 1px solid #d8d8d8;">

              <div class="col-md-2">
                <span style="font-size: 14px; margin-top: 10px; margin-right: -20px;float: right" class="roundCircle">PO</span>
              </div>
              <div id="commenter" class="col-md-10">

                <form data-remote data-turboboost id="addCommentForm" action="<%= report_comment_path(@report, view: params[:view]) %>" method="post">
                  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                  <input name="report_id" id="reportIDForComment" value="<%= %>" type="hidden">
                  <textarea style="border-radius: 1px; background-color: ghostwhite" id="commentTextAreaEditModal" name="comment"></textarea>
                  <input name="show_flash" type="text" value="true" hidden="hidden">
                  <button class="editExpenseButton" style="margin-top: 10px; margin-right: 0;
                      background-color: #475D8B;
                      color: white;
                      width: 130px;
                  ">POST COMMENT
                  </button>
                </form>
              </div>
            </div>

          </div>
          <div class="col-md-4" id="expenseReceiptContainer">
            <i id="receiptRemove" class="fa fa-remove roundCircle" style="display: none" onclick="removeReceipt()"></i>

            <% unless @report.processing? || @report.approved? %>
                <i id="receiptEditPencil" class="fa fa-pencil roundCircle" style="<%  if @report.approved? %> display:none;
                  <% end %>" onclick="editExpense()"></i>
            <% end %>

            <a data-turbolinks="false" target="_blank" id="expenseReceiptHref" style="justify-content: center;
                display: flex;
                align-items: center;">
              <img id="expenseReceipt" style="max-width: 100%;" hidden="hidden">
            </a>
            <img id="hiddenExpenseReceipt" style="max-width: 100%" hidden="hidden">

            <div id="noReceiptText" style=" border-style: dashed;background-color: ghostwhite; border-color:#a0a0a0 ; height: 100%;border-width: 1px ; text-align: center;color: #a0a0a0; margin-top: 10px;display: none">
              <p style="letter-spacing: 1px;font-weight: 200;margin-top: 200px">No Receipt</p>
            </div>

            <div id="viewReceiptUpload" style="cursor: pointer; margin: 0;display: none" onclick="selectFileForView()">
              <div style=" border-style: dashed; border-color:#a0a0a0 ; height: 100%;border-width: 1px ; text-align: center;color: #a0a0a0; margin-top: 10px; background-color: ghostwhite">
                <div id="noReceipt">
                  <button class="fa fa-arrow-circle-up" form="" style="background-color: transparent; border: none;outline: none;font-size: 60px; margin-top: 170px; opacity: 0.5;cursor: pointer"></button>
                  <p style="font-weight: 200; letter-spacing: 1px"> Upload a Receipt </p>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>


  <div class="modal fade" id="addExistingExpenseModal" role="dialog" style="margin-top: 5%; ">
    <div class="modal-dialog modal-lg" style="width: 90%">
      <div class="modal-content" style="border-radius: 1px">
        <div class="modal-header" style="background-color: #e9e9e9 ; height: 60px">
          <button type="button" id="closeAddExistingExpenseModal" class="close" style="opacity: 0.7" data-dismiss="modal">&times;</button>

          <form hidden="hidden" data-remote data-turboboost id="createReportFromExpenses" action="<%= report_add_expenses_path(@report, load_params) %>" method="post">
            <input name="authenticity_token" value="<%= form_authenticity_token %>" hidden="hidden">
            <input id="createReportExpenseIds" name="expense_id" type="text">
          </form>

          <button id="addExpenseButton" onclick="createReportFromSelectedExpenses()" type="button" style="float: right;
              background: #465c8b;
              margin-right: 20px;
              color: white;
              font-size: 10px;
              padding: 5px;
              letter-spacing: 1px;display: none">ADD EXPENSE
          </button>
          <h4 class="modal-title" style="font-weight: 400;border-bottom: #d8d8d8">Add Expenses To Report</h4>
        </div>
        <div class="modal-body" style="padding: 0">

          <form data-remote data-turboboost id="existingExpensesList" action="<%= expenses_unreported_path(load_params) %>" method="post">
            <input name="authenticity_token" value="<%= form_authenticity_token %>" hidden="hidden">

            <section id="filterSection" style="float: left;width: 25%;">
              <div style="font-size: 18px;
                  margin-left: 20px;
                  margin-top: 10px;
                  margin-bottom: 10px;"> Filters
              </div>
              <input type="text" id="filterMerchant" name="filter_merchant" style="width: 81%;margin-left: 20px; padding: 5px;" placeholder="Merchant">

              <div style="font-size: 12px;
                  margin-left: 20px;
                  margin-top: 10px;"> Select Category:
              </div>
              <select placeholder="Select Category" name="filter_category_id" class="selectors" onchange="$('form#existingExpensesList').submit();" style="width: 81%;margin-left: 20px; padding: 5px;margin-top: 10px">
                <option value="" selected="selected">None</option>
                <% @categories.each do |cat| %>
                    <option value="<%= cat.id %>"><%= cat.name %></option>
                <% end %>
              </select>
              <input id="dateFrom" type="text" onchange="setDate(this)" name="filter_date[type]" value="expense" hidden="hidden">

              <div style="padding: 16px 0 8px 21px;"><label style="font-weight: 400;margin-top: 3px">From</label>

                <input id="dateFrom" type="date" onchange="setDate(this)" name="filter_date[from]" value="" style="font-size: 14px;float: right;border: 1px solid #d8d8d8;margin-right: 35px;color: #2E2F30;padding: 3px;background-color: white;border-radius: 1px;line-height: normal !important;width: 60%;">
              </div>
              <div style="padding: 8px 0 16px 21px"><label style="font-weight: 400; margin-top: 3px">To</label>
                <input id="dateTo" type="date" onchange="setDate(this)" name="filter_date[to]" value="" style="font-size: 14px;margin-right: 35px;border: 1px solid #d8d8d8;float: right;color: #2E2F30;padding: 3px;background-color: white;border-radius: 1px;line-height: normal !important;width: 60%;">
              </div>
              <input id="filterStatus" type="text" hidden="hidden" name="filter_status" style="font-size: 14px;margin-right: 30px;border: 1px solid #d8d8d8;float: right;color: #2E2F30;padding: 3px;background-color: white;border-radius: 1px;line-height: normal !important;width: 60%;">
            </section>
          </form>
          <section id="expensesSection" style="background-color: white;margin-left: 25%; min-height: 250px;
              width: 75%; border-left: 1px solid #d8d8d8">
            <div class="row" style="margin: 0;font-size: 10px; text-align: left; padding: 10px 0 10px 0;height: 30px;border-bottom: 1px solid #d8d8d8;">
              <div class="col-md-2"><input type="checkbox" id="checkAll" style="margin-right: 4px">DATE</div>
              <div class="col-md-3">MERCHANT</div>
              <div class="col-md-4">NOTE</div>
              <div class="col-md-2" style="text-align: center;margin-left: 20px">AMOUNT</div>
            </div>
            <%= render 'existing_expense' %>
          </section>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="newExpenseModal" role="dialog" style="margin-top: 5%;">
    <div class="modal-dialog modal-md" style="background-color: white">

      <form id="expenseForm" accept-charset="UTF-8" enctype="multipart/form-data" method="post" style="background: white;" data-remote data-turboboost action="<%= expenses_path(current_user) %>">

        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <input type="text" hidden="hidden" name="expense[report_id]" value="<%= @report.id %>"/>


        <div style="width: 100%;margin: 0 auto;display: block; max-width: 940px;">
          <div style="height: 70px; background-color: white;width: 640px ">
            <p style="color: #a0a0a0; font-weight: 500; display: inline-block;vertical-align: middle; line-height: 70px;margin-left: 24px ">
              NEW EXPENSE </p>
            <button type="submit" class="green-button" id="sendBtn" style="margin-right: 5px">Add</button>
            <button type="reset" form="" id="cancelExpense" style="border: 1px solid #dfdfdf;background-color: #f9f9f9; color: #999" onclick="cancelExpense()">Cancel</button>
          </div>
          <div id="splitHeader" style="float: left;width: 640px;
              margin: 0px;
              display: inline-block;
              background-color: #465c8b;" class="row">
            <div class="col-md-8">
              <div id="uppertone" style="border-bottom: 1px solid #465c8b;
                  margin-top: 10px ;
                  padding: 0px ;
                  margin-bottom: 10px;">
                <p style="float: left;margin-left: 24px;font-size: 36px; color: white">&#8377</p>
                <input id="currency" class="clearInput" type="text" name="expense[amount]" placeholder="0.00" style="border:none; margin-left: 1px; font-size: 34px;width: 70%  ;color: white ; background-color: #465c8b;outline: none" onkeypress='validate(event)'>
                <hr id="upperhr">
                <div>
                  <p style="color: #eeeeee; margin-left: 24px;font-size: 14px; font-weight: 700;float: left;opacity: 0.7">MERCHANT:</p>
                  <input type="text" class="clearInput" name="expense[merchant]" width="40%" style="border:none; margin-left: 23px; font-size: 14px ;color: white ; background-color: #465c8b;outline: none">
                </div>
              </div>
            </div>
            <div class="col-md-4" style="padding:5px 5px 5px 0">

              <input type="file" class="clearInput" name="expense[receipt]" id="receiptSelectFile" style="display:none" accept=".png, .jpg,.pdf, .jpeg" onchange="readFile(this)"/>

              <div id="receiptUpload" style="cursor: pointer;height: 135px;width: 130px; margin: 0" onclick="selectFile()" onchange="readFile(this)">
                <div style=" border-style: dashed; border-color:#a0a0a0;height: 125px ;border-width: 1px ; text-align: center;color: #a0a0a0">
                  <div id="noReceiptForAddExpense">
                    <button class="fa fa-arrow-circle-up" form="" style="background-color: transparent; border: none;outline: none;font-size: 40px; margin-top: 27px; opacity: 0.5;cursor: pointer"></button>
                    <p style="font-weight: 200"> Upload a Receipt </p>
                  </div>
                  <div id="attachedReceipt" hidden="hidden" style="padding: 1px">
                    <img id="receiptImage" style="max-width: 110px; max-height: 125px">

                  </div>
                </div>
              </div>
            </div>

          </div>


          <div id="split">

            <div class="splitSections">
              <p class="splitSideHeader">CATEGORY:</p>
              <select name="expense[category_id]" id="newExpenseCategory">
                <% current_company.categories.each do |cat| %>
                    <option value="<%= cat.id %>"><%= cat.name %></option>
                <% end %>
              </select>

            </div>

            <div class="splitSections">
              <p class="splitSideHeader">NOTE:</p>
              <textarea id="expenseNote" class="clearInput" name="expense[note]" style="border: none;font-size: 14px ;color: #2E2F30 ; background-color: white;border-radius: 1px; line-height: normal !important; width: 60%; margin-left: 80px "></textarea>

            </div>

            <div class="splitSections">
              <p class="splitSideHeader">DATE:</p>
              <input id="date" type="date" class="clearInput" name="expense[date]" width="40%" style="font-size: 14px;color: #2E2F30;background-color: white;border-radius: 1px;line-height: normal !important;width: 60%;margin-left: 80px;border: none;">

            </div>


          </div>

        </div>

      </form>
    </div>
  </div>
</div>