<div class="row" style="margin-top: 10px">
  <div class="col-md-3">

    <% if @policy %>
        <% unless @violation_messages[expense.id]['blocking'].blank? %>
            <i class="fa fa-exclamation-circle" style="color: red; margin-left: -22px;vertical-align: middle;margin-right: 30px; font-size: 20px" data-html="true" data-toggle="popover" title="Violation: Blocking Rule" data-content="<br /><%= formatted_violations @violation_messages[expense.id]['blocking'] %>"></i>
        <% end %>
        <% unless @violation_messages[expense.id]['warning'].blank? %>
            <i class="fa fa-shield" style="color: sandybrown;margin-top: 3px; margin-left: -22px;vertical-align: middle;margin-right: 30px; font-size: 20px" data-html="true" data-toggle="popover" title="Violation: Warning Rule" data-content="<br /><%= formatted_violations @violation_messages[expense.id]['warning'] %>"></i>
        <% end %>
    <% end %>

    <button style="border: none;
        font-size: 10px;
        width: 40%;
        margin-left: 10px;
        background: #93c178;
        color: white;" onclick="openEditableExpenseModal('<%= ej expense.id %>','<%= ej expense.merchant_name %>',
        '<%= ej expense.amount.precision_value %>','<%= ej expense.note %>','<%= ej expense.date.strftime("%d-%b-%y") %>',
        '<%= ej expense.date %>','<%= ej category_name %>','<%= ej expense.category_id %>',
        '<%= ej(expense.receipts.first.image) if expense.receipts.present? %>','<%= ej(expense.receipts.first.url) if expense.receipts.present? %>',
        '<%= formatted_violations @violation_messages[expense.id]['blocking'] if @policy %>',
        '<%= formatted_violations @violation_messages[expense.id]['warning'] if @policy %>')">VIEW

    </button>
    <%= expense.date.strftime("%d-%b-%y") %>
  </div>
  <div class="col-md-2"><%= expense.merchant_name %></div>
  <div class="col-md-3"><%= expense.note %></div>
  <div class="col-md-2"><%= "\u20B9#{expense.amount.value}" %></div>
  <div class="col-md-2" id="expenseRowsCollection" style="padding: 0">
    <% if @report.open? %>
        <%= render partial: 'approval', locals: {expense: expense} %>
    <% else %>
        <% if @report.approved? %>
            <button class="btn active"> Approved</button>
        <% elsif @report.rejected? %>
            <button class="btn inactive"> Rejected</button>
        <% end %>
    <% end %>

  </div>
</div>