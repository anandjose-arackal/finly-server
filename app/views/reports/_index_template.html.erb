<% provide(:title, current_user.name) %>
<% provide(:searchDiv,"reportPlaceholder" )%>

<body style="background-color: #f5f6f9">

<%= render 'shared/lower_header' %>

<form data-remote data-turboboost id="allReportsFilters" action="
<% if current_user.admin? %>
<%= admin_company_reports_path %>
<% else %>
<%= user_reports_path(current_user) %>
<% end %>
" method="get">
  <!-- applied filters -->
  <div id="showPreviousFilters" style="min-height: 20px;">
    <% param = get_old_filters(params, 2) # i.e get filters for expenses %>
    <% param.each do |item| %>
        <%= render partial: 'shared/applied_filter_item', locals: {item: item} %>
    <% end %>
  </div>
</form>

<div class="row" style="margin-top: 120px; padding-left: 20%; padding-right: 12.5%; margin-bottom: 40px">

  <div class="col-sm-8" style="border: 1px solid #d8d8d8;background-color: #CFE8DA">
    <div>
      <div id="headerTitle" style="background-color: #CFE8DA;border-bottom: 1px solid #d8d8d8; padding-top: 5px; padding-bottom: 5px">
      </div>
      <div style="background-color: white">

        <!--    <input type="checkbox" id="checkAll" style="float: left; margin-top: 20px">
    -->
        <div class="row" style="background-color: white;border-bottom: 2px solid #d8d8d8;">
          <% path = admin_company_users_path if is_admin_view %>
          <% path = admin_users_path if is_manager_view %>
          <form data-remote data-turboboost action="<%= path %>" method="get">
            <% params.each do |key, value| %>
                <% if key.start_with?('filter') && key != 'filter_search' %>
                    <input type="text" hidden="hidden" name="<%= key %>" value="<%= value %>">
                <% end %>
            <% end %>
            <!--<input form="filterForm" type="search" name="filter_search" placeholder="Filter by report name..." style="width: 250px;
                border-radius: 4px;
                border: 1px solid #d8d8d8;
                outline: none;
                padding: 6px 10px;
                margin: 10px 0px 10px 25px;
                font-size: 14px;
                background-position: 99% 50%;
                background-size: 32px;
                opacity: 0.5;" value="< %= params[:filter_search] if params[:filter_search] %>">-->
            <!--<input form="filterForm" type="submit" hidden="hidden"/>-->
          </form>
        </div>
      </div>
      <div id="my-posts">
        <%= yield :items %>
      </div>
      <div id="infinite-scrolling" style="display: none">
        <%= will_paginate @reports if @reports.present? %>
      </div>
    </div>

  </div>
  <div class="col-sm-4">
    <form data-remote data-turboboost action="<%= user_reports_path(current_user) %>" method="post">
      <input name="authenticity_token" value="<%= form_authenticity_token %>" hidden="hidden">
      <% if is_personal_view %>
          <button class="invite" type="submit">
            CREATE NEW REPORT
          </button>
      <% end %>
    </form>

    <div class="navblock" style=" <% unless is_personal_view %> margin-top: 0
      <% end %>">
      <p class="listHeaders">Date Submitted</p>

      <form data-remote data-turboboost id="filterForm" action="<%= request.path %>" method="get" style="background-color: white">
        <div style="padding: 16px 0 8px 16px;"><label style="font-weight: 400;margin-top: 3px">From</label>
          <input id="dateFrom" type="date" name="filter_date[from]" onchange="setDate(this)" value="<%= params[:filter_date][:from] if params[:filter_date] && params[:filter_date][:from] %>" style="font-size: 14px;float: right;border: 1px solid #d8d8d8;margin-right: 30px;color: #2E2F30;padding: 3px;background-color: beige;border-radius: 1px;line-height: normal !important;width: 60%;">
        </div>
        <div style="padding: 8px 0 16px 16px"><label style="font-weight: 400; margin-top: 3px">To</label>
          <input id="dateTo" type="date" name="filter_date[to]" value="<%= params[:filter_date][:to] if params[:filter_date] && params[:filter_date][:to] %>" onchange="setDate(this)" style="font-size: 14px;margin-right: 30px;border: 1px solid #d8d8d8;float: right;color: #2E2F30;padding: 3px;background-color: beige;border-radius: 1px;line-height: normal !important;width: 60%;">
        </div>
        <input id="filterStatus" type="text" hidden="hidden" name="filter_status" value="<%= params[:filter_status] if params[:filter_status] %>" style="font-size: 14px;margin-right: 30px;border: 1px solid #d8d8d8;float: right;color: #2E2F30;padding: 3px;background-color: white;border-radius: 1px;line-height: normal !important;width: 60%;">
      </form>
    </div>

    <div class="navblock">
      <p class="listHeaders">STATUS</p>

      <% if is_personal_view %>
          <div class="listOptions" id="unsubmittedReportsSelector" onclick="reloadPageWithStatus(0)"> Unsubmitted
            <span class="listOptionsNumbers"><%= @unsubmitted_count %></span>
          </div>
      <% end %>
      <div class="listOptions" id="submittedReportsSelector" onclick="reloadPageWithStatus(1)"> Submitted
        <span class="listOptionsNumbers"><%= @submitted_count %></span>
      </div>
      <div class="listOptions" id="approvedReportsSelector" onclick="reloadPageWithStatus(2)"> Approved
        <span class="listOptionsNumbers"><%= @approved_count %></span>
      </div>
      <div class="listOptions" id="rejectedReportsSelector" onclick="reloadPageWithStatus(3)"> Rejected
        <span class="listOptionsNumbers"><%= @rejected_count %></span>
      </div>
      <div class="listOptions" id="retractedReportsSelector" onclick="reloadPageWithStatus(4)"> Retracted
        <span class="listOptionsNumbers"><%= @retracted_count %></span>
      </div>
      <div class="listOptions" id="allReportsSelector" onclick="reloadPageWithStatus(null)"> All
        <span class="listOptionsNumbers"><%= @all_count %></span>
      </div>
    </div>

  </div>

</div>

</body>

<style>
  body {
    background-color: #f5f5f5;
  }

  .showFilteringSidebar{
    visibility: hidden;
  }

  #searchdiv{
    margin-left: 23% !important;
  }

  .newTransaction{
    display: none;
  }

  .dialogInputStyle {
    width: 80%;
    margin-left: 40px;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 14px;
    font-weight: 400;
    -webkit-font-smoothing: antialiased;
    border-radius: 1px;
    background-color: #fff;
    border: 1px solid #ddd;
    box-shadow: 0 1px 0px #eee inset;
    box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.075);
    vertical-align: middle;
    color: #444;
    line-height: 20px;
    padding: 16px;
  }

  .roundCircle {
    display: block;
    height: 50px;
    width: 50px;
    line-height: 50px;

    -moz-border-radius: 30px;
    border-radius: 60px;

    background-color: #9EACC9;
    color: white;
    text-align: center;
    font-size: 1em;
  }

  .listOptionsNumbers {
    float: right;
    color: #aaa;
  }

  .navblock {
    margin-top: 20px;
    border: 1px solid #d8d8d8;
  }

  .listOptions {
    background-color: #fff;
    border-top: 1px solid #e5e5e5;
    margin-top: -1px;
    padding: 10px 16px;
    cursor: pointer;
    position: relative;
    zoom: 1;
  }

  .listHeaders {
    height: 100%;
    background-color: #CFE8DA;
    padding: 10px 16px;
    border-bottom: 1px solid #d8d8d8;
    font-size: 14px;
    font-family: 'Roboto Condensed', 'Helvetica Neue', Helvetica, sans-serif;
    text-transform: uppercase;
    font-weight: 400;
    color: #777;
    margin: 0;
  }

  .show {
    display: block;
  }

  .sendButton {

    display: inline-block;
    margin-bottom: 20px;
    margin-left: 40px;
    color: white;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 500;
    height: 45px;
    text-align: center;
    -ms-touch-action: manipulation;
    touch-action: manipulation;
    cursor: pointer;
    resize: vertical;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    border: 1px solid transparent;
    border-radius: 3px;
    -webkit-transition: all 0.15s ease-in-out;
    -moz-transition: all 0.15s ease-in-out;
    -o-transition: all 0.15s ease-in-out;
    -moz-transition: all 0.15s ease-in-out;
    -webkit-transition: all 0.15s ease-in-out;
    transition: all 0.15s ease-in-out;
    -moz-user-select: none;
    -webkit-user-select: none;
    user-select: none;
    background-color: #93c178;

  }

  .invite {
    background-color: #93c178;
    display: block;
    width: 100%;
    display: inline-block;
    padding: 10px 16px;
    margin-bottom: 0;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 500;
    text-align: center;
    vertical-align: middle;
    -ms-touch-action: manipulation;
    touch-action: manipulation;
    cursor: pointer;
    color: white;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    border: 1px solid transparent;
    border-radius: 1px;
  }

  .dropdown-content {
    display: none;
    position: absolute;
    background-color: #f9f9f9;
    min-width: 140px;
    box-shadow: 0px 8px 16px 0px rgba(0, 0, 0, 0.2);
  }

  .dropdown-content a {
    color: black;
    padding: 12px 16px;
    text-decoration: none;
    display: block;
  }

  .editProfileDialogHeaders {
    font-size: 14px;
    font-family: 'Roboto Condensed', 'Helvetica Neue', Helvetica, sans-serif;
    text-transform: uppercase;
    font-weight: 400;
    padding: 20px 0 5px 40px;
    color: #777;
  }

  .spanEditProfile {
    color: #a0a0a0;
    text-transform: lowercase;
    font-size: 10px;
    font-weight: 300;
  }


</style>

<script>

  $(document).ready(function () {

    <% if  params[:filter_status] == "0"%>
    $('#unsubmittedReportsSelector').css("background", "#FFFFBB")
    $('#headerTitle').text('UNSUBMITTED');
    <% elsif   params[:filter_status] == "1"%>
    $('#submittedReportsSelector').css("background", "#FFFFBB")
    $('#headerTitle').text('SUBMITTED');
    <% elsif   params[:filter_status] == "2"%>
    $('#closedReportsSelector').css("background", "#FFFFBB")
    $('#headerTitle').text('CLOSED');
    <% elsif   params[:filter_status] == "3"%>
    $('#reopenedReportsSelector').css("background", "#FFFFBB")
    $('#headerTitle').text('REOPENED');
    <% else %>
    $('#headerTitle').text('ALL');
    $('#allReportsSelector').css("background", "#FFFFBB")
    <% end %>


  });


  function showList() {
    document.getElementById("myDropdown").classList.toggle("show");
  }

  function setDate(element) {
    if (element == null)
      return;
    var val = element.valueAsDate;
    if (val == null) {
      $('form#filterForm').submit();
      return;
    }
    var day = val.getDate();
    var month = val.getMonth();
    var year = val.getFullYear();
    console.log("date : " + day + " - " + month + " - " + year);
    if (day != null && month != null && year != null) {
      $('form#filterForm').submit();
    }
  }

  function reloadPageWithStatus(id) {
    $('#filterStatus').val(id);
    $('form#filterForm').submit();
  }

  function loadNewReport() {
    Turbolinks.visit("<%= new_user_report_path(current_user) %>")
  }

  function closeFilter(id) {
    var div = $('#' + id);
    div.attr('form', "");
    div.remove();
    $('#allReportsFilters').submit()
  }


</script>
