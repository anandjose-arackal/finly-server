<% content_for :body do %>
    <head>
      <title>Reminder - Payment for <%=@payload[:biller_name] %> is due</title>
    </head>
    <body style="background-color: #f3f3f3; margin: 0px;height: auto;">
    <br/>Dear Sir/Mam,<br/><br/>
    This is a reminder that the payment for your
    <STRONG> <%=@payload[:biller_name] %> </STRONG> bill is due on <STRONG> <%=@payload[:due_date] %> </STRONG>. <br/>
    Below are the additional Details of the bill:<br/>

    <ul>
      <% unless @payload[:category].nil? %>
        <li>Bill type : <%= @payload[:category] %> </li>
      <% end %>
      <li>Operator/Vendor : <%= @payload[:biller_name] %> </li>
      <li>Bill amount : <%= @payload[:amount] %> </li>
      <!-- <li>Invoice No: (Invoice No as per invoice) </li> -->
      <li>Department : <%= @payload[:department] %> </li>
      <li>Cost Center : <%= @payload[:cost_center] %> </li>
      <% unless @payload[:location]nil? %>
        <li>Location: <%= @payload[:location] %> </li>
      <% end %>
    </ul><br/>
    Click here for more Details. <br/><br/>

    If you have already submitted your payment, please disregard this reminder.<br/><br/>

    Thanks,<br/>
    Team Finly<br/>
    </body>
<% end %>

<%= render 'application_mailer/template' %>