<div class="banner-wrapper" style="position: relative;">
  <% if Rails.env.production? %>
    <img src="/common/images/mailers/background/<%= payload["hero_bg_image"] %>.png" style="width: 100%;">
  <% else %>
    <img src="http://localhost:3001/common/images/mailers/backgrounds/<%= payload["hero_bg_image"] %>.png" style="width: 100%;height: 100%;">
  <% end %>
  <div class="banner-details" style="position: absolute;top: 85px;width: calc(100% - 30px);padding: 0 15px;margin: 0 auto;">
    <span class="main-header" style="display: block;text-align: center;font-size: 28px;font-weight: 600;width: 100%;color: white;padding: 15px 0;"><%= payload["title"] %></span>
    <% if payload["sub_header"].present? %>
      <span class="sub-header" style="display: block;text-align: center;font-size: 17px;font-weight: 600;width: 100%;color: antiquewhite;"><%= payload["sub_header"] %></span>
    <% end %>
  </div>
</div>