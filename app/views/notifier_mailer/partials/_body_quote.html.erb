<% if payload["body_quote_text"].present? %>
  <fieldset style="margin: 0px 70px 40px;border: 2px solid #E74C3C;border-radius: 8px;">

    <legend align="center" style="padding: 10px;">
      <% if Rails.env.development? %>
        <% if payload["body_quote_icon"].present? %>
          <img src="http://localhost:3001/common/images/mailers/icons/<%= payload["body_quote_icon"] %>.png" style="width: 40px;">
        <% else %>
          <img src="http://localhost:3001/common/images/mailers/icons/icon_quote_rejection.png" style="width: 40px">
        <% end %>
      <% elsif Rails.env.staging? %>
        <% if payload["body_quote_icon"].present? %>
          <img src="
            <% ActionMailer::Base.default_url_options[:host] %>/system/common/images/mailers/icons/<%= payload["body_quote_icon"] %>.png" style="width: 40px;">
        <% else %>
          <img src="
            <% ActionMailer::Base.default_url_options[:host] %>/system/common/images/mailers/icons/icon_quote_rejection.png" style="width: 40px">
        <% end %>
      <% else %>
        <% if payload["body_quote_icon"].present? %>
          <img src="https://www.finly.io/common/images/mailers/icons/<%= payload["body_quote_icon"] %>.png" style="width: 40px;">
        <% else %>
          <img src="https://www.finly.io/common/images/mailers/icons/icon_quote_rejection.png" style="width: 40px;">
        <% end %>
      <% end %>
    </legend>

    <p style="margin: 0;padding: 0 20px 26px;">
      <%= payload["body_quote_text"] %>
    </p>

    <% if payload["body_quote_by"].present? %>
      <div style="font-weight: bold; text-align: center;margin-bottom: 15px;">
        <%= payload["body_quote_by"] %>
      </div>
    <% end %>
  </fieldset>
<% end %>