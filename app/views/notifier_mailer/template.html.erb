<div class="wrapper-main">
  <div class="mail-container">
    <div class="section-header">
      <img src="./images/company_logo.png" width="100" height="auto"/>
      <a href="https://www.finly.io/login">Login</a>
    </div>
    <div class="section-body">

      <!--
        Common Banner on the Basis of IF-ElSE condition
       -->
      <div class="banner-wrapper">
        <img src="./images/BG/Report_Rejected.png"/>
        <div class="banner-details">
          <span class="main-header"><%= @payload["title"] %></span>
          <% if @payload["sub_header"].present? %>
            <span class="sub-header"><%= @payload["sub_header"] %></span>
          <% end %>
        </div>
      </div>
      <!-- END -->

      <!-- Message Body FOR "EXPENSE REPORTS" -->
      <div class="mailer-details-wrapper">
        <div class="user-message">
          <div class="header">
            <span class="circle"></span>
            <span class="user-name">Vivek AG</span>
          </div>
          <div class="body">
            Lorem ipsum, dolor sit amet consectetur adipisicing elit. Sequi ex laboriosam impedit eligendi distinctio
            voluptatem libero harum nobis odit tempore consequuntur, ipsum, culpa, autem neque fugit adipisci voluptas
            perspiciatis maiores.
            Lorem ipsum dolor sit amet consectetur, adipisicing elit. Accusamus expedita mollitia nobis dolores nisi
            suscipit consequuntur praesentium nesciunt consectetur autem eaque consequatur cumque, nemo adipisci minima
            quasi sed earum architecto.
          </div>
        </div>

        <% if @payload["tables"].present? %>
          <% @payload["tables"].each_with_index do |table, index| %>
            <div class="items-list">
              <% if table["header"].present? %>
                <div class="items-list-header">
                  <span class="list-item-count">3 Expenses</span>
                  <span class="list-item-total">Total : 15,829</span>
                </div>
              <% end %>

              <% if table["content"].present? %>
                <table class="table-items-list">
                  <% if table["content"]["thead"].present? %>
                    <thead>
                    <tr>
                      <% table["content"]["thead"].each do |header| %>
                        <th><%= header %></th>
                      <% end %>
                    </tr>
                    </thead>
                  <% end %>

                  <% if table["content"]["tbody"].present? && table["content"]["tbody"].is_a?(Array) %>
                    <tbody>
                    <% table["content"]["tbody"].each do |tr| %>
                      <tr>
                        <% tr.each do |cell| %>
                          <td><%= cell %></td>
                        <% end %>
                      </tr>
                    <% end %>
                    </tbody>
                  <% end %>
                </table>
              <% end %>
            </div>
            <div class="divider"></div>
          <% end %>
        <% end %>
        <% if @payload["actions"].present? %>
          <div class="redirect-section actions">
            <% @payload["actions"].each do |action| %>
              <a href="<%= action.href %>" class="button"><%= action.title %></a>
            <% end %>
          </div>
        <% end %>
      </div>
      <!-- END -->
    </div>
    <div class="section-footer">
      <span class="footer-item">Thanks!<br/>Team Finly.</span>
      <span class="footer-item">Spend Management for Businesses.</span>
      <span class="footer-item">Download App : <a href="#">iOS</a><a href="#">Android</a></span>
    </div>
  </div>
</div>
