<div class="section-card">
  <div class="row no-margin section-header" style="margin-bottom: 15px;">
    <div class="col-sm-12">
      <h4>Categories</h4>
    </div>
  </div>

  <div class="row no-margin">
    
    <div class="col-sm-12">
     <% @result.categories.each do |category| %>
      <div class="row" style="padding-left: 20px; padding-right: 10px">
        <div class="col-md-11" style="font-size: 12px; font-weight: 500">
          <%= category.name %>
        </div>
        <i class="fa fa-close btn-delete-category" data-url="<%= category_path(category) %>"></i>
      </div>

      <hr style="margin-top: 10px; margin-bottom: 10px;">
    <% end %> 
    </div>

    <div class="col-sm-12" style="background: #F6F7FC; border-radius: 0 0 4px 4px; padding-bottom: 20px;">
      
      <form id="form-add-category" action="<%= categories_path %>" style="margin-top: 30px;">
        <input name="authenticity_token" value="<%= form_authenticity_token %>" type="hidden">
        <input type="text" class="form-control" name="category[name]" id="newCategory" placeholder="Add new category name" style="display: inline-block;width: 35%; border-radius: 1px">
        <button class="green-button btn-add-category" id="add_new_category" style="margin-left: 80px;height: 30px; line-height: 30px" type="submit">
          ADD NEW CATEGORY
        </button>
      </form> 
    </div>
  </div>
</div>

