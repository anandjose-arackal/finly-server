<div style="margin-top: 20px;background: white;
    padding: 15px;border: 1px solid #d8d8d8; width: 650px;float: left">
  <p style="font-size: 24px;
      font-weight: 600;
      font-family: 'Roboto Condensed', 'Helvetica Neue', Helvetica, sans-serif;">Company Policy List</p>

  <hr>

  <% unless @result.policies.present? %>
      <div>
        <p> No Policies to Display.</p>
      </div>
  <% end %>


  <div id="policyListTable">
    <ul style="list-style-type: none; padding-left: 0;">
      <% @result.policies.each do |policy| %>
        <li class="policy">
          <div class="row no-margin">
            <div class="col-sm-8" style="font-size: 21px;line-height: 42px;">
              <%= link_to policy.name, policy_path(id: policy.id, view: params[:view]) %>
            </div>
            <div class="col-sm-3">
              <a id="showReportsButton" class="btn btn-primary btn-md" href="<%= root_path + '#reports/params={"filter_policy":"' + policy.id.to_s + '", "view": "admin"}'%>">View Reports</a>
            </div>
            <div class="col-sm-1">
              <%= form_for(policy, :html => { :method => :delete, :remote => true }) do |f| %>
                <%= button_tag( :class => "btn btn-sm btn-danger") do %>
                  <i class="fa fa-trash-o" role="button"></i>
                <% end %>
              <% end %>  
            </div>
            
          </div>
        </li>
      <% end %>  
    </ul>
  </div>


</div>
<div style="margin: 20px 0px 0px 680px;background: white;
    padding: 15px;border: 1px solid #d8d8d8; width: 270px; position: fixed">
  <p style="font-size: 24px;
      font-weight: 600;
      font-family: 'Roboto Condensed', 'Helvetica Neue', Helvetica, sans-serif;">Add new policy</p>
  <hr>
  <form data-turboboost id="policyCreate"  action="<%= policies_path(view: 'admin') %>" method="post" data-remote="true">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

    <input type="text" id="policyName" name="name" style="height: 40px;
        padding: 10px;" placeholder="Enter name of policy">

    <!--<p style="margin-top: 20px; font-family: 'Roboto Condensed', 'Helvetica Neue', Helvetica, sans-serif;">Policy-->
      <!--applied to: </p>-->
    <!--<input type="radio" name="users" value="everyone" checked> Everyone <br>-->
    <!--<input type="radio" name="users" value=""> Invite Employees Later <br>-->

    <input type="submit" class="abaButton" onclick="return validate()" style="border-radius: 1px;margin-top: 20px;margin-left: 0px" id="createPolicy" value="Create">
  </form>
</div>

<script>

  function validate(){
    var x;
    x = document.getElementById("policyName").value.trim();
    if (x == "") {
      alert("Enter a Policy Name");
      return false;
    }
  }

  function getPolicyReportsPath(policyId) {

    path = '/admin/company/reports?filter_policy_id=' + policyId;

    return path;

  }

</script>

<style type="text/css">
  .policy{
    margin-bottom: 10px;
    border: 1px solid #efefef;
    padding: 10px;
    padding-right: 20px;
    background: honeydew;
  }

  .policy:hover{
    /*box-shadow: 0px 0 6px -1px rgba(0, 0, 0, 0.5);*/
  }
</style>

