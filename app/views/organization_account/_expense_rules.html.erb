<button id="createNewRule" data-toggle="modal" data-target="#createNewRuleModal">Create New Rule
</button>
<div>

  <div id="warningDiv">
    <div class="header">
      <img src="<%= image_url("warn_rule") %>">WARNING RULES
    </div>

    <div style="padding: 20px 20px 0 20px">

      <!-- < % @policy.rules.each do |rule| %>
           < % if rule.rule_type == 'warning' %>-->
      <p>This is the rule</p>
      <!-- < % end %>
   < % end %>-->
      <p id="warningPara" onclick="warningDescToggle()" style="color: #6664c7;
          font-weight: 500;
          font-size: 13px;
          border-top: 1px solid rgba(0,0,0,0.1);
          cursor: pointer;
          padding-top: 10px ;"> What is a warning rule?</p>
      <p id="warningParaDesc" style="color: #666;
          font-size: 13px;
          padding-top: 6px ;display: none">Expenses that violate warning rules can be added to the report, but you
        probably
        shouldn’t.
        Before you submit the report
        Finly will display the warnings, and the expense will be badged with a warning icon.</p>
    </div>
  </div>
  <div id="blockingDiv" style="float: right">
    <div class="header">
      <img src="<%= image_url("block_rule") %>">BLOCKING RULES
    </div>
    <div style="padding: 20px 20px 0 20px">

      <!--  < % @policy.rules.each do |rule| %>
            < % if rule.rule_type == 'blocking' %>
      --> <p>This is the rule</p>
      <!-- < % end %>
   < % end %>-->

      <p id="blockingPara" onclick="blockingDescToggle()" style="color: #6664c7;
          font-weight: 500;
          font-size: 13px;
          border-top: 1px solid rgba(0,0,0,0.1);
          cursor: pointer;
          padding-top: 10px; "> What is a blocking rule?</p>

      <p id="blockingParaDesc" style="color: #666;
          font-size: 13px;
          padding-top: 6px ;display: none">You can’t submit reports with expenses that violate blocking rules. The
        blocks will be displayed in the report.</p>
    </div>
  </div>


</div>


<div class="modal fade" id="createNewRuleModal" role="dialog">
  <div class="modal-dialog modal-md">
    <div class="modal-content" style="border-radius: 1px">
      <div class="modal-header" style="background-color: #e9e9e9 ">

        <button type="button" class="close" style="opacity: 0.7" data-dismiss="modal">&times;</button>
        <h4 class="modal-title" style="text-align: center;text-transform: uppercase;font-weight: 400;border-bottom: #d8d8d8">Add
          New Rule for this Policy</h4>
      </div>
      <div class="modal-body" style="padding: 0 35px 35px 35px">

        <form data-remote="true" data-turboboost name="submitNewRuleForm"  action="<%= policy_add_rule_path %>" method="post">
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
          
          <input type="radio" name="rule[name]" target="newRuleAfterDays" value="require_receipt" checked>Require
          Receipt
          <br>
          <input type="radio" name="rule[name]" target="newRuleAfterDays" value="require_note">Require Note<br>
          <input type="radio" name="rule[name]" target="newRulePeriod" value="budget">Set Budget<br>
          <input type="radio" name="rule[name]" target="newRuleAfterDays" value="disallow_expense">Disallow Expense


          <h5>For the Category</h5>

          <div id="categoriesOthers">
            <input type="radio" name="rule[category_id]" value="">All <br>
            <!--    < % @categories.each do |cat| %>
                    <input type="radio" name="rule[category_id]" value="< %= cat.id %>">< %= cat.name %> <br>
                < % end %>-->
          </div>

          <div id="categoriesBudget" style="display:none">
            <input type="radio">Total <br>
            <!-- < % @categories.each do |cat| %>
                 <input type="radio" name="rule[category_id]" value="< %= cat.id %>">< %= cat.name %> <br>
             < % end %>-->
          </div>

          <h5 id="amountValueOthers">If the Expense Amount is... <span>[OPTIONAL]</span></h5>

          <h5 id="amountValueBudget" style="display:none">Budget Amount is... <span>[OPTIONAL]</span></h5>

          <select class="selectors" name="rule[amount_bound]">
            <option value="">Select ...</option>
            <option value="lteq">Lesser than</option>
            <option value="gteq">Greater than</option>
            <option value="eq">Equal to</option>
          </select>

          <input name="rule[amount]" type="text" placeholder="0.00">


          <div id="newRulePeriod" style="display: none">
            <h5>Per... <span>[OPTIONAL]</span></h5>
            <input type="radio" name="rule[period]" value="day">Day <br>
            <input type="radio" name="rule[period]" value="week">Week<br>
            <input type="radio" name="rule[period]" value="month">Month<br>
            <input type="radio" name="rule[period]" value="year">Year<br>
          </div>

          <div id="newRuleAfterDays">
            <h5>Submitted after... <span>[OPTIONAL]</span></h5>
            <input name="rule[days_after]" type="text" placeholder="0" style="margin-left: 25px">
            <span>day/s of the expense.</span>
          </div>

          <div id="newRuleBeforeDays" style="display: none">
            <h5>Submitted within... <span>[OPTIONAL]</span></h5>
            <input name="rule[days_before]" type="text" placeholder="0" style="margin-left: 25px">
            <span>day/s of the expense.</span>
          </div>

          <div id="newRuleTypeChooser" style="display:block">
            <h5>Block or Warning? </h5>
            <input type="radio" name="rule[rule_type]" value="blocking" checked>Blocking <br>
            <input type="radio" name="rule[rule_type]" value="warning">Warning<br>
          </div>

          <button type="submit" id="createPolicy"> Create</button>

        </form>
      </div>
    </div>
  </div>
</div>


<script>

  $(document).ready(function () {
    $('form#usersPolicyList').submit();
  });

  function warningDescToggle() {
    $('#warningParaDesc').toggle();
  }

  function blockingDescToggle() {
    $('#blockingParaDesc').toggle();
  }

  function autoApprovalDescToggle() {
    $('#autoApprovalParaDesc').toggle();

  }

  function checkIfUsersAreSelected() {
    if ($("input:checkbox:checked").length > 0) {
    }
    else {
      $('#removePolicyMembersAlert').modal('show');

    }
  }

</script>
