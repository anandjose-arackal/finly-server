
<div id="exportPreferencesDiv">


<p>Please choose the format of the csv, and the respective column names you want to export.</p>

<hr style="margin-top: 20px">


  <input type="checkbox" name="serial_no" value="1"

  > Include serial number in Export<br>

  <hr style="margin-top: 20px">


<% @export_preferences.each_with_index do |export_preference, index| %>

<form data-remote data-turboboost id="exportPreferences<%=export_preference.id%>" method="post" action="<%= update_export_preference_path(export_preference)%>">

 <input name="authenticity_token" value="<%= form_authenticity_token %>" type="hidden">
 <input name="_method" type="hidden" value="patch">

  <p> Column <%= index + 1 %>: </p>
  <span>Export</span>
  <select class="selectors" name="export[export_field_id]">
    <% @export_fields.each do |export_field| %>
        <option value="<%= export_field.id %>"
        <% if export_preference.export_field_id == export_field.id %>
        selected
        <% end %>
        ><%= export_field.name %></option>
    <% end %>
  </select>
  <span> as </span>


  <span style="margin-left: 15px;
      font-size: 14px;
      background-color: white;
      padding: 5px;
      font-variant: small-caps;
      font-weight: 500;
  " class="exportColumnValue"><input type="text" name="export[name]" class="exportNameInput" placeholder="Column Name" value="<%= export_preference.name %>">
  </span>

</form>

  <i class="fa fa-trash-o" onclick="$('#deleteExportField<%=export_preference.id%>').submit();" style="color: indianred; margin-left: 80px"></i>
  <hr>

  <form data-remote data-turboboost id="deleteExportField<%=export_preference.id%>" action="<%=delete_export_field_path%>" method="post">
    <input name="authenticity_token" value="<%= form_authenticity_token %>" type="hidden">
    <input name="_method" type="hidden" value="delete">
    <input name="export_field_id" value="<%=export_preference.id%>" type="hidden">
  </form>

  <button class="green-button" style="width: 80px;
      padding: 5px;
      margin-bottom: 40px;" id="saveExportConfig" form="exportPreferences<%=export_preference.id%>" type="submit"> SAVE
  </button>



<% end %>


  <div style="background-color: lavender;
      padding: 15px;">
    <form data-remote data-turboboost method="post" action="<%= add_export_field_path%>" style="margin-bottom: 30px">
      <input name="authenticity_token" value="<%= %>" type="hidden">

      <span>Export</span>
      <select class="selectors" name="export[export_field_id]">
      <option style="display:none" value="" selected="selected"></option>
        <% @export_fields.each do |export_field| %>
             <option value="<%= export_field.id %>"><%= export_field.name %></option>
        <% end %>
      </select>
      <span> as </span>
      <input type="text" name="export[name]" class="exportNameInput" placeholder="Column Name" >

      <button class="green-button" id="addNewColumn" type="submit" style="margin-left: 70px;
          padding: 7px 10px 7px 10px;" onclick="setHeight()"> ADD NEW COLUMN
      </button>
    </form>


  </div>

</div>