<div id="policyMembersDiv">

  <button data-toggle="modal" data-target="#inviteUsersToPolicy">Invite Employees
  </button>

  <button style="margin-left: 10px" data-toggle="modal" data-target="#assignExistingUsersToPolicy">Assign Employees to
    Policy
  </button>

  <button id="removeEmployees" style=" background-color: #df524e;margin-left: 10px" onclick="removeUsersFromPolicyList()">Remove
  </button>

  <label>Show: </label>

  <ul id="people_filter_type" class="segmented-control">
    <li data-value="all" class="activeMembers">All</li>
    <li data-value="approvers" class="">Approvers</li>
    <li data-value="admins" class="">Policy Admins</li>
  </ul>
