<div class="container">
  <div class="row no-margin">
    <div class="col-sm-6 col-sm-offset-3 main">
      <form>
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

        <div class="form-group">
          <label class="control-label" style="display: block;">Mobile Number</label>
          <input id="user_mobile_number" class="form-control otp" type="number" name="user[mobile_number]" style="width: 50%;" value="<%= current_user.mobile_number %>">
          <button class="btn btn-warning edit-mobile-number">Edit&nbsp;&nbsp;<i class="fa fa-edit"></i></button>
        </div>

        <div class="verification" disabled="disabled">
          <div class="form-group">
            <label class="control-label" style="display: block;">One Time Password:</label>
            <input id="user_otp" class="form-control otp" type="number" name="otp" style="width: 50%;">
            <button class="btn btn-default resend-otp" disabled="disabled">Resend OTP In: <span>00:00</span></button>
          </div>

          <div class="form-group text-center">
            <button class="btn btn-primary btn-verify">Verify</button>
          </div>  

        </div>
        

      </form>
    </div>
  </div>
</div>

<style type="text/css">
  .main{
    background: white;
    padding-top: 20px;

  }

  input.otp{
    display: inline;
    width: 50%;
    height: 45px;
    font-size: 25px;
    margin-top: 6px;
  }

  .resend-otp, .edit-mobile-number, .btn-verify, .update-mobile-number{
    width: 200px;
    margin-top: 0;
    height: 45px;
    margin-left: 36px;
    margin-bottom: 9px;
  }

  .edit-mobile-number{
    /*width: 60px;*/
  }


</style>

<script type="text/javascript">
  $(document).ready(function(){

    Timer = {
      initialize: function(){
        this.button = $(".resend-otp");
        this.time = 10;
        this.startTimer();
      },
      

      startTimer: function(){
        $(this.button).html("Resend OTP In: <span>00:00</span>").removeClass("btn-success").addClass('btn-default')
        _this = this;
        this.time = 60;
        this.timer = setInterval(function(){
          $(_this.button).attr('disabled', 'disabled');
          // console.log("Time is", _this.time);
          if(_this.time === 0){
            _this.showResend();
          }
          if(_this.time.toString().length == 1){
            $(_this.button).find('span').text("00:0" + _this.time.toString());
          } else {
            $(_this.button).find('span').text("00:" + _this.time.toString());
          }
          _this.time = _this.time - 1;
        }, 1000);
      },



      showResend: function(){
        _this = this;
        $(_this.button).attr('disabled', false).html("Resend OTP").addClass('btn-success');
        clearInterval(_this.timer);
      },

      disableVerification: function(){
        // $("")
      }
    }

    Timer.initialize();

    $(".resend-otp").on('click', function(e){
      e.preventDefault();
      $.ajax({
        url: "<%= resend_otp_path %>",
        dataType: "JSON",
        type: "POST",
        data: {
          authenticity_token: $("#authenticity_token").val()
        },
        success: function(res){
          console.log("Success", res);
          Timer.startTimer();

        },
        error: function(err){
          console.log("Error", err)
        }
      })
    });

    $(".btn-verify").on('click', function(e){
      e.preventDefault();
      $.ajax({
        url: "<%= verify_otp_path %>",
        type: "POST",
        dataType: "json",
        data: {
          authenticity_token: $("#authenticity_token").val(),
          verification_code: $("#user_otp").val()
        },
        success: function(res){
          console.log("Success", res);
          if(res.success === true){
            window.location = window.location.protocol + '//' + window.location.host;
          } else {
            console.log("Error");
          }
        },
        error: function(err){
          console.log("Err", err);
        }
      })
    })
    

    $(".edit-mobile-number").on('click', function(e){
      e.preventDefault();
      target = e.currentTarget;
      $(target).html("Update&nbsp;&nbsp;<i class='fa fa-check-circle'></i>").removeClass("edit-mobile-number btn-warning").addClass("update-mobile-number btn-success");
      $(target).closest('.form-group').find('input').attr('readonly', false);
      $(this).unbind();
      attachUpdateEvents();
    });

    function attachUpdateEvents(){
      $(".update-mobile-number").on('click', function(e){
        e.preventDefault();
        target = e.currentTarget;
        mobile_number = $("#user_mobile_number").val();

        $.ajax({
          url: '<%= update_mobile_number_path %>',
          dataType: 'json',
          type: "POST",
          data: {
            authenticity_token: $("#authenticity_token").val(),
            user: {
              mobile_number: mobile_number
            }
          },
          success: function(res){
            console.log("Success", res);
            if(res.success === true){
              console.log("Success is tru")
              // new_mobile_number = res.mobile_number
              window.location.reload()
            }
          },
          error: function(err){
            console.log("Error", err);
          }
        })

      });
    }

    
  });
</script>