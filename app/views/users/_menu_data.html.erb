<div style="display: none;">
  <input type="hidden" id="current_user_id" value="<%= current_user.id %>" data-user-name="<%= current_user.name %>" data-user-email="<%= current_user.email %>">
  <input type="hidden" id="d_code_assigned" value="<%= current_user.company.feature_subscription.d_code_assigned ? 1 : 0 %>" %>">

  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  <input name="utf8" id="form_utf8" type="hidden" value="&#x2713;"/>
  <input type="hidden" id="data-nav-company" value="<%= current_company.name %>">
  <input type="hidden" id="company_logo" value="<%= current_company.configuration.logo.url(:thumb) %>">

  <ul id="menu-nav-views-dropdown">
    <% if current_user.admin? %>
      <li><a href='#reports/params={"view":"admin"}' class="navbar-view-type" data-view-type="admin">Admin View</a></li>
    <% end %>
    <% if current_user.finance_manager? %>
      <li><a href='#reports/params={"view":"finance_manager"}' class="navbar-view-type" data-view-type="finance_manager">Finance View</a></li>
    <% end %>
    <% if current_user.manager? %>
      <li><a href='#reports/params={"view":"manager"}' class="navbar-view-type" data-view-type="manager">Manager View</a></li>
    <% end %>
    <% if current_user.employee? %>
      <li><a href="#" class="navbar-view-type" data-view-type="personal">Personal View</a></li>
    <% end %>
  </ul>

  <% views = YamlUtils.load_yaml_erb "#{Rails.root}/config/data/view_wise_data.yml.erb", current_user: current_user, current_company: current_company %>
  <ul id="navbar-cog-navigation-admin">
    <% if current_user.admin? %>
      <% views["admin"]["links"]["cog"].each do |item| %>
        <% item.select do |key, value| %>
          <% if value == '#settings' %>
            <li><a class="btn btn-primary btn-block navbar-menu-li non-backbone-link" data-path="<%= value %>" href="<%= value %>" data-profile="true"><%= key %></a></li>
          <% elsif value =~ /organization_account/i || value =~ /faq/i || value =~ /statement/i %>
            <li><a class="btn btn-default btn-block navbar-menu-li non-backbone-link" data-path="<%= value %>" href="<%= value %>"><%= key %></a></li>
          <% else %>
            <li><a target="_blank" class="btn btn-default btn-block navbar-menu-li non-backbone-link" data-path="<%= value %>" href="<%= value %>"><%= key %></a></li>
          <% end %>
        <% end %>
      <% end %>
    <% elsif current_user.finance_manager? %>
      <% views["finance_manager"]["links"]["cog"].each do |item| %>
        <% item.select do |key, value| %>
          <% if value == '#settings' %>
            <li><a class="btn btn-primary btn-block navbar-menu-li non-backbone-link" data-path="<%= value %>" href="<%= value %>" data-profile="true"><%= key %></a></li>
          <% else %>
            <li><a target="_blank" class="btn btn-default btn-block navbar-menu-li non-backbone-link" data-path="<%= value %>" href="<%= value %>"><%= key %></a></li>
          <% end %>
        <% end %>
      <% end %>
    <% elsif current_user.manager? %>
      <% views["manager"]["links"]["cog"].each do |item| %>
        <% item.select do |key, value| %>
          <% if value == '#settings' %>
            <li><a class="btn btn-primary btn-block navbar-menu-li non-backbone-link" data-path="<%= value %>" href="<%= value %>" data-profile="true"><%= key %></a></li>
          <% else %>
            <li><a target="_blank" class="btn btn-default btn-block navbar-menu-li non-backbone-link" data-path="<%= value %>" href="<%= value %>"><%= key %></a></li>
          <% end %>
        <% end %>
      <% end %>
    <% elsif current_user.employee? %>
      <% views["personal"]["links"]["cog"].each do |item| %>
        <% item.select do |key, value| %>
          <% if value == '#settings' %>
            <li><a class="btn btn-primary btn-block navbar-menu-li non-backbone-link" data-path="<%= value %>" href="<%= value %>" data-profile="true"><%= key %></a></li>
          <% else %>
            <li><a target="_blank" class="btn btn-default btn-block navbar-menu-li non-backbone-link" data-path="<%= value %>" href="<%= value %>"><%= key %></a></li>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </ul>

  <ul id="navbar-menu-navigation-admin">
    <% if current_user.admin?%>
      <% views["admin"]["links"]["primary_navbar"].each do |item| %>
        <% item.select do |key, value| %>
          <li><a class="navbar-menu-li line-break-links text-center" data-path="<%= value %>" href='#<%= value %>/params={"view":"admin"}'><%= raw key %></a></li>
        <% end %>
      <% end %>
    <% end %>
  </ul>

  <ul id="navbar-menu-navigation-personal">
    <% if current_user.employee? %>
      <% views["personal"]["links"]["primary_navbar"].each do |item| %>
        <% item.select do |key, value| %>
          <% unless value == 'settlements' %>
            <li><a class="navbar-menu-li" data-path="<%= value %>"  href='#<%= value %>/params={"view":"personal"}'><%= key %></a></li>
          <% else %>
            <li><a class="navbar-menu-li" data-path="<%= value + '/' + current_user.id.to_s %>"  href='#<%= value + "/" + current_user.id.to_s %>'><%= key %></a></li>
          <% end %>
        <% end %>
      <% end %>
    <% end %>   
  </ul>

  <ul id="navbar-menu-navigation-manager">
    <% if current_user.manager? %>
      <% views["manager"]["links"]["primary_navbar"].each do |item| %>
        <% item.select do |key, value| %>
          <li><a class="navbar-menu-li line-break-links text-center" data-path="<%= value %>" href='#<%= value %>/params={"view":"manager"}'><%= raw key %></a></li>
        <% end %>
      <% end %>
    <% end %>   
  </ul>

  <ul id="navbar-menu-navigation-finance">
    <% if current_user.finance_manager? %>
      <% views["finance_manager"]["links"]["primary_navbar"].each do |item| %>
        <% item.select do |key, value| %>
          <li><a class="navbar-menu-li line-break-links text-center" data-path="<%= value %>" href='#<%= value %>/params={"view":"finance_manager"}'><%= raw key %></a></li>
        <% end %>
      <% end %>
    <% end %>   
  </ul>
</div>