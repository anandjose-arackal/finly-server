<div id="employeeDetailsDiv">
  <ul class="innerul">
    <li class="modalListHeader"><%= @user.name %>
    </li>
    <li class="active" data-switch="#user_info"><a href="#" data-turbolinks="false">User's Info
      <i class="fa fa-angle-right fa-fw arrow " aria-hidden="true"></i></a>
    <li data-switch="#roles"><a href="#" data-turbolinks="false">Roles
      <i class="fa fa-angle-right fa-fw arrow" aria-hidden="true"></i></a>
    </li>
    <li data-switch="#policies_assigned"><a href="#" data-turbolinks="false">Policies Assigned
      <i class="fa fa-angle-right fa-fw arrow" aria-hidden="true"></i></a>
    </li>
    <!--    <li data-switch="#cards_assigned"><a href="#" data-turbolinks="false">Cards Assigned
          <i class="fa fa-angle-right fa-fw arrow" aria-hidden="true"></i></a>
        </li>-->
    <li data-switch="#userReports"><a href="#" data-turbolinks="false">Reports
      <i class="fa fa-angle-right fa-fw arrow" aria-hidden="true"></i></a>
    </li>
    <!--   <li data-switch="#accounting_statements"><a href="#" data-turbolinks="false">Accounting Statements
         <i class="fa fa-angle-right fa-fw arrow" aria-hidden="true"></i></a>
       </li>-->
  </ul>


  <div id="page-2" class="innerdiv">

    <!-- Hidden blocks that you show when requested. -->

    <div class="divsections" id="user_info">

      <h3 id="divsection_heading">User Info</h3>

      <%= render 'profile_info' %>


    </div>

    <div class="divsections" id="roles" style="display: none">

      <h3 id="divsection_heading">Roles</h3>

      <%= render 'people/user_roles' %>


    </div>


    <div class="divsections " id="policies_assigned" style="display: none">

      <h3 id="divsection_heading">Policies Assigned</h3>

      <%= render 'user_policy_list' %>

      <hr style="margin-top: 20px">


    </div>


    <div class="divsections " id="cards_assigned" style="display: none">

      <h3 id="divsection_heading">Cards Assigned</h3>


      <hr style="margin-top: 20px">


    </div>


    <div class="divsections" id="userReports" style="display: none">

      <h3 id="divsection_heading">Reports</h3>

     <!-- < %= render 'user_reports' %>
-->

    </div>

    <div class="divsections" id="accounting_statements" style="display: none">

      <h3 id="divsection_heading">Accounting Statements</h3>


    </div>


  </div>


</div>



<script>

  var selector, elems, makeActive;

  selector = '.innerul li';
  elems = document.querySelectorAll(selector);

  makeActive = function () {
    for (var i = 0; i < elems.length; i++) {
      elems[i].classList.remove('active');
    }
    this.classList.add('active');
  };

  for (var i = 1; i < elems.length; i++)
    elems[i].addEventListener('mousedown', makeActive);


  $('[data-switch]').on('click', function (e) {
    var $page = $('#page-2'),
        blockToShow = e.currentTarget.getAttribute('data-switch');


    // Hide all children.
    $page.children().hide();

    // And show the requested component.
    $page.children(blockToShow).show();

  });


  function policySettingsModal(id) {

    var name = $('#policy_' + id + '_name').val();
    var email_id = $('#policy_' + id + '_email_id').val();
    var is_employee = $('#policy_' + id + '_is_employee').val();
    var is_admin = $('#policy_' + id + '_is_admin').val();
    var manager_id = $('#policy_' + id + '_manager_id').val();
    var conditional_manager_id = $('#policy_' + id + '_conditional_manager_id').val();
    var conditional_manager_amount = $('#policy_' + id + '_conditional_manager_amount').val();
    var finance_manager_id = $('#policy_' + id + '_finance_manager_id').val();
    var conditional_finance_manager_id = $('#policy_' + id + '_conditional_finance_manager_id').val();
    var conditional_finance_manager_amount = $('#policy_' + id + '_conditional_finance_manager_amount').val();
    var is_manager = $('#policy_' + id + '_is_manager').val();
    var approves_to = $('#policy_' + id + '_approves_to').val();
    var conditional_approves_to = $('#policy_' + id + '_conditional_approves_to').val();
    var conditional_approves_to_amount = $('#policy_' + id + '_conditional_approves_to_amount').val();
    var is_finance_manager = $('#policy_' + id + '_is_finance_manager').val();
    var approves_finance_to = $('#policy_' + id + '_approves_finance_to').val();
    var conditional_approves_finance_to = $('#policy_' + id + '_conditional_approves_finance_to').val();
    var conditional_approves_finance_to_amount = $('#policy_' + id + '_conditional_approves_finance_to_amount').val();
    var default_mapping_id = $('#policy_' + id + '_default_mapping_id').val();
    var conditional_manager_mapping_id = $('#policy_' + id + '_conditional_manager_mapping_id').val();
    var conditional_finance_manager_mapping_id = $('#policy_' + id + '_conditional_finance_manager_mapping_id').val();
    var conditional_approves_to_mapping_id = $('#policy_' + id + '_conditional_approves_to_mapping_id').val();
    var conditional_approves_finance_to_mapping_id = $('#policy_' + id + '_conditional_approves_finance_to_mapping_id').val();

    document.getElementById("policyMemberEmailId").textContent = email_id;
    $('#policyMemberSettingsUserId').val(<%=@user.id%>);
    $('#policyMemberManagerSelector').val(manager_id);
    $('#policyMemberManagerConditionalAmount').val(conditional_manager_amount);
    $('#policyMemberManagerConditionalSelector').val(conditional_manager_id);
    $('#policyMemberFinanceManager').val(finance_manager_id);
    $('#policyMemberFinanceManagerConditionalManager').val(conditional_finance_manager_id);
    $('#policyMemberFinanceManagerConditionalAmount').val(conditional_finance_manager_amount);
    $('#policyMemberApprovesToSelector').val(approves_to);
    $('#policyMemberApprovesToConditionalSelector').val(conditional_approves_to);
    $('#policyMemberApprovesToConditionalAmount').val(conditional_approves_to_amount);
    $('#policyMemberApprovesFinanceToSelector').val(approves_finance_to);
    $('#policyMemberApprovesFinanceToConditionalSelector').val(conditional_approves_finance_to);
    $('#policyMemberApprovesFinanceToConditionalAmount').val(conditional_approves_finance_to_amount);
    $('#policyMemberSettingsDefaultMappingId').val(default_mapping_id);
    $('#policyMemberSettingsManagerMappingId').val(conditional_manager_mapping_id);
    $('#policyMemberSettingsFinanceManagerMappingId').val(conditional_finance_manager_mapping_id);
    $('#policyMemberSettingsApprovesToMappingId').val(conditional_approves_to_mapping_id);
    $('#policyMemberSettingsApprovesFinanceToMappingId').val(conditional_approves_finance_to_mapping_id);
    $('#updateUserPolicyConfiguration').attr('action', 'policies/' + id + '/update_users_configuration');

    if (is_admin == "true") {
      $("#dialogAdminTrue").prop("checked", true);
    } else {
      $("#dialogAdminFalse").prop("checked", true);
    }

    if (is_employee == "true") {
      $('#policyMemberSettingsEmployeeSection').show();
    } else {
      $('#policyMemberSettingsEmployeeSection').hide();
    }

    if (is_manager == "true") {
      $('#policyMemberSettingsApprovesToSection').show();
    } else {
      $('#policyMemberSettingsApprovesToSection').hide();
    }

    if (is_finance_manager == "true") {
      $('#policyMemberSettingsApprovesFinanceToSection').show();
    } else {
      $('#policyMemberSettingsApprovesFinanceToSection').hide();
    }

    $('#policyMemberSettings').modal('show');
  }


  function userSettingsModal() {
    $('#defaultUserSettings').modal('show');

    var isEmployee = "<%=@user.employee?%>";
    var isManager = "<%=@user.manager?%>";
    var isFinanceManager = "<%=@user.finance_manager?%>";

    if (isEmployee == "true") {
      $('#userSettingsEmployeeSection').show();
    } else {
      $('#userSettingsEmployeeSection').hide();
    }

    if (isManager == "true") {
      $('#userSettingsApprovesToSection').show();
    } else {
      $('#userSettingsApprovesToSection').hide();
    }

    if (isFinanceManager == "true") {
      $('#userSettingsApprovesFinanceToSection').show();
    } else {
      $('#userSettingsApprovesFinanceToSection').hide();
    }
  }

</script>