<div id="userRoleDiv">

<form data-remote data-turboboost id="updateRoleForm" action="<%=user_update_role_path(@user)%>" method="post">
<input name="authenticity_token" value="<%=form_authenticity_token%>" type="hidden">
<input name="_method" value="patch" type="hidden">

<label class="editProfileDialogHeaders">Assign Admin Role?</label>

<label class="radio-inline" style="font-size: 12px">
  <input id="adminTrue" type="radio" name="admin" style="font-size: 8px" value="1">Yes
</label>
<label class="radio-inline" style="font-size: 12px">
  <input id="adminFalse" type="radio" name="admin" value="0" checked="checked" style="font-size: 8px">No
</label>
<hr style=" margin: 15px 0 0 0">

<label class="editProfileDialogHeaders">Assign Manager Role?</label>

<label class="radio-inline" style="font-size: 12px">
  <input id="managerTrue" type="radio" name="manager" style="font-size: 8px" value="1">Yes
</label>
<label class="radio-inline" style="font-size: 12px">
  <input id="managerTrue" type="radio" name="manager" value="0" checked="checked" style="font-size: 8px">No
</label>


<hr style=" margin: 15px 0 0 0">
<label class="editProfileDialogHeaders">Assign Finance Role?</label>

<label class="radio-inline" style="font-size: 12px">
  <input id="managerTrue" type="radio" name="finance_manager" style="font-size: 8px" value="1">Yes
</label>
<label class="radio-inline" style="font-size: 12px">
  <input id="managerTrue" type="radio" name="finance_manager" value="0" checked="checked" style="font-size: 8px">No
</label>

  <button type="submit" class="green-button"
          style="width: 100px;
              height: 35px;
              float: left;
              letter-spacing: 1px;
              margin-top: 30px;background-color: #46568b">Update
  </button>

</form>

</div>