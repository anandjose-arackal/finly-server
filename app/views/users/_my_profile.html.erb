<div class="row no-margin">
  <div class="col-sm-12">
    <div class="section-card">
      <div class="row no-margin section-header" style="margin-bottom: 15px;">
        <div class="col-sm-12">
          <h4>My Profile</h4>
        </div>
      </div>

      <div class="row no-margin" style="padding-bottom: 20px;">
        
        <div class="col-sm-12">
          <div class="row no-margin">
            <div class="col-sm-2">
              <label class="control-label">Organization Name:</label>
            </div>
            <div class="col-sm-4">
              <label class="control-label"><%= current_user.company_name %></label>
            </div>
          </div>

          <div class="row no-margin">
            <div class="col-sm-2">
              <label class="control-label">Name:</label>
            </div>
            <div class="col-sm-4">
              <label class="control-label"><%= current_user.name %></label>
            </div>
          </div>

          <div class="row no-margin">
            <div class="col-sm-2">
              <label class="control-label">Email:</label>
            </div>
            <div class="col-sm-4">
              <label class="control-label"><%= current_user.email %></label>
            </div>
          </div>

          <div class="row no-margin">
            <div class="col-sm-2">
              <label class="control-label">Mobile:</label>
            </div>
            <div class="col-sm-4">
              <label class="control-label"><%= current_user.mobile_number %></label>
            </div>
          </div>

          <div class="row no-margin">
            <div class="col-sm-2">
              <label class="control-label">Address:</label>
            </div>
            <div class="col-sm-4">
              <label class="control-label"><%= (current_user.profile.address_1 || 'Address line 1 not set') + ", " + (current_user.profile.address_2 || 'Address line 2 note set') + ", " + (current_user.profile.city || 'City not set') + ", " + (current_user.profile.pin_code || 'PIN Code not set') %></label>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>

