<div class="row" style="background-color: white;  margin-top: 1px; padding-top: 10px; padding-bottom: 10px ">

  <div id="eachRow" class="row" data-toggle="modal" data-target="#showEmployeeProfile" onclick="$('form#userDetailsForm<%=user.id%>').submit()">

  <div class="col-sm-2"><span class="roundCircle" style="">VR</span></div>
  <div class="col-sm-8" style="">
    <p userTarget="name" style="line-height: 80%;font-weight: 600; margin-top: 5px"><%= user.name %></p>

    <p userTarget="email" style="font-size: 12px; font-weight: 200; line-height: 95% ;color: #a0a0a0"><%= user.email %>
    </p>
    <p style="font-size: 12px; color: darkred; line-height: 100%">Employee</p>
  </div>
  <div class="col-sm-2">

  <form data-remote data-turboboost id="userDetailsForm<%=user.id%>"  action="<%= user_details_path(user.id) %>" method="post">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

    <button id="editProfile<%= user.id %>" onclick="$('form#userDetailsForm<%=user.id%>').submit()" type="submit" style=" margin-top: 10px; padding: 10px; border: 1px solid #d8d8d8;width: 70%; background-color: #EFEFEF">
      <i class="fa fa-pencil" style="font-size: 15px; color: black"> </i></button>
  </form>

  </div>
  </div>
</div>