<div class="row no-margin">
  <div class="col-sm-12">
    <div class="section-card">
      
      <div class="row no-margin section-header" style="margin-bottom: 15px;">
        <div class="col-sm-12">
          <h4>Change Password</h4>
        </div>
      </div>

      <div class="row no-margin">
        <div class="col-sm-4">
          <form id="changePassword" action="<%= user_update_password_path(current_user) %>" method="post">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

            <h4 id="password_subheading">Current Password</h4>
            <input name="user[current_password]" type="password" class="form-control" id="current_pwd">

            <h4 id="password_subheading2">New Password</h4>
            <input name="user[password]" type="password" class="form-control" id="new_pwd">

            <h4 id="password_subheading3">Confirm New Password</h4>
            <input name="user[password_confirmation]" type="password" class="form-control" id="confirm_new_pwd">

            <div class="text-center">
              <button type="submit" class="btn btn-success btn-sm" style="padding: 7px 20px;
                margin: 12px 2px;
              " id="save_button">Change Password</button>
            </div>
            

          </form>
        </div>    
      </div>

    </div>
  </div>
</div>