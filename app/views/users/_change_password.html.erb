<h3 id="divsection_heading">Change Password</h3>

<form data-remote data-turboboost id="changePassword" action="<%= user_update_password_path(current_user) %>" method="post">
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

  <h4 id="password_subheading">Current Password</h4>
  <input name="user[current_password]" type="password" class="form-control" id="current_pwd">

  <h4 id="password_subheading2">New Password</h4>
  <input name="user[password]" type="password" class="form-control" id="new_pwd">

  <h4 id="password_subheading3">Confirm New Password</h4>
  <input name="user[password_confirmation]" type="password" class="form-control" id="confirm_new_pwd">

  <input type="submit" class="green-button" style="padding: 7px 20px;
      margin: 12px 2px;
  " id="save_button">

</form>

<hr style="margin-top: 20px">
