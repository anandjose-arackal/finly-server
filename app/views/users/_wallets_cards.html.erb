<div class="row no-margin">
  <div class="col-sm-4 no-padding">
    <div class="row no-margin section-title">
      <div class="col-sm-6">
        <h4>Wallet</h4>
      </div>
      <div class="col-sm-6 text-right">
        <!-- <button class="btn btn-success btn-sm btn-transfer" data-transfer="wallet-to-card">Transfer to Card</button> -->
      </div>

    </div> 
    <div class="row no-margin" style="margin-top: 20px;">
      <div class="col-sm-4">
        <label class="control-label" style="font-size: 20px; font-weight: normal;">Balance:</label>
      </div>
      <div class="col-sm-8" style="font-size: 25px; color: #2ECC71;">
        <span>&#8377;&nbsp;&nbsp;</span><span class="current_user_wallet_balance"><i class="fa fa-spin fa-spinner"></i></span>
      </div>
      
    </div>
  </div>

  <div class="col-sm-8 no-padding" style="padding-left: 10px;">
    <div class="row no-margin section-title">
      <div class="col-sm-6">
        <h4>Cards</h4>
      </div>
      <div class="col-sm-6 text-right">
        <!-- <button class="btn btn-success btn-sm btn-transfer" data-transfer="card-to-wallet">Transfer to Wallet</button> -->
      </div>
    </div>
    <div class="row no-margin" style="padding: 10px;">
      <% current_user.cards.each do |card| %>
        <div class="card text-center" style="display: inline-block;">
          <div class="logo">Finly</div>
          <div class="status">
            <% if card.active %>
              <label class="control-label"><i class="fa fa-check-circle" style="color: #2ecc71;"></i>&nbsp;&nbsp;<span>Active</span></label>
            <% else %>
              <label class="control-label"><i class="fa fa-minus-circle" style="color: #e74c3c;"></i>&nbsp;&nbsp;<span>Inactive</span></label>
            <% end %>
          </div>
          <div class="card-type">Expense Card</div>
          <div class="card-number">
            <span class="first-four">XXXX</span>
            <span class="second-four">XXXX</span>
            <span class="third-four">XXXX</span>
            <span class="fourth-four"><%= card.ending_number %></span>
          </div>
          <div class="user-name"><%= card.user.name %></div>
          <div class="visa"><i class="fa fa-cc-visa"></i></div>
        </div>
        <div class="card-balance" style="display: inline-block; position: absolute; margin-left: 15px;">
          <label class="control-label" style="font-size: 20px; font-weight: normal;">Card Balance:</label>
          <span class="balance" style="font-size: 25px; color: #2ECC71;">&#8377;&nbsp;&nbsp;</span><span class="current_user_card_balance"><i class="fa fa-spin fa-spinner"></i></span>
        </div>
        <% if card.active %>
          <button class="btn btn-sm btn-danger btn-card-update-status" data-card-status-type="0" data-target="#modal-confirm-card-status" data-toggle="modal">Deactivate</button>
        <% else %>
          <button class="btn btn-sm btn-success btn-card-update-status" data-card-status-type="1" data-target="#modal-confirm-card-status" data-toggle="modal">Activate</button>
        <% end %>
      <% end %>    
    </div>
     
  </div>

</div>

<div class="modal fade in" tabindex="-1" role="dialog" id="modal-confirm-card-status">
  <div class="modal-dialog" role="document" style="width: 40%;">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
        <h4 class="modal-title">Confirm Card Status Change</h4>
      </div>
      <div class="modal-body">
        <div class="row no-margin">
          <div class="col-sm-8 col-sm-offset-2">

            <div class="form-group">
              <label class="control-form">Password:</label>
              <input name="password" class="form-control password" type="password">
            </div>

            <div class="form-group text-center">
              <button class="btn btn-success btn-confirm-card-status btn-wd-100" data-card-status-type="1">Confirm</button>
            </div>
          </div>
        </div>
      </div>
    </div><!-- /.modal-content -->
  </div><!-- /.modal-dialog -->
</div>

<style type="text/css">
  .section-title{
    background: #DDDAEA;
    padding: 0 10px;
  }
</style>

<script type="text/javascript">
  $(document).ready(function(){
    //Get card balance and populate
    $.ajax({
      url: '/users/' + '<%= current_user.id %>' + '/balance',
      data: {
        current_user_wallet: true,
        current_user_card: true
      },
      dataType: 'json',
      success: function(res){
        $(".current_user_wallet_balance").html(res.current_user_wallet);
        $(".current_user_card_balance").html(res.current_user_card);
      },
      error: function(err){
        console.log("Error", err);
      }
    });
  });

  $(".btn-transfer").on('click', function(e){
    console.log(this);
    transfer_type = $(this).attr('data-transfer')
    switch(transfer_type) {
      case 'wallet-to-card':
        // show modal
        break;
      case 'card-to-wallet':
        // show modal
      }
    //Show modal for collecting amoutn and password

    //Send data 
  });

  $(".btn-card-update-status").on('click', function(e){
    var card_status = $(this).attr('data-card-status-type');
    $(".btn-confirm-card-status").attr('data-card-status-type', card_status)
  });
  $(".btn-confirm-card-status").on('click', function(e){
    var card_status = $(this).attr('data-card-status-type');
    target = this;
    $.ajax({
      url: '/cards/update_status',
      type: "POST",
      dataType: 'json',
      data: {
        view: 'personal',
        user_id: '<%= current_user.id %>',
        status_type: card_status,
        password: $(target).closest('.modal-body').find('input[type=password]').val()
      },
      success: function(res){
        console.log(res);
        if(res.success === true){
          window.location.reload();
        }
      },
      error: function(err){
        console.log("ERror", err);
      }
    });
  });
</script>