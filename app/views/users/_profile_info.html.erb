<h4 class="profile_subheading">Name:</h4>

<p class="profile_info"><%= @user.name %></p>

<h4 class="profile_subheading">Email:</h4>

<p class="profile_info"><%= @user.email %></p>

<h4 class="profile_subheading">Mobile:</h4>

<p class="profile_info"><%= @user.mobile_number %></p>


<h4 class="profile_subheading">Default Reporting managers</h4>

<div>
  <p class="profile_info"><select id="policyMemberManagerSelector" form="updateUserPolicyConfiguration"
                                  name="policy[default][manager_id]" class="selectors">
    <option value="" selected="selected"></option>
    <% @company_managers.each do |manager| %>
        <option value="<%= manager.id %>"><%= manager.name %></option>
    <% end %>
  </select></p>
</div>


<h4 class="profile_subheading">Default Reporting Finance managers</h4>

<div>
  <p class="profile_info">
    <select id="policyMemberFinanceManager" form="updateUserPolicyConfiguration" name="policy[default][finance_manager_id]"
            class="selectors">
      <option value="" selected="selected"></option>
      <% @company_finance_managers.each do |manager| %>
          <option value="<%= manager.id %>"><%= manager.name %></option>
      <% end %>
    </select></p>
</div>



<button class="green-button" style="width: 100px;
    height: 35px;
    float: left;
    letter-spacing: 1px;
    margin-top: 30px;background-color: #46568b">Update
</button>

