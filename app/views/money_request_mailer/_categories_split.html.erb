<table class="row">
  <tbody>
  <tr>
    <th class="small-12 large-12 columns first last" colspan="2">
      <table class="row custom_moneyrequest_bottom_table_class ">
        <thead>
        <tr style="background-color: #DCDCDC;">
          <th style="font-weight: bold;">Categories:</th>
          <th style="font-weight: bold;">Total</th>
        </tr>
        <% @data.money_request.items.each do |item| %>
          <tr>
            <th style="font-weight: bold; opacity: 0.9;"><%=item.category_name%></th>
            <th>&#8377;<%= item.amount_value%></th>
          </tr>
        <% end %>
        </thead>
      </table>
    </th>
  </tr>
  </tbody>
</table>