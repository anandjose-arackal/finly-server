<% content_for :body do %>

    <head>
      <title>Money Request</title>
    </head>
    <body style="background-color: #f3f3f3; margin: 0px;">
    <div style="height: 80px; width: 100%; margin: auto; background-color: #2980b9; color: white; display: table;">
      <p style="font-size: 22px; display: table-cell; vertical-align: middle; padding-left: 3%;"><%=@data.action_name%></p>
    </div>
    <div style="margin: auto; height: 100%; width: 100%; background-color: white;">
      <!--<p style="font-size: 18px; padding-top: 3%; margin-top: 0px; margin-left: 3%;"><span style="color: #2980b9;">Abhinash1354@gmail.com</span> has shared 'New Money Request' with you.</p>-->
      <p style="font-size: 17px; margin-left: 3%;"><%= @data.body_val.html_safe%></p><br>

      <div style="text-align: center;">
        <a href="<%=@data.view_url%>" style="height: 33px; width: 200px; background-color: #3adb76; color: white; border: none; font-size: 16px;padding: 10px 20px;
            border-radius: 2px;
            text-decoration: none;">View Money Request</a>
      </div><br>

      <div style="text-align: right; padding-right: 3%;">
        <label style="font-size: 20px; font-weight: bold;">Money Request Total&nbsp;:&nbsp;&#8377;2000</label>
      </div>
      <br>

      <% unless @data.event_id == NotifierType.id_for(:money_request_comment) %>
        <%= render 'money_request_mailer/categories_split' %>
      <% end %>
      <br>
    </div>
    </body>

<% end %>

<%= render 'application_mailer/template' %>