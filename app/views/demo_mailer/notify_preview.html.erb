<% content_for :body do %>
  <h3><%= "#{@preview_registration.email}" %> has requested for a demo of our product. The details are as follows: </h3>

    <h4>Requester Name: <%= @preview_registration.name %></h4>
    <br/>
    <h4>Requester Email: <%= @preview_registration.email %></h4>
    <br/>
    <h4>Requester Mobile Number: <%= @preview_registration.phone_number %></h4>
    <br/>
    <h4>Company: <%= @preview_registration.company %></h4>
    <br/>
  <% if @sales_person %>
    <h3 class="url">URL (page from which user sign up): <%= @preview_registration.url || @preview_registration.referrer %></h3>
  <% end %>
<% end %>

<%= render 'application_mailer/template' %>

<style>
  h3.url {
    width: 340px;
    word-wrap: break-word;
  }
</style>