<!DOCTYPE html>
<html>
    <head>
        <title>
            Invoice Mailer
        </title>
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
            <style type="text/css">
                
                body, table, td, a, p, span{font-family: 'Arial' !important; font-size: 14px;}
            </style>
    </head>
    <body style="padding:0;margin:0;">
        <div class="container" style="width: 80%;margin: 0 auto;height: auto; position: relative;">
            <div class="header" style="margin: 14px 0 14px 0">
                <img class="company-logo" style="width: 100px;" src="https://www.finly.io/common/images/logos/logo_md1.png" alt="finly"/>
            </div>
            <div class="email-header-container" style="width: 100%;background: #E1F0FA; border-radius: 2px; margin-bottom: 20px;">
                <div class="email-header--content" style="padding: 20px;">
                    <span style="font-family: 'work sans'; font-size: 24px; font-weight: 600;color: #0F3044;">Invoice Submitted</span><br/>
                    <div style="margin: 10px 0 10px 0;">
                    <span style="font-family:'work sans';font-weight: 400;font-size: 14px;color: #143B52;"> You have a new invoice that needs your approval <a style="color: #2D9DE7;"href="<%= @data.view_url%>" target="_blank"><%= @data.invoice.invoice_number%></a></span>
                    </div>
                    <div style="margin: 24px 0 24px 0;" class="btn-container">
                        <a href="mailto:<%= @data.reply_to%>?subject=Approving invoice&body=Approve." id="btn-success" style="background: #143B52;color: #FFFFFF;min-width: 88px;height: 35px; border-radius: 2px; text-decoration: none; padding: 14px;border: none;font-weight: 600;" class="btn btn-success">Approve</a>&nbsp;&nbsp;
                        <a href="mailto:<%= @data.reply_to%>?subject=Rejecting invoice&body=Reject." id = "btn-default" style="color: #143B52;background:#F7F7FB;min-width: 88px;height: 35px;border-radius: 2px;text-decoration: none;margin-left: 5px;padding: 14px;border: none;font-weight: 600;" class="btn btn-default">Reject</a>
                    </div>
                    <div style="font-size: 12px;color: #4D4D4D;font-weight: 400;font-style: italic;">* Content in the reply is auto generated when you click <span style="font-size: 12px;font-weight: 600;">Approve</span> or <span style="font-size: 12px;font-weight: 600;">Reject</span>. Do not edit the reply before hitting send.</div>
                </div>
            </div>
            <div class="email-body" style="width: 100%;padding-bottom: 30px;">
                <div>
                <span class="email-salutation" style="font-size: 16px;font-weight: 400;">Hi <%=@data.to_name %>,</span>
                </div>
                <p style="margin: 5px 0 10px 0; font-size: 14px; line-height: 20px;">
                    <span style="font-size: 14px;font-weight: 600;"><%= %></span>
                    <%= %> This invoice is waiting on your approval <a style="color: #2D9DE7;" href="<%= @data.view_url%>" target="_blank"><%= @data.invoice.invoice_number%></a> in Finly. Below is the summary for the same,
                </p>
                <div class="email-body--invoice-details">
                    
                        <table style="width:100%;font-weight: 400;border-collapse: collapse;">
                            <tr style="font-weight: 400;border-bottom: 1px solid #F0F0F0; ">
                                <th style="text-align:left; font-size: 14px;font-weight: 400;">Vendor Name</th>
                                <td style="font-size: 14px;text-align: right; padding: 10px 0 10px 0;"><%= @data.invoice.vendor.name%></td>
                            </tr>
                            <tr style="font-weight: 400;border-bottom: 1px solid #F0F0F0; ">
                                <th style="text-align:left;font-size: 14px;font-weight: 400;">Invoice Number</th>
                                <td style="font-size: 14px;text-align: right; padding: 10px 0 10px 0;"><%= @data.invoice.invoice_number%></td>
                            </tr>
                            <tr style="font-weight: 400;border-bottom: 1px solid #F0F0F0; ">
                                <th style="text-align:left;font-size: 14px;font-weight: 400;">Invoice date</th>
                                <td style="font-size: 14px;text-align: right; padding: 10px 0 10px 0;"><%= @data.invoice.date%></td>
                            </tr>
                            <tr style="font-weight: 400;border-bottom: 1px solid #F0F0F0; ">
                                <th style="text-align:left;font-size: 14px;font-weight: 400;">Invoice Amount</th>
                                <td style="font-size: 14px;text-align: right; padding: 10px 0 10px 0;"><%=@data.invoice.base_currency&.country_code%>  <%=@data.invoice.amount&.value.to_f.round(2) %></td>
                              </tr>
                            </tr>
                            <tr style="font-weight: 600;border-bottom: 1px solid #F0F0F0; ">
                                <th style=" text-align:left;font-size: 14px;font-weight: 600;">Net Payable Amount</th>
                                <td style="font-size: 14px; text-align: right; padding: 10px 0 10px 0;"><%=@data.invoice.base_currency&.country_code%>  <%=@data.invoice.net_amount&.value.to_f.round(2) %></td>
                            </tr>
                          </table>
                </div>
                <div class="more-details-section" style="width:100%; margin-top: 20px;">
                    <table style="width:100%;font-weight: 400; border-collapse: collapse;">
                        <tr style="font-weight: 400;">
                            <th style=" text-align:left;font-size: 14px;font-weight: 400;">
                                More details on invoice can be viewed on <span style="font-weight: 600;padding: 0;margin: 0;">Finly</span>
                            </th>
                            <td style="font-size: 14px; width:150px;white-space: nowrap; text-align: right;font-weight: 600;">
                                <a style="font-size:14px ;color: #143B52; background:#F7F7FB; width: 70px;height: 35px ;border-radius: 2px;text-decoration: none;padding: 12px 5px 12px 5px;border: none;"class="btn view-invoice" href="<%= @data.view_url%>" target="_blank">View Invoice </a>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
            <div style="bottom:5px;position: relative; margin: 10px 0 10px 0;border-top: 1px solid #F0F0F0;width: 100%;">
                <div style="margin: 10px 0 10px 0;">
                    <table style="width:100%;border-collapse: collapse;">
                        <tr>
                            <th>
                                <img style="width: 100px;" src="https://www.finly.io/common/images/logos/logo_md1.png" alt="Finly">
                            </th>
                        </tr>
                        <tr>
                            <th>
                                <span style="line-height: 20px; font-size: 14px;font-weight: 500;">Connected by Finly</span>
                            </th>
                        </tr>
                        <tr>
                            <th>
                                <span style="line-height: 16px; font-size: 12px; color: #6F828E;font-weight: 400;">The connected accounting network</span>
                            </th>
                        </tr>
                    </table>
                </div>    
            </div>
        </div>
    </body>
</html>