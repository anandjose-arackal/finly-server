<% content_for :body do %>
  <head>
    <title>@data.action_name</title>
  </head>
  <body style="background-color: #f3f3f3; height: auto;">
  <div style="height: 80px; width: 100%; margin: auto; background-color: #2980b9; color: white; display: table;">
    <p style="font-size: 22px; display: table-cell; vertical-align: middle; padding-left: 3%;"><%=@data.action_name%></p>
  </div>
  <div style="width: 100%; height: auto; margin: auto; background-color: white;">

    <% if @data.inward_document_pending_submit.present? %>
      <div style="text-align: left;margin-top: 20px">GRN pending submission</div>
      <table style="width: 100%;">
        <thead>
        <tr>
          <% @data.inward_document_pending_submit_columns.each do |column_name| %>
            <th><%= column_name %></th>
          <% end %>
        </tr>
        </thead>
        <tbody>
        <% @data.inward_document_pending_submit_column_values.each do |column_values| %>
          <tr>
            <% column_values.each do |value| %>
              <td><%= value %></td>
            <% end %>
          </tr>
        <% end %>
        </tbody>
      </table>
    <% end %>
    <br>


    <% if @data.non_po_pending_submit.present? %>
      <div style="text-align: left;margin-top: 20px">Non PO Pending submission</div>
      <table style="width: 100%;">
        <thead>
        <tr>
          <% @data.non_po_pending_submit_columns.each do |column_name| %>
            <th><%= column_name %></th>
          <% end %>
        </tr>
        </thead>
        <tbody>
        <% @data.non_po_pending_submit_column_values.each do |column_values| %>
          <tr>
            <% column_values.each do |value| %>
              <td><%= value %></td>
            <% end %>
          </tr>
        <% end %>
        </tbody>
      </table>
    <% end %>
    <br>

    <% if @data.po_invoice_pending_submit.present? %>
      <div style="text-align: left;margin-top: 20px">PO pending submission</div>
      <table style="width: 100%;">
        <thead>
        <tr>
          <% @data.po_invoice_pending_submit_columns.each do |column_name| %>
            <th><%= column_name %></th>
          <% end %>
        </tr>
        </thead>
        <tbody>
        <% @data.po_invoice_pending_submit_column_values.each do |column_values| %>
          <tr>
            <% column_values.each do |value| %>
              <td><%= value %></td>
            <% end %>
          </tr>
        <% end %>
        </tbody>
      </table>
    <% end %>
    <br>



    <br>
  </div>
  </body>
<% end %>

<%= render 'application_mailer/template' %>