<% content_for :body do %>
  <head>
    <title>@data.title</title>
  </head>
  <body style="background-color: #f3f3f3; height: auto;">
  <div style="height: 80px; width: 100%; margin: auto; background-color: #2980b9; color: white; display: table;">
    <p style="font-size: 22px; display: table-cell; vertical-align: middle; padding-left: 3%;"><%=@data.action_name%></p>
  </div>
  <div style="width: 100%; height: auto; margin: auto; background-color: white;">

    <% if @data.awaiting_approvals.length > 0 %>
      <div style="text-align: left;"><%= @data.body_val.html_safe %></div>
      <table style="width: 100%;">
        <thead>
        <tr>
          <th>#</th>
          <th>PO #</th>
          <th>Created By</th>
          <th>Sub Department</th>
          <th>Amount</th>
        </tr>
        </thead>
        <tbody>
        <% @data.awaiting_approvals.each_with_index do |po_details, index| %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= po_details[:po_number] %></td>
            <td><%= po_details[:user] %></td>
            <td><%= po_details[:sub_department] %></td>
            <td>&#8377;<%= po_details[:amount]&.to_d.round(2) rescue 0 %></td>
          </tr>
        <% end %>
        </tbody>
      </table>
    <% end %>
    <br>
  </div>
  </body>
<% end %>

<%= render 'application_mailer/template' %>