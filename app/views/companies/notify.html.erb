amount: value of balance added
#   Reference ID: the transaction ID of the NEFT transfer
#   date: Date of the NEFT transfer
#   remarks: Optional remarks
#   company_id: id of the company whose balance is being updated

<div class="row no-margin">
  
  <div class="col-sm-6 col-sm-offset-3 no-padding main">
    <form id="form-submit-request">
    <input type="hidden" name="company_id" value="<%= current_company.id %>">

    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

      <div class="form-group">
        <div class="col-xs-4 text-right">
          <label class="control-label">Amount Transferred:</label>
        </div> 
        <div class="col-xs-8">
          <input type="number" class="form-control" name="amount" />
        </div>
      </div>
      <br /><br />
      <div class="form-group">
        <div class="col-xs-4 text-right">
          <label class="control-label">Reference ID:</label>
        </div> 
        <div class="col-xs-8">
          <input type="text" class="form-control" name="reference_id" />
        </div>
      </div>
      
      <br /><br />
      <div class="form-group">
        <div class="col-xs-4 text-right">
          <label class="control-label">Transfer Date:</label>
        </div> 
        <div class="col-xs-8">
          <input type="text" class="form-control" name="date" />
        </div>
      </div>
      <br /><br />
      <div class="form-group">
        <div class="col-xs-4 text-right">
          <label class="control-label">Remark:</label>
        </div> 
        <div class="col-xs-8">
          <textarea name="remark"></textarea>
        </div>
      </div>

      <br /><br />
      <div class="form-group">
        <div class="col-xs-8 col-sm-offset-4">
          <button class="btn btn-sm btn-submit btn-success">Submit</button>
        </div>
      </div>

    </form>


    
  </div>
</div>

<script type="text/javascript">
  $(document).ready(function(e){
    $("input[name=date]").datepicker({dateFormat: "yy-mm-dd"});

    $(".btn-submit").on('click', function(e){
      alert("Will post now");

      e.preventDefault();
      formData = new FormData($('form#form-submit-request')[0])

      $.ajax({
        url: '/companies/<%= current_company.id %>/add_balance',
        type: "POST",
        data: formData,
        success: function(res){
          // FinlyF.snapNotify(res.messages);
          console.log(res);
        },
        error: function(err){
          console.log("Error", err);
        },
        cache: false,
        contentType: false,
        processData: false
      })
    });
  });
</script>

<style type="text/css">
  .main{
    padding: 20px;
    background: white;
    margin-top: 50px;

  }
  .form-group{
    margin-bottom: 10px;
    color: #333;
  }
</style>