<div class="row no-margin main-container" style="margin-top: -20px; height: calc(100vh - 50px); padding-top: 20px;">
  <div class="col-sm-10 col-sm-offset-1 no-padding" style="background: white;border-radius: 8px 8px 0 0;">
    <div class="row no-margin" style="border-radius: 7px 7px 0 0; background: #eee; padding-left: 20px; padding-right: 20px;">
      <div class="col-sm-6">
        <h3 style="margin-bottom: 15px;">Load Balance into Company</h3>
      </div>
      <div class="col-sm-6 text-right">
        <h4 style="margin-top: 20px;">Company Balance: <span class="currency" style="color: green;">&#8377;&nbsp;<%= @company_balance %></span></h4>
      </div>
    </div>
    <div class="row no-margin">
      <div class="col-sm-6" style="border-right: 1px solid #eee; padding: 50px 30px;">
        <div class="row no-margin">
          <div class="col-sm-12">
            <h4>Please transfer the amount you want to load to the following account using NEFT</h4>
          </div>
        </div>
        <div class="row no-margin">
          <div class="col-sm-12">
            
            <div class="row no-margin">
              <div class="col-sm-4 text-right">Account Name:</div>
              <div class="col-sm-8"><label>ITZ CASH CARD LTD</label></div>
            </div>

            <div class="row no-margin">
              <div class="col-sm-4 text-right">Account Number:</div>
              <div class="col-sm-8"><label>00600330004211</label></div>
            </div>

            <div class="row no-margin">
              <div class="col-sm-4 text-right">Account Type:</div>
              <div class="col-sm-8"><label>Current</label></div>
            </div>
            <div class="row no-margin">
              <div class="col-sm-4 text-right">IFSC Code:</div>
              <div class="col-sm-8"><label>HDFC0000060</label></div>
            </div>

            <div class="row no-margin">
              <div class="col-sm-4 text-right">Bank Name:</div>
              <div class="col-sm-8"><label>HDFC BANK</label></div>
            </div>

            <div class="row no-margin">
              <div class="col-sm-4 text-right">Branch Name:</div>
              <div class="col-sm-8"><label>Fort</label></div>
            </div>

            <div class="row no-margin">
              <div class="col-sm-4 text-right">Address:</div>
              <div class="col-sm-8"><label>Fort-400001</label></div>
            </div>
          </div> 
        </div>

        <div class="alert alert-info">
          <b>Note:</b> You will need to add the above account as beneficiary in your company's bank account     
        </div>

        <p>Mention the amount, reference number and date in the form provided and submit. The amount will be credited to your account within 2 business days.</p>
      </div>
      
      <div class="col-sm-6 no-padding main">

        <h4 class="text-center">Please fill in transfer details</h4>

        <div class="row no-margin"><div class="col-sm-12"><hr /></div></div>

        <form id="form-submit-request">
        <input type="hidden" name="company_id" value="<%= current_company.id %>">
        <input type="hidden" name="view" value="admin" />

        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

          <div class="form-group">
            <div class="row">
               <div class="col-xs-4 text-right">
                <label class="control-label">Amount Transferred:</label>
              </div> 
              <div class="col-xs-8">
                <input type="number" class="form-control amount" name="amount_attributes[value]" />
              </div>  
            </div>
            
          </div>

          <div class="form-group">
            <div class="row">
              <div class="col-xs-4 text-right">
                <label class="control-label">Reference ID:</label>
              </div> 
              <div class="col-xs-8">
                <input type="text" class="form-control" name="reference_id" />
              </div>  
            </div>
          </div>

          <div class="form-group">
            <div class="row">
              <div class="col-xs-4 text-right">
                <label class="control-label">Transfer Date:</label>
              </div> 
              <div class="col-xs-8">
                <input type="text" class="form-control" name="date" />
              </div>  
            </div>
          </div>

          <div class="form-group">
            <div class="row">
              <div class="col-xs-4 text-right">
                <label class="control-label">Remark:</label>
              </div> 
              <div class="col-xs-8">
                <textarea name="remark" class="form-control"></textarea>
              </div>  
            </div>
          </div>

          <div class="form-group">
            <div class="row text-center">
              <button class="btn btn-sm btn-submit btn-success">Submit</button>
            </div>
          </div>

        </form>
      </div>    
    </div>
  </div>
  
</div>

<div class="hidden success-notice-container">
  <div class="row no-margin">
    <div class="col-sm-10 col-sm-offset-1">
      <h3 class='success-notice text-center' style="margin-top: 50px;">
        Successfully Notified Finly about the transfer of <span style="text-decoration: underline;">&#8377;&nbsp;<span id="transfer-amount"></span></span>. The amount will be credited to your account within 2 business days. Thank you.
      </h3>
      <h4 class="text-center success-notice">This window will auto close in <span id="count-down-time">20</span> seconds.</h4>
    </div>
  </div>
  
</div>

<div id="ohsnap"></div>
<div id="ohsnap-priority"></div>

<script type="text/javascript">
  $(document).ready(function(e){
    snapNotify = function(obj){
      // console.log "From snap", obj
      ohSnapX()
      for (type in obj) {
        messages = obj[type];
        switch (type) {
          case 'error':
            color = 'red';
            container = 'ohsnap-priority';
            break;
          case 'success':
            color = 'green';
            container = 'ohsnap';
            break;
          case 'failure':
            ({
              color: 'orange'
            });
            container = 'ohsnap-priority';
            break;
          case 'message':
            ({
              color: 'blue'
            });
            container = 'ohsnap';
            break;
          case 'notice':
            ({
              color: 'blue'
            });
            container = 'ohsnap';
            break;
          default:
            ({
              color: 'blue'
            });
            container = 'ohsnap';
        }
        if (messages.length) {
          for (i = 0, len = messages.length; i < len; i++) {
            message = messages[i];
            ohSnap(message, {
              color: color,
              'duration': '9000',
              'container-id': container
            });
          }
        }
      }
    }


    $("input[name=date]").datepicker({dateFormat: "dd-mm-yy"});
    // successTemplate = HandlebarsTemplates['abinash'];
    // $("input[name=date]").datepicker({
    //   beforeShow: function(input, inst){
    //     inst.dpDiv.css({marginTop: -input.offsetHeight + 'px', marginLeft: input.offsetWidth + 'px'});
    //   },
    //   dateFormat: "yy-mm-dd"
    // });

    $(".btn-submit").on('click', function(e){
      e.preventDefault();
      target = this;
      $(this).html("&nbsp;&nbsp;<i class='fa fa-spin fa-spinner'></i>&nbsp;&nbsp;").attr('disabled', true)
      formData = new FormData($('form#form-submit-request')[0])

      amount = $("form#form-submit-request input.amount").val()

      $.ajax({
        url: '/api/companies/<%= current_company.id %>/add_balance',
        type: "POST",
        data: formData,
        dataType: "json",
        success: function(res){
          if(res.success === true){
            $(".main-container").html($(".success-notice-container").html());
            $("#transfer-amount").text(amount);

            time = parseInt($("#count-down-time").text());

            setInterval(function(){
              if(time === 0){
                window.close(); 
              }
              time = time - 1;
              $("#count-down-time").text(time);
            }, 1000)
          } else {
            snapNotify(res.messages);
            $(target).text('Submit').removeAttr('disabled')
          }

          // FinlyF.snapNotify(res.messages);
          // console.log(res);
        },
        error: function(err){
          console.log("Error", err);
          $(target).text('Submit').removeAttr('disabled')

        },
        cache: false,
        contentType: false,
        processData: false

      })
    });
  });
</script>

<style type="text/css">
  .main{
    /*padding: 0 20px 20px;*/
    padding: 50px 30px;
    background: white;
  }
  .form-group{
    margin-bottom: 10px;
    color: #333;
  }
  .ui-datepicker { 
    /*margin-top: 266px;*/
    z-index: 1041 !important;
  }

  .success-notice{
    color: #353B53;
  }
#ohsnap-priority{
  position: fixed;
}
</style>