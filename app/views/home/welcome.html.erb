<div class="jumbotron" style="min-height: 500px;">
  <div class="container">
    <div style="">
      <img class="feature_image" src="<%= image_url('home_screen_bg.png') %>" style="">
    </div>


    <div class="text-center">
      <h1 style="font-size: 40px; color: #F2EC5C; font-weight: 200;">Scalable &amp; Intelligent<br />Expense Management System</h1>
      <p style="color: rgb(204, 204, 204); font-size: 16px; width: 500px; margin-left: auto; margin-right: auto;">Simplify expense management and payables processing so you can focus on the important things — like growing your business!</p>  
    </div>
    
  </div>
</div>
<div class="jumbotron" id="" style="background: #EEF5F9;">
  <div class="container">
    <div class="row text-center no-margin">
      <h2>Features &amp; Benefits</h1>
    </div>

    <div class="row no-margin landing-feature">
      <div class="col-lg-5 col-lg-offset-1">
        <h3 style="">Super Fast Reporting</h3>
        <p>
          Employees can generate expense reports on the fly for the expenses incurred, have them reviewed by their manager and claim reimbursements 10x faster than traditional process.  
        </p>
      </div>

      <div class="col-lg-6 text-center">
        <%= image_tag("landing/features/stopwatch.png", class: "img-responsive", style: "height: 250px; margin-top: -40px; display: inline;") %>
      </div>
    </div>
    <div class="row no-margin landing-feature">
      <div class="col-lg-6 text-center">
        <!-- Image/Animation -->
        <%= image_tag("landing/features/policy.png", class: "img-responsive", style: "height: 230px; display: inline;") %>
      </div>

      <div class="col-lg-5">
        <h3 style="">Policy Compliance</h3>
        <p>
          Flexibility to set expense reporting compliance rules and enforce your own spending policies. Spending limits and expense policies are built right into the system, so your employees will know immediately when an expense report falls outside company policy.
        </p>
      </div>
    </div>

    <div class="row no-margin landing-feature">
      <div class="col-lg-5 col-lg-offset-1">
        <h3 style="">Streamlined Workflow</h3>
        <p>
          Design a multi-level approval workflow to meet your organization’s needs. Approval workflow gives our clients the opportunity to set defined approval paths with various routing rules including approval limits and special approval rules.
        </p>
      </div>

      <div class="col-lg-6 text-center">
        <%= image_tag("landing/features/streamline.png", class: "img-responsive", style: "height: 230px; display: inline;") %>
      </div>
    </div>

    <div class="row no-margin landing-feature">
      <div class="col-lg-6 text-center">
        
        <%= image_tag("landing/features/sync.png", class: "img-responsive", style: "display:inline; height: 200px;") %>
      </div>

      <div class="col-lg-5">
        <h3 style="">Syncronize</h3>
        <p>
          Integrates with your accounting system, allowing you to cut time spent on data entry and easily export the data you need, be it in excel or in PDF format.
        </p>
      </div>
    </div>

    <div class="row no-margin landing-feature">
      <div class="col-lg-5 col-lg-offset-1">
        <h3 style="">Mobile</h3>
        <p>
          Never lose a receipt again! Snap pictures of receipts on the go Create and submit expense reports from your phone Free mobile app for Android.
        </p>
      </div>

      <div class="col-lg-6 text-center">
        <%= image_tag("landing/features/mobile.png", class: "img-responsive", style: "display:inline; height: 200px; clip: rect(0, 100px, 200px, 0);") %>
      </div>
    </div>

    <div class="row no-margin landing-feature">
      <div class="col-lg-6 text-center">
        <%= image_tag("landing/features/analysis.png", class: "img-responsive", style: "display:inline; height: 250px;") %>
      </div>

      <div class="col-lg-5">
        <h3 style="">Thorough Analysis</h3>
        <p>
          Analyze overall expense spending for opportunities to reduce costs and get better insight into company's spend.
        </p>
      </div>
    </div>


  </div>
</div>


