<div id="ohsnap"></div>
<div id="ohsnap-priority"></div>
    

<script type="text/javascript">
  $(document).ready(function() {
    snapNotify = function(obj){
      // console.log "From snap", obj
      ohSnapX()
      for (type in obj) {
        messages = obj[type];
        switch (type) {
          case 'error':
            color = 'red';
            container = 'ohsnap-priority';
            break;
          case 'success':
            color = 'green';
            container = 'ohsnap';
            break;
          case 'failure':
            ({
              color: 'orange'
            });
            container = 'ohsnap-priority';
            break;
          case 'message':
            ({
              color: 'blue'
            });
            container = 'ohsnap';
            break;
          case 'notice':
            ({
              color: 'blue'
            });
            container = 'ohsnap';
            break;
          default:
            ({
              color: 'blue'
            });
            container = 'ohsnap';
        }
        if (messages.length) {
          for (i = 0, len = messages.length; i < len; i++) {
            message = messages[i];
            ohSnap(message, {
              color: color,
              'duration': '9000',
              'container-id': container
            });
          }
        }
      }
    }


    // Dynamic banner content
    ar = ["Instant Expense Reporting", "Immediate Approvals", "Quick Reimbursements", "Zero Paperwork", "Zero Auditing Hassles", "Easy Cash Disbursement", "Realtime Visibility", "Robust Expense Policies"];
    var i = 0;
    timer = setInterval(function(){
      $("#banner-dynamic-content span").fadeOut()
      max = ar.length;
      if(i == max){
        i = 0;
      }
      $("#banner-dynamic-content").html("<span style='display: none;'>" + ar[i] + "</span>");
      $("#banner-dynamic-content span").fadeIn()


      i++;
    }, 2500);

    //carousels options
    $('#quote-carousel').carousel({
      pause: true, interval: 10000
    });

    $("#carousel-stakeholder-mobile").carousel({
      pause: true, interval: 10000
    });

    $("#modal-play-video").on('hidden.bs.modal', function (e) {
      $("#modal-play-video iframe").attr("src", $("#modal-play-video iframe").attr("src"));
    });

    // $(".btn-request-demo").on('click', function(e) {
    //   e.preventDefault();
    //   // $(window).scrollTop(document.getElementById('request-for-demo').offsetTop - 50);
    // });

    $(".form-request-demo, .form-request-demo-mobile").on('submit', function(e){
      e.preventDefault();
      form = this

      $.ajax({
        url: '/welcome/preview',
        data: $(form).serialize(),
        type: "POST",
        dataType: 'json',
        success: function(res){
          // console.log(res);
          if(res.success === true){
            if($(form).closest('.modal').length >= 0){
              $(form).closest('.modal').modal('hide')
            }
            ohSnap("Thank you for the request! We will contact you soon", {color: 'green', 'duration': '6000'});
          } else {
            snapNotify(res.messages)
            // ohSnap("Something went wrong. Please try again.", {color: 'red', 'duration': '6000'});
          }
        }
      });
    });
  });
</script>