<div class="jumbotron" style="background-color: #F2F2F2; color: white;">
  <div class="container">
    <h2 class="text-center" style="color: #456B9F;">Join Us</h2>
    <div class="row">
      <div class="col-lg-6 text-center">
        <%= image_tag("landing/contact-us.png", class: 'img-responsive', style: "height: 290px; display: inline;") %>
      </div>

      <div class="col-lg-5 col-lg-offset-1">
        <div style="display: inline-block; vertical-align: middle; height: 100%;">
          <p style="color: #565656; font-size: 24px; font-weight: 500;">Interested in joining us early?<br />Leave us your contact details.</p>
          <form data-remote data-turboboost method="post" action="<%= %>">
            <input name="authenticity_token" value="<%= form_authenticity_token %>" hidden="hidden">
            <div class="form-group">
              <input class="contact-fields inputWorkEmail" name="register[email]" type="text" placeholder="Work Email"><br />
              <input class="contact-fields inputWorkMobile" name="register[mobile]" type="text" placeholder="Phone Number">
            </div>
            <button id="addComment" class="contact-button btn btn-xs btn-success requestDemo" type="submit">Request Early Access</button>
          </form>  
        </div>
      </div>
    </div><!-- .row -->
    <div class="row">
      <div class="row no-margin">
        <h2 class="text-center" style="font-weight: 100px; color: #456B9F;">We are social</h2>
        <div class="text-center">
          <a href="http://facebook.com">
            <%= image_tag("landing/social/facebook.png", height: "50", class: "social-icons") %>
          </a>
          <a href="#">
            <%= image_tag("landing/social/twitter.png", height: "50", class: "social-icons") %>
          </a>
          <a href="#">
            <%= image_tag("landing/social/linkedin.png", height: "50", class: "social-icons") %>
          </a>
          <a href="#">
            <%= image_tag("landing/social/instgram.png", height: "50", class: "social-icons") %>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>


