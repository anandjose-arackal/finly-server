<script type="text/javascript">
  $(document).ready(function() {
    snapNotify = function(obj){
      // console.log "From snap", obj
      ohSnapX()
      for (type in obj) {
        messages = obj[type];
        switch (type) {
          case 'error':
            color = 'red';
            container = 'ohsnap-priority';
            break;
          case 'success':
            color = 'green';
            container = 'ohsnap';
            break;
          case 'failure':
            ({
              color: 'orange'
            });
            container = 'ohsnap-priority';
            break;
          case 'message':
            ({
              color: 'blue'
            });
            container = 'ohsnap';
            break;
          case 'notice':
            ({
              color: 'blue'
            });
            container = 'ohsnap';
            break;
          default:
            ({
              color: 'blue'
            });
            container = 'ohsnap';
        }
        if (messages.length) {
          for (i = 0, len = messages.length; i < len; i++) {
            message = messages[i];
            ohSnap(message, {
              color: color,
              'duration': '9000',
              'container-id': container
            });
          }
        }
      }
    }

    $(".btn-download").on('click', function(e){
      var file_index = $(this).attr('data-file-index');
      img_src = $(this).closest('.resource').find('img').attr('src');
      console.log(file_index, img_src);

      $("#modal-download-resources").find('input.input-file-index').val(file_index);
      $("#modal-download-resources").find('.modal-resource-preview').attr('src', img_src);
    })

    $(".form-request-demo").on('submit', function(e){
      e.preventDefault();
      form = this;

      $.ajax({
        url: '/welcome/preview',
        data: $(form).serialize(),
        type: "POST",
        dataType: 'json',
        success: function(res){
          // console.log(res);
          if(res.success === true){
            ohSnap("Thank you for the request! We will contact you soon.", {color: 'green', 'duration': '6000'});
            if($(form).closest('.modal').length >= 0){
              $(form).closest('.modal').modal('hide')
            }
          } else {
            snapNotify(res.messages)
            // ohSnap("Something went wrong. Please try again.", {color: 'red', 'duration': '6000'});
          }
        }
      });
    });

    $(".form-download-resources").on('submit', function(e){
      e.preventDefault();
      form = this

      $.ajax({
        url: '/download_resources',
        data: $(form).serialize(),
        type: "POST",
        dataType: 'json',
        success: function(res){
          // console.log(res);
          if(res.success === true){
            ohSnap("Thank you. Resource file will start downloading in a bit.", {color: 'green', 'duration': '6000'});
            win =  window.open(res.file_src, '_blank');
            win.focus();
            // window.location = res.file_src



            if($(form).closest('.modal').length >= 0){
              $(form).closest('.modal').modal('hide');
            }
            // $("#resource-downloader").attr('href', res.file_src);
            // $("#resource-downloader").click();
          } else {
            snapNotify(res.messages)
            // ohSnap("Something went wrong. Please try again.", {color: 'red', 'duration': '6000'});
          }
        }
      });
    });

  });
</script>