                  <label class="col-md-4 control-label" for="name">Name</label>  
                  <div class="col-md-4">
                  <input id="name" name="request[name]" placeholder="Your Name" class="form-control input-md" type="text">
                    
                  </div>
                </div>

                <!-- Text input-->
                <div class="form-group">
                  <label class="col-md-4 control-label" for="email">Email</label>  
                  <div class="col-md-4">
                  <input id="email" name="request[email]" placeholder="Your Work Email" class="form-control input-md" type="text">
                    
                  </div>
                </div>

                <!-- Text input-->
                <div class="form-group">
                  <label class="col-md-4 control-label" for="phonenumber">Mobile Number</label>  
                  <div class="col-md-4">
                  <input id="phonenumber" name="request[phone_number]" placeholder="Your Contact Number" class="form-control input-md" type="text">
                    
                  </div>
                </div>

                <!-- Button -->
                <div class="form-group">
                  <label class="col-md-4 control-label" for="submit"></label>
                  <div class="col-md-4">
                    <button id="submit" name="submit" class="btn btn-primary">Download</button>
                  </div>
                </div>

              </fieldset>
            </form>
 
          </div>
        </div>
      </div>
    </div> 
  </div>
</div>

