<div id="backbone-container">
</div>

<input type="hidden" id="current_user_id" value="<%= current_user.id %>">

<%= hidden_field_tag :authenticity_token, form_authenticity_token %>
<input name="utf8" id="form_utf8" type="hidden" value="&#x2713;"/>

<div style="display: none;">
  <select name="" id="newExpenseCategory">
    <% current_company.active_categories.each do |cat| %>
        <option value="<%= cat.id %>"><%= cat.name %></option>
    <% end %>
  </select>

  <input type="hidden" id="data-nav-company" value="<%= current_company.name %>">

  <ul id="menu-nav-views-dropdown">
    <% if current_user.admin? %>
      <li><a href='#reports/params={"view":"admin"}' class="navbar-view-type" data-view-type="admin">Admin View</a></li>
    <% end %>
    <% if current_user.finance_manager? %>
      <li><a href='#reports/params={"view":"finance_manager"}' class="navbar-view-type" data-view-type="finance_manager">Finance View</a></li>
    <% end %>
    <% if current_user.manager? %>
      <li><a href='#reports/params={"view":"manager"}' class="navbar-view-type" data-view-type="manager">Manager View</a></li>
    <% end %>
    <% if current_user.employee? %>
      <li><a href="#" class="navbar-view-type" data-view-type="personal">Personal View</a></li>
    <% end %>
  </ul>

  <% views = YAML.load_file("#{Rails.root}/config/data/view_wise_data.yml") %>
  <ul id="navbar-cog-navigation-admin">
    <% if current_user.admin? %>
      <% views["admin"]["links"]["cog"].each do |item| %>
        <% item.select do |key, value| %>
          <% if value == '/users/' %>
            <li><a target="_blank" class="navbar-menu-li non-backbone-link" data-path="<%= value + current_user.id.to_s + '/profile' %>" href="<%= value + current_user.id.to_s + '/profile' %>"><%= key %></a></li>
          <% else %>
            <!-- Special Functionality for my balance -->
            <% if key =~ /balance/i %>
              <li><a href="#" data-toggle="modal" data-target="#modal-balance"><%= key %></a></li>
            <% elsif key =~ /transfer/i %>
              <li><a href="<%= value %>" target="_blank"><%= key %></a></li>
            <% else %>
              <li><a target="_blank" class="navbar-menu-li non-backbone-link" data-path="<%= value %>" href="<%= value %>"><%= key %></a></li>
            <% end %>
          <% end %>

        <% end %>
      <% end %>
    <% elsif current_user.finance_manager? %>
      <% views["finance_manager"]["links"]["cog"].each do |item| %>
        <% item.select do |key, value| %>
          <% if value == '/users/' %>
            <li><a target="_blank" class="navbar-menu-li non-backbone-link" data-path="<%= value + current_user.id.to_s + '/profile' %>" href="<%= value + current_user.id.to_s + '/profile' %>"><%= key %></a></li>
          <% else %>
            <% if key =~ /balance/i %>
              <li><a href="#" data-toggle="modal" data-target="#modal-balance"><%= key %></a></li>
            <% else %>
              <li><a target="_blank" class="navbar-menu-li" data-path="<%= value %>" href="<%= value %>"><%= key %></a></li>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% elsif current_user.manager? %>
      <% views["manager"]["links"]["cog"].each do |item| %>
        <% item.select do |key, value| %>
          <% if value == '/users/' %>
            <li><a target="_blank" class="navbar-menu-li non-backbone-link" data-path="<%= value + current_user.id.to_s + '/profile' %>" href="<%= value + current_user.id.to_s + '/profile' %>"><%= key %></a></li>
          <% else %>
            <% if key =~ /balance/i %>
              <li><a href="#" data-toggle="modal" data-target="#modal-balance"><%= key %></a></li>
            <% else %>
              <li><a target="_blank" class="navbar-menu-li" data-path="<%= value %>" href="<%= value %>"><%= key %></a></li>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% elsif current_user.employee? %>
      <% views["personal"]["links"]["cog"].each do |item| %>
        <% item.select do |key, value| %>
          <% if value == '/users/' %>
            <li><a target="_blank" class="navbar-menu-li non-backbone-link" data-path="<%= value + current_user.id.to_s + '/profile' %>" href="<%= value + current_user.id.to_s + '/profile' %>"><%= key %></a></li>
          <% else %>
            <% if key =~ /balance/i %>
              <li><a href="#" data-toggle="modal" data-target="#modal-balance"><%= key %></a></li>
            <% else %>
              <li><a target="_blank" class="navbar-menu-li" data-path="<%= value %>" href="<%= value %>"><%= key %></a></li>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </ul>

  <ul id="navbar-menu-navigation-admin">
    <% if current_user.admin?%>
      <% views["admin"]["links"]["primary_navbar"].each do |item| %>
        <% item.select do |key, value| %>
          <li><a class="navbar-menu-li" data-path="<%= value %>" href='#<%= value %>/params={"view":"admin"}'><%= key %></a></li>
        <% end %>
      <% end %>
    <% end %>
  </ul>

  <ul id="navbar-menu-navigation-personal">
    <% if current_user.employee? %>
      <% views["personal"]["links"]["primary_navbar"].each do |item| %>
        <% item.select do |key, value| %>
          <% unless value == 'settlements' %>
            <li><a class="navbar-menu-li" data-path="<%= value %>"  href='#<%= value %>/params={"view":"personal"}'><%= key %></a></li>
          <% else %>
            <li><a class="navbar-menu-li" data-path="<%= value + '/' + current_user.id.to_s %>"  href='#<%= value + "/" + current_user.id.to_s %>'><%= key %></a></li>
          <% end %>
        <% end %>
      <% end %>
    <% end %>   
  </ul>

  <ul id="navbar-menu-navigation-manager">
    <% if current_user.manager? %>
      <% views["manager"]["links"]["primary_navbar"].each do |item| %>
        <% item.select do |key, value| %>
          <li><a class="navbar-menu-li" data-path="<%= value %>" href='#<%= value %>/params={"view":"manager"}'><%= key %></a></li>
        <% end %>
      <% end %>
    <% end %>   
  </ul>

  <ul id="navbar-menu-navigation-finance">
    <% if current_user.finance_manager? %>
      <% views["finance_manager"]["links"]["primary_navbar"].each do |item| %>
        <% item.select do |key, value| %>
          <li><a class="navbar-menu-li" data-path="<%= value %>" href='#<%= value %>/params={"view":"finance_manager"}'><%= key %></a></li>
        <% end %>
      <% end %>
    <% end %>   
  </ul>
</div>

<div id="ohsnap"></div>
<div id="ohsnap-priority"></div>

<div class="modal fade" tabindex="-1" role="dialog" id="modal-balance">
  <div class="modal-dialog" role="document" style="width: 40%;">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title">My Balance</h4>
      </div>
      <div class="modal-body" data-user-id="<%= current_user.id %>">
      </div>
    </div><!-- /.modal-content -->
  </div><!-- /.modal-dialog -->
</div><!-- /.modal -->

<div class="modal fade in" tabindex="-1" role="dialog" id="modal-global-transfer">
  <div class="modal-dialog" role="document" style="width: 40%;">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
        <h4 class="modal-title">Load Funds into Card</h4>
      </div>
      <div class="modal-body">
        
      </div>
    </div><!-- /.modal-content -->
  </div><!-- /.modal-dialog -->
</div>
