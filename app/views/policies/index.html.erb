<body style="background-color: #f5f6f9;">


<div style="margin-top: 20px;background: white;
    padding: 15px;border: 1px solid #d8d8d8; width: 650px;float: left">
  <p style="font-size: 24px;
      font-weight: 600;
      font-family: 'Roboto Condensed', 'Helvetica Neue', Helvetica, sans-serif;">Policies you are Admin for: </p>

  <hr>

  <% unless @policies.present? %>
      <div>
        <p> No Policies to Display.</p>
      </div>
  <% end %>


  <div id="policyListTable">

    <% @policies.each do |policy| %>

        <table>
          <thead>
          <tr>
            <th style="width: 50%;"><%= link_to policy.name, policy %></th>
            <th style="width:  50%;"></th>
          </tr>
          </thead>


          <!-- deleting a particular policy -->
          <form data-remote data-turboboost method="post" action="<%= %>" id="deletePolicy<%= policy.id %>"></form>
          <input name="_method" type="hidden" value="delete"/>
          <input name="authenticity_token" value="<%= form_authenticity_token %>" hidden="hidden">

          <tr>
            <td style="width: 30%;">
              <% link_to policy.name, policy %></td>
            <td style="width: 40%;">
              <a id="showReportsButton" class="btn btn-primary green-button" href="<%= reports_path(view: params[:view]) %>">View
                Reports</a>
              <i class="fa fa-trash-o"></i></td>
          </tr>

        </table>

    <% end %>
  </div>


</div>

</body>



<script>

    function validate() {
        var x;
        x = document.getElementById("policyName").value.trim();
        if (x == "") {
            alert("Enter a Policy Name");
            return false;
        }
        ;
    }

    function getPolicyReportsPath(policyId) {

        path = '/admin/company/reports?filter_policy_id=' + policyId;

        return path;

    }

</script>

