  function userSettingsModal(id) {
    // get the current info in html table
    var name = $('#policy_member_' + id + '_name').val();
    var email_id = $('#policy_member_' + id + '_email_id').val();
    var is_employee = $('#policy_member_' + id + '_is_employee').val();
    var is_admin = $('#policy_member_' + id + '_is_admin').val();
    var manager_id = $('#policy_member_' + id + '_manager_id').val();
    var conditional_manager_id = $('#policy_member_' + id + '_conditional_manager_id').val();
    var conditional_manager_amount = $('#policy_member_' + id + '_conditional_manager_amount').val();
    var finance_manager_id = $('#policy_member_' + id + '_finance_manager_id').val();
    var conditional_finance_manager_id = $('#policy_member_' + id + '_conditional_finance_manager_id').val();
    var conditional_finance_manager_amount = $('#policy_member_' + id + '_conditional_finance_manager_amount').val();
    var is_manager = $('#policy_member_' + id + '_is_manager').val();
    var approves_to = $('#policy_member_' + id + '_approves_to').val();
    var conditional_approves_to = $('#policy_member_' + id + '_conditional_approves_to').val();
    var conditional_approves_to_amount = $('#policy_member_' + id + '_conditional_approves_to_amount').val();
    var is_finance_manager = $('#policy_member_' + id + '_is_finance_manager').val();
    var approves_finance_to = $('#policy_member_' + id + '_approves_finance_to').val();
    var conditional_approves_finance_to = $('#policy_member_' + id + '_conditional_approves_finance_to').val();
    var conditional_approves_finance_to_amount = $('#policy_member_' + id + '_conditional_approves_finance_to_amount').val();
    var default_mapping_id = $('#policy_member_' + id + '_default_mapping_id').val();
    var conditional_manager_mapping_id = $('#policy_member_' + id + '_conditional_manager_mapping_id').val();
    var conditional_finance_manager_mapping_id = $('#policy_member_' + id + '_conditional_finance_manager_mapping_id').val();
    var conditional_approves_to_mapping_id = $('#policy_member_' + id + '_conditional_approves_to_mapping_id').val();
    var conditional_approves_finance_to_mapping_id = $('#policy_member_' + id + '_conditional_approves_finance_to_mapping_id').val();

    document.getElementById("policyMemberEmailId").textContent = email_id;
    $('#policyMemberSettingsUserId').val(id);
    $('#policyMemberManagerSelector').val(manager_id);
    $('#policyMemberManagerConditionalAmount').val(conditional_manager_amount);
    $('#policyMemberManagerConditionalSelector').val(conditional_manager_id);
    $('#policyMemberFinanceManager').val(finance_manager_id);
    $('#policyMemberFinanceManagerConditionalManager').val(conditional_finance_manager_id);
    $('#policyMemberFinanceManagerConditionalAmount').val(conditional_finance_manager_amount);
    $('#policyMemberApprovesToSelector').val(approves_to);
    $('#policyMemberApprovesToConditionalSelector').val(conditional_approves_to);
    $('#policyMemberApprovesToConditionalAmount').val(conditional_approves_to_amount);
    $('#policyMemberApprovesFinanceToSelector').val(approves_finance_to);
    $('#policyMemberApprovesFinanceToConditionalSelector').val(conditional_approves_finance_to);
    $('#policyMemberApprovesFinanceToConditionalAmount').val(conditional_approves_finance_to_amount);
    $('#policyMemberSettingsDefaultMappingId').val(default_mapping_id);
    $('#policyMemberSettingsManagerMappingId').val(conditional_manager_mapping_id);
    $('#policyMemberSettingsFinanceManagerMappingId').val(conditional_finance_manager_mapping_id);
    $('#policyMemberSettingsApprovesToMappingId').val(conditional_approves_to_mapping_id);
    $('#policyMemberSettingsApprovesFinanceToMappingId').val(conditional_approves_finance_to_mapping_id);

    if (is_admin == "true") {
      $("#dialogAdminTrue").prop("checked", true);
    } else {
      $("#dialogAdminFalse").prop("checked", true);
    }

    if (is_employee == "true") {
      $('#policyMemberSettingsEmployeeSection').show();
    } else {
      $('#policyMemberSettingsEmployeeSection').hide();
    }

    if (is_manager == "true") {
      $('#policyMemberSettingsApprovesToSection').show();
    } else {
      $('#policyMemberSettingsApprovesToSection').hide();
    }

    if (is_finance_manager == "true") {
      $('#policyMemberSettingsApprovesFinanceToSection').show();
    } else {
      $('#policyMemberSettingsApprovesFinanceToSection').hide();
    }

    $('#policyMemberSettings').modal('show');
  }

