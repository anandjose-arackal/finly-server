<body style="overflow: hidden">

<div class="inner" style=" border-bottom: 1px solid #e6e6e6;margin-bottom: 20px;">
  <ul class="innerul">
    <li style="padding: 20px; background: beige">
      <%= @result.policy.name %>
    </li>
    <li class="active" data-switch="#rules"><a href="#" data-turbolinks="false">Rules
      <i class="fa fa-angle-right fa-fw arrow " aria-hidden="true"></i></a>
    </li>
    <% if current_user.policy_admin?(@result.policy) or current_user.admin? %>
    <li data-switch="#policy_members"><a href="#" data-turbolinks="false">Policy Members
      <i class="fa fa-angle-right fa-fw arrow" aria-hidden="true"></i></a>
    </li>
    <% end %>
  </ul>

  <div id="page-2" class="innerdiv" style="background: white; overflow: scroll">

    <!-- Hidden blocks that you show when requested. -->

    <!-- EDIT CATEGORIES -->

    <div class="divsections " id="account_manager" style="display: none">

      <h3 id="divsection_heading">Account Manager</h3>

      <!--<button onclick="temperory()"> add</button>-->

      <p>Please choose the format of the csv, and the respective column names you want to export.</p>

      <hr style="margin-top: 20px">


    </div>

    <% if current_user.policy_admin?(@result.policy) or current_user.admin? %>

    <div class="divsections" id="policy_members" style="display: none">

      <h3 id="divsection_heading">Policy Members</h3>


      <%= render 'policy_members' %>

      <hr style="margin-top: 20px">

    </div>

    <% end %>

    <div class="divsections" id="rules" >

      <h3 id="divsection_heading">Expense Rules</h3>

      <div id="expense-rules">
        <%= render 'expense_rules' %>
      </div>

      <hr style="margin-top: 20px">

      <h3 id="divsection_heading">Budget Rules</h3>
      <div id="budget-rules">
        <%= render 'budget_rules' %>
      </div>

    </div>


  </div>

</div>

<% if current_user.policy_admin?(@result.policy) or current_user.admin? %>

<form data-turboboost hidden="hidden" id="removeUsersFromPolicy" action="<%= policy_remove_users_path(load_params policy_id: @result.policy.id) %>" method="post">
  <input name="authenticity_token" value="<%= form_authenticity_token %>" hidden="hidden">
  <input id="removeUserIds" name="user_id" type="text">
</form>


<div class="modal fade" id="assignExistingUsersToPolicy" role="dialog" style="margin-top: 5%; ">
  <div class="modal-dialog modal-md">
    <div class="modal-content" style="border-radius: 1px">
      <div class="modal-header" style="background-color: #e9e9e9 ; height: 60px">
        <button type="button" class="close" style="opacity: 0.7" data-dismiss="modal">&times;</button>

        <form data-turboboost hidden="hidden"  id="addUsersToPolicyForm" method="post">
          <input name="authenticity_token" value="<%= form_authenticity_token %>" hidden="hidden">
          <input id="addUserToPolicyIds" name="users_id" type="text">
        </form>

        <button id="addUsersToPolicyButton" onclick="addUsersToPolicyFromList()" type="button" style="float: right;
            background: #465c8b;
            margin-right: 20px;
            color: white;
            font-size: 10px;outline: none;
            padding: 5px;
            letter-spacing: 1px;display: none">INVITE
        </button>


        <h4 class="modal-title" style="font-weight: 400;border-bottom: #d8d8d8">Invite Employees To Policy</h4>
      </div>
      <div class="modal-body" style="padding: 0">

        <form data-remote data-turboboost  id="usersPolicyList" action="<%= policy_invitable_users_path(load_params policy_id: @result.policy.id) %>" method="post" style="float: left;width: 25%;">
          <input name="authenticity_token" value="<%= form_authenticity_token %>" hidden="hidden">
          <section id="filterSection">
            <div style="font-size: 18px;
                margin-left: 20px;
                margin-top: 10px;
                margin-bottom: 10px;"> Filters
            </div>
            <input id="filterUserName" name="filter_name" style="width: 81%;margin-left: 20px; padding: 5px;" placeholder="User Name">
            <input id="filterUserMailId" name="filter_email" style="width: 81%;margin-left: 20px;margin-top: 10px; padding: 5px;" placeholder="User Email Id">


            <p style="margin-left: 20px;
                font-size: 18px;
                margin-top: 15px;">Managed by:</p>
            <select name="filter_manager_id" class="selectors" style="width: 81%;margin-left: 20px; padding: 5px;margin-top: 10px" onchange="$('form#usersPolicyList').submit();">
              <option value="" selected="selected">None</option>
              <% if @result.company_managers.present? %>
                  <% @result.company_managers.each do |manager| %>
                      <option value="<%= manager.id %>"><%= manager.name %></option>
                  <% end %>
              <% end %>
            </select>
          </section>
        </form>
        <section id="addUsersSection" style="background-color: white;margin-left: 25%; min-height: 250px;
            width: 75%; border-left: 1px solid #d8d8d8">
          <div class="row" style="margin: 0;font-size: 10px; text-align: left; padding: 10px 0 10px 0;height: 30px;border-bottom: 1px solid #d8d8d8;">
            <div class="col-md-1"><input type="checkbox" id="checkAll" style="margin-right: 4px"></div>
            <div class="col-md-3" style="padding-left: 20px">User Name</div>
            <div class="col-md-4" style="padding-left: 25px">Email Id</div>
            <div class="col-md-4" style="text-align: center;padding-left: 38px">Manager</div>
          </div>
          <div id="invitableUsersContainer">
          </div>
          <form data-remote data-turboboost hidden="hidden"  id="addUsersToPolicy" action="<%= policy_add_users_path(load_params policy_id: @result.policy.id) %>" method="post">
            <input name="authenticity_token" value="<%= form_authenticity_token %>" hidden="hidden">
            <input id="addUserIds" name="user_id" type="text">
          </form>
        </section>
      </div>
    </div>
  </div>
</div>


    <div class="modal fade" id="inviteUsersToPolicy" role="dialog" style="margin-top: 5%; ">
      <div class="modal-dialog modal-md">
        <form data-remote data-turboboost id="inviteMembersForm" action="<%= pending_invites_path %>" method="post">
          <input name="authenticity_token" value="<%= form_authenticity_token %>" type="hidden">
          <input name="pending_invite[company_id]" value="<%= current_company.id %>" type="hidden">

          <div class="modal-content">
            <div class="modal-header">
              <button type="button" class="close" style="opacity: 0.7" data-dismiss="modal">&times;</button>
              <h4 class="modal-title">INVITE TEAM
                MEMBERS</h4>
            </div>
            <p style="font-size: 14px;
                font-family: 'Roboto Condensed', 'Helvetica Neue', Helvetica, sans-serif;
                text-transform: uppercase;
                font-weight: 400; padding: 20px 0 5px 40px;
                color: #777;">Email</p>

            <input type="text" name="pending_invite[email]" class="dialogInputStyle" placeholder="example@company.com, two@asa.com">
        <textarea class="dialogInputStyle" id="modalInputComment" class="form-control" name="pending_invite[note]"
                  placeholder="Add a note (optional)" style="margin-top: 20px;"></textarea>


            <% if current_user.admin? %>

                <label class="editProfileDialogHeaders">Assign Admin Role?</label>

                <label class="radio-inline" style="font-size: 12px">
                  <input id="adminTrue" type="radio" name="admin" style="font-size: 8px" value="1">Yes
                </label>
                <label class="radio-inline" style="font-size: 12px">
                  <input id="adminFalse" type="radio" name="admin" value="0" checked="checked" style="font-size: 8px">No
                </label>

            <% end %>

            <hr style=" margin: 15px 0 0 0">

            <% if current_user.admin? or current_user.manager? %>

                <label class="editProfileDialogHeaders">Assign Manager Role?</label>

                <label class="radio-inline" style="font-size: 12px">
                  <input id="managerTrue" type="radio" name="manager" onclick="displayApprovesReports(true)" style="font-size: 8px" value="1">Yes
                </label>
                <label class="radio-inline" style="font-size: 12px">
                  <input id="managerTrue" type="radio" name="manager" onclick="displayApprovesReports(false)" value="0" checked="checked" style="font-size: 8px">No
                </label>

                <div id="approvesReportsTo" style="display: none">
                  <label class="editProfileDialogHeaders">Approves Reports To : </label>

                  <% if current_user.admin? %>

                      <select form="inviteMembersForm" id="userManager" name="pending_invite[team_mapping_attributes][approves_to_id]"
                              class="selectors">
                        <option value=""></option>
                        <% @result.company_managers.each do |manager| %>
                            <option value="<%= manager.id %>"><%= manager.name %></option>
                        <% end %>

                      </select>

                  <% else %>

                      <%= current_user.name %>
                      <input name="pending_invite[approves_to_id]" value="<%= current_user.id %>" type="hidden">

                  <% end %>

                </div>

            <% end %>

            <hr style=" margin: 15px 0 0 0">

            <% if current_user.admin? or current_user.finance_manager? %>

                <label class="editProfileDialogHeaders">Assign Finance Manager Role?</label>

                <label class="radio-inline" style="font-size: 12px">
                  <input id="financeManagerTrue" type="radio" name="finance_manager" onclick="displayApprovesFinanceReports(true)" style="font-size: 8px" value="1">Yes
                </label>
                <label class="radio-inline" style="font-size: 12px">
                  <input id="financeManagerTrue" type="radio" name="finance_manager" onclick="displayApprovesFinanceReports(false)" value="0" checked="checked" style="font-size: 8px">No
                </label>

                <div id="approvesFinanceReports" style="display: none">
                  <label class="editProfileDialogHeaders">Approves Finance Reports To : </label>

                  <% if current_user.admin? %>

                      <select form="inviteMembersForm" id="userFinanceManager" name="pending_invite[team_mapping_attributes][approves_finance_to_id]"
                              class="selectors">
                        <option value=""></option>
                        <% @result.company_finance_managers.each do |finance_manager| %>
                            <option value="<%= finance_manager.id %>"><%= finance_manager.name %></option>
                        <% end %>
                      </select>

                  <% else %>

                      <%= current_user.name %>
                      <input name="pending_invite[approves_finance_to_id]" value="<%= current_user.id %>" type="hidden">

                  <% end %>

                </div>

            <% end %>

            <hr style=" margin: 15px 0 0 0">

            <label class="editProfileDialogHeaders">Managed By :
              <span class="spanEditProfile"> (this is the person who will review user's expenses first)</span>
            </label>

            <% if current_user.admin? or current_user.finance_manager? %>

                <select class="dialogInputStyle" name="pending_invite[team_mapping_attributes][manager_id]" placeholder="( Optional ) Assign Manager" list="suggestionList" id="answerInput">
                  <datalist id="suggestionList">
                    <option value="">None</option>
                    <% @result.company_managers.each do |user| %>
                        <option value="<%= "#{user.id}" %>"><%= "#{user.name}" %></option>
                    <% end %>
                  </datalist>
                </select>

            <% else %>

                <%= current_user.name %>
                <input name="pending_invite[manager_id]" value="<%= current_user.id %>" type="hidden">

            <% end %>


            <hr style=" margin: 15px 0 0 0">


            <label class="editProfileDialogHeaders">Finance Managed By :
              <span class="spanEditProfile"> (this is the person who will reimburse the user's expenses)</span>
            </label>

            <% if current_user.admin? or current_user.manager? %>

                <select class="dialogInputStyle" name="pending_invite[team_mapping_attributes][finance_manager_id]" placeholder="( Optional ) Assign Manager" list="suggestionList" id="answerInput">
                  <datalist id="suggestionList">
                    <option value="">None</option>
                    <% @result.company_finance_managers.each do |user| %>
                        <option value="<%= "#{user.id}" %>"><%= "#{user.name}" %></option>
                    <% end %>
                  </datalist>
                </select>

            <% else %>

                <%= current_user.name %>
                <input name="pending_invite[finance_manager_id]" value="<%= current_user.id %>" type="hidden">

            <% end %>

            <input name="pending_invite[policy_id]" value="<%=@result.policy.id%>" type="hidden">


            <button style="margin-top: 20px" id="inviteUsersSubmitButton" class="green-button sendButton" type="submit">INVITE</button>
          </div>
        </form>
      </div>
    </div>


