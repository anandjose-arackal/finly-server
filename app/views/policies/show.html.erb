  $(document).ready(function () {

    $('[data-toggle="popover"]').popover({
      placement: 'top',
      trigger: 'hover',
      html: true
    });

    $('form#usersPolicyList').submit();

    //setup before functions
    var typingTimer;                //timer identifier
    var doneTypingInterval = 1000;  //time in ms, 1 second for example
    var $input = $('#filterUserName');
    var $input2 = $('#filterUserMailId');

//on keyup, start the countdown
    $input.on('keyup', function () {
      clearTimeout(typingTimer);
      typingTimer = setTimeout(doneTyping, doneTypingInterval);
    });

//on keydown, clear the countdown
    $input.on('keydown', function () {
      clearTimeout(typingTimer);
    });

    //on keyup, start the countdown
    $input2.on('keyup', function () {
      clearTimeout(typingTimer);
      typingTimer = setTimeout(doneTyping, doneTypingInterval);
    });

//on keydown, clear the countdown
    $input2.on('keydown', function () {
      clearTimeout(typingTimer);
    });

//user is "finished typing," do something
    function doneTyping() {
      //do something
      $('form#usersPolicyList').submit();
    }


    $("#checkAll").change(function () {
      $("input:checkbox").prop('checked', $(this).prop("checked"));
    });

  });

  function addUsersToPolicyFromList() {
    var array = []
    $("input:checkbox[name=add_user_id]:checked").each(function () {
      array.push($(this).val());
    });
    $('#addUserIds').val(array);
    $('form#addUsersToPolicy').submit();
  }

  function removeUsersFromPolicyList() {
    var array = []
    $("input:checkbox[name=remove_user_id]:checked").each(function () {
      array.push($(this).val());
    });
    console.log("removeUserIds : " + array);
    $('#removeUserIds').val(array);
    $('form#removeUsersFromPolicy').submit();
  }

  function makeButtonVisible() {

    if ($("input:checkbox:checked").length > 0) {
      $('#addUsersToPolicyButton').show();
    }
    else {
      $('#addUsersToPolicyButton').hide();
    }
  }

