<% if (current_user.admin? or current_user.policy_admin?(@result.policy)) and params[:view] == 'admin' %>
<button id="createNewRule" data-toggle="modal" data-target="#createNewExpenseRuleModal">Create New Rule
</button>
<% end %>

<div>

  <div id="warningDiv">
    <div class="header">
      <img src="<%= image_url("warn_rule") %>">WARNING RULES
    </div>

    <div style="padding: 20px 20px 0 20px">

      <% @result.policy.expense_rules.each do |rule| %>
        <% if rule.rule_type_id == 1 %>
              <!-- deleting a particular rule or warning -->

              <div style="margin-bottom: 15px" class="row">
                <i style="font-size: 18px; color:#93c178" class="fa fa-check col-md-1"></i>
                <span class="col-md-10"><%= rule_in_words rule%></span>

                <% if current_user.admin? or current_user.policy_admin?(@result.policy) %>
                  <%= form_for @result.policy, url: policy_remove_rule_path(@result.policy, view: params[:view]), :html => { :method => :delete, :remote => true } do |f| %>
                    <input name="authenticity_token" value="<%= form_authenticity_token %>" hidden="hidden">
                    <input name="expense_rule_id" type="hidden" value="<%=rule.id%>">
                    <%= button_tag( :class => "btn btn-sm btn-danger", style: "margin: 0;", data: { confirm: 'Are you sure you want to remove this rule?' }) do %>
                      <i class="fa fa-times" role="button"></i>
                    <% end %>
                  <% end %>  
                <% end %>




                

              </div>
        <% end %>
      <% end %>

      <p id="warningPara" onclick="warningDescToggle()" style="color: #6664c7;
          font-weight: 500;
          font-size: 13px;
          border-top: 1px solid rgba(0,0,0,0.1);
          cursor: pointer;
          padding-top: 10px ;"> What is a warning rule?</p>
      <p id="warningParaDesc" style="color: #666;
          font-size: 13px;
          padding-top: 6px ;display: none">Expenses that violate warning rules can be added to the report, but you
        probably
        shouldn’t.
        Before you submit the report
        Finly will display the warnings, and the expense will be badged with a warning icon.</p>
    </div>
  </div>
  <div id="blockingDiv" style="float: right">
    <div class="header">
      <img src="<%= image_url("block_rule") %>">BLOCKING RULES
    </div>
    <div style="padding: 20px 20px 0 20px">

      <% @result.policy.expense_rules.each do |rule| %>
          <% if rule.rule_type_id == 2 %>
              <!-- deleting a particular rule or warning -->
              <div style="margin-bottom: 15px" class="row">
                <i style="font-size: 18px; color:#93c178" class="fa fa-check col-md-1"></i>
                <span class="col-md-10"><%= rule_in_words rule%></span>
                <% if current_user.admin? or current_user.policy_admin?(@result.policy) %>
                  <%= form_for @result.policy, url: policy_remove_rule_path(@result.policy, view: params[:view]), :html => { :method => :delete, :remote => true } do |f| %>
                    <input name="authenticity_token" value="<%= form_authenticity_token %>" hidden="hidden">
                    <input name="expense_rule_id" type="hidden" value="<%=rule.id%>">
                    <%= button_tag( :class => "btn btn-sm btn-danger", style: "margin: 0;", data: { confirm: 'Are you sure you want to remove this rule?' }) do %>
                      <i class="fa fa-times" role="button"></i>
                    <% end %>
                  <% end %>  
                <% end %>
              </div>
          <% end %>
      <% end %>

      <p id="blockingPara" onclick="blockingDescToggle()" style="color: #6664c7;
          font-weight: 500;
          font-size: 13px;
          border-top: 1px solid rgba(0,0,0,0.1);
          cursor: pointer;
          padding-top: 10px; "> What is a blocking rule?</p>

      <p id="blockingParaDesc" style="color: #666;
          font-size: 13px;
          padding-top: 6px ;display: none">You can’t submit reports with expenses that violate blocking rules. The
        blocks will be displayed in the report.</p>
    </div>
  </div>


</div>

<% if (current_user.admin? or current_user.policy_admin?(@result.policy)) and params[:view] == 'admin' %>

<div class="modal fade" id="createNewExpenseRuleModal" role="dialog">
  <div class="modal-dialog modal-md">
    <div class="modal-content" style="border-radius: 1px">
      <div class="modal-header" style="background-color: #e9e9e9 ">

        <button type="button" class="close" style="opacity: 0.7" data-dismiss="modal">&times;</button>
        <h4 class="modal-title" style="text-align: center;text-transform: uppercase;font-weight: 400;border-bottom: #d8d8d8">Add
          New Expense Rule for this Policy</h4>
      </div>
      <div class="modal-body" style="padding: 0 35px 35px 35px">

        <form data-remote="true" name="submitNewRuleForm"  action="<%= policy_add_rule_path(@result.policy, view: params[:view])%>" method="post">
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

          <h5>The rule is...</h5>

          <input type="radio" name="expense_rule[expense_rule_type_id]" target="newRuleAfterDays" value="1" checked>Require
          Receipt
          <br>
          <input type="radio" name="expense_rule[expense_rule_type_id]" target="newRuleAfterDays" value="2">Require Note<br>
          <input type="radio" name="expense_rule[expense_rule_type_id]" target="newRuleAfterDays" value="3">Disallow Expense


          <h5>For the Category... <span>[OPTIONAL]</span></h5>

          <div id="categoriesOthers">
            <input type="radio" name="expense_rule[category_id]" value="">All <br>
               <% @result.categories.each do |cat| %>
                  <input type="radio" name="expense_rule[category_id]" value="<%= cat.id %>"><%= cat.category_name %> <br>
               <% end %>
          </div>


          <h5 id="amountValueOthers">If the Expense Amount is greater than... <span>[OPTIONAL]</span></h5>

          <input name="expense_rule[greater_than_amount_attributes[value]]" type="text" placeholder="0.00">

          <input name="expense_rule[greater_than_amount_attributes[currency_id]]" value="1" type="hidden" placeholder="0.00">

          <div id="newRuleAfterDays">
            <h5>Submitted after... <span>[OPTIONAL]</span></h5>
            <input name="expense_rule[days_after]" type="text" placeholder="0" style="margin-left: 25px">
            <span>day/s of the expense.</span>
          </div>

          <div id="newRuleTypeChooser" style="display:block">
            <h5>Block or Warning? </h5>
            <input type="radio" name="expense_rule[rule_type_id]" value="2" checked>Blocking <br>
            <input type="radio" name="expense_rule[rule_type_id]" value="1">Warning<br>
          </div>

          <button type="submit" class="btn btn-primary btn-sm" id="createPolicy"> Create</button>

        </form>
      </div>
    </div>
  </div>
</div>
<% end %>


<script>

  $(document).ready(function () {
//    $('form#usersPolicyList').submit();
  });

  function warningDescToggle() {
    $('#warningParaDesc').toggle();
  }

  function blockingDescToggle() {
    $('#blockingParaDesc').toggle();
  }

  function autoApprovalDescToggle() {
    $('#autoApprovalParaDesc').toggle();

  }

  function checkIfUsersAreSelected() {
    if ($("input:checkbox:checked").length > 0) {
    }
    else {
      $('#removePolicyMembersAlert').modal('show');

    }
  }

</script>
