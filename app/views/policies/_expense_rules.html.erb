

<div class="row no-margin">
  <div class="col-sm-6 no-padding" style="padding: 10px;">
    <div class="warning-rules" style="background: white; padding: 10px;">
      <div class="row no-margin">
        <div class="col-sm-6 no-padding"><img src="<%= image_url('warn_rule') %>" style="height: 35px; margin-right: 20px;">WARNING RULES</div>
        <div class="col-sm-6 text-right">
          <% if (current_user.admin? or current_user.policy_admin?(@result.policy)) and params[:view] == 'admin' %>
            <button class="btn-create-rule btn btn-primary btn-sm">Create New Rule</button>
          <% end %>         
        </div>
      </div>
      <div class="row no-margin">
        <div class="col-sm-12 no-padding"><hr style="margin-top: 10px; margin-bottom: 10px;" /></div>
      </div>
      <div class="row no-margin">
        <% @result.policy.expense_rules.each do |rule| %>
          <% if rule.rule_type_id == 1 %>
            <!-- deleting a particular rule or warning -->
            <div class="col-sm-12 no-padding">
              <div class="col-sm-1">
                <i style="font-size: 18px; color:#93c178" class="fa fa-check"></i>
              </div>
              <div class="col-sm-10">
                <%= rule_in_words rule%>
              </div>
              <div class="col-sm-1 text-right">
                <% if current_user.admin? or current_user.policy_admin?(@result.policy) %>
                  <%= form_for @result.policy, url: policy_remove_rule_path(@result.policy, view: params[:view]), :html => { :method => :delete, :remote => true } do |f| %>
                    <input name="authenticity_token" value="<%= form_authenticity_token %>" hidden="hidden">
                    <input name="expense_rule_id" type="hidden" value="<%=rule.id%>">
                    <%= button_tag( :class => "btn btn-sm btn-danger", style: "margin: 0;", data: { confirm: 'Are you sure you want to remove this rule?' }) do %>
                      <i class="fa fa-times" role="button"></i>
                    <% end %>
                  <% end %>  
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
      <div class="row no-margin">
        <div class="col-sm-12"><hr style="margin-top: 10px; margin-bottom: 10px;" /></div>
      </div>
      <div class="row no-margin">
        <div class="col-sm-12">
          <p data-toggle="collapse" data-target="#collapseWarningDefinition" aria-expanded="false">
            What is a warning rule?
          </p>
          <div class="collapse" id="collapseWarningDefinition">
            <div class="well">
              <p>
                Expenses that violate warning rules can be added to the report, but you
                probably
                shouldn’t.
                Before you submit the report
                Finly will display the warnings, and the expense will be badged with a warning icon.  
              </p>
            </div>
          </div>
        </div>
      </div>  
    </div>
  </div>

  <div class="col-sm-6 no-padding" style="padding: 10px;">
    <div class="warning-rules" style="background: white; padding: 10px;">
      <div class="row no-margin">
        <div class="col-sm-6 no-padding"><img src="<%= image_url('block_rule') %>" style="height: 35px; margin-right: 20px;">BLOCKING RULES</div>
        <div class="col-sm-6 text-right">
          <% if (current_user.admin? or current_user.policy_admin?(@result.policy)) and params[:view] == 'admin' %>
            <button class="btn-create-rule btn btn-primary btn-sm">Create New Rule</button>
          <% end %>         
        </div>
      </div>
      <div class="row no-margin">
        <div class="col-sm-12 no-padding"><hr style="margin-top: 10px; margin-bottom: 10px;" /></div>
      </div>
      <div class="row no-margin">
        <% @result.policy.expense_rules.each do |rule| %>
          <% if rule.rule_type_id == 2 %>
            <!-- deleting a particular rule or warning -->
            <div class="col-sm-12 no-padding">
              <div class="col-sm-1">
                <i style="font-size: 18px; color:#93c178" class="fa fa-check"></i>
              </div>
              <div class="col-sm-10">
                <%= rule_in_words rule%>
              </div>
              <div class="col-sm-1">
                <% if current_user.admin? or current_user.policy_admin?(@result.policy) %>
                  <%= form_for @result.policy, url: policy_remove_rule_path(@result.policy, view: params[:view]), :html => { :method => :delete, :remote => true } do |f| %>
                    <input name="authenticity_token" value="<%= form_authenticity_token %>" hidden="hidden">
                    <input name="expense_rule_id" type="hidden" value="<%=rule.id%>">
                    <%= button_tag( :class => "btn btn-sm btn-danger", style: "margin: 0;", data: { confirm: 'Are you sure you want to remove this rule?' }) do %>
                      <i class="fa fa-times" role="button"></i>
                    <% end %>
                  <% end %>  
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
      <div class="row no-margin">
        <div class="col-sm-12"><hr style="margin-top: 10px; margin-bottom: 10px;" /></div>
      </div>
      <div class="row no-margin">
        <div class="col-sm-12">
          <p data-toggle="collapse" data-target="#collapseBlockingDefinition" aria-expanded="false">
            What is a blocking rule?
          </p>
          <div class="collapse" id="collapseBlockingDefinition">
            <div class="well">
              <p>
                You can’t submit reports with expenses that violate blocking rules. The
                blocks will be displayed in the report.
              </p>
            </div>
          </div>
        </div>
      </div>  
    </div>
  </div>
</div>





<script>

  $(document).ready(function () {
//    $('form#usersPolicyList').submit();
  });

  function warningDescToggle() {
    $('#warningParaDesc').toggle();
  }

  function blockingDescToggle() {
    $('#blockingParaDesc').toggle();
  }

  function autoApprovalDescToggle() {
    $('#autoApprovalParaDesc').toggle();

  }

  function checkIfUsersAreSelected() {
    if ($("input:checkbox:checked").length > 0) {
    }
    else {
      $('#removePolicyMembersAlert').modal('show');

    }
  }

</script>
