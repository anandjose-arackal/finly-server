<div class="modal-dialog" style="width: 60%;">
  <div class="modal-content" style="border-radius: 1px">
    <div class="modal-header" style="background-color: #e9e9e9;">
      <button type="button" class="close" style="opacity: 0.7" data-dismiss="modal">&times;</button>
      <h4 class="modal-title" style="font-weight: 400;border-bottom: #d8d8d8">Policy Member settings</h4>

    </div>

    <form data-remote data-turboboost hidden="hidden"  id="updateUserPolicyConfiguration" action="<%= policy_update_user_configuration_path(load_params policy_id: @result.policy.id) %>" method="post">
      <input name="authenticity_token" value="<%= form_authenticity_token %>" hidden="hidden">
      <input name="_method" type="hidden" value="patch"/>
    </form>

    <div class="modal-body">
      <label style="margin-top: 0">User Name: </label>
      <span id="policyMemberEmailId" style="margin-left: 30px">MaryJain@spidey.com</span>
      <label>Policy Admin
        <span style="font-size: 10px; font-weight: 400 "> (Policy Admins can take control of any of the reports submitted by the employees belonging to this policy)</span>
      </label>

      <div>
        <span class="radio-inline" style="font-size: 12px">
          <input id="dialogAdminTrue" type="radio" form="updateUserPolicyConfiguration" name="policy[admin]" style="font-size: 8px" value="1" form="updateUserForm">Yes
        </span>
        <span class="radio-inline" style="font-size: 12px">
          <input id="dialogAdminFalse" type="radio" form="updateUserPolicyConfiguration" name="policy[admin]" style="font-size: 8px" checked="checked" value="0" form="updateUserForm">No
        </span>
      </div>

      <div class="row no-margin">
        <div class="policy">
          <div class="row policy-name no-margin">
            <div class="col-sm-6">
              <h4>
                <%= @result.map[:policy].name %>
                <input type="hidden" name="user_manager_mapping[0][mapping][policy_id]" value="<%= @result.map[:policy].id %>">
              </h4>
            </div>
          </div>

          <div class="policy-rules row no-margin">
            <form id="form-policy-member-settings">
              <div class="row no-margin" style="padding: 10px 10px 0;">
                <div class="col-sm-12 manager-data manager-container">
                  <div class="row manager non-conditional no-margin">
                    Submits reports To:&nbsp;&nbsp;

                    <input type="hidden" name="user_manager_mapping[0][mapping_id]" value="<%= @result.map[:default][0].id %>">
                    
                    <select class="select-assign-manager form-control item-attr-edit" name="user_manager_mapping[0][mapping][manager_id]" data-default-value="<%= @result.map[:default][0].manager ? @result.map[:default][0].manager.id : '' %>">
                      <option value="">None</option>
                      <% @managers.team_managers.each do |m| %>
                        <option value="<%= m.id %>"><%= m.name %></option>
                      <% end %>
                    </select>
                  </div>
                  
                  <% conditional_manager_count = 0 %>
                  <% @result.map[:conditional_manager].each_with_index do |conditional_manager, index| %>

                  <% conditional_manager_count += 1  %>
                  <div class="row x conditional no-margin" data-condition-serial="<%= index + 1 %>">

                    <div class="col-sm-12 hidden">
                        <input type="number" name="user_manager_mapping[<%= index + 1 %>][mapping][policy_id]" value="<%= @result.map[:policy].id %>">
                      <input type="number" class="mapping-id" name="user_manager_mapping[<%= index + 1 %>][mapping_id]" value="<%= conditional_manager.id %>">
                    </div>

                    <div class="col-sm-3">If report total is greater than:</div>

                    <div class="col-sm-2">
                      </label>
                      <input type="hidden" class="item-attr-edit" name="user_manager_mapping[<%= index + 1 %>][mapping][greater_than_amount_attributes][currency_id]" value="1">
                      <input type="number" class="form-control item-attr-edit" name="user_manager_mapping[<%= index + 1 %>][mapping][greater_than_amount_attributes][value]" value="<%= conditional_manager.greater_than_amount ? conditional_manager.greater_than_amount.value : '' %>">
                    </div>

                    <div class="col-sm-3">then submits report to:</div>

                    <div class="col-sm-3">
                      <select class="select-assign-manager form-control item-attr-edit" name="user_manager_mapping[<%= index + 1 %>][mapping][manager_id]" data-default-value="<%= conditional_manager.manager ? conditional_manager.manager.id : '' %>">
                        <option value="">None</option>
                        <% @managers.team_managers.each do |m| %>
                          <option value="<%= m.id %>"><%= m.name %></option>
                        <% end %>
                      </select>
                    </div>
                    <div class="col-sm-1">
                      <button class="item-attr-edit btn btn-xs btn-danger btn-remove-condition">Remove</button>
                    </div>
                  </div><!-- .conditional -->
                  <% end %>

                  <div class="col-sm-12 add-condition">
                    <button class="btn btn-sm btn-default btn-add-condition item-attr-edit" data-policy-id="<%= @result.map[:policy] %>" data-manager-type="manager">Add Condition</button>
                  </div>
                </div><!-- .col-sm-12 -->
                <hr />
                <div class="col-sm-12 finance-manager-data manager-container">
                  <div class="row finance-manager non-conditional no-margin">
                    Submits Report Finance to:&nbsp;&nbsp;

                    <select class="select-assign-manager form-control item-attr-edit" name="user_manager_mapping[0][mapping][finance_manager_id]" data-default-value="<%= @result.map[:default][0].finance_manager ? @result.map[:default][0].finance_manager.id : '' %>">
                      <option value="">None</option>
                      <% @managers.team_finance_managers.each do |m| %>
                        <option value="<%= m.id %>"><%= m.name %></option>
                      <% end %>
                    </select>

                  </div>

                  <% conditional_finance_manager_count = 0 %>
                  <% @result.map[:conditional_finance_manager].each_with_index do |conditional_finance_manager, index| %>

                  <% conditional_finance_manager_count += 1 %>
                  <div class="row finance-manager conditional no-margin" data-condition-serial="<%= conditional_manager_count + index + 1 %>">
                    <div class="col-sm-12 hidden">
                      <input type="number" name="user_manager_mapping[<%= conditional_manager_count + index + 1 %>][mapping][policy_id]" value="<%= @result.map[:policy].id %>">

                      <input type="number" class="mapping-id" name="user_manager_mapping[<%= conditional_manager_count + index + 1 %>][mapping_id]" value="<%= conditional_finance_manager.id %>">
                    </div>

                    <div class="col-sm-3">If report total is greater than:</div>

                    <div class="col-sm-2">
                      <input type="hidden" class="item-attr-edit" name="user_manager_mapping[<%= conditional_manager_count + index + 1 %>][mapping][greater_than_amount_attributes][currency_id]" value="1">
                      <input type="number" class="form-control item-attr-edit" name="user_manager_mapping[<%= conditional_manager_count + index + 1 %>][mapping][greater_than_amount_attributes][value]" value="<%= conditional_finance_manager.greater_than_amount ?  conditional_finance_manager.greater_than_amount.value : '' %>">
                    </div>

                    
                    <div class="col-sm-3">then submits report finance to:</div>



                    <div class="col-sm-3">
                      <select class="select-assign-manager form-control item-attr-edit" name="user_manager_mapping[<%= conditional_manager_count + index + 1 %>][mapping][finance_manager_id]" data-default-value="<%= conditional_finance_manager.finance_manager ? conditional_finance_manager.finance_manager.id : '' %>">
                        <option value="">None</option>
                        <% @managers.team_finance_managers.each do |m| %>
                          <option value="<%= m.id %>"><%= m.name %></option>
                        <% end %>
                      </select>
                    </div>

                    <div class="col-sm-1"><button class="item-attr-edit btn btn-xs btn-danger btn-remove-condition">Remove</button></div>

                  </div><!-- .conditional -->
                  <% end %>
                  <div class="col-sm-12 add-condition">
                    <button class="btn btn-sm btn-default btn-add-condition item-attr-edit" data-policy-id="<%= @result.map[:policy] %>" data-manager-type="finance_manager">Add Condition</button>
                  </div>
                </div><!-- .col-sm-12 -->
              </div><!-- .row -->

              <div class="row no-margin" style="padding:0 10px;">
                <% if @target_user.manager? %>
                <div class="col-sm-12 approves-to-data manager-container">
                  <div class="row approves-to non-conditional no-margin">
                    Approves To:&nbsp;&nbsp;
                    

                    <select class="select-assign-manager form-control item-attr-edit" name="user_manager_mapping[0][mapping][approves_to_id]" data-default-value="<%= @result.map[:default][0].approves_to ? @result.map[:default][0].approves_to.id : '' %>">
                      <option value="">None</option>
                      <% @managers.team_managers.each do |m| %>
                        <option value="<%= m.id %>"><%= m.name %></option>
                      <% end %>
                    </select>

                  </div>
                  <% conditional_approves_to_count = 0 %>
                  <% @result.map[:conditional_approves_to].each_with_index do |conditional_approves_to, index| %>

                  <% conditional_approves_to_count += 1 %>
                  <div class="row conditional approves_to no-margin" data-condition-serial="<%= conditional_manager_count + conditional_finance_manager_count + index + 1 %>">

                    <div class="col-sm-12 hidden">  
                      <input type="number" name="user_manager_mapping[<%= conditional_manager_count + conditional_finance_manager_count + index + 1 %>][mapping][policy_id]" value="<%= @result.map[:policy].id %>">

                      <input type="number" class="mapping-id" name="user_manager_mapping[<%= conditional_manager_count + conditional_finance_manager_count + index + 1 %>][mapping_id]" value="<%= conditional_approves_to.id %>">
                    </div>

                    <div class="col-sm-3">If report total is greater than:</div>

                    <div class="col-sm-2">
                      <input type="hidden" class="item-attr-edit" name="user_manager_mapping[<%= conditional_manager_count + conditional_finance_manager_count + index + 1 %>][mapping][greater_than_amount_attributes][currency_id]" value="1">
                      <input type="number" class="form-control item-attr-edit" name="user_manager_mapping[<%= conditional_manager_count + conditional_finance_manager_count + index + 1 %>][mapping][greater_than_amount_attributes][value]" value="<%= conditional_approves_to.greater_than_amount ? conditional_approves_to.greater_than_amount.value : '' %>">

                    </div>

                    <div class="col-sm-3">then approves report to:</div>

                    <div class="col-sm-3">

                      <select class="select-assign-manager form-control item-attr-edit" name="user_manager_mapping[<%= conditional_manager_count + conditional_finance_manager_count + index + 1 %>][mapping][approves_to_id]" data-default-value="<%= conditional_approves_to.approves_to ? conditional_approves_to.approves_to.id : '' %>">
                        <option value="">None</option>
                        <% @managers.team_managers.each do |m| %>
                          <option value="<%= m.id %>"><%= m.name %></option>
                        <% end %>
                      </select>
                    </div>
                    <div class="col-sm-1"><button class="item-attr-edit btn btn-xs btn-danger btn-remove-condition">Remove</button></div>
                  </div>
                  <% end %>
                  <div class="col-sm-12 add-condition">
                    <button class="btn btn-sm btn-default btn-add-condition item-attr-edit" data-policy-id="<%= @result.map[:policy] %>" data-manager-type="approves_to">Add Condition</button>
                  </div>
                </div><!-- .col-sm-12 -->
                <% end %>


                <% if @target_user.finance_manager? %>
                <div class="col-sm-12 approves-finance-to-data manager-container">
                  <div class="row approves-finance-to non-conditional no-margin">
                    Approves Finance To:&nbsp;&nbsp;

                    <select class="select-assign-manager form-control item-attr-edit" name="user_manager_mapping[0][mapping][approves_finance_to_id]" data-default-value="<%= @result.map[:default][0].approves_finance_to ? @result.map[:default][0].approves_finance_to.id : '' %>">
                      <option value="">None</option>
                      <% @managers.team_finance_managers.each do |m| %>
                        <option value="<%= m.id %>"><%= m.name %></option>
                      <% end %>
                    </select>

                  </div>

                  <% conditional_approves_finance_to_count = 0 %>
                  <% @result.map[:conditional_approves_finance_to].each_with_index do |conditional_approves_finance_to, index| %>

                  <% conditional_approves_finance_to_count += 1 %>
                  <div class="row conditional approves-finance-to no-margin" data-condition-serial="<%= conditional_manager_count + conditional_finance_manager_count + conditional_approves_to_count + index + 1 %>">
                    <div class="col-sm-12 hidden">

                      <input type="number" name="user_manager_mapping[<%= conditional_manager_count + conditional_finance_manager_count + conditional_approves_to_count + index + 1 %>][mapping][policy_id]" value="<%= @result.map[:policy].id %>">



                      <input type="number" class="mapping-id" name="user_manager_mapping[<%= conditional_manager_count + conditional_finance_manager_count + conditional_approves_to_count + index + 1 %>][mapping_id]" value="<%= conditional_approves_finance_to.id %>">
                    </div>

                    <div class="col-sm-3">If report total is greater than:</div>

                    <div class="col-sm-2">
                      <input type="hidden" class="item-attr-edit" name="user_manager_mapping[<%= conditional_manager_count + conditional_finance_manager_count + conditional_approves_to_count + index + 1 %>][mapping][greater_than_amount_attributes][currency_id]" value="1">
                      <input type="number" class="form-control item-attr-edit" name="user_manager_mapping[<%= conditional_manager_count + conditional_finance_manager_count + conditional_approves_to_count + index + 1 %>][mapping][greater_than_amount_attributes][value]" value="<%= conditional_approves_finance_to.greater_than_amount ? conditional_approves_finance_to.greater_than_amount.value : '' %>">

                    </div>

                    <div class="col-sm-3">then approves report finance to:</div>

                    <div class="col-sm-3">
                      <select class="select-assign-manager form-control item-attr-edit" name="user_manager_mapping[<%= conditional_manager_count + conditional_finance_manager_count + conditional_approves_to_count + index + 1 %>][mapping][approves_finance_to_id]" data-default-value="<%= conditional_approves_finance_to.approves_finance_to ? conditional_approves_finance_to.approves_finance_to.id : '' %>">
                        <option value="">None</option>
                        <% @managers.team_finance_managers.each do |m| %>
                          <option value="<%= m.id %>"><%= m.name %></option>
                        <% end %>
                      </select>
                    </div>
                    <div class="col-sm-1"><button class="item-attr-edit btn btn-xs btn-danger btn-remove-condition">Remove</button></div>
                  </div>
                  <% end %>
                  <div class="col-sm-12 add-condition">
                    <button class="btn btn-sm btn-default btn-add-condition item-attr-edit" data-policy-id="<%= @result.map[:policy] %>" data-manager-type="approves_finance_to">Add Condition</button>
                  </div>
                </div><!-- .col-sm-12 -->
                <% end %>
              </div>
              <input type="hidden" name="type" value="team">
              <button data-user-id="<%= @target_user.id %>" type="submit" class="btn btn-primary btn-sm btn-update-policy-member-settings">Update</button>
            </form>
          </div>
        </div><!-- .policy -->   

      </div>


      <br />
    </div>

  </div>
</div>