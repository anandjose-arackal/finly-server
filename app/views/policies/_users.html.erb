<div class="modal-dialog modal-md" style="width: 60%; height: 100%;">
  <div class="modal-content" style="height: 80%; overflow-y: scroll;">
    <div class="modal-header" style="">
      <button type="button" class="close" data-dismiss="modal">&times;</button>

      <form data-remote="true" hidden="hidden"  id="addUsersToPolicyForm" method="post">
        <input name="authenticity_token" value="<%= form_authenticity_token %>" hidden="hidden">
        <input id="addUserToPolicyIds" name="users_id" type="text">
      </form>

      <button class="btn btn-primary btn-sm hidden" id="addUsersToPolicyButton" type="button" data-url="<%= policy_add_users_path(load_params policy_id: @result.policy.id) %>">INVITE</button>


      <h4 class="modal-title">Invite Employees To Policy</h4>
    </div>
    <div class="modal-body" style="padding: 0; max-height: 75%; overflow-y: scroll; ">
      <form data-remote data-turboboost  id="usersPolicyList" action="<%= policy_invitable_users_path(load_params policy_id: @result.policy.id) %>" method="post" style="display: none;">
        <input name="authenticity_token" value="<%= form_authenticity_token %>" hidden="hidden">
      </form>
        <div class="row no-margin">
          <div class="col-sm-12">
            <div class="row no-margin">
              <div class="col-md-1"><input type="checkbox" id="select-invitable-users"></div>
              <div class="col-md-3">User Name</div>
              <div class="col-md-4">Email Id</div>
              <div class="col-md-4">Manager</div>
            </div>
            <div id="invitable-users">
              <% if @result.users_with_manager_email.present? %>
                <% @result.users_with_manager_email.each do |item| %>
                  <% user = item[:user] %>
                  <div class="row no-margin invitable-user" data-user-id="<%= user.id %>">
                    <div class="col-md-1"><input class="select-invitable-user" type="checkbox" name="add_user_id" value="<%= user.id %>"></div>
                    <div class="col-md-3"><%= user.name %></div>
                    <div class="col-md-4"><%= user.email %></div>
                    <div class="col-md-4"><%= item[:manager] %></div>
                  </div>
                <% end %>
              <% end %>
            </div>  
          </div>
          
        </div><!-- .row -->
        
        <form data-remote data-turboboost hidden="hidden"  id="addUsersToPolicy" action="<%= policy_add_users_path(load_params policy_id: @result.policy.id) %>" method="post">
          <input name="authenticity_token" value="<%= form_authenticity_token %>" hidden="hidden">
          <input id="addUserIds" name="user_id" type="text">
        </form>
      </section>
    </div>
  </div>
</div>