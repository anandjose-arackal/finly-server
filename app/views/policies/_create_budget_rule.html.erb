<% if (current_user.admin? or current_user.policy_admin?(@result.policy)) and params[:view] == 'admin' %>

<div class="modal-dialog modal-md">
  <div class="modal-content" style="border-radius: 1px">
    <div class="modal-header" style="background-color: #e9e9e9 ">

      <button type="button" class="close" style="opacity: 0.7" data-dismiss="modal">&times;</button>
      <h4 class="modal-title" style="text-align: center;text-transform: uppercase;font-weight: 400;border-bottom: #d8d8d8">Add
        New Budget Rule for this Policy</h4>
    </div>
    <div class="modal-body" style="padding: 0 35px 35px 35px">

      <form id="form-create-rule" name="submitNewRuleForm" action="<%= policy_add_rule_path(@result.policy, view: params[:view]) %>">
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>


        <h5>For the Category:</h5>

        <div id="categoriesBudget">
          <input type="radio" name="budget_rule[category_id]" value="">All <br>
            <% @result.categories.each do |cat| %>
               <input type="radio" name="budget_rule[category_id]" value="<%= cat.id %>"><%= cat.category_name %> <br>
            <% end %>
        </div>

        <h5>Budget Amount is:</h5>

        <input name="budget_rule[amount_attributes[value]]" type="text" placeholder="0.00">

        <input name="budget_rule[amount_attributes[currency_id]]" value="1" type="hidden" placeholder="0.00">

        <div id="newRulePeriod">
          <h5>Per:</h5>
          <input type="radio" name="budget_rule[budget_period_id]" value="1">Day <br>
          <input type="radio" name="budget_rule[budget_period_id]" value="2">Week<br>
          <input type="radio" name="budget_rule[budget_period_id]" value="3">Month<br>
          <input type="radio" name="budget_rule[budget_period_id]" value="4">Year<br>
        </div>

        <% if params[:rule_type] == 'warning' %>
          <input type="hidden" name="budget_rule[rule_type_id]" value="1">
          <button type="submit" class="btn btn-primary btn-sm" id="createPolicy"> Create Warning Rule</button>
        <% elsif params[:rule_type] == 'blocking' %>
          <input type="hidden" name="budget_rule[rule_type_id]" value="2">
          <button type="submit" class="btn btn-primary btn-sm" id="createPolicy"> Create Blocking Rule</button>
        <% end %>


      </form>
    </div>
  </div>
</div>
<% end %>