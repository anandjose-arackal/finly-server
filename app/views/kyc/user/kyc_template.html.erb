<style>
  .text {
    font-size: 40px;
  }
</style>
<table style="min-width: 2300px;">
  <tbody>
  <tr>
    <td class="text">First Name: <%= kyc.user.first_name %></td>
    <td class="text">Last Name: <%= kyc.user.last_name %></td>
    <td class="text">Mothers Maiden Name: <%= kyc.user.mothers_maiden_name %></td>
  </tr>
  <tr>
    <td class="text">Mobile Number: <%= kyc.user.mobile_number %></td>
    <td class="text">Card Serial No: <%= kyc.user.cards.last&.proxy %></td>
    <td class="text">&nbsp;</td>
  </tr>
  </tbody>
</table>
<table>
  <tbody>
  <tr>
    <td><img src="<%= kyc.kyc_1_front.url(:original) %>" style="max-width: 1000px;"/></td>
    <td><img src="<%= kyc.photo.url(:original) %>" style="max-width: 350px; margin-left: 100px"/></td>
  </tr>
  <tr>
    <td><img src="<%= kyc.kyc_1_back.url(:original) %>" style="max-width: 1000px;"/></td>
    <td><img src="<%= kyc.signature.url(:original) %>" style="max-height: 500px;"/></td>
  </tr>
  <% if kyc.aadhar_card? %>
  <tr>
    <td><img src="<%= kyc.kyc_2_front.url(:original) %>" style="max-width: 1000px;"/></td>
    <td><img src="<%= kyc.kyc_2_back.url(:original) %>" style="max-width: 1000px;"/></td>
  </tr>
  <% end %>
  </tbody>
</table>
