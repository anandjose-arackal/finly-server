<div class="section-card">
  <div class="row no-margin">
    <div class="col-sm-12 no-padding">
      <div class="row no-margin section-header">
        <div class="col-sm-12">
          <h4>Account Balance</h4>
        </div>
      </div>
      <div class="row no-margin">
        <div class="col-sm-12">
          <table class="table table-striped" style="border: 1px solid #ddd;">
            <thead>
              <tr>
                <td>Type</td>
                <td>Description</td>
                <td>Amount</td>
              </tr>
            </thead>

            <tbody aria-live="polite" aria-relevant="all">
              <tr role="row">
                <td><strong>User Account Opening Balance</strong></td>
                <td></td>
                <td>&#8377;&nbsp;{{item.user_account_opening_balance}}</td>
              </tr>
              <tr role="row">
                <td><strong>User Account Status Details</strong></td>
                <td>Account Load</td>
                <td>&#8377;&nbsp;{{item.user_account_status_details.account_load}}</td>
              </tr>
              <tr role="row">
                <td></td>
                <td>Account Withdrawal</td>
                <td>&#8377;&nbsp;{{item.user_account_status_details.account_withdrawal}}</td>
              </tr>
              <tr role="row">
                <td></td>
                <td>Account Transfer (to Other User Accounts)</td>
                <td>&#8377;&nbsp;{{item.user_account_status_details.account_transfer_to_other_accounts}}</td>
              </tr>
              <tr role="row">
                <td></td>
                <td>Account Transfer (to Other Cards)</td>
                <td>&#8377;&nbsp;{{item.user_account_status_details.account_transfer_to_other_cards}}</td>
              </tr>
              <tr role="row">
                <td><strong>Transferred to Card</strong></td>
                <td>From Own Account</td>
                <td>&#8377;&nbsp;{{item.transferred_to_card.from_own_account}}</td>
              </tr>
              <tr role="row">
                <td></td>
                <td>From Other Accounts</td>
                <td>&#8377;&nbsp;{{item.transferred_to_card.from_other_accounts}}</td>
              </tr>
              <tr role="row">
                <td></td>
                <td>From Company Account</td>
                <td>&#8377;&nbsp;{{item.transferred_to_card.from_company_account}}</td>
              </tr>
              <tr role="row">
                <td><strong>Spent from Card</strong></td>
                <td>ATM Withdrawals</td>
                <td>&#8377;&nbsp;{{item.spent_from_card.atm}}</td>
              </tr>
              <tr role="row">
                <td></td>
                <td>POS Expenses</td>
                <td>&#8377;&nbsp;{{item.spent_from_card.pos}}</td>
              </tr>
              <tr role="row">
                <td></td>
                <td>Online Expenses</td>
                <td>&#8377;&nbsp;{{item.spent_from_card.online}}</td>
              </tr>
              {{!-- <tr role="row">
                <td></td>
                <td>Reversals</td>
                <td>{{item.table1.reversals}}</td>
              </tr>
              <tr role="row">
                <td><strong>Bank Charges</strong></td>
                <td>ATM Withdrawal Fee</td>
                <td>{{item.table1.atm_fees}}</td>
              </tr>
              <tr role="row">
                <td></td>
                <td>Fuel Surcharge</td>
                <td>{{item.table1.surcharge}}</td>
              </tr>
              <tr role="row">
                <td></td>
                <td>Other Surcharges [ eg. IRCTC]</td>
                <td>{{item.table1.other_surcharges}}</td>
              </tr> --}}
              <tr role="row">
                <td><strong>= Account Closing Balance</strong></td>
                <td></td>
                <td>&#8377;&nbsp;{{item.account_closing_balance}}</td>
              </tr>
              <tr role="row">
                <td><strong>= Card Closing Balance</strong></td>
                <td></td>
                <td>&#8377;&nbsp;{{item.card_closing_balance}}</td>
              </tr>
              <tr role="row">
                <td><strong>= Cash on Hand</strong></td>
                <td></td>
                <td>&#8377;&nbsp;{{item.closing_cash_in_hand}}</td>
              </tr></tbody>
          </table>
        </div>
      </div>
          
    </div>
  </div>
</div>

<div class="section-card">
  <div class="row no-margin">
    <div class="col-sm-12 no-padding">
      <div class="row no-margin section-header">
        <div class="col-sm-12">
          <h4>Verified Expenses on Account</h4>
        </div>
      </div>
      <div class="row no-margin">
        <div class="col-sm-12">
          <table class="table table-striped" style="border: 1px solid #ddd;">
            <thead>
              <tr>
                <td>Type</td>
                <td>Description</td>
                <td>Amount</td>
              </tr>
            </thead>
            <tbody aria-live="polite" aria-relevant="all">
              <tr role="row">
                <td><strong>Opening Card Balance with the Employee</strong></td>
                <td></td>
                <td>&#8377;&nbsp;{{item.opening_card_balance}}</td>
              </tr>
              <tr role="row">
                <td><strong>Opening Cash on Hand</strong></td>
                <td></td>
                <td>&#8377;&nbsp;{{item.opening_cash_in_hand}}</td>
              </tr>
              <tr role="row">
                <td><strong>Total amount transacted with employee within this period</strong></td>
                <td>Card Load</td>
                <td>&#8377;&nbsp;{{item.amount_transacted.card_load}}</td>
              </tr>
              
              <tr role="row">
                <td></td>
                <td>Paid to employee via Cash/ NEFT</td>
                <td>&#8377;&nbsp;{{item.amount_transacted.paid_to_employee}}</td>
              </tr>
              <tr role="row">
                <td></td>
                <td><span>Received from employee via Cash/ NEFT</span></td>
                <td>&#8377;&nbsp;{{item.amount_transacted.paid_by_employee}}</td>
              </tr>
              <tr role="row">
                <td><strong>Total Verified Expenses</strong></td>
                <td>Verified Card Expenses</td>
                <td>&#8377;&nbsp;{{item.total_verified_expenses.verified_card_expenses}}</td>
              </tr>
              <tr role="row">
                <td></td>
                <td>Verified Cash Expenses</td>
                <td>&#8377;&nbsp;{{item.total_verified_expenses.verified_cash_expenses}}</td>
              </tr>
              <tr role="row">
                <td>
                  <p><strong>= Closing Card Balance</strong></p>
                </td>
                <td></td>
                <td>&#8377;&nbsp;{{item.closing_card_balance}}</td>
              </tr>
              <tr role="row">
                <td><strong>= Remaining Cash with the Employee</strong></td>
                <td></td>
                <td>&#8377;&nbsp;{{item.closing_cash_in_hand}}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
          
    </div>
  </div>
</div>

