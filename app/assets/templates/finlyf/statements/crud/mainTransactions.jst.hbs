<div class="section-card">
  <div class="row no-margin section-header">
    <div class="col-sm-6"><h4>Transactions</h4></div>
    <div class="col-sm-6 text-right">
      <div class="dropdown">
        <button class="btn-primary btn btn-sm btn-default dropdown-toggle" type="button" data-toggle="dropdown">Export <span class="caret"></span></button>
        <ul class="dropdown-menu dropdown-menu-right">
          <li><a href="#" class="btn-export-transactions" data-export-type="xls">XLS</a></li>
          <li><a href="#" class="btn-export-transactions" data-export-type="csv">CSV</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="row no-margin">
    <div class="col-sm-12">
      <table class="table table-striped" style="border: 1px solid #ddd;">
        <thead>
          <tr>
            <th>Date</th>
            <th>Type</th>
            <th>Merchant</th>
            <th>Debit</th>
            <th>Credit</th>
            {{!-- <th>Balance</th> --}}
            <th>Category</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {{#each item}}
          <tr role="row">
            <td>{{#if this.date}}{{this.date}}{{else}}-{{/if}}</td>
            <td>{{#if this.transaction_type}}{{this.transaction_type}}{{else}}-{{/if}}</td>
            <td>{{#if this.merchant}}{{this.merchant}}{{else}}-{{/if}}</td>
            <td>{{#if this.debit_amount}}&#8377;&nbsp;{{this.debit_amount}}{{else}}-{{/if}}</td>
            <td>{{#if this.credit_amount}}&#8377;&nbsp;{{this.credit_amount}}{{else}}-{{/if}}</td>
            {{!-- <td>{{#if this.balance}}{{this.balance}}{{else}}-{{/if}}</td> --}}
            <td>{{#if this.category}}{{this.category}}{{else}}-{{/if}}</td>
            <td>{{#if this.status}}{{this.status}}{{else}}-{{/if}}</td>
          </tr>
          {{/each}}
        </tbody> 
      </table>
    </div>
  </div>
</div>

<style type="text/css">
.section-header{
  margin-bottom: 15px;
}
thead{
  font-size: 16px;
  /*font-weight: normal;*/
}

thead th{
  font-weight: normal;
}
</style>

  