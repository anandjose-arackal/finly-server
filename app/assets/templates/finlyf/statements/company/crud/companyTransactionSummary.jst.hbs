<table class="table table-striped table-bordered" style="border: 1px solid #ddd;">
  <thead>
    <tr>
      <td>Type</td>
      <td>Description</td>
      <td>Amount(INR)</td>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>Company Account Opening Balance:</td>
      <td></td>
      <td>&#8377;&nbsp;{{item.company_account_opening_balance}}</td>
    </tr>

    <tr>
      <td>Company Account Details</td>
      <td class="no-padding-imp">
        <table class="table table-striped table-nested">
          <thead>
            <tr><td>Total Account Load via NEFT/ Cheque</td></tr>
          </thead>
            <tbody>
              {{#each item.company_account_details.loads}}
                <tr>
                  <td>Date - {{this.date}}</td>
                </tr>
              {{/each}}
            </tbody>
        </table>
      </td>
      <!-- <td>
        <p>Total Account Load via NEFT / Cheque</p>
        <ul>
          {{#each item.company_account_details.loads}}
            <li>Date - {{this.date}} </li>
          {{/each}}
        </ul>
      </td> -->


      <!-- <td>
        <p>&#8377;&nbsp;{{item.company_account_details.total_account_load_via_NEFT}}</p>
        <ul>
          {{#each item.company_account_details.loads}}
            <li>&#8377;&nbsp;{{this.amount}}</li>
          {{/each}}
        </ul>
      </td>
 -->
      <td class="no-padding-imp">
        <table class="table table-striped table-nested">
          <thead>
            <tr><td>&#8377;&nbsp;{{item.company_account_details.total_account_load_via_NEFT}}</td></tr>
          </thead>
            <tbody>
              {{#each item.company_account_details.loads}}
                <tr>
                  <td>&#8377;&nbsp;{{this.amount}}</td>
                </tr>
              {{/each}}
            </tbody>
        </table>
      </td>
    </tr>

    <tr>
      <td>Transfers to Company Account</td>
      <td class="no-padding-imp">
        <table class="table table-striped table-nested">
          <thead>
            <tr><td>Total</td></tr>
          </thead>
          <tbody>
          {{#each item.transfers_to_company_account.admin_transfers}}
              <tr>
                <td>Admin {{add @index 1}} - {{this.name}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </td>

      <!-- <td>
        <p>Total</p>
        <ul>
          {{#each item.transfers_to_company_account.admin_transfers}}
            <li>Admin {{add @index 1}} - {{this.name}}</li>
          {{/each}}
        </ul>        
      </td> -->

      <td class="no-padding-imp">
        <table class="table table-striped table-nested">
        <thead>
          <tr><td>&#8377;&nbsp;{{item.transfers_to_company_account.total}}</td></tr>
        </thead>
          <tbody>
            {{#each item.transfers_to_company_account.admin_transfers}}
                <tr>
                  <td>&#8377;&nbsp;{{this.amount}}</td>
                </tr>
              {{/each}}
          </tbody>
        </table>
      </td>

      <!-- <td>
        <p>&#8377;&nbsp;{{item.transfers_to_company_account.total}}</p>
        <ul>
          {{#each item.transfers_to_company_account.admin_transfers}}
            <li>&#8377;&nbsp;{{this.amount}}</li>
          {{/each}}
        </ul>
      </td>
    </tr> -->

    <tr>
      <td>Transfers from Company Account</td>

      <td class="no-padding-imp">
        <table class="table table-striped table-nested">
          <thead>
            <tr><td>Total</td></tr>
          </thead>
          <tbody>
            {{#each item.transfers_from_company_account.admin_transfers}}
                <tr>
                  <td>Admin {{add @index 1}} - {{this.name}}</td>
                </tr>
              {{/each}}
          </tbody>
        </table>
      </td>

      <!-- <td>
        <p>Total</p>
        <ul>
          {{#each item.transfers_from_company_account.admin_transfers}}
            <li>Admin {{add @index 1}} - {{this.name}}</li>
          {{/each}}
        </ul>        
      </td> -->


      <td class="no-padding-imp">
        <table class="table table-striped table-nested">
          <thead>
            <tr><td>&#8377;&nbsp;{{item.transfers_from_company_account.total}}</td></tr>
          </thead>
          <tbody>
            {{#each item.transfers_from_company_account.admin_transfers}}
                <tr>
                  <td>&#8377;&nbsp;{{this.amount}}</td>
                </tr>
              {{/each}}
          </tbody>
        </table>
      </td>

      <!-- <td>
        <p>&#8377;&nbsp;{{item.transfers_from_company_account.total}}</p>
        <ul>
          {{#each item.transfers_from_company_account.admin_transfers}}
            <li>&#8377;&nbsp;{{this.amount}}</li>
          {{/each}}
        </ul>
      </td> -->
    </tr>

    <tr>
      <td>Total Amount Transferred</td>
      <td class="no-padding-imp">
        <table class="table table-striped table-nested">
          <tbody>
            <tr>
              <td>To Finly Expense Cards</td>
            </tr>
            <tr>
              <td>To Finly Money</td>
            </tr>
          </tbody>
        </table>
      </td>

      <td class="no-padding-imp">
        <table class="table table-striped table-nested">
          <tbody>
            <tr>
              <td>&#8377;&nbsp;{{item.total_amount_transferred.to_finly_cards}}</td>
            </tr>
            <tr>
              <td>&#8377;&nbsp;{{item.total_amount_transferred.to_finly_money}}</td>
            </tr>
          </tbody>
        </table>
      </td>
    </tr>

    <tr>
      <td colspan="2">Account Closing Balance</td>
      <td>&#8377;&nbsp;{{item.company_account_closing_balance}}</td>
    </tr>
  </tbody>
</table>
