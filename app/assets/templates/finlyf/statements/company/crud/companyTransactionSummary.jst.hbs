<table class="table table-striped" style="border: 1px solid #ddd;">
  <thead>
    <tr>
      <td>Type</td>
      <td>Description</td>
      <td>Amount(INR)</td>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>Company Account Opening Balance:</td>
      <td></td>
      <td>&#8377;&nbsp;{{item.company_account_opening_balance}}</td>
    </tr>

    <tr rowspan="4">
      <td>Company Account Details</td>
      <td>
        <p>Total Account Load via NEFT / Cheque</p>
        <ul>
          {{#each item.company_account_details.loads}}
            <li>Date - {{this.date}} </li>
          {{/each}}
        </ul>
      </td>
      <td>
        <p>&#8377;&nbsp;{{item.company_account_details.total_account_load_via_NEFT}}</p>
        <ul>
          {{#each item.company_account_details.loads}}
            <li>&#8377;&nbsp;{{this.amount}}</li>
          {{/each}}
        </ul>
      </td>
    </tr>

    <tr>
      <td>Transfers to Company Account</td>

      <td>
        <p>Total</p>
        <ul>
          {{#each item.transfers_to_company_account.admin_transfers}}
            <li>Admin {{add @index 1}} - {{this.name}}</li>
          {{/each}}
        </ul>        
      </td>

      <td>
        <p>&#8377;&nbsp;{{item.transfers_to_company_account.total}}</p>
        <ul>
          {{#each item.transfers_to_company_account.admin_transfers}}
            <li>&#8377;&nbsp;{{this.amount}}</li>
          {{/each}}
        </ul>
      </td>
    </tr>

    <tr>
      <td>Transfers from Company Account</td>

      <td>
        <p>Total</p>
        <ul>
          {{#each item.transfers_from_company_account.admin_transfers}}
            <li>Admin {{add @index 1}} - {{this.name}}</li>
          {{/each}}
        </ul>        
      </td>

      <td>
        <p>&#8377;&nbsp;{{item.transfers_from_company_account.total}}</p>
        <ul>
          {{#each item.transfers_from_company_account.admin_transfers}}
            <li>&#8377;&nbsp;{{this.amount}}</li>
          {{/each}}
        </ul>
      </td>
    </tr>

    <tr>
      <td>Total Amount Transferred</td>
      <td>
        <ul>
          <li>To Finly Expense Cards</li>
          <li>To Finly Money</li>
        </ul>
      </td>

      <td>
        <ul>
          <li>&#8377;&nbsp;{{item.total_amount_transferred.to_finly_cards}}</li>
          <li>&#8377;&nbsp;{{item.total_amount_transferred.to_finly_money}}</li>
        </ul>
      </td>
    </tr>

    <tr>
      <td>Account Closing Balance</td>
      <td></td>
      <td>&#8377;&nbsp;{{item.company_account_closing_balance}}</td>
    </tr>
  </tbody>
</table>