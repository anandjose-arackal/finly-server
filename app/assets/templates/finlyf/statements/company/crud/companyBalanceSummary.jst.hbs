<table class="table table-bordered table-striped" style="border: 1px solid #ddd;">
  <thead>
    <tr>
      <td>Type</td>
      <td>Status as on {{item.current_date}}</td>
      <td>Amount(INR)</td>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>1</td>
      <td>Company Balance:</td>
      <td>&#8377;&nbsp;{{item.current_company_balance}}</td>
    </tr>

    <tr>
      <td>2</td>
      <td class="no-padding-imp">
        <table class="table table-striped table-nested">
          <tbody>
            <tr>
              <td>Total Amount with Employees</td>
            </tr>
            <tr>
              <td>Total Amount on Cards</td>
            </tr>
            <tr>
              <td>Total Amount on Finly Accounts</td>
            </tr>
            <tr>
              <td>Total Cash on Employees Hand</td>
            </tr>
          </tbody>
        </table>
      </td>
      <td class="no-padding-imp">
        <table class="table table-striped table-nested">
          <tbody>
            <tr>
              <td>&#8377;&nbsp;{{item.total_amount_with_employees.total}}</td>
            </tr>
            <tr>
              <td>&#8377;&nbsp;{{item.total_amount_with_employees.in_cards}}</td>
            </tr>
            <tr>
              <td>&#8377;&nbsp;{{item.total_amount_with_employees.in_finly_money}}</td>
            </tr>
            <tr>
              <td>&#8377;&nbsp;{{item.total_amount_with_employees.in_cash_on_hand}}</td>
            </tr>
          </tbody>
        </table>
      </td>
    </tr>

    <tr>
      <td>3</td>
      <td class="no-padding-imp">
        <table class="table table-striped table-nested">
          <tbody>
          <tr>
            <td>Money Request Awaiting Settlement</td>
          </tr>
            <tr>
              <td>Via Card</td>
            </tr>
            <tr>
              <td>Via Cash</td>
            </tr>
          </tbody>
        </table>
      </td>
      <td class="no-padding-imp">
        <table class="table table-striped table-nested">
          <tbody>
          <tr>
            <td>&nbsp;</td>
          </tr>
            <tr>
              <td>&#8377;&nbsp;{{item.money_requests_awaiting_settlement.via_card}}</td>
            </tr>
            <tr>
              <td>&#8377;&nbsp;{{item.money_requests_awaiting_settlement.via_cash}}</td>
            </tr>
          </tbody>
        </table>
      </td>
    </tr>
      

    <tr>
      <td>3</td>
      <td>Reports Awaiting Settlement</td>
      <td>&nbsp;{{item.reports_awaiting_settlement}} reports</td>
    </tr>

    <tr>
      <td>4</td>
      <td class="no-padding-imp">
        <table class="table table-striped table-nested">
          <tbody>
            <tr>
              <td>Unreported Expenses</td>
            </tr>
            <tr>
              <td>Via Card</td>
            </tr>
            <tr>
              <td>Via Cash</td>
            </tr>
          </tbody>
        </table>
      </td>
      <td class="no-padding-imp">
        <table class="table table-striped table-nested">
          <tbody>
          <tr>
            <td>&nbsp;</td>
          </tr>
            <tr>
              <td>{{item.unreported_expenses.via_card_number}} Expenses&nbsp;|&nbsp;&#8377;&nbsp;{{item.unreported_expenses.via_card_total}}</td>
            </tr>
            <tr>
              <td>{{item.unreported_expenses.via_cash_number}} Expenses&nbsp;|&nbsp;&#8377;&nbsp;{{item.unreported_expenses.via_cash_total}}</td>
            </tr>
          </tbody>
        </table>
      </td>
    </tr>
  </tbody>
</table>