<table class="table table-bordered" style="table-layout: fixed;">
  <thead>
    <tr>
      <td>#</td>
      <td>Policy Name</td>
      <td>Amount(INR)</td>
    </tr>
  </thead>

  <tbody>
  {{#each item}}
    <tr>
      <td>{{add @index 1}}</td>
      <td colspan="1" class="no-padding-imp">
        <table class="table table-striped table-nested">
          <tr>
            <td>{{this.name}}</td>
          </tr>
          <tr>
            <td>&nbsp;&nbsp;&nbsp;&nbsp;Via Card</td>
          </tr>
          <tr>
            <td>&nbsp;&nbsp;&nbsp;&nbsp;Via Cash</td>
          </tr>
        </table>
      </td>
      <td colspan="1" class="no-padding-imp">
        <table class="table table-striped table-nested">
          <tr>
            <td>&#8377;&nbsp;{{this.total}}</td>
          </tr>
          <tr>
            <td>&#8377;&nbsp;{{this.via_card}}</td>
          </tr>
          <tr>
            <td>&#8377;&nbsp;{{this.via_cash}}</td>
          </tr>
        </table>
      </td>
    </tr>
  {{/each}}
  </tbody>
</table>