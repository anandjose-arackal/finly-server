<div class="row sidebar-element">
  <div class="col-sm-3">
    From
  </div>
  <div class="col-sm-9">
    <input type="text" class="datepicker filter-date-from" style="width: 100%;" value="{{item.filter_date_from}}" />
    <span class="fa fa-calendar input-icon "></span> 

  </div>
</div>
<div class="row sidebar-element">
  <div class="col-sm-3">
    To
  </div>
  <div class="col-sm-9">
    <input type="text" class="datepicker filter-date-to" style="width: 100%;" value="{{item.filter_date_to}}" />
    <span class="fa fa-calendar input-icon "></span> 
  </div>
</div>

<div class="row sidebar-element">

  <div class="col-sm-12">
    <input type="text" class="filter-merchant" style="width: 100%;" placeholder="Merchant" value="{{item.filter_merchant}}" />
    <span class="fa fa-search input-icon"></span> 
  </div>
</div>
{{!-- {{item.filter_amount_type}} --}}
<div class="row sidebar-element">
  <div class="col-sm-12">
    <select class="form-control">
      <option>Show For:</option>
      <option>All</option>
      <option>Team</option>
      <option>User</option>
    </select>
  </div> 
</div>

<div class="row sidebar-element">
  <div class="col-sm-12">
    Search by User
  </div>
  <div class="col-sm-12">
    <input type="text" class="filter-field filter-user" style="width: 100%;" data-field="user" />
    <span class="fa fa-search input-icon"></span> 
  </div>
</div>

<div class="row sidebar-element">
  <div class="col-sm-12">Category</div>
  <div class="col-sm-12">
    <select style="width: 100%;" class="filter-category-id">
      <option value="">Select</option>
    </select>
  </div>
</div>

<div class="row sidebar-element">
  <div class="col-sm-4">Receipt</div>
  <div class="col-sm-8">
    <select style="width: 100%;" class="filter-receipt">
      <option value="select">Select</option>
      <option value="present">Has Receipt</option>
      <option value="absent">No Receipt</option>
    </select>
  </div>
</div>
{{!-- REF==2O --}}
{{#unless item.indexOnly}}
<div class="row sidebar-element">
  <div class="col-sm-12 text-center">
    <button class="btn btn-sm btn-warning btn-filter-expenses" data-navigate="true">Apply Filter</button>
  </div>
</div>
{{else}}
<div class="row sidebar-element">
  <div class="col-sm-12 text-center">
    <button class="btn-warning btn btn-sm btn-filter-expenses" data-navigate="false">Apply Filter</button>
  </div>
</div>
{{/unless}}