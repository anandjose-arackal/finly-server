<div class="row sidebar-element">
  <div class="col-sm-3 sidebar-label">
    From
  </div>
  <div class="col-sm-9">
    <input type="text" class="form-control datepicker filter-date-from" style="width: 100%;" value="{{item.filter_date_from}}" />
    <span class="fa fa-calendar input-icon "></span> 

  </div>
</div>
<div class="row sidebar-element">
  <div class="col-sm-3 sidebar-label">
    To
  </div>
  <div class="col-sm-9">
    <input type="text" class="form-control datepicker filter-date-to" style="width: 100%;" value="{{item.filter_date_to}}" />
    <span class="fa fa-calendar input-icon "></span> 
  </div>
</div>

<div class="row sidebar-element">

  <div class="col-sm-12">
    <input type="text" class="form-control filter-merchant filter-field" style="width: 100%;" placeholder="Merchant" data-field="merchant" value="{{item.filter_merchant}}" />
    <span class="fa fa-search input-icon"></span> 
  </div>
</div>

{{#if item.view}}
  {{#if_not_eq item.view 'personal'}}
    {{!-- <div class="row sidebar-element">
      <div class="col-sm-12 sidebar-label">
        Show for:
      </div>
      <div class="col-sm-12">
        <select class="form-control select-show-for">
          <option>All</option>
          <option value="user">User</option>
        </select>
      </div> 
    </div> --}}
    <div class="row sidebar-element search_by_user">
      <div class="col-sm-12 sidebar-label">
        Search by User
      </div>
      <div class="col-sm-12">
        <input type="text" class="form-control filter-field filter-user" style="width: 100%;" data-item-id="{{item.filter_user_id}}" data-field="user" value="{{item.filter_user_name}}" />
        <span class="fa fa-search input-icon"></span> 
      </div>
    </div>

  {{/if_not_eq}}
{{/if}}

<div class="row sidebar-element">
    <div class="col-sm-12 sidebar-label">
        Filter by Expense Status
    </div>
    <div class="col-sm-12">
        <label><input type="checkbox" class="filter-expense-status-id" value="1" {{#ifIn "1" item.filter_expense_status_id }}checked="checked"{{/ifIn}}>&nbsp; Unreported</label><br />
        <label><input type="checkbox" class="filter-expense-status-id" value="2" {{#ifIn "2" item.filter_expense_status_id }}checked="checked"{{/ifIn}}>&nbsp; Processing</label><br />
        <label><input type="checkbox" class="filter-expense-status-id" value="3" {{#ifIn "3" item.filter_expense_status_id }}checked="checked"{{/ifIn}}>&nbsp; Approved</label><br />
        <label><input type="checkbox" class="filter-expense-status-id" value="4" {{#ifIn "4" item.filter_expense_status_id }}checked="checked"{{/ifIn}}>&nbsp; Reimbursed</label>
    </div>
</div>

<div class="row sidebar-element">
    <div class="col-sm-12 sidebar-label">
        Filter by Expense Type
    </div>
    <div class="col-sm-12">
        <label><input type="checkbox" class="filter-expense-type-id" value="2" {{#ifIn "1" item.filter_expense_type_id }}checked="checked"{{/ifIn}}>&nbsp; Card</label><br />
        <label><input type="checkbox" class="filter-expense-type-id" value="1" {{#ifIn "2" item.filter_expense_type_id }}checked="checked"{{/ifIn}}>&nbsp; Manual</label>
    </div>
</div>
{{!-- {{item.filter_amount_type}} --}}

<div class="row sidebar-element">
  <div class="col-sm-12 text-center">
    <button class="btn btn-sm btn-default btn-filter-expenses" data-navigate="true">Apply Filter</button>
  </div>
</div>