{{#if item.meta}}
  <div class="row no-margin" style="position: fixed;z-index: 1;background: rgba(255, 255, 255, 1);width: 82%; padding: 15px;">
    <div class="col-sm-3">
      <label class="control-label analytics-type">Total</label>
    </div>

    <div class="col-sm-7">
      <div class="progress">
        <div class="progress-bar" role="progressbar" aria-valuenow="{{percentage item.total item.max_total}}" aria-valuemin="0" aria-valuemax="100" style="min-width: 2em; width: 100%;">
        </div>
      </div>
    </div>

    <div class="col-sm-2 text-right">
      <label class="control-label analytics-total">&#8377;&nbsp;{{item.total}} blah blah</label>
    </div>
  </div>
{{else}}
  <div class="row no-margin">
    <div class="col-sm-3">
      <label class="control-label analytics-type">{{item.item}}</label>
    </div>

    <div class="col-sm-7">
      <div class="progress">
        <div class="progress-bar" role="progressbar" aria-valuenow="{{percentage item.item_total item.max_total}}" aria-valuemin="0" aria-valuemax="100" style="min-width: 2em; width: {{percentage item.item_total item.max_total}}%;">
        </div>
      </div>
    </div>

    <div class="col-sm-2 text-right">
      <label class="control-label analytics-total">&#8377;&nbsp;{{item.item_total}}</label>
    </div>
  </div>
{{/if}}
