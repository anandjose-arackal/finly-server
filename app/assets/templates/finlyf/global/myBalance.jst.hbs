{{#if item.virtual_account}}
<div class="row no-margin" style="margin-bottom: 10px;">
  <div class="col-xs-5 no-padding">Company Balance:</div>
  <div class="col-xs-7 no-padding text-right">&#8377;&nbsp;{{item.virtual_account}}</div>
</div>
{{/if}}

<div class="row no-margin" style="margin-bottom: 10px;">
  <div class="col-xs-5 no-padding">Cash in Hand:</div>
  <div class="col-xs-7 no-padding text-right">&#8377;&nbsp;{{item.current_user_cash_in_hand}}</div>
</div>

<div class="row no-margin" style="margin-bottom: 10px;">
  <div class="col-xs-5 no-padding">Finly Account Balance:</div>
  <div class="col-xs-7 no-padding text-right">&#8377;&nbsp;{{item.current_user_wallet}}</div>
</div>


<div class="row no-margin">
  <div class="col-xs-5 no-padding">Card Balance:</div>
  <div class="col-xs-7 no-padding text-right">
  {{#if item.current_user_card_details.assigned}}
    {{#if item.current_user_card_details.active}}
      &#8377;&nbsp;&nbsp;{{item.current_user_card}}<br />
      <button class="btn btn-success btn-load-unload-funds btn-sm" style="margin: 10px 0 0; position: relative;">Transfer Funds</button>
    {{else}}
      &#8377;&nbsp;&nbsp;{{item.current_user_card}}<br />
      (Blocked by {{item.current_user_card_details.disabled_by.name}})
      <button disabled="disabled" class="btn btn-success btn-sm" style="margin: 10px 0 0; position: relative;">Transfer Funds</button>
    {{/if}}
  {{else}}
    Card Unassigned
  {{/if}}
  </div>
</div>