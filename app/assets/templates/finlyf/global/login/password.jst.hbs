<input type="hidden" name="authenticity_token" value="{{item.authenticity_token}}" />
<input type="hidden" name="user[email]" value="{{item.email_mobile}}" />

<div class="formgroup">
  <div class="row no-margin">
    <div class="col-sm-12 no-padding">
      {{#if_eq item.type 'mobile'}}
        <label class="control-label">Mobile Number:</label>
      {{else}}
        <label class="control-label">Email ID:</label>
      {{/if_eq}}
    </div>
  </div>
  <div class="row no-margin">
    <div class="col-sm-12 no-padding" style="word-wrap: break-word;">
      <label class="text-left">{{item.email_mobile}}</label>
    </div>
  </div>
</div>