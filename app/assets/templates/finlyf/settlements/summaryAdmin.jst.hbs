<div class="col-sm-12 no-padding" style="height: 100%; padding: 10px 0;">
  <div class="col-sm-6" style="height: 100%;border-right: 1px solid #bbb;">
    <div class="row no-margin" style="height: 35%;">
      <div class="col-sm-8">
        <span class="settlement-summary-type">Pending Reimbursement:</span>
      </div>
      <div class="col-sm-4">
        <label class="settlement-summary-value">&#8377;&nbsp;{{item.pending_reimbursement}}</label>
        <input type="hidden" name="pending_reimbursement" value="{{item.pending_reimbursement}}">
      </div>
    </div>

    <div class="row no-margin" style="height: 35%;">
      <div class="col-sm-8">
        <span class="settlement-summary-type">Advance Request:</span>
      </div>
      <div class="col-sm-4">
        <label class="settlement-summary-value">&#8377;&nbsp;{{item.pending_money_request}}</label>
        <input type="hidden" name="pending_money_request" value="{{item.pending_money_request}}">
      </div>
    </div>

    <div class="row no-margin text-center" style="height: 30%;">
      <button class="btn btn-success btn-sm btn-summary-action btn-credit">Credit</button>      
      
    </div>
  </div>

  <div class="col-sm-6" style="height: 100%;">
    <div class="row no-margin" style="height: 35%;">
      <div class="col-sm-8">
        <span class="settlement-summary-type">Cash in Hand:</span>
      </div>
      <div class="col-sm-4">
        <label class="settlement-summary-value">&#8377;&nbsp;{{item.cash_in_hand}}</label>

        <input type="hidden" name="cash_in_hand" value="{{item.cash_in_hand}}">
      </div>
    </div>

    <div class="row no-margin" style="height: 35%;">
      <div class="col-sm-8">
        <span class="settlement-summary-type">Card Balance:</span>
      </div>
      <div class="col-sm-4">
        <label class="settlement-summary-value">&#8377;&nbsp;{{item.pending_money_request}}</label>
        <input type="hidden" name="card_balance" value="{{item.cash_in_hand}}">
      </div>
    </div>

    <div class="row no-margin text-center" style="height: 30%;">
      <button class="btn btn-sm btn-warning btn-summary-action btn-debit">Debit</button>
    </div>
  </div>

</div>
<style type="text/css">

  .settlement-summary-type, .settlement-summary-value{
    font-size: 18px;
  }

.summary-actions{
  margin-top: -15px;
}
.btn-report-summary-action{
  width: 150px;
  margin-top: 5px;
  margin-bottom: 5px;
  /*display: block;*/
}
</style>
