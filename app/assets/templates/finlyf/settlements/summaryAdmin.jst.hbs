<div class="col-sm-12 no-padding" style="height: 100%; padding: 10px 0;">
  <div class="col-sm-12" style="height: 100%;border-right: 1px solid #bbb;">
    <div class="row no-margin settlement-summary-item" style="margin-top: 0;">
      <div class="col-sm-3">
        <span class="settlement-summary-type">Approved Reports:</span>
      </div>
      <div class="col-sm-2 text-right">
        <label class="settlement-summary-value">&#8377;&nbsp;{{item.pending_reimbursement}}</label>
        <input type="hidden" name="pending_reimbursement" value="{{item.pending_reimbursement}}">
      </div>

      <div class="col-sm-4 col-sm-offset-1">
        <button class="btn-sm btn btn-primary btn-settlement-summary-action wd250" data-action-type="process-reports">Process Reports</button>
      </div>
    </div>

    <div class="row no-margin settlement-summary-item">
      <div class="col-sm-3">
        <span class="settlement-summary-type">Approved Money Requests:</span>
      </div>
      <div class="col-sm-2 text-right">
        <label class="settlement-summary-value">&#8377;&nbsp;{{item.pending_money_request}}</label>
        <input type="hidden" name="pending_money_request" value="{{item.pending_money_request}}">
      </div>
      <div class="col-sm-4 col-sm-offset-1">
        <button class="btn-sm btn btn-primary btn-settlement-summary-action wd250" data-action-type="process-money-requests">Process Money Requests</button>
      </div>
    </div>

    <div class="row no-margin settlement-summary-item">
      <div class="col-sm-3">
        <span class="settlement-summary-type">Cash on Hand:</span>
      </div>
      <div class="col-sm-2 text-right">
        <label class="settlement-summary-value">&#8377;&nbsp;{{item.cash_in_hand}}</label>

        <input type="hidden" name="cash_in_hand" value="{{item.cash_in_hand}}">
      </div>

      <div class="col-sm-4 col-sm-offset-1">
        <button class="btn-sm btn btn-success btn-settlement-summary-action wd125" data-action-type="credit-cash">Credit Cash</button>
        <button class="btn-sm btn btn-danger btn-settlement-summary-action wd125" data-action-type="debit-cash">Debit Cash</button>
      </div>
    </div>

    <div class="row no-margin settlement-summary-item">
      <div class="col-sm-3">
        <span class="settlement-summary-type">Card Balance:</span>
      </div>
      <div class="col-sm-2 text-right">
      {{#if item.card_balance}}
        <label class="settlement-summary-value">&#8377;&nbsp;{{item.card_balance}}</label>
      {{else}}
        <label class="settlement-summary-value">Not Assigned</label>
      {{/if}}
      </div>

      <div class="col-sm-6 col-sm-offset-1">
        {{#if item.target_user_card.assigned}}
          {{#if item.target_user_card.active}}
            <button class="btn-sm btn btn-success btn-settlement-summary-action wd125" data-action-type="load-funds-card">Load Funds</button>
            <button class="btn-sm btn btn-danger btn-settlement-summary-action wd125" data-action-type="withdraw-funds-card">Withdraw Funds</button>
          {{else}}
            <button disabled="disabled" class="btn-sm btn-settlement-summary-action btn btn-success wd125">Load Funds</button>
            <button disabled="disabled" class="btn-sm btn-settlement-summary-action btn btn-danger wd125">Withdraw Funds</button>
            <span>Blocked by <label>{{item.target_user_card.disabled_by.name}}({{item.target_user_card.disabled_by.role}})</label></span>
          {{/if}}
        {{else}}
          <button disabled="disabled" class="btn-sm btn btn-settlement-summary-action btn-success wd125">Load Funds</button>
          <button disabled="disabled" class="btn-sm btn btn-settlement-summary-action btn-danger wd125">Withdraw Funds</button>
        {{/if}}
      </div>
    </div>
    <div class="row no-margin settlement-summary-item" style="border-bottom: none;">
      <div class="col-sm-3">
        <span class="settlement-summary-type">Finly Money Balance:</span>
      </div>
      <div class="col-sm-2 text-right">
        <label class="settlement-summary-value">&#8377;&nbsp;{{item.wallet_balance}}</label>
      </div>

      <div class="col-sm-4 col-sm-offset-1">
        <button class="btn-sm btn btn-success btn-settlement-summary-action wd125" data-action-type="load-funds-finlymoney">Load Funds</button>
        <button class="btn-sm btn btn-danger btn-settlement-summary-action wd125" data-action-type="withdraw-funds-finlymoney">Withdraw Funds</button>
      </div>
    </div>
    
    {{!-- <div class="row no-margin text-center">
      <button class="btn btn-success btn-sm btn-summary-action btn-credit">Credit</button>      
      
    </div> --}}
  </div>

  {{!-- <div class="col-sm-6" style="height: 100%;">
    

    <div class="row no-margin text-center">
      <button class="btn btn-sm btn-warning btn-summary-action btn-debit">Debit</button>
    </div>
  </div> --}}

</div>
<style type="text/css">

.settlement-summary-item{
  border-bottom: 1px solid #dfdfdf;
  margin: 3px;
}



  .settlement-summary-type, .settlement-summary-value{
    font-size: 14px;
  }

.btn-settlement-summary-action{
  margin: 0;
  margin-bottom: 3px;
}
.btn-report-summary-action{
  width: 150px;
  margin-top: 5px;
  margin-bottom: 5px;
  /*display: block;*/
}
</style>
