<div class="container-fluid container-main" style="position: relative;margin-top: 33px; height: 100%; padding-left: 0; padding-right: 0; width: 100%;">

  <div class="col-sm-3 no-padding users sidebar">
    <div class="row no-margin">
      
    </div>

    <div class="row no-margin" id="users">
      
    </div>
  </div>

  <div class="col-sm-9 col-sm-offset-3 main">

    <div class="summary row no-margin" style="background: #DDDAEA;color: #555;margin-bottom: 0px; height: 150px;box-shadow: 0 0 2px -1px rgba(0, 0, 0, 0.5);border-bottom: 3px solid #fff;">
      <div class="col-sm-10 col-sm-offset-1">
        <h1>Select user to see settlement details.</h1>
      </div>
    </div>  
    
    <div class="row no-margin settlements-content" style="height: calc(100% - 150px); display:none;">
      <div class="container-fluid"> 
        <ul class="nav nav-pills filter-status">
          <li class="{{#if_eq item.view_to_load 'payments'}}active{{/if_eq}}"><a href="#" data-view="payments">Settlements History</a></li>
          <li class="{{#if_eq item.view_to_load 'approved'}}active{{/if_eq}}"><a href="#" data-view="approved">Approved Reports</a></li>
          <li class="{{#if_eq item.view_to_load 'reimbursed'}}active{{/if_eq}}"><a href="#" data-view="reimbursed">Reimbursed Reports</a></li>
          <li class="{{#if_eq item.view_to_load 'closed'}}active{{/if_eq}}"><a href="#" data-view="closed">Closed Reports</a></li>
          <li class="{{#if_eq item.view_to_load 'credited_money_request'}}active{{/if_eq}}"><a href="#" data-view="credited_money_request">Credited Requests</a></li>
          <li class="{{#if_eq item.view_to_load 'money_request'}}active{{/if_eq}}"><a href="#" data-view="approved_money_request">Approved Requests</a></li>
        </ul>
      </div>

      <div class="settlements-index" style="height: 100%; overflow-y: scroll;"></div>
    </div>
  </div>

  <div class="modal fade" tabindex="-1" role="dialog" id="modal-settlements">
    <div class="modal-dialog" role="document" style="width: 60%;">
      <div class="modal-content">
        
      </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
  </div><!-- /.modal -->
</div>


