<nav class="navbar navbar-default navbar-fixed-top secondary-navbar" style="">
  <div class="container-fluid">
    <div class="row no-margin no-padding">
      <div class="col-md-3" style="box-shadow: -5px 0px 15px -10px rgba(0, 0, 0, 0.125) inset; padding-left: 0; padding-right: 0;">
        <div class="navbar-header navbar-sidebar" style="width: 100%;">
          <form class="navbar-form" role="search" style="padding-right: 0;">  
            <div class="input-group" style="width: 100%;">
              <input type="text" class="search-user input-global-search form-control" placeholder="Search" name="q" style="width: 100%;">
              <div class="input-group-btn">
                <button class="btn btn-default btn-global-search" type="submit"><i class="fa fa-search"></i></button>
              </div>
            </div>
          </form>
        </div>
      </div>
      <div class="col-md-9" style="">
        <div class="navbar-collapse collapse navbar-main">
          <ul class="navbar-nav nav">
            <li><a href="#">Company Balance: 50,500.00</a></li>
            <li><a href="#">Cash in Hand: 2,500.00</a></li>
            <li><a href="#">Card Balance: 10,500.00</a></li>
          </ul>
        </div><!--/.nav-collapse -->    
      </div>
    </div>
  </div><!--/.container-fluid -->
