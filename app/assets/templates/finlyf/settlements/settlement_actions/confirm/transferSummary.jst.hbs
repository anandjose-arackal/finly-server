<div class="row no-margin">
  <div class="col-sm-12 no-padding">
    <div class="row no-margin">
      <h4>Summary:</h4>
    </div>

    {{!-- <div class="row no-margin">
      <div class="col-sm-3 text-right">Initiating User:</div>
      <div class="col-sm-8"><label>You</label></div>
    </div> --}}

    <div class="row no-margin">
      <div class="col-sm-3 text-right">Receiver:</div>
      <div class="col-sm-8"><label>{{summary.actionData.transfer.receiver}}</label></div>
    </div>

    <div class="row no-margin">
      <div class="col-sm-3 text-right">Type of Payment:</div>
      <div class="col-sm-8"><label>Credit</label></div>
    </div>

    <div class="row no-margin">
      <div class="col-sm-3 text-right">From:</div>
      <div class="col-sm-8"><label>{{summary.actionData.transfer.from}}</label></div>
    </div>

    <div class="row no-margin">
      <div class="col-sm-3 text-right">To:</div>
      <div class="col-sm-8"><label>{{summary.actionData.transfer.to}}</label></div>
    </div>

    {{!-- <div class="row no-margin">
      <div class="col-sm-3 text-right">Note:</div>
      <div class="col-sm-8"><label>{{summary.actionData.c_card_from_wallet.note}}</label></div>
    </div> --}}

    <div class="row no-margin">
      <div class="col-sm-3 text-right">Total Amount:</div>
      <div class="col-sm-8"><label class="currency">&#8377;&nbsp;{{summary.actionData.transfer.amount}}</label></div>
    </div>
    
  </div>
</div>

<div class="row"><div class="col-sm-12 no-padding"><hr /></div></div>

<div class="row no-margin">
  <div class="col-sm-12 no-padding">

    <div class="form-group">
      <label class="control-label">Note</label>
      <textarea class="form-control" name="note"></textarea>
    </div>

    <div class="form-group">
      <label class="control-label">Date</label>
      <input class="form-control datepicker" type="text" name="date" readonly>
    </div>

    <div class="form-group">
      <label class="control-form">Password:</label>
      <input type="password" name="password" class="form-control password"/>
    </div>

    <div class="form-group text-center">
      <button class="btn btn-success btn-confirm-transfer step-final-action" data-url="{{summary.actionData.transfer.current_url}}" data-action-type="transfer">Confirm &amp; Transfer</button>
    </div>
  </div>
</div>






