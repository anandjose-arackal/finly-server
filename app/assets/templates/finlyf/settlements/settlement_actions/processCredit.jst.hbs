<div class="modal-dialog" role="document" style="width: 60%;">
  <div class="modal-content">
    <div class="modal-header">
      <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
      <h4 class="modal-title">Credit</h4>
    </div>
    <div class="modal-body">
      <div class="panel-group" id="accordion" role="tablist" aria-multiselectable="true">
        <div class="panel panel-default settlement-step-1 active" data-step="1" data-navigate="1">
          <div class="panel-heading" role="tab" id="headingOne">
            <div class="row no-margin" style="padding: 0 20px;">
              <div class="col-sm-6 no-padding">
                <h4 class="step-title">
                  <i class="fa fa-plus"></i><i class="fa fa-minus"></i>&nbsp;&nbsp;
                  <span class="title">Please Select Credit Type</span>
                  
                  {{!-- <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapse-step-1" aria-expanded="true" aria-controls="collapseOne">
                    Please Select Credit Type
                  </a> --}}
                </h4>
              </div>
              <div class="col-sm-6 no-padding">
                <h4 class="text-right"></h4>
              </div>
            </div>
            
          </div>
          <div id="collapse-step-1" class="panel-collapse collapse in" role="tabpanel" aria-labelledby="headingOne">
            <div class="panel-body">
              <div class="settlement-action-types col-sm-6">
                <ul class="settlement-actions">
                  {{#if summary.actions.credit_reimbursement}}
                    <li>
                      <label>
                        <input type="radio" name='settlement_credit_action' data-url="{{summary.actions.credit_reimbursement}}" data-action-type="credit_reimbursement"/> Credit Reimbursements
                      </label>
                      <label class="hidden">Reimburse by selecting reports</label>
                    </li>
                  {{/if}}
                  
                  {{#if summary.actions.credit_cash_advance}}
                    <li>
                      <label>
                        <input type="radio" name='settlement_credit_action' data-url="{{summary.actions.credit_cash_advance}}" data-action-type="credit_cash_advance" /> Add Cash Advance
                      </label>
                      <label class="hidden">Give advance funds to employee by transferring to their card or giving them cash.</label>
                    </li> 
                  {{/if}}
                  
                  {{#if summary.actions.credit_money_request}}
                    <li>
                      <label>
                        <input type="radio" name='settlement_credit_action' data-url="{{summary.actions.credit_money_request}}" data-action-type="credit_money_request" /> Credit Advance Fund Requests
                      </label>
                      <label class="hidden">Credit advance fund requests from employee.</label>
                    </li> 
                  {{/if}}
                  {{#if summary.actions.credit_card_from_card}}
                    <li>
                      <label>
                        <input type="radio" name='settlement_credit_action' data-url="{{summary.actions.credit_card_from_card}}" data-action-type="credit_card_from_card"/> Credit User's Card from Your Card
                      </label>
                      <label class="hidden">Credit employee's card from your own card.</label>
                    </li> 
                  {{/if}}
                  {{#if summary.actions.credit_card_from_wallet}}
                    <li>
                      <label>
                        <input type="radio" name='settlement_credit_action' data-url="{{summary.actions.credit_card_from_wallet}}" data-action-type="credit_card_from_wallet"/> Credit User's Card from Your Wallet
                      </label>
                      <label class="hidden">Credit employee's card from your wallet.</label>
                    </li> 
                  {{/if}}
                  {{#if summary.actions.credit_wallet_from_wallet}}
                    <li>
                      <label>
                        <input type="radio" name='settlement_credit_action' data-url="{{summary.actions.credit_wallet_from_wallet}}" data-action-type="credit_wallet_from_wallet"/> Credit Employee's Wallet from Your Wallet
                      </label>
                      <label class="hidden">Credit employee's wallet from your wallet.</label>
                    </li> 
                  {{/if}}
                  {{#if summary.actions.credit_card_from_virtual_account}}
                    <li>
                      <label>
                        <input type="radio" name='settlement_credit_action' data-url="{{summary.actions.credit_card_from_virtual_account}}" data-action-type="credit_card_from_virtual_account"/> Credit User's Card From Company Credits
                      </label>
                      <label class="hidden">Credit employee's card from company's credits.</label>
                    </li> 
                  {{/if}}
                  {{#if summary.actions.credit_wallet_from_virtual_account}}
                    <li>
                      <label>
                        <input type="radio" name='settlement_credit_action' data-url="{{summary.actions.credit_wallet_from_virtual_account}}" data-action-type="credit_wallet_from_virtual_account"/> Credit User's Wallet From Company Credits
                      </label>
                      <label class="hidden">Credit employee's wallet from company's credits.</label>
                    </li> 
                  {{/if}}
                </ul>
              </div>

              <div class="col-sm-6 settlement-action-definition">
                Credits and shit!
              </div>
            </div><!-- panel-body -->
          </div>
        </div>
        <div class="panel panel-default settlement-step-2" data-step="2" data-navigate="0">
          <div class="panel-heading" role="tab" id="headingTwo">
            <div class="row no-margin" style="padding: 0 20px;">
              <div class="col-sm-6 no-padding">
                <h4 class="step-title">
                  <i class="fa fa-plus"></i><i class="fa fa-minus"></i>&nbsp;&nbsp;
                  <span class="title">Please Select Credit Type</span>
                  {{!-- <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapse-step-1" aria-expanded="true" aria-controls="collapseOne">
                    Please Select Credit Type
                  </a> --}}
                </h4>
              </div>
              <div class="col-sm-6 no-padding">
                <h4 class="text-right"></h4>
              </div>
            </div>
          </div>
          <div id="collapse-step-2" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingTwo">
            <div class="panel-body">
              {{!-- Content --}}
            </div>
          </div>
        </div>

        <div class="panel panel-default settlement-step-3" data-step="3" data-navigate="0">
          <div class="panel-heading" role="tab" id="headingTwo">
            <div class="row no-margin" style="padding: 0 20px;">
              <div class="col-sm-6 no-padding">
                <h4 class="step-title">
                  <i class="fa fa-plus"></i><i class="fa fa-minus"></i>&nbsp;&nbsp;
                  <span class="title">Confirmation</span>
                  {{!-- <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapse-step-1" aria-expanded="true" aria-controls="collapseOne">
                    Please Select Credit Type
                  </a> --}}
                </h4>
              </div>
              <div class="col-sm-6 no-padding">
                <h4 class="text-right"></h4>
              </div>
            </div>
          </div>
          <div id="collapse-step-3" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingTwo">
            <div class="panel-body">
              <div class="col-sm-12">
                <div class="summary">
                  <button class="btn btn-default btn-sm btn-back-step-2">Previous Step</button>
                </div>
                <div class="content">
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div><!-- /.modal-content -->
</div><!-- /.modal-dialog -->
