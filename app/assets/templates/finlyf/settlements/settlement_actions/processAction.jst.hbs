<div class="modal-dialog" role="document" style="width: 70%;">
  <div class="modal-content">
    <div class="modal-header">
      <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
      <h4 class="modal-title">Action Title</h4>
    </div>
    <div class="modal-body">
      <div class="row no-margin">
        <div class="col-sm-12 no-padding border-accent-darker" style="border-radius: 2px 2px 0 0; margin-bottom: 10px;">
          <div class="row no-margin">
            <h4 class="no-margin bg-accent-dark" style="padding: 10px;">Selected User Details</h4>
          </div>
          <div class="row no-margin">
            <div class="col-sm-12 no-padding" style="padding: 10px 0;">
              <div class="col-sm-6" style="margin-bottom: 10px;">
                <div class="col-sm-5">User Name:</div>
                <div class="col-sm-7"><label>{{summary.user_details.name}}</label></div>
              </div>
              <div class="col-sm-6" style="margin-bottom: 10px;">
                <div class="col-sm-5">Mobile Number:</div>
                <div class="col-sm-7"><label>{{summary.user_details.mobile_number}}</label></div>
              </div>
              <div class="col-sm-6">
                <div class="col-sm-5">Email:</div>
                <div class="col-sm-7"><label>{{summary.user_details.email}}</label></div>
              </div>
            </div>  
          </div>
        </div>
      </div>


      <div class="panel-group" id="accordion" role="tablist" aria-multiselectable="true">
        <div class="panel panel-default settlement-step-1 active border-accent-darker" data-step="1" data-navigate="1">
          <div class="panel-heading bg-accent-dark" role="tab" id="headingOne">
            <div class="row no-margin" style="padding: 0 20px;">
              <div class="col-sm-12 no-padding">
                <h4 class="step-title">
                  <i class="fa fa-plus"></i><i class="fa fa-minus"></i>&nbsp;&nbsp;
                  <span class="title">Title Step 1</span>
                </h4>
              </div>
            </div>
          </div>
          <div id="collapse-step-1" class="panel-collapse collapse in" role="tabpanel" aria-labelledby="headingOne">
            <div class="panel-body">
              
            </div><!-- panel-body -->
          </div>
        </div>

        {{#if_eq summary.currentAction 'process-reports'}}
          <div class="panel panel-default settlement-step-2 border-accent-darker" data-step="2" data-navigate="0">
            <div class="panel-heading bg-accent-dark" role="tab" id="headingTwo">
              <div class="row no-margin" style="padding: 0 20px;">
                <div class="col-sm-12 no-padding">
                  <h4 class="step-title">
                    <i class="fa fa-plus"></i><i class="fa fa-minus"></i>&nbsp;&nbsp;
                    <span class="title">Title Step 2</span>
                  </h4>
                </div>
              </div>
            </div>
            <div id="collapse-step-2" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingTwo">
              <div class="panel-body">
                {{!-- Content --}}
              </div>
            </div>
          </div>
        {{/if_eq}}

        <div class="panel panel-default settlement-step-final border-accent-darker" data-step="3" data-navigate="0">
          <div class="panel-heading bg-accent-dark" role="tab" id="headingThree">
            <div class="row no-margin" style="padding: 0 20px;">
              <div class="col-sm-12 no-padding">
                <h4 class="step-title">
                  <i class="fa fa-plus"></i><i class="fa fa-minus"></i>&nbsp;&nbsp;
                  <span class="title">Confirm &amp; Proceed</span>
                </h4>
              </div>
            </div>
          </div>
          <div id="collapse-step-final" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingThree">
            <div class="panel-body">
              {{!-- Content --}}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div><!-- /.modal-content -->
</div><!-- /.modal-dialog -->
