<div class="process-screen col-sm-12">
  <div class="row no-margin">
    <label style="margin-top: 8px">Amount</label>
    <input name="payment[amount]" id="settlementAmount" class="form-control" style="margin-top: 4px; border-radius: 1px" type="text">
    <label style="margin-top: 8px">Date</label>

    <input name="payment[date]" id="settlementDate" class="form-control datepicker" min="'2000-01-01'" max="'2020-01-01'" style="margin-top: 4px;border-radius: 1px" type="text">
    <label style="margin-top: 8px">Note</label>

    <textarea id="settlementNote" name="payment[note]" class="form-control" placeholder="Write a note..." style="margin-top: 4px; border-radius: 1px;resize: vertical; margin-bottom: 10px;"></textarea>


    <input name="payment_type" value="{{item.payment_type}}" type="hidden" />

    {{#if_eq item.payment_type 1}}
      <label class="control-label">
        <input type="radio" name="payment[mode_type]" value="1">&nbsp; <i class="fa fa-money"></i> Cash
      </label>&nbsp;&nbsp;&nbsp;

      <label class="control-label">
        <input type="radio" name="payment[mode_type]" value="2">&nbsp; <i class="fa fa-cc-visa"></i> Card
      </label>

    {{/if_eq}}
    {{!-- <label class="radio-inline" style="">
      <input name="payment_type" value="1" type="radio" checked="checked">Cash Advance
    </label>

    <label class="radio-inline">
      <input name="payment_type" value="2" type="radio">Debt Clearance
    </label> --}}
    <br />

    <label style="margin-top: 8px">Password</label>

    <input name="password" class="form-control" style="margin-top: 4px;border-radius: 1px" type="password">
    <br />
  </div>
</div>