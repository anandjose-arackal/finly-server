<div class="row no-margin">
  <div class="col-sm-12 no-padding">
    <h4>Total Reimbursement to be Made: <span class="currency">&#8377;&nbsp;{{summary.actionData.selectedReportsTotal}}</span></h4>
    <input type="hidden" name="total_reimbursement" value="{{summary.actionData.selectedReportsTotal}}">
  </div>

  <div class="col-sm-12 no-padding">
    <div class="row no-margin">
      <div class="col-sm-6 no-padding">
        <h4>Cash in Hand:<span class="currency">&#8377;&nbsp;{{summary.userData.cash_in_hand}}</span></h4>
      </div>

      <div class="col-sm-6">
        <div class="form-group">
          <label>Deduct from Cash on Hand</label>
          <input type="number" value="0" name="from_cash_in_hand" class="form-control reimbursement-calculation cash-in-hand">
        </div>
      </div>
    </div>
  </div>

  <div class="col-sm-12 no-padding">
    <div class="row no-margin">
      <div class="col-sm-6 col-sm-offset-6">
        <div class="form-group">
          <label>Deduct from Cash in Hand</label>
          <input type="number" value="{{summary.actionData.selectedReportsTotal}}" name="from_outside_finly" class="form-control reimbursement-calculation outside-finly">
        </div>
      </div>
    </div>
  </div>
  <div class="col-sm-12 no-padding text-center">
    <button class="btn btn-sm btn-primary step-2-action" data-action-type="credit_reimbursement" data-url="{{summary.userData.actions.credit_reimbursement}}">Proceed</button>
  </div>
</div>