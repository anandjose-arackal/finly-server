<div class="row no-margin">
  <div class="col-sm-8 col-sm-offset-2">

    <div class="row no-margin">
      <div class="col-sm-3 no-padding">
        <label class="grey-text">From:</label>
        <h4 class="no-margin">User's&nbsp;Finly&nbsp;Account&nbsp;Balance</h4>
        <h3 class="no-margin mt-5 target_user_wallet_balance currency" style="margin-bottom: 0;"><i class="fa fa-spin fa-spinner"></i></h3>
      </div>

      <div class="transfer-flow"><i class="fa fa-long-arrow-right"></i></div>

      <div class="col-sm-2 col-sm-offset-5 no-padding">
        <label class="grey-text">To:</label>
        <h4 class="no-margin">Your&nbsp;Finly&nbsp;Account&nbsp;Balance</h4>
        <h3 class="no-margin mt-5 current_user_wallet_balance currency" style="margin-bottom: 0;"><i class="fa fa-spin fa-spinner"></i></h3>
      </div>
    </div>
  </div>

  <div class="col-sm-8 col-sm-offset-2"><hr /></div>
    
  <div class="col-sm-8 col-sm-offset-2"> 
    <div class="form-group">
      <label class="control-form">Amount:</label>
      <input type="number" name="amount" class="form-control card-funds-amount" />
    </div>

    <div class="form-group text-center">
      <button class="btn btn-success btn-confirm-transfer step-2-action" data-action-type="debit_wallet_to_wallet">Proceed</button>
    </div>
  </div>
</div>