<div class="row no-margin">
  <div class="col-sm-8 col-sm-offset-2">
    <div>
      You wallet balance: {{item.current_user_wallet_balance}}
    </div>
    <div class="form-group">
      <label class="control-form">Amount:</label>
      <input type="number" name="amount" class="form-control card-funds-amount" value="{{item.amount}}" />
    </div>

    <div class="form-group text-center">
      <button class="btn btn-success btn-confirm-transfer step-2-action" data-action-type="credit_wallet_from_virtual_account">Proceed</button>
    </div>
  </div>
</div>