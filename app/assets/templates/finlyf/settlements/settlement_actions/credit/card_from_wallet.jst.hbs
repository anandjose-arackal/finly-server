<div class="row no-margin">
  <div class="col-sm-8 col-sm-offset-2">

    <div class="col-sm-6 text-center">
      <h3 class="current_user_wallet_balance" style="margin-bottom: 0;">&nbsp;</h3>
      <span style="font-size: 11px;=">(Your Wallet Balance)</span>
    </div>

    <div class="transfer-flow"><i class="fa fa-long-arrow-right"></i></div>

    <div class="col-sm-6 text-center">
      <h3 class="target_user_card_balance" style="margin-bottom: 0;">&nbsp;</h3>
      <span style="font-size: 11px;=">(User's Card Balance)</span>
    </div>
    
    <div class="form-group">
      <label class="control-form">Amount:</label>
      {{#if item.target_user_card_details.active}}
      <input type="number" name="amount" class="form-control card-funds-amount" value="" />
      {{else}}
      <input type="text" name="amount" class="form-control card-funds-amount" value="Employee's card is blocked!" disabled="disabled" />
      {{/if}}
    </div>

    <div class="form-group text-center">
    {{#if item.target_user_card_details.active}}
      <button class="btn btn-success btn-confirm-transfer step-2-action" data-action-type="credit_card_from_wallet">Proceed</button>
    {{else}}
      <button class="btn btn-success btn-confirm-transfer" disabled="disabled" data-action-type="credit_card_from_wallet">Proceed</button>
    {{/if}}
    </div>
  </div>
</div>