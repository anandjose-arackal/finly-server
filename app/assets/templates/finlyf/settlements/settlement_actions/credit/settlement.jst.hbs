<div class="process-screen col-sm-12">
  <div class="row no-margin">
    <div class="col-sm-8 no-padding" style="border-right: 1px solid #eee;">
      <div class="row no-margin">
        <div class="col-sm-9"><h5>Cash on Hand</h5></div>
        <div class="col-sm-3"><h5 class="requested_money">{{summary.cash_in_hand}}</h5></div>
      </div>
      <div class="row no-margin">
        <div class="col-sm-9"><h5>Selected Reports' Total</h5></div>
        <div class="col-sm-3"><h5 class="selected_items_total">0</h5></div>
      </div>
    </div>

    <div class="col-sm-4 no-padding text-center">
      <button class="btn btn-sm btn-success btn-settlement-action" disabled="disabled">Credit Reports</button>
    </div>
  </div>

  <div class="row no-margin">
    <div class="col-sm-12 no-padding bg-accent-light" style="font-weight: bold;">
      <div class="col-md-5">
        <div class="col-sm-2">{{!-- <input class="main-select-all" type="checkbox" /> --}}</div>
        <div class="col-sm-10">Name</div>
      </div>

      <div class="col-md-7">
        <div class="col-sm-5">Final Approver</div>
        <div class="col-sm-4 text-right">Reimbursement Amount</div>
        <div class="col-sm-3 text-right">Total Amount</div>
      </div>
    </div>
    <div class="settlement-action-items"></div>
  </div>
</div>

<div class="confirmation-screen col-sm-6 col-sm-offset-3" style="display: none;">
  <div class="row no-margin" style="margin-bottom: 10px">
    <div class="col-sm-6">
      <button class="btn btn-lg navbar-btn btn-cancel-confirmation"><i class="fa fa-backward"></i></button>
    </div>
  </div>
  <div class="row no-margin" style="margin-bottom: 10px;">
    <div class="col-sm-4 text-right">
      <label class="control-label">Note</label>
    </div>

    <div class="col-sm-8">
      <textarea class="form-control" name="payment[note]"></textarea>
    </div>
  </div>
  <div class="row no-margin" style="margin-bottom: 10px;">
    <div class="col-sm-4 text-right">
      <label class="control-label">Date</label>
    </div>

    <div class="col-sm-8">
      <input class="form-control datepicker" type="text" name="payment[date]">
    </div>
  </div>

  <div class="row no-margin">
    <div class="col-sm-8 col-sm-offset-5">
      <button class="btn btn-sm btn-primary confirm-report-action" data-action-type="credit-money-request">Credit</button>
    </div>
  </div>

</div>