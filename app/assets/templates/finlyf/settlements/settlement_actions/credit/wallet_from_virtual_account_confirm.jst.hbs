<div class="row no-margin">
  <div class="col-sm-12 no-padding">
    <div class="row no-margin">
      <h4>Summary:</h4>
    </div>

    {{!-- <div class="row no-margin">
      <div class="col-sm-3 text-right">Initiating User:</div>
      <div class="col-sm-8"><label>You</label></div>
    </div> --}}

    <div class="row no-margin">
      <div class="col-sm-3 text-right">Receiving User:</div>
      <div class="col-sm-8"><label>{{summary.userData.user_details.name}}</label></div>
    </div>

    <div class="row no-margin">
      <div class="col-sm-3 text-right">Type of Payment:</div>
      <div class="col-sm-8"><label>Credit</label></div>
    </div>

    <div class="row no-margin">
      <div class="col-sm-3 text-right">From:</div>
      <div class="col-sm-8"><label>Company Account</label></div>
    </div>

    <div class="row no-margin">
      <div class="col-sm-3 text-right">To:</div>
      <div class="col-sm-8"><label>{{summary.userData.user_details.name}}'s Wallet</label></div>
    </div>

    <div class="row no-margin">
      <div class="col-sm-3 text-right">Total Amount:</div>
      <div class="col-sm-8"><label class="currency">&#8377;&nbsp;{{summary.actionData.c_wallet_from_virtual_account.amount}}</label></div>
    </div>
    
  </div>
</div>

<div class="row"><div class="col-sm-12 no-padding"><hr /></div></div>

<div class="row no-margin">
  <div class="col-sm-12 no-padding">
    <div class="form-group">
      <label class="control-form">Password:</label>
      <input type="password" name="password" class="form-control password"/>
    </div>

    <div class="form-group text-center">
      <button class="btn btn-success btn-confirm-transfer step-3-action" data-url="{{summary.userAction.actions.credit_wallet_from_virtual_account}}" data-action-type="credit_wallet_from_virtual_account">Confirm &amp; Transfer</button>
    </div>
  </div>
</div>