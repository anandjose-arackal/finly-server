<div class="col-sm-12 no-padding">
  <div class="row no-margin" style="margin-bottom: 10px;">
    <div class="col-sm-4 text-right">
      <label class="control-label">Note</label>
    </div>

    <div class="col-sm-8">
      <textarea class="form-control" name="payment[note]"></textarea>
    </div>
  </div>

  <div class="row no-margin" style="margin-bottom: 10px;">
    <div class="col-sm-4 text-right">
      <label class="control-label">Date</label>
    </div>

    <div class="col-sm-8">
      <input class="form-control datepicker" type="text" name="payment[date]">
    </div>
  </div>

  <div class="row no-margin">
    <div class="col-sm-8 col-sm-offset-5">
      <button class="btn btn-sm btn-primary confirm-report-action step-3-action" data-url="{{summary.actions.credit_money_request}}" data-action-type="credit_money_request">Credit</button>
    </div>
  </div>
</div> 