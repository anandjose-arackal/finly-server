<div class="col-md-4">
  <div class="col-sm-2"><input class="settlement-report-select" type="checkbox" data-item-id="{{item.id}}" /></div>
  <div class="col-sm-10">{{item.name}}</div>
</div>

<div class="col-md-8">
  <div class="col-sm-4">
    {{#if item.final_approver}}
      {{item.final_approver}}
    {{else}}
      Auto-Approved
    {{/if}}
  </div>
  <div class="col-sm-3 text-right">&#8377;&nbsp;{{item.card_expenses_total}}</div>
  <div class="col-sm-3 text-right">&#8377;&nbsp;{{item.cash_expenses_total}}</div>
  <div class="col-sm-2 text-right">&#8377;&nbsp;{{item.total_amount}}</div>
</div>