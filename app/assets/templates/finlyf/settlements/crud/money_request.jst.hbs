<div class="col-sm-2">{{item.name}}</div>
<div class="col-sm-2 no-padding">
  {{#if item.final_approver}}
    {{item.final_approver}}
  {{else}}
    Auto-Approved
  {{/if}}
</div>
<div class="col-sm-1">
  {{#switch item.payment_mode_id}}
    {{#case 1}}<i class='fa fa-money'></i>&nbsp; Cash{{/case}}
    {{#case 2}}<i class='fa fa-cc-visa'></i>&nbsp; Card{{/case}}
  {{/switch}}
</div>
<div class="col-sm-1 no-padding">{{item.status}}</div>
<div class="col-sm-2">
{{#if item.credited_date}}
  {{item.credited_date}}
{{else if item.required_by_date}}
  {{item.required_by_date}}
{{else}}
  --
{{/if}}
</div>
<div class="col-sm-3 no-padding">{{#if item.memo}}{{item.memo}}{{else}}--{{/if}}</div>
<div class="col-sm-1 text-right">&#8377; {{item.request_amount}}</div>