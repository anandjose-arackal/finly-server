<div class="col-sm-10 col-sm-offset-1">
  <div class="col-sm-4">
    <h4>Pending Reimbursement</h4>
    <h4 class="summary_pending_reimbursement">{{item.pending_reimbursement}}</h4>
    <button class="btn btn-sm btn-process-reimburse">Reimburse</button>
  </div>

  <div class="col-sm-4">
    <h4>Cash in Hand</h4>
    <h4 class="summary_cash_id_hand">{{item.cash_in_hand}}</h4>
    <input type="hidden" name="cash_in_hand" value="{{item.cash_in_hand}}">
    <button class="btn btn-sm btn-process-debt">Settle Debt</button>
  </div>

  <div class="col-sm-4">
    <button class="btn btn-sm btn-process-payment">Add Cash</button>
  </div>
</div>

