<div class="row x conditional no-margin" data-condition-serial="{{item.condition_serial}}">
  <div class="col-sm-12 hideme">
    {{#if this.policy_id}}{{else}}
      <input type="number" name="user_manager_mapping[{{item.condition_serial}}][mapping][policy_id]" value="{{item.policy_id}}">(Policy Name {{item.condition_serial}})
    {{/if}}
    <input type="number" name="user_manager_mapping[{{item.condition_serial}}][mapping_id]" value="">(Mapping ID {{item.condition_serial}})
  </div>

  <div class="col-sm-3">If report total is greater than:</div>

  <div class="col-sm-2">
    <input type="hidden" class="" name="user_manager_mapping[{{item.condition_serial}}][mapping][greater_than_amount_attributes][currency_id]" value="1">
    <input type="number" class="form-control" name="user_manager_mapping[{{item.condition_serial}}][mapping][greater_than_amount_attributes][value]" value="">
  </div>

  <div class="col-sm-3">then submits reports to:{{item.condition_serial}} - {{item.policy_id}}</div>

  <div class="col-sm-3">
    <select class="form-control" name="user_manager_mapping[{{item.condition_serial}}][mapping][{{item.manager_type}}_id]" data-default-value="">
      <option value="">None</option>
      {{#if_eq item.manager_type 'manager'}}
        {{#each item.managers}}
          <option value="{{this.id}}">{{this.name}}</option>
        {{/each}}
      {{else}}
        {{#each item.finance_managers}}
          <option value="{{this.id}}">{{this.name}}</option>
        {{/each}}
      {{/if_eq}}
    </select>
    {{!-- <input type="number" class="item-attr-edit" name="user_manager_mapping[1][mapping][manager_id]" value="{{this.conditional_manager.manager.id}}"> --}}
  </div>
  <div class="col-sm-1"><button class="btn-remove-condition btn btn-xs btn-danger">Remove</button></div>
</div><!-- .conditional -->
{{!-- 
conditional_serial
managers
policy_id
manager_type

 --}}