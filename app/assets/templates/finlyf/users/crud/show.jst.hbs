<section class="user-info">
  <div class="row">
    <div class="col-sm-6">
      <h4>User Info</h4>
    </div>
    <div class="col-sm-6 text-right">
      <button class="btn btn-sm navbar-btn btn-warning btn-edit-user">Edit</button>
    </div>
  </div>
  <form class="form-user-info">
    <div class="row">
      <div class="col-sm-3">Name</div>
      <div class="col-sm-9">
        <label class="item-attr-preview">{{item.name}}</label>
        <input class="item-attr-edit" type="text" name="user[name]" value="{{item.name}}" />
      </div>
    </div>

    <div class="row">
      <div class="col-sm-3">Email</div>
      <div class="col-sm-9">
        <label class="item-attr-preview">{{item.email}}</label>
        <input class="item-attr-edit" type="text" name="user[email]" value="{{item.email}}" />
      </div>
    </div>

    <div class="row">
      <div class="col-sm-3">Mobile</div>
      <div class="col-sm-9">
        <label class="item-attr-preview">{{item.mobile_number}}</label>
        <input class="item-attr-edit" type="text" name="user[mobile_number]" value="{{item.mobile_number}}" />
      </div>
    </div>
  </form>
</section>


<section class="user-roles">
  <div class="row">
    <div class="col-sm-6">
      <h4>User Roles</h4>
    </div>
    <div class="col-sm-6 text-right">
      <button class="btn btn-sm navbar-btn btn-warning btn-edit-user">Edit</button>
    </div>
  </div> 
  <form class="fomr-user-roles">
    
  
    <div class="row">
      <div class="col-sm-3">Admin?</div>
      <div class="col-sm-9">
        <label class="item-attr-preview">{{#if item.role.admin}}Yes{{else}}No{{/if}}</label>

        <label class="item-attr-edit">
          <input class="" type="radio" name="user_roles[admin]" value="1" />&nbsp;&nbsp;Yes
        </label>

        <label class="item-attr-edit">
          <input class="" type="radio" name="user_roles[admin]" value="0" />&nbsp;&nbsp;No  
        </label>
        
      </div>
    </div>

    <div class="row">
      <div class="col-sm-3">Manager?</div>
      <div class="col-sm-9">
        <label class="item-attr-preview">{{#if item.role.manager}}Yes{{else}}No{{/if}}</label>

        <label class="item-attr-edit">
           <input class="" type="radio" name="user_roles[manager]" value="1" />&nbsp;&nbsp;Yes
        </label>

        <label class="item-attr-edit">
           <input class="" type="radio" name="user_roles[manager]" value="0" />&nbsp;&nbsp;No
        </label>
      </div>
    </div>

    <div class="row">
      <div class="col-sm-3">Finance Manager?</div>
      <div class="col-sm-9">
        <label class="item-attr-preview">{{#if item.role.finance_manager}}Yes{{else}}No{{/if}}</label>

        <label class="item-attr-edit">
           <input class="" type="radio" name="user_roles[finance_manager]" value="1" />&nbsp;&nbsp;Yes
        </label>

        <label class="item-attr-edit">
           <input class="" type="radio" name="user_roles[finance_manager]" value="0" />&nbsp;&nbsp;No
        </label>
      </div>
    </div>
  </form>

</section>

<div class="user-policies">
  <div class="row">
    <div class="col-sm-6">
      <h4>Policies</h4>
    </div>
  </div>

  
  {{#each item.mapping}}
  <form>
  <div class="policy-name">
    {{#if this.company_default}}Default{{else}}{{this.policy.name}}{{/if}}
    {{#if this.company_default}}{{else}}
      <input type="number" name="user_manager_mapping[0][mapping][policy_id]" value="{{this.policy.id}}">{{this.policy.name}}(PolicyName 0)
    {{/if}}
  </div>
  <div class="managers pad">
    <input type="number" name="user_manager_mapping[0][mapping_id]" value="{{this.default.mapping_id}}">(Mapping ID 0)
    <div class="manager">
      <input type="number" name="user_manager_mapping[0][mapping][manager_id]" value="{{this.default.manager.id}}">{{this.default.manager.name}}(Manger 0)
    </div>
    <div class="finance-manager">
      <input type="number" name="user_manager_mapping[0][mapping][finance_manager_id]" value="{{this.default.finance_manager.id}}">{{this.default.finance_manager.name}}(Finance Manager 0)
    </div>

    <div class="approves-to">
      <input type="number" name="user_manager_mapping[0][mapping][approves_to_id]" value="{{this.default.approves_to.id}}">{{this.default.approves_to.name}}(Approves_to 0)

    </div>

    <div class="approves-finance-to">
      <input type="number" name="user_manager_mapping[0][mapping][approves_finance_to_id]" value="{{this.default.approves_finance_to.id}}">{{this.default.approves_finance_to.name}}(Approves Finance to 0)

    </div>

    <div class="conditional-manager pad">
      <div class="policy-name">
        {{#if this.company_default}}{{else}}
          <input type="number" name="user_manager_mapping[1][mapping][policy_id]" value="{{this.policy.id}}">{{this.policy.name}}(Policy Name 1)
        {{/if}}
      </div>
      <input type="number" name="user_manager_mapping[1][mapping_id]" value="{{this.conditional_manager.mapping_id}}">(Mapping ID 1)

      <div class="greater-than">
        <input type="number" name="user_manager_mapping[1][mapping][greater_than_amount_attributes][value]" value="{{this.conditional_manager.greater_than_amount.value}}">(Greater than amount 1)
      </div>

      <div class="manager">
        <input type="number" name="user_manager_mapping[1][mapping][manager_id]" value="{{this.conditional_manager.manager.id}}">{{this.conditional_manager.manager.name}}(Conditional Manager 1)
      </div>
      
      
    </div>

    <div class="conditional-finance-manager pad">
      <div class="policy-name">
        {{#if this.company_default}}{{else}}
          <input type="number" name="user_manager_mapping[2][mapping][policy_id]" value="{{this.policy.id}}">{{this.policy.name}}(Policy Name 2)
        {{/if}}
      </div>
      <input type="number" name="user_manager_mapping[2][mapping_id]" value="{{this.conditional_finance_manager.mapping_id}}">(Mapping ID 2)

      <div class="greater-than">
        <input type="number" name="user_manager_mapping[2][mapping][greater_than_amount_attributes][value]" value="{{this.conditional_finance_manager.greater_than_amount.value}}">(Greater than amount 2)
      </div>

      <div class="finance-manager">
        <input type="number" name="user_manager_mapping[2][mapping][finance_manager_id]" value="{{this.conditional_finance_manager.finance_manager.id}}">{{this.conditional_finance_manager.finance_manager.name}}(Conditional Manager 2)
      </div>
      
      
    </div>

    <div class="conditional-approves-to pad">
      <div class="policy-name">
        {{#if this.company_default}}{{else}}
          <input type="number" name="user_manager_mapping[3][mapping][policy_id]" value="{{this.policy.id}}">{{this.policy.name}}(Policy Name 3)
        {{/if}}
      </div>
      <input type="number" name="user_manager_mapping[3][mapping_id]" value="{{this.conditional_approves_to.mapping_id}}">(Mapping ID 3)

      <div class="greater-than">
        <input type="number" name="user_manager_mapping[3][mapping][greater_than_amount_attributes][value]" value="{{this.conditional_approves_to.greater_than_amount.value}}">(Greater than amount 3)
      </div>

      <div class="manager">
        <input type="number" name="user_manager_mapping[3][mapping][approves_to_id]" value="{{this.conditional_approves_to.approves_to.id}}">{{this.conditional_approves_to.approves_to.name}}(Conditional approves to 3)
      </div>
      
      
    </div>

    <div class="conditional-approves-finance-to pad">
      <div class="policy-name">
        {{#if this.company_default}}{{else}}
          <input type="number" name="user_manager_mapping[4][mapping][policy_id]" value="{{this.policy.id}}">{{this.policy.name}}(Policy Name 4)
        {{/if}}
      </div>
      <input type="number" name="user_manager_mapping[4][mapping_id]" value="{{this.conditional_approves_finance_to.mapping_id}}">(Mapping ID 4)

      <div class="greater-than">
        <input type="number" name="user_manager_mapping[3][mapping][greater_than_amount_attributes][value]" value="{{this.conditional_approves_finance_to.greater_than_amount.value}}">(Greater than amount 4)
      </div>

      <div class="manager">
        <input type="number" name="user_manager_mapping[4][mapping][approves_finance_to_id]" value="{{this.conditional_approves_finance_to.approves_to.id}}">{{this.conditional_approves_finance_to.approves_to.name}}(Conditional approves to 4)
      </div>
      
      
    </div>

    <input type="hidden" name="type" value="team">
    <button class="btn-update-user">Update</button>
  </div>
  </form>
  <hr /><hr />
  {{/each}}


</div>


<style type="text/css">
  .pad{
    padding: 10px;
    background: white;
    margin-bottom: 10px;
  }
</style>









