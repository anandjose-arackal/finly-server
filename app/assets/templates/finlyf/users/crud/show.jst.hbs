<section class="user-policies">
  <div class="row">
    <div class="col-sm-6">
      <h4>Policies</h4>
    </div>
  </div>

  
  {{#each item.mapping}}
  <div class="policy">
    <div class="row policy-name">
      <div class="col-sm-6">
        {{#if this.company_default}}
          Default
        {{else}}
          <input type="hidden" name="user_manager_mapping[0][mapping][policy_id]" value="{{this.policy.id}}">
          {{this.policy.name}}{{!-- (PolicyName 0) --}}
        {{/if}}
      </div>

      <div class="col-sm-6 text-right">
        <button class="btn btn-sm btn-warning btn-edit-policy">Edit</button>
      </div>
    </div>

    <div class="policy-rules row no-margin">
      <form>
        <div class="row no-margin">
          <div class="col-sm-6 manager-data">
            <div class="row manager non-conditional">

              <div class="col-sm-5">
                Reports to:
              </div>

              <div class="col-sm-7">

                <input type="hidden" class="conditional-mapping-id" name="user_manager_mapping[0][mapping_id]" value="{{this.default.mapping_id}}">{{!-- (Mapping ID 0) --}}
                <label class="control-label item-attr-preview">
                  {{#if this.default.manager.name}}
                    {{this.default.manager.name}}
                  {{else}}
                    Not Set
                  {{/if}}
                </label>{{!-- Manager 0 --}}
                <select class="item-attr-edit" name="user_manager_mapping[0][mapping][manager_id]" data-default-value="{{this.default.manager.id}}">
                  <option value="">None</option>
                  {{#each ../item.company_managers}}
                    <option value="{{this.id}}">{{this.name}}</option>
                  {{/each}}
                </select>
                {{!-- <input type="number" class="item-attr-edit" name="user_manager_mapping[0][mapping][manager_id]" value="{{this.default.manager.id}}"> --}}
              </div>
            </div>
            
            <hr />

            {{#each this.conditional_manager}}
            <div class="row x conditional" data-condition-serial="1">

              <div class="col-sm-12 hideme">
                {{#if ../this.company_default}}{{else}}
                  <input type="number" name="user_manager_mapping[1][mapping][policy_id]" value="{{../this.policy.id}}">{{../this.policy.name}}(Policy Name 1)
                {{/if}}
                <input type="number" name="user_manager_mapping[1][mapping_id]" value="{{this.mapping_id}}">(Mapping ID 1)
              </div>

              <div class="col-sm-5">If amount is greater than:</div>

              <div class="col-sm-7">
                <label class="control-label item-attr-preview">
                {{#if this.greater_than_amount.value}}
                  {{this.greater_than_amount.value}}
                {{else}}
                  Not Set
                {{/if}}
                </label>{{!-- (Greater than amount 1) --}}
                <input type="hidden" class="item-attr-edit" name="user_manager_mapping[1][mapping][greater_than_amount_attributes][currency_id]" value="1">
                <input type="number" class="item-attr-edit" name="user_manager_mapping[1][mapping][greater_than_amount_attributes][value]" value="{{this.greater_than_amount.value}}">
              </div>

              <div class="col-sm-5">Then Reports to:</div>

              <div class="col-sm-7">
                <label class="control-label item-attr-preview">
                {{#if this.manager.name}}
                  {{this.manager.name}}
                {{else}}
                  Not Set
                {{/if}}
                </label>{{!-- (Conditional Manager 1) --}}
                <select class="item-attr-edit" name="user_manager_mapping[1][mapping][manager_id]" data-default-value="{{this.manager.id}}">
                  <option value="">None</option>
                  {{#each ../../item.company_managers}}
                    <option value="{{this.id}}">{{this.name}}</option>
                  {{/each}}
                </select>
                {{!-- <input type="number" class="item-attr-edit" name="user_manager_mapping[1][mapping][manager_id]" value="{{this.conditional_manager.manager.id}}"> --}}
              </div>
              
            </div><!-- .conditional -->

            {{/each}}
            <div class="col-sm-12 add-condition">
              <button class="btn-sm btn-default btn-add-condition item-attr-edit" data-policy-id="{{../item.policy.id}}" data-manager-type="manager">Add Condition</button>
            </div>
          </div><!-- .col-sm-6 -->

          <div class="col-sm-6 finance-manager-data">

            <div class="row finance-manager non-conditional">
              <div class="col-sm-5">
                Reports Finance to:
              </div>

              <div class="col-sm-7">
                <label class="control-label item-attr-preview">
                  {{#if this.default.finance_manager.name}}
                    {{this.default.finance_manager.name}}
                  {{else}}
                    Not Set
                  {{/if}}
                </label>{{!-- (Finance Manager 0) --}}
                <select class="item-attr-edit" name="user_manager_mapping[0][mapping][finance_manager_id]" data-default-value="{{this.default.finance_manager.id}}">
                  <option value="">None</option>
                  {{#each ../item.company_finance_managers}}
                    <option value="{{this.id}}">{{this.name}}</option>
                  {{/each}}
                </select>
                {{!-- <input type="number" class="item-attr-edit" name="user_manager_mapping[0][mapping][finance_manager_id]" value="{{this.default.finance_manager.id}}"> --}}
              </div>
            </div>

            <hr />
            {{#each conditional_finance_manager}}
            <div class="row finance-manager conditional" data-condition-serial="2">
              <div class="col-sm-12 hideme">
                {{#if ../this.company_default}}{{else}}
                  <input type="number" name="user_manager_mapping[2][mapping][policy_id]" value="{{../this.policy.id}}">{{../this.policy.name}}(Policy Name 2)
                {{/if}}

                <input type="number" name="user_manager_mapping[2][mapping_id]" value="{{this.mapping_id}}">(Mapping ID 2)
              </div>

              <div class="col-sm-5">If Amount is Greater than:</div>

              <div class="col-sm-7">
                <label class="control-label item-attr-preview">
                  {{#if this.greater_than_amount.value}}
                    {{this.greater_than_amount.value}}
                  {{else}}
                    Not Set
                  {{/if}}
                </label>{{!-- (Greater than amount 2) --}}
                <input type="hidden" class="item-attr-edit" name="user_manager_mapping[2][mapping][greater_than_amount_attributes][currency_id]" value="1">
                <input type="number" class="item-attr-edit" name="user_manager_mapping[2][mapping][greater_than_amount_attributes][value]" value="{{this.greater_than_amount.value}}">
              </div>

              
              <div class="col-sm-5">Then Reports to:</div>



              <div class="col-sm-7">
                <label class="control-label">
                {{#if this.finance_manager.name}}
                  {{this.finance_manager.name}}
                {{else}}
                  Not Set
                {{/if}}
                </label>{{!-- (Conditional Manager 2) --}}
                <select class="item-attr-edit" name="user_manager_mapping[2][mapping][finance_manager_id]" data-default-value="{{this.finance_manager.id}}">
                  <option value="">None</option>
                  {{#each ../../item.company_finance_managers}}
                    <option value="{{this.id}}">{{this.name}}</option>
                  {{/each}}
                </select>
                {{!-- <input type="number" class="item-attr-edit" name="user_manager_mapping[2][mapping][finance_manager_id]" value="{{this.conditional_finance_manager.finance_manager.id}}"> --}}
              </div>

            </div><!-- .conditional -->
            {{/each}}
            <div class="col-sm-12 add-condition">
              <button class="btn-sm btn-default btn-add-condition item-attr-edit" data-policy-id="{{../item.policy.id}}" data-manager-type="finance_manager">Add Condition</button>
            </div>
          </div><!-- .col-sm-6 -->
        </div><!-- .row -->

        <hr />


        <div class="row no-margin">
          <div class="col-sm-6 approves-to-data">

            {{#if ../item.role.manager}}
            <div class="row approves-to non-conditional">
              <div class="col-sm-5">
                Approves To:
              </div>

              <div class="col-sm-7">
                <label class="control-label item-attr-preview">
                {{#if this.default.approves_to.name}}
                  {{this.default.approves_to.name}}
                {{else}}
                  Not Set
                {{/if}}
                </label>{{!-- (Approves_to 0) --}}

                <select class="item-attr-edit" name="user_manager_mapping[0][mapping][approves_to_id]" data-default-value="{{this.default.approves_to.id}}">
                  <option value="">None</option>
                  {{#each ../item.company_managers}}
                    <option value="{{this.id}}">{{this.name}}</option>
                  {{/each}}
                </select>
                {{!-- <input type="number" class="item-attr-edit" name="user_manager_mapping[0][mapping][approves_to_id]" value="{{this.default.approves_to.id}}"> --}}
              </div>
            </div>

            <hr />

            {{#each conditional_approves_to}}
            <div class="row conditional approves_to" data-condition-serial="3">

              <div class="col-sm-12 hideme">
                {{#if ../this.company_default}}{{else}}
                  <input type="number" name="user_manager_mapping[3][mapping][policy_id]" value="{{../this.policy.id}}">{{../this.policy.name}}(Policy Name 3)
                {{/if}}
                <input type="number" name="user_manager_mapping[3][mapping_id]" value="{{this.mapping_id}}">(Mapping ID 3)
              </div>

              <div class="col-sm-5">If Amount is Greater than:</div>

              <div class="col-sm-7">
                <label class="control-label item-attr-preview">
                  {{#if this.greater_than_amount.value}}
                    {{this.greater_than_amount.value}}
                  {{else}}
                    Not Set
                  {{/if}}
                </label>{{!-- (Greater than amount 3) --}}
                <input type="hidden" class="item-attr-edit" name="user_manager_mapping[3][mapping][greater_than_amount_attributes][currency_id]" value="1">
                <input type="number" class="item-attr-edit" name="user_manager_mapping[3][mapping][greater_than_amount_attributes][value]" value="{{this.greater_than_amount.value}}">

              </div>

              <div class="col-sm-5">Then Reports to:</div>

              <div class="col-sm-7">
                <label class="control-label item-attr-preview">
                  {{#if this.approves_to.name}}
                    {{this.approves_to.name}}
                  {{else}}
                    Not Set
                  {{/if}}
                </label>{{!-- (Conditional approves to 3) --}}

                <select class="item-attr-edit" name="user_manager_mapping[3][mapping][approves_to_id]" data-default-value="{{this.approves_to.id}}">
                  <option value="">None</option>
                  {{#each ../../item.company_managers}}
                    <option value="{{this.id}}">{{this.name}}</option>
                  {{/each}}
                </select>
                {{!-- <input type="number" class="item-attr-edit" name="user_manager_mapping[3][mapping][approves_to_id]" value="{{this.conditional_approves_to.approves_to.id}}"> --}}
              </div>
            </div>
            {{/each}}
            <div class="col-sm-12 add-condition">
              <button class="btn-sm btn-default btn-add-condition item-attr-edit" data-policy-id="{{../item.policy.id}}" data-manager-type="approves_to">Add Condition</button>
            </div>
            {{/if}}
          </div><!-- .col-sm-6 -->


          <div class="col-sm-6 approves-finance-to-data">
            {{#if ../item.role.finance_manager}}
            <div class="row approves-finance-to non-conditional">
              <div class="col-sm-5">Approves Finance To</div>

              <div class="col-sm-7">
                <label class="control-label item-attr-preview">
                  {{#if this.default.approves_finance_to.name}}
                    {{this.default.approves_finance_to.name}}
                  {{else}}
                    Not Set
                  {{/if}}
                </label>{{!-- (Approves Finance to 0) --}}

                <select class="item-attr-edit" name="user_manager_mapping[0][mapping][approves_finance_to_id]" data-default-value="{{this.default.approves_finance_to.id}}">
                  <option value="">None</option>
                  {{#each ../item.company_finance_managers}}
                    <option value="{{this.id}}">{{this.name}}</option>
                  {{/each}}
                </select>
                {{!-- <input type="number" class="item-attr-edit" name="user_manager_mapping[0][mapping][approves_finance_to_id]" value="{{this.default.approves_finance_to.id}}"> --}}

              </div>
            </div>

            <hr />

            {{#each this.conditional_approves_finance_to}}
            <div class="row conditional approves-finance-to" data-condition-serial="4">
              <div class="col-sm-12 hideme">
                {{#if ../this.company_default}}{{else}}
                  <input type="number" name="user_manager_mapping[4][mapping][policy_id]" value="{{../this.policy.id}}">{{../this.policy.name}}(Policy Name 4)
                {{/if}}

                <input type="number" name="user_manager_mapping[4][mapping_id]" value="{{this.mapping_id}}">(Mapping ID 4)
              </div>

              <div class="col-sm-5">If Amount Greater than:</div>

              <div class="col-sm-7">
                <label class="item-attr-preview">
                  {{#if this.greater_than_amount.value}}
                    {{this.greater_than_amount.value}}
                  {{else}}
                    Not Set
                  {{/if}}
                </label>{{!-- (Greater than amount 4) --}}
                <input type="hidden" class="item-attr-edit" name="user_manager_mapping[4][mapping][greater_than_amount_attributes][currency_id]" value="1">
                <input type="number" class="item-attr-edit" name="user_manager_mapping[4][mapping][greater_than_amount_attributes][value]" value="{{this.greater_than_amount.value}}">

              </div>

              <div class="col-sm-5">Then Reports To:</div>

              <div class="col-sm-7">
                <label class="control-label item-attr-preview">
                  {{#if this.approves_finance_to.name}}
                    {{this.approves_finance_to.name}}
                  {{else}}
                    Not Set
                  {{/if}}
                </label>{{!-- (Conditional approves to 4) --}}
                <select class="item-attr-edit" name="user_manager_mapping[4][mapping][approves_finance_to_id]" data-default-value="{{this.approves_finance_to.id}}">
                  <option value="">None</option>
                  {{#each ../../item.company_finance_managers}}
                    <option value="{{this.id}}">{{this.name}}</option>
                  {{/each}}
                </select>
                {{!-- <input type="number" class="item-attr-edit" name="user_manager_mapping[4][mapping][approves_finance_to_id]" value="{{this.conditional_approves_finance_to.approves_to.id}}"> --}}
              </div>
            </div>
            {{/each}}
            <div class="col-sm-12 add-condition">
              <button class="btn-sm btn-default btn-add-condition item-attr-edit" data-policy-id="{{../item.policy.id}}" data-manager-type="approves_finance_to">Add Condition</button>
            </div>

            {{/if}}
            
          </div><!-- .col-sm-6 -->
        </div>
        <input type="hidden" name="type" value="team">
      </form>
    </div>
    
    <hr /><hr />
  </div><!-- .policy -->
  {{/each}}


</section>


