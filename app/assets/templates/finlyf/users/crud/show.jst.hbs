<div class="row-no-margin" style="height: 100%;">
  <div class="col-sm-2 no-padding" style="position: fixed; z-index: 1;">
    <ul class="nav nav-tabs user-tab-panes">
      <li class="active"><a href="#tab-user-details" data-toggle="tab">Details</a></li>
      <li><a href="#tab-user-roles" data-toggle="tab">Roles</a></li>
      <li><a href="#tab-user-wallet-cards" data-toggle="tab">Finly Account &amp; Cards</a></li>
      {{!-- <li><a href="#tab-user-cards" data-toggle="tab">Cards</a></li> --}}
      <li><a href="#tab-user-policies" data-toggle="tab">Policies</a></li>
    </ul>
  </div>

  <div class="col-sm-10 col-sm-offset-2 no-padding" style="height: 100%; background: #fff; box-shadow: 0 0 30px 0 rgba(0,0,0,.1);">
    <div class="tab-content">
      <div class="tab-pane active" id="tab-user-details">
        <section class="user-info">
          <div class="row">
            <div class="col-sm-6">
              <h4>User Info</h4>
            </div>
            {{#if item.user.editable}}
              <div class="col-sm-6 text-right">
                {{#if item.actions.delete_invite}}
                  <button class="btn btn-danger btn-sm btn-user-action" data-method="DELETE" data-presence="false" data-type="" data-url="{{item.actions.delete_invite}}">Delete Invite</button>
                {{/if}}
                {{#if item.actions.resend_invite}}
                  <button class="btn btn-success btn-sm btn-user-action" data-method="PUT" data-presence="true" data-type="resend" data-url="{{item.actions.resend_invite}}">Resend Invite</button>
                {{/if}}
                {{#if item.actions.deactivate}}
                  <button class="btn btn-danger btn-sm btn-user-action" data-method="PUT" data-presence="true" data-type="state" data-state-active="false" data-url="{{item.actions.deactivate}}">Deactivate</button>
                {{/if}}
                {{#if item.actions.activate}}
                  <button class="btn btn-success btn-sm btn-user-action" data-method="PUT" data-presence="true" data-type="state" data-state-active="true" data-url="{{item.actions.activate}}">Activate</button>
                {{/if}}
                {{#if item.user.activateable}}
                  <button class="btn btn-lg btn-success btn-active-employee">Activate</button>
                {{/if}}
              </div>
            {{/if}}

          </div>
          <form class="form-user-info">
            <div class="row">
              <div class="col-sm-3">Name</div>
              <div class="col-sm-9">
                <label class="item-attr-preview">{{item.user.name}}</label>
                <input class="item-attr-edit form-control" type="text" name="user[name]" value="{{item.user.name}}" />
              </div>
            </div>

            <div class="row">
              <div class="col-sm-3">Email</div>
              <div class="col-sm-9">
                <label class="item-attr-preview">{{item.user.email}}</label>
                <input class="item-attr-edit form-control" type="text" disabled="disabled" name="" value="{{item.user.email}}" />
              </div>
            </div>

            <div class="row">
              <div class="col-sm-3">Mobile</div>
              <div class="col-sm-9">
                <label class="item-attr-preview">
                  {{#if item.user.mobile_number}}
                    {{item.user.mobile_number}}
                  {{else}}
                    Not Set
                  {{/if}}
                </label>
                <input class="item-attr-edit form-control" type="text" name="user[mobile_number]" value="{{item.user.mobile_number}}" />
              </div>
            </div>

            <div class="row">
              <div class="col-sm-3">Gender</div>
              <div class="col-sm-9">
                <label class="item-attr-preview">
                  {{#if item.user.gender}}
                    {{#if_eq item.user.gender 'm'}}Male{{else}}Female{{/if_eq}}
                  {{/if}}
                </label>
              </div>
            </div>

            <div class="row">
              <div class="col-sm-3">Address</div>
              <div class="col-sm-9">
                <label class="item-attr-preview">
                  {{#if item.user.address}}
                    {{item.user.address}}
                  {{else}}
                    --
                  {{/if}}
                </label>
              </div>
            </div>

            <input type="hidden" name="type" value="details">
          </form>
        </section>
      </div>
      <div class="tab-pane" id="tab-user-roles">
        <section class="user-roles">
          <div class="row">
            <div class="col-sm-6">
              <h4>User Roles</h4>
            </div>
            <div class="col-sm-6 text-right">
            {{#if item.user.editable}}
              <button class="btn btn-sm btn-warning btn-edit-user"><i class="fa fa-edit"></i>&nbsp;&nbsp;Edit</button>
            {{/if}}
            </div>
          </div> 
          <form class="form-user-roles">
          
            <div class="row">
              <div class="col-sm-3">Admin?</div>
              <div class="col-sm-9">
                <label class="item-attr-preview">{{#if item.role.admin}}Yes{{else}}No{{/if}}</label>

                {{#if item.role.editable.admin}}

                  {{#if item.role.admin}}
                    <label class="item-attr-edit">
                      <input class="" type="radio" name="user_roles[admin]" value="1" checked="checked" />&nbsp;&nbsp;Yes
                    </label>
                    <label class="item-attr-edit">
                      <input class="" type="radio" name="user_roles[admin]" value="0" />&nbsp;&nbsp;No  
                    </label>
                  {{else}}
                    <label class="item-attr-edit">
                      <input class="" type="radio" name="user_roles[admin]" value="1" />&nbsp;&nbsp;Yes
                    </label>
                    <label class="item-attr-edit">
                      <input class="" type="radio" name="user_roles[admin]" value="0" checked="checked" />&nbsp;&nbsp;No  
                    </label>
                  {{/if}}

                {{else}}

                  {{#if item.role.admin}}
                    <label class="item-attr-edit">
                      <input disabled="disabled" class="" type="radio" name="user_roles[admin]" value="1" checked="checked" />&nbsp;&nbsp;Yes
                    </label>
                    <label class="item-attr-edit">
                      <input disabled="disabled" class="" type="radio" name="user_roles[admin]" value="0" />&nbsp;&nbsp;No  
                    </label>
                  {{else}}
                    <label class="item-attr-edit">
                      <input disabled="disabled" class="" type="radio" name="user_roles[admin]" value="1" />&nbsp;&nbsp;Yes
                    </label>
                    <label class="item-attr-edit">
                      <input disabled="disabled" class="" type="radio" name="user_roles[admin]" value="0" checked="checked" />&nbsp;&nbsp;No  
                    </label>
                  {{/if}}

                {{/if}}

                
                
              </div>
            </div>

            <div class="row">
              <div class="col-sm-3">Manager?</div>
              <div class="col-sm-9">
                <label class="item-attr-preview">{{#if item.role.manager}}Yes{{else}}No{{/if}}</label>

                {{#if item.role.editable.manager}}
                  {{#if item.role.manager}}
                    <label class="item-attr-edit">
                       <input class="" type="radio" name="user_roles[manager]" value="1" checked="checked" />&nbsp;&nbsp;Yes
                    </label>
                    <label class="item-attr-edit">
                       <input class="" type="radio" name="user_roles[manager]" value="0" />&nbsp;&nbsp;No
                    </label>
                  {{else}}
                    <label class="item-attr-edit">
                       <input class="" type="radio" name="user_roles[manager]" value="1" />&nbsp;&nbsp;Yes
                    </label>
                    <label class="item-attr-edit">
                       <input class="" type="radio" name="user_roles[manager]" value="0" checked="checked" />&nbsp;&nbsp;No
                    </label>
                  {{/if}}

                {{else}}

                  {{#if item.role.manager}}
                    <label class="item-attr-edit">
                       <input disabled="disabled" class="" type="radio" name="user_roles[manager]" value="1" checked="checked" />&nbsp;&nbsp;Yes
                    </label>
                    <label class="item-attr-edit">
                       <input disabled="disabled" class="" type="radio" name="user_roles[manager]" value="0" />&nbsp;&nbsp;No
                    </label>
                  {{else}}
                    <label class="item-attr-edit">
                       <input disabled="disabled" class="" type="radio" name="user_roles[manager]" value="1" />&nbsp;&nbsp;Yes
                    </label>
                    <label class="item-attr-edit">
                       <input disabled="disabled" class="" type="radio" name="user_roles[manager]" value="0" checked="checked" />&nbsp;&nbsp;No
                    </label>
                  {{/if}}

                {{/if}}
                
              </div>
            </div>

            <div class="row">
              <div class="col-sm-3">Finance Manager?</div>
              <div class="col-sm-9">
                <label class="item-attr-preview">{{#if item.role.finance_manager}}Yes{{else}}No{{/if}}</label>

                {{#if item.role.editable.finance_manager}}

                  {{#if item.role.finance_manager}}
                    <label class="item-attr-edit">
                       <input class="" type="radio" name="user_roles[finance_manager]" value="1" checked="checked" />&nbsp;&nbsp;Yes
                    </label>
                    <label class="item-attr-edit">
                       <input class="" type="radio" name="user_roles[finance_manager]" value="0" />&nbsp;&nbsp;No
                    </label>
                  {{else}}
                    <label class="item-attr-edit">
                       <input class="" type="radio" name="user_roles[finance_manager]" value="1" />&nbsp;&nbsp;Yes
                    </label>
                    <label class="item-attr-edit">
                       <input class="" type="radio" name="user_roles[finance_manager]" value="0" checked="checked" />&nbsp;&nbsp;No
                    </label>
                  {{/if}}

                {{else}}

                  {{#if item.role.finance_manager}}
                    <label class="item-attr-edit">
                       <input disabled="disabled" class="" type="radio" name="user_roles[finance_manager]" value="1" checked="checked" />&nbsp;&nbsp;Yes
                    </label>
                    <label class="item-attr-edit">
                       <input disabled="disabled" class="" type="radio" name="user_roles[finance_manager]" value="0" />&nbsp;&nbsp;No
                    </label>
                  {{else}}
                    <label class="item-attr-edit">
                       <input disabled="disabled" class="" type="radio" name="user_roles[finance_manager]" value="1" />&nbsp;&nbsp;Yes
                    </label>
                    <label class="item-attr-edit">
                       <input disabled="disabled" class="" type="radio" name="user_roles[finance_manager]" value="0" checked="checked" />&nbsp;&nbsp;No
                    </label>
                  {{/if}}

                {{/if}}
                
              </div>
            </div>

            <input type="hidden" name="type" value="role">
          </form>
        </section>
      </div>
      <div class="tab-pane" id="tab-user-wallet-cards">
        <section class="user-wallet" style="">
          <div class="row">
            <div class="col-sm-6"><h4>Finly Account</h4></div>
          </div>
          <div class="row">
            <div class="col-sm-6">
              <div class="col-sm-3" style="padding-top: 15px; font-size: 16px;">Balance:</div>
              <div class="col-sm-9"><h4 class="wallet-balance currency" style="font-size: 24px; font-weight: bold;">&#8377;&nbsp;&nbsp;{{item.wallet.balance}}</h4></div>
            </div>
          </div>
          <div class="row">
            <div class="col-sm-6">
              <div class="col-sm-3" style="padding-top: 15px; font-size: 16px;">Actions:</div>
              <div class="col-sm-9">
                <div class="dropdown">
                  <button class="btn btn-sm btn-success" data-target="#" href="" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                    Credit
                    <span class="caret"></span>
                  </button>

                  <ul class="dropdown-menu" aria-labelledby="dLabel">
                    {{#if item.actions.credit_wallet_from_virtual_account}}
                      <li><a class="btn-card-action" data-url="{{item.actions.credit_wallet_from_virtual_account}}" data-action-type="credit_wallet_from_virtual_account">From Company Credits</a> </li>
                    {{/if}}
                    {{#if item.actions.credit_wallet_from_wallet}}
                      <li><a class="btn-card-action" data-url="{{item.actions.credit_wallet_from_wallet}}" data-action-type="credit_wallet_from_wallet">From Your Finly Account</a> </li>
                    {{/if}}
                  </ul>
                </div>


                <div class="dropdown">
                  <button class="btn btn-sm btn-success" data-target="#" href="" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                    Debit
                    <span class="caret"></span>
                  </button>

                  <ul class="dropdown-menu" aria-labelledby="dLabel">
                    {{#if item.actions.debit_wallet_to_virtual_account}}
                      <li><a class="btn-card-action" data-url="{{item.actions.debit_wallet_to_virtual_account}}" data-action-type="debit_wallet_to_virtual_account">To Company Credits</a> </li>
                    {{/if}}
                    {{#if item.actions.debit_wallet_to_wallet}}
                      <li><a class="btn-card-action" data-url="{{item.actions.debit_wallet_to_wallet}}" data-action-type="debit_wallet_to_wallet">To Your Finly Account</a> </li>
                    {{/if}}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </section>
        <hr />
        {{#if item.card.assigned}}
        <section class="user-cards">
          <div class="row">
            <div class="col-sm-6"><h4 style="margin-bottom: 20px;">Assigned Cards</h4></div>
          </div>

          <div class="row">
            <div class="col-sm-6">
              <div class="card text-center">
                <div class="logo">Finly</div>
                <div class="status">
                  {{#if item.card.active}}
                    <label class="control-label"><i class="fa fa-check-circle" style="color: #2ecc71; cursor: default;"></i>&nbsp;&nbsp;<span>Active</span></label>
                  {{else}}
                    <label class="control-label"><i class="fa fa-minus-circle" style="color: #e74c3c; cursor: default;"></i>&nbsp;&nbsp;<span>Inactive</span></label>
                  {{/if}}
                </div>
                <div class="card-type">Expense Card</div>
                <div class="card-number">
                  <span class="first-four">XXXX</span>
                  <span class="second-four">XXXX</span>
                  <span class="third-four">XXXX</span>
                  <span class="fourth-four">{{item.card.ending_number}}</span>
                </div>
                <div class="user-name">{{item.user.name}}</div>
                <div class="visa"><i class="fa fa-cc-visa" style="cursor: default;"></i></div>
                
              </div>
            </div>

            <div class="col-sm-6 card-actions">
              <div class="row" style="margin-bottom: 25px;">
                <div class="col-sm-3" style="font-size: 16px;">
                  Status:
                </div>
                <div class="col-sm-9" style="margin-top: -5px; font-size: 16px;">
                  {{#if item.card.active}}
                    <label class="control-label">Active</label>
                  {{else}}
                    <label class="control-label">Blocked</label>
                  {{/if}}

                  {{#if item.actions.deactivate_card}}
                  &nbsp;&nbsp;&nbsp; <button class="btn btn-sm btn-danger btn-card-update-status no-margin" data-card-status-type="0">Block</button>
                  {{/if}}
                  {{#if item.actions.activate_card}}
                  &nbsp;&nbsp;&nbsp;<button class="btn btn-sm btn-success btn-card-update-status no-margin" data-card-status-type="1">Unblock</button>
                  {{/if}}
                </div>
              </div>
              <div class="row" style="margin-bottom: 25px;">
                <div class="col-sm-3" style="font-size: 16px;">
                  Actions: 
                </div>
                <div class="col-sm-9">
                  {{#if item.card.active}}
                    {{#ifCond item.actions.credit_card_from_virtual_account '||' item.actions.credit_card_from_wallet}}
                      <div class="dropdown">
                        <button class="btn btn-sm btn-success" style="margin: 0;" data-target="#" href="" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                          Credit
                          <span class="caret"></span>
                        </button>

                        <ul class="dropdown-menu" aria-labelledby="dLabel">
                          {{#if item.actions.credit_card_from_virtual_account}}
                            <li><a class="btn-card-action" data-url="{{item.actions.credit_card_from_virtual_account}}" data-action-type="credit_card_from_virtual_account">From Company Credits</a> </li>
                          {{/if}}
                          {{#if item.actions.credit_card_from_wallet}}
                            <li><a class="btn-card-action" data-url="{{item.actions.credit_card_from_wallet}}" data-action-type="credit_card_from_wallet">From Your Finly Account</a> </li>
                          {{/if}}
                        </ul>
                      </div>
                    {{/ifCond}} 
                  {{else}}
                    <button class="btn btn-sm btn-success" disabled="disabled">Credit <span class="caret"></span></button>
                    (Blocked by {{item.card.disabled_by.name}})
                  {{/if}}
                </div>
              </div>
              <div class="row" style="margin-bottom: 25px;">
                <div class="col-sm-3" style="font-size: 16px;">
                  Balance: 
                </div>
                <div class="col-sm-9" style="font-size: 16px;">
                  <div class="card-balance">
                    <label class="balance currency">&nbsp;</label>&nbsp;&nbsp;&nbsp;<i style="color: #4CAF50;" class="fa fa-refresh btn-card-request-balance"></i>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
        {{else}}
        <section>
          <h4>User is not associated with any cards.</h4>
        </section>
        {{/if}}
      </div>
      {{!-- <div class="tab-pane" id="tab-user-cards">
        
      </div> --}}
      <div class="tab-pane" id="tab-user-policies">
        <section class="user-policies">
          <div class="row">
            <div class="col-sm-6">
              <h4>POLICIES</h4>
            </div>
          </div>

          
          {{#each item.mapping}}
          <div class="policy">
            <div class="row policy-name no-margin">
              <div class="col-sm-6">
                <h4>
                  {{#if this.company_default}}
                    Default
                  {{else}}
                    <input type="hidden" name="user_manager_mapping[0][mapping][policy_id]" value="{{this.policy.id}}">
                    {{this.policy.name}}{{!-- (PolicyName 0) --}}
                  {{/if}}
                </h4>
              </div>

              <div class="col-sm-6 text-right">

              {{#if ../item.user.editable}}
                <button class="btn btn-sm btn-warning btn-edit-policy"><i class="fa fa-edit"></i>&nbsp;&nbsp;Edit</button>
              {{/if}}
              </div>
            </div>

            <div class="policy-rules row no-margin">
              <form>
                <div class="row no-margin" style="padding: 10px 10px 0;">
                  <div class="col-sm-12 manager-data manager-container">
                    <div class="row manager non-conditional no-margin">
                      Submits reports To:&nbsp;&nbsp;

                      <input type="hidden" name="user_manager_mapping[0][mapping_id]" value="{{this.default.mapping_id}}">{{!-- (Mapping ID 0) --}}
                      <label class="control-label item-attr-preview">
                        {{#if this.default.manager.name}}
                          {{this.default.manager.name}}
                        {{else}}
                          Not Set
                        {{/if}}
                      </label>{{!-- Manager 0 --}}
                      <select class="select-assign-manager form-control item-attr-edit" name="user_manager_mapping[0][mapping][manager_id]" data-default-value="{{this.default.manager.id}}">
                        <option value="">None</option>
                        {{#each ../item.team_managers}}
                          <option value="{{this.id}}">{{this.name}}</option>
                        {{/each}}
                      </select>
                      {{!-- <input type="number" class="item-attr-edit" name="user_manager_mapping[0][mapping][manager_id]" value="{{this.default.manager.id}}"> --}}
                    </div>
                    
                    
                    {{#each this.conditional_manager}}
                    <div class="row x conditional no-margin" data-condition-serial="{{add @index 1}}">

                      <div class="col-sm-12 hideme">
                        {{#if ../this.company_default}}{{else}}
                          <input type="number" name="user_manager_mapping[{{increment @index 1}}][mapping][policy_id]" value="{{../this.policy.id}}">{{../this.policy.name}}(Policy Name 1)
                        {{/if}}
                        <input type="number" class="mapping-id" name="user_manager_mapping[{{increment @index 1}}][mapping_id]" value="{{this.mapping_id}}">(Mapping ID 1)
                      </div>

                      <div class="col-sm-3">If report total is greater than:</div>

                      <div class="col-sm-2">
                        <label class="control-label item-attr-preview">
                        {{#if this.greater_than_amount.value}}
                          {{this.greater_than_amount.value}}
                        {{else}}
                          Not Set
                        {{/if}}
                        </label>{{!-- (Greater than amount 1) --}}
                        <input type="hidden" class="item-attr-edit" name="user_manager_mapping[{{increment @index 1}}][mapping][greater_than_amount_attributes][currency_id]" value="1">
                        <input type="number" class="form-control item-attr-edit" name="user_manager_mapping[{{increment @index 1}}][mapping][greater_than_amount_attributes][value]" value="{{this.greater_than_amount.value}}">
                      </div>

                      <div class="col-sm-3">then submits report to:</div>

                      <div class="col-sm-3">
                        <label class="control-label item-attr-preview">
                        {{#if this.manager.name}}
                          {{this.manager.name}}
                        {{else}}
                          Not Set
                        {{/if}}
                        </label>{{!-- (Conditional Manager 1) --}}
                        <select class="form-control item-attr-edit" name="user_manager_mapping[{{increment @index 1}}][mapping][manager_id]" data-default-value="{{this.manager.id}}">
                          <option value="">None</option>
                          {{#each ../../item.team_managers}}
                            <option value="{{this.id}}">{{this.name}}</option>
                          {{/each}}
                        </select>
                        {{!-- <input type="number" class="item-attr-edit" name="user_manager_mapping[1][mapping][manager_id]" value="{{this.conditional_manager.manager.id}}"> --}}
                      </div>
                      <div class="col-sm-1">
                        <button class="item-attr-edit btn btn-xs btn-danger btn-remove-condition">Remove</button>
                      </div>
                    </div><!-- .conditional -->
                    {{/each}}
                    <div class="col-sm-12 add-condition">
                      <button class="btn btn-sm btn-default btn-add-condition item-attr-edit" data-policy-id="{{this.policy.id}}" data-manager-type="manager">Add Condition</button>
                    </div>
                  </div><!-- .col-sm-12 -->
                  <hr />
                  <div class="col-sm-12 finance-manager-data manager-container">
                    <div class="row finance-manager non-conditional no-margin">
                      Submits Report Finance to:&nbsp;&nbsp;

                      <label class="control-label item-attr-preview">
                        {{#if this.default.finance_manager.name}}
                          {{this.default.finance_manager.name}}
                        {{else}}
                          Not Set
                        {{/if}}
                      </label>{{!-- (Finance Manager 0) --}}
                      <select class="select-assign-manager form-control item-attr-edit" name="user_manager_mapping[0][mapping][finance_manager_id]" data-default-value="{{this.default.finance_manager.id}}">
                        <option value="">None</option>
                        {{#each ../item.team_finance_managers}}
                          <option value="{{this.id}}">{{this.name}}</option>
                        {{/each}}
                      </select>
                      {{!-- <input type="number" class="item-attr-edit" name="user_manager_mapping[0][mapping][finance_manager_id]" value="{{this.default.finance_manager.id}}"> --}}
                    </div>

                    {{#each this.conditional_finance_manager}}
                    <div class="row finance-manager conditional no-margin" data-condition-serial="{{add ../this.conditional_manager.length @index 1}}">
                      <div class="col-sm-12 hideme">
                        {{#if ../this.company_default}}{{else}}
                          <input type="number" name="user_manager_mapping[{{add ../this.conditional_manager.length @index 1}}][mapping][policy_id]" value="{{../this.policy.id}}">{{../this.policy.name}}(Policy Name 2)
                        {{/if}}

                        <input type="number" class="mapping-id" name="user_manager_mapping[{{add ../this.conditional_manager.length @index 1}}][mapping_id]" value="{{this.mapping_id}}">(Mapping ID 2)
                      </div>

                      <div class="col-sm-3">If report total is greater than:</div>

                      <div class="col-sm-2">
                        <label class="control-label item-attr-preview">
                          {{#if this.greater_than_amount.value}}
                            {{this.greater_than_amount.value}}
                          {{else}}
                            Not Set
                          {{/if}}
                        </label>{{!-- (Greater than amount 2) --}}
                        <input type="hidden" class="item-attr-edit" name="user_manager_mapping[{{add ../this.conditional_manager.length @index 1}}][mapping][greater_than_amount_attributes][currency_id]" value="1">
                        <input type="number" class="form-control item-attr-edit" name="user_manager_mapping[{{add ../this.conditional_manager.length @index 1}}][mapping][greater_than_amount_attributes][value]" value="{{this.greater_than_amount.value}}">
                      </div>

                      
