<div class="row no-margin">
  <div class="col-sm-6">
    <h4>{{item.category.name}}</h4>
  </div>
  <div class="col-sm-4">

    <input type="hidden" name="money_request[items_attributes][][category_id]" value="{{item.category.id}}">
    <label class="control-label item-attr-preview">{{item.amount.value}}</label>
    <input name="money_request[items_attributes][][amount_attributes][value]" type="number" class="item-attr-edit form-control" value="{{item.amount.value}}" />
    <input name="money_request[items_attributes][][amount_attributes][currency_id]" type="hidden" value="1" />
  </div>
  <div class="col-sm-2">
    <button class="btn btn-danger btn-sm btn-remove-request-category item-attr-edit">Remove</button>
  </div>
</div>