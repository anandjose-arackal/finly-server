<div class="row sidebar-element">
  <ul class="nav nav-pills nav-stacked filter-status">
    <li class="{{#if item.filter_status}}{{else}}active{{/if}}"><a href="#" data-status-id="">All</a></li>
    {{#if item.view}}
      {{#if_eq item.view 'personal'}}
        <li class="{{#if_eq item.filter_status 1}}active{{/if_eq}}"><a href="#" data-status-id="1">Open</a></li>
      {{/if_eq}}
    {{else}}
      <li class="{{#if_eq item.filter_status 1}}active{{/if_eq}}"><a href="#" data-status-id="1">Open</a></li>
    {{/if}}
    <li class="{{#if_eq item.filter_status 2}}active{{/if_eq}}"><a href="#" data-status-id="2">Processing</a></li>
    <li class="{{#if_eq item.filter_status 5}}active{{/if_eq}}"><a href="#" data-status-id="5">Approved</a></li>
    <li class="{{#if_eq item.filter_status 4}}active{{/if_eq}}"><a href="#" data-status-id="4">Rejected</a></li>
    <li class="{{#if_eq item.filter_status 3}}active{{/if_eq}}"><a href="#" data-status-id="3">Retracted</a></li>
    <li class="{{#if_eq item.filter_status 6}}active{{/if_eq}}"><a href="#" data-status-id="6">Credited</a></li>
    <li 
  </ul>
</div>
<hr />
<div class="row sidebar-element">
  <div class="col-sm-3 sidebar-label">
    From
  </div>
  <div class="col-sm-9">
    <input type="text" class="form-control datepicker filter-date-from" style="width: 100%;" value="{{item.filter_date_from}}"/>
    <span class="fa fa-calendar input-icon "></span> 

  </div>
</div>
<div class="row sidebar-element">
  <div class="col-sm-3 sidebar-label">
    To
  </div>
  <div class="col-sm-9">
    <input type="text" class="form-control datepicker filter-date-to" style="width: 100%;" value="{{item.filter_date_to}}" />
    <span class="fa fa-calendar input-icon "></span> 
  </div>
</div>

{{#if item.view}}
  {{#if_not_eq item.view 'personal'}}
  <div class="row sidebar-element">
    <div class="col-sm-12 sidebar-label">
      Search by User
    </div>
    <div class="col-sm-12">
      <input type="text" class="form-control filter-field filter-user" style="width: 100%;" data-field="user" />
      <span class="fa fa-search input-icon"></span> 
    </div>
  </div>
  {{/if_not_eq}}
{{/if}}

<div class="row sidebar-element">
  <div class="col-sm-12 text-center">
    <button class="btn-warning btn btn-sm btn-filter">Apply Filter</button>
  </div>
</div>

<style type="text/css">
  ul.nav-stacked > li > a{
    color: #787878;
    /*text-transform: uppercase;*/
    padding: 5px 15px;
    background: transparent;
    border-radius: 0;
  }

  ul.nav-stacked > li > a.active{
    background: #594DA8;
    color: white;
    text-decoration: none;
  }
</style>