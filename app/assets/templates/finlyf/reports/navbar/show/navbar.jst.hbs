<div class="row no-margin no-padding">
  <div class="col-sm-8" style="box-shadow: -5px 0px 15px -10px rgba(0, 0, 0, 0.125) inset">
    <div class="">
      <div class="col-sm-4 no-padding">
        <ul class="nav navbar-nav navbar-left">
          <button class="btn-go-back btn btn-info btn-sm"><i class="fa fa-step-backward"></i>&nbsp;Go Back to Reports</button>
        </ul>
      </div>
      
      <div class="col-sm-4 col-sm-offset-4">
        <ul class="nav navbar-nav navbar-right">
          {{#if item.actions.take_control}}
            <button class="btn btn-warning btn-sm" id="btnTakeControlReport" data-toggle="modal" data-target="#modal-confirm-take-control" data-url="{{item.actions.take_control}}">Take Control&nbsp;&nbsp;<i class="fa fa-edit"></i></button>
          {{/if}}

          {{#if item.actions.submit}}
            {{#if item.actions.editable}}
              <button class="btn bnt-warning btn-sm btn-edit-item">Edit&nbsp;&nbsp;<i class="fa fa-edit"></i></button>
            {{/if}}
            <button class="btn btn-sm btn-report-action btn-success" data-url="{{item.actions.submit}}">Submit&nbsp;&nbsp;<i class="fa fa-check-square"></i></button>
          {{/if}}

          {{#if item.actions.retract}}
            <button class="btn btn-sm btn-report-action btn-danger" data-url="{{item.actions.retract}}">Retract&nbsp;&nbsp;<i class="fa fa-check-square"></i></button>
          {{/if}}

          {{#if item.actions.approve}}
            <button class="btn btn-sm btn-success btn-report-action" data-url="{{item.actions.approve}}">Approve</button>
          {{/if}}

          {{#if item.actions.unapprove}}
            <button class="btn btn-sm btn-danger btn-report-action" data-url="{{item.actions.unapprove}}">Unapprove</button>
          {{/if}}

          {{#if item.actions.reject}}
            <button class="btn btn-sm btn-danger" id="btnRejectReport" data-toggle="modal" data-target="#modal-confirm-reject" data-url="{{item.actions.reject}}">Reject</button>
          {{/if}}

          {{#if item.actions.reimbursement_confirm}}
            <button class="btn btn-sm btn-success btn-report-action" data-url="{{item.actions.reimbursement_confirm}}"><i class="fa fa-check-circle"></i>&nbsp;&nbsp;Confirm Reimbursement</button>
          {{/if}}
        </ul>   
      </div>
    </div>
  </div>
  <div class="col-sm-4" style="background: #F6F7FC; height: 50px;">
    <div class="navbar-header navbar-sidebar">
      <h4>Timeline</h4>
    </div>
  </div>
</div>