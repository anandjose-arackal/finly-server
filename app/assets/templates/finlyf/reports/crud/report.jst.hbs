{{!-- item = report --}}
{{#if item.view}}
  {{#if_not_eq item.view 'personal'}}
    <div class="col-md-4">
      <div class="col-sm-1 no-padding">
        <input class="select-item report" type="checkbox" data-item-id="{{item.id}}" />
      </div>
      <div class="col-sm-4">{{item.date}}</div>
      <div class="col-sm-7">{{item.name}}</div>
    </div>

    <div class="col-md-8">
      <div class="col-sm-3">{{item.user.name}}</div>
      <div class="col-sm-2 text-center">
      {{#switch item.status}}
        {{#case 'Open'}}<span class="label label-default">{{item.status}}</span>{{/case}}
        {{#case 'Approved'}}<span class="label label-success">{{item.status}}</span>{{/case}}
        {{#case 'Rejected'}}<span class="label label-danger">{{item.status}}</span>{{/case}}
        {{#case 'Retracted'}}<span class="label label-default">{{item.status}}</span>{{/case}}
        {{#case 'Processing'}}<span class="label label-primary">{{item.status}}</span>{{/case}}
        {{#case 'Awaiting Approval'}}<span class="label label-primary">{{item.status}}</span>{{/case}}
        {{#case 'Settled'}}<span class="label label-success"><i class="fa fa-check-circle"></i>&nbsp;{{item.status}}</span>{{/case}}
        {{#case 'Settlement Confirmed'}}<span class="label label-success"><i class="fa fa-check-circle"></i><i class="fa fa-check-circle"></i>&nbsp;{{item.status}}</span>{{/case}}
        {{#case 'Closed'}}<span class="label label-success"><i class="fa fa-check-circle"></i><i class="fa fa-check-circle"></i>&nbsp;{{item.status}}</span>{{/case}}
      {{/switch}}
      </div>
      <div class="col-sm-2 text-right">&#8377;&nbsp;{{item.total}}</div>
      <div class="col-sm-2">{{#if item.policy}}{{item.policy}}{{else}}--{{/if}}</div>
      <div class="col-sm-3">{{#if item.memo}}{{item.memo}}{{else}}--{{/if}}</div>
    </div>
  {{else}}
    <div class="col-md-4">
      <div class="col-sm-1 no-padding">
        <input class="select-item report" type="checkbox" data-item-id="{{item.id}}" />
      </div>
      <div class="col-sm-4">{{item.date}}</div>
      <div class="col-sm-7">{{item.name}}</div>
    </div>

    <div class="col-md-8">
      <div class="col-sm-3 text-center">
      {{#switch item.status}}
        {{#case 'Open'}}<span class="label label-default">{{item.status}}</span>{{/case}}
        {{#case 'Approved'}}<span class="label label-success">{{item.status}}</span>{{/case}}
        {{#case 'Rejected'}}<span class="label label-danger">{{item.status}}</span>{{/case}}
        {{#case 'Retracted'}}<span class="label label-default">{{item.status}}</span>{{/case}}
        {{#case 'Processing'}}<span class="label label-primary">{{item.status}}</span>{{/case}}
        {{#case 'Awaiting Approval'}}<span class="label label-primary">{{item.status}}</span>{{/case}}
        {{#case 'Settled'}}<span class="label label-success"><i class="fa fa-check-circle"></i>&nbsp;{{item.status}}</span>{{/case}}
        {{#case 'Settlement Confirmed'}}<span class="label label-success"><i class="fa fa-check-circle"></i><i class="fa fa-check-circle"></i>&nbsp;{{item.status}}</span>{{/case}}
        {{#case 'Closed'}}<span class="label label-success"><i class="fa fa-check-circle"></i><i class="fa fa-check-circle"></i>&nbsp;{{item.status}}</span>{{/case}}
      {{/switch}}
      </div>
      <div class="col-sm-2 text-right">&#8377;&nbsp;{{item.total}}</div>
      <div class="col-sm-3">{{#if item.policy}}{{item.policy}}{{else}}--{{/if}}</div>
      <div class="col-sm-4">{{#if item.memo}}{{item.memo}}{{else}}--{{/if}}</div>
    </div>
  {{/if_not_eq}}
{{else}}
  <div class="col-md-4">
    <div class="col-sm-1 no-padding">
      <input class="select-item report" type="checkbox" data-item-id="{{item.id}}" />
    </div>
    <div class="col-sm-4">{{item.date}}</div>
    <div class="col-sm-7">{{item.name}}</div>
  </div>

  <div class="col-md-8">
    <div class="col-sm-3 text-center">
    {{#switch item.status}}
      {{#case 'Open'}}<span class="label label-default">{{item.status}}</span>{{/case}}
        {{#case 'Approved'}}<span class="label label-success">{{item.status}}</span>{{/case}}
        {{#case 'Rejected'}}<span class="label label-danger">{{item.status}}</span>{{/case}}
        {{#case 'Retracted'}}<span class="label label-default">{{item.status}}</span>{{/case}}
        {{#case 'Processing'}}<span class="label label-primary">{{item.status}}</span>{{/case}}
        {{#case 'Awaiting Approval'}}<span class="label label-primary">{{item.status}}</span>{{/case}}
        {{#case 'Settled'}}<span class="label label-success"><i class="fa fa-check-circle"></i>&nbsp;{{item.status}}</span>{{/case}}
        {{#case 'Settlement Confirmed'}}<span class="label label-success"><i class="fa fa-check-circle"></i><i class="fa fa-check-circle"></i>&nbsp;{{item.status}}</span>{{/case}}
        {{#case 'Closed'}}<span class="label label-success"><i class="fa fa-check-circle"></i><i class="fa fa-check-circle"></i>&nbsp;{{item.status}}</span>{{/case}}
    {{/switch}}
    </div>
    <div class="col-sm-2 text-right">&#8377;&nbsp;{{item.total}}</div>
    <div class="col-sm-3">{{#if item.policy}}{{item.policy}}{{else}}--{{/if}}</div>
    <div class="col-sm-4">{{#if item.memo}}{{item.memo}}{{else}}--{{/if}}</div>
  </div>
{{/if}}
