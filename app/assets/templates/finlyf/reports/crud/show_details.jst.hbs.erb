<div class="row" style="height: 100%;">
  <div class="col-sm-8 show-details-panel">
    <div class="row item-title">
      <div class="col-sm-6">
        <h4 class="item-name">
          <label class="item-attr-preview">{{item.name}}</label>
          <input type="text" class="item-name-edit item-attr-edit" value="{{item.name}}">
        </h4>
      </div>
      <div class="col-sm-6 text-right">

        {{#if item.actions.take_control}}
          <button class="btn btn-warning navbar-btn btn-sm btn-report-action" data-url="{{item.actions.take_control}}">Take Control&nbsp;&nbsp;<i class="fa fa-edit"></i></button>
        {{/if}}

        {{#if item.actions.submit}}
          {{#if item.actions.editable}}
            <button class="btn navbar-btn btn-sm btn-edit-item">Edit&nbsp;&nbsp;<i class="fa fa-edit"></i></button>
          {{/if}}
          <button class="btn btn-sm btn-report-action navbar-btn" data-url="{{item.actions.submit}}">Submit&nbsp;&nbsp;<i class="fa fa-check-square"></i></button>
        {{/if}}

        {{#if item.actions.retract}}
          <button class="btn btn-sm btn-report-action navbar-btn" data-url="{{item.actions.retract}}">Retract&nbsp;&nbsp;<i class="fa fa-check-square"></i></button>
        {{/if}}

        {{#if item.actions.approve}}
          <button class="btn btn-sm navbar-btn btn-report-action" data-url="{{item.actions.approve}}">Approve</button>
        {{/if}}

        {{#if item.actions.unapprove}}
          <button class="btn btn-sm navbar-btn btn-report-action" data-url="{{item.actions.unapprove}}">Unapprove</button>
        {{/if}}

        {{#if item.actions.reject}}
          <button class="btn btn-sm navbar-btn btn-report-action" data-url="{{item.actions.reject}}">Reject</button>
        {{/if}}
        
      </div>
    </div>

    <div class="row item-body">
      <div class="col-sm-7">
        <div class="row no-margin">
          <div class="col-sm-6"><label class="control-label">Policy</label></div>
          <div class="col-sm-6 item-policy">
            <label class="control-label item-attr-preview">
              {{#if item.policy}}
                {{item.policy}}
              {{else}}
                None
              {{/if}}
            </label>
            <select class="item-attr-edit item-policy item-policy-edit form-control" name="item-policy" data-default-value="{{item.policy_id}}">
              <option value="">None</option>
              {{#each item.policies}}
                <option value="{{this.id}}">{{this.name}}</option>
              {{/each}}
            </select>
          </div>
        </div>
        <div class="row no-margin">
          <div class="col-sm-6"><label class="control-label">Status</label></div>
          <div class="col-sm-6"><span class="label label-success">{{item.status}}</span></div>
        </div>
        <div class="row no-margin">
          <div class="col-sm-6"><label class="control-label">To</label></div>
          <div class="col-sm-6">{{item.manager_name}}</div>
        </div>

        <div class="row no-margin">
          <div class="col-sm-6"><label class="control-label">From</label></div>
          <div class="col-sm-6">{{item.user_name}}</div>   
        </div>

        <div class="row no-margin">
          <div class="col-sm-6"><label class="control-label">Date</label></div>
          <div class="col-sm-6">{{item.date}}</div>   
        </div>

        <div class="row no-margin">
          <div class="col-sm-6"><label class="control-label">Expenditure</label></div>
          <div class="col-sm-6">{{item.total}}</div>
        </div>
        
      </div>
      <div class="col-sm-5">
        <div class="row">

          <div class="dropdown">
            <button class="navbar-btn btn btn-sm btn-default dropdown-toggle" type="button" data-toggle="dropdown">Export <span class="caret"></span></button>
            <ul class="dropdown-menu dropdown-menu-right">
              <li><a href="{{item.export_pdf}}" target="_blank">PDF</a></li>
              <li><a href="{{item.export_xls}}" target="_blank">XLS</a></li>
              <li><a href="{{item.export_csv}}" target="_blank">CSV</a></li>
            </ul>
          </div>

          {{#if item.actions.editable}}
            <button class="btn btn-navbar btn-sm btn-danger btn-delete-item"><i class="fa fa-trash"></i>&nbsp;&nbsp;Delete</button>
          {{/if}}


        </div><!-- .row-->
      </div>
    </div>
    <hr />
    <div class="row no-margin violations">
      <h4>Report Violations</h4>
      <div class="col-sm-12">
        {{#each item.violations}}
          {{#if this.expense_warning.note}}
            {{#each this.expense_warning.note}}
              <div class="col-sm-10 text-center col-sm-offset-1 alert alert-warning" role="alert">{{this}}</div>
            {{/each}}
          {{/if}}
          {{#if this.expense_blocking.note}}
            {{#each this.expense_blocking.note}}
              <div class="col-sm-10 text-center col-sm-offset-1 alert alert-danger" role="alert">{{this}}</div>
            {{/each}}
          {{/if}}
          {{#if this.budget_warning.note}}
            {{#each this.budget_warning.note}}
              <div class="col-sm-10 text-center col-sm-offset-1 alert alert-warning" role="alert">{{this}}</div>
            {{/each}}
          {{/if}}
          {{#if this.budget_blocking.note}}
            {{#each this.budget_blocking.note}}
              <div class="col-sm-10 text-center col-sm-offset-1 alert alert-danger" role="alert">{{this}}</div>
            {{/each}}
          {{/if}}
          <!-- {{#each this}}
            {{#if this}}
              {{this.note}}
            {{/if}}
          {{/each}} -->
        {{/each}}
      </div>
    </div><!-- .violations -->

    <div class="row no-margin">
      <div class="col-sm-6 no-padding">
        <h4>Expenses</h4>
      </div>
      <div class="col-sm-6 no-padding text-right">
        {{#if item.actions.editable}}
          <button class="add-new-expense btn btn-navbar" data-item-id="{{item.id}}">Add New Expense</button>
          <button class="add-existing-expense btn btn-navbar" data-item-id="{{item.id}}">Add Existing Expense</button>
        {{/if}}
      </div>
    </div>
    <div class="row no-margin">
      {{#each item.expense_sections}}
      <div class="col-sm-12 expense-category">
        <div class="row" style="padding: 0 10px; background: #B4AFD0;">
          <div class="col-sm-6 no-padding"><h5>{{this.section_name}}</h5></div>
          <div class="col-sm-6 no-padding"><h5 class="text-right">{{this.section_total}}</h5></div>
        </div>
        <div class="row" style="padding: 5px 10px; background: #DDDAEA;">
          <div class="col-sm-1 no-padding">Sl. No.</div>
          <div class="col-sm-2 no-padding">Date</div>
          <div class="col-sm-2 no-padding">Merchant</div>
          <div class="col-sm-2 no-padding">Note</div>
          <div class="col-sm-1 no-padding text-right">Total</div>
          <div class="col-sm-2 no-padding text-right">Violations</div>
          <div class="col-sm-2 no-padding text-right">Actions</div>
        </div>

        {{#each this.expenses}}
        <div class="row" style="padding: 3px 10px;">
          <div class="col-sm-1 no-padding">{{increment @index 1}}</div>
          <div class="col-sm-2 no-padding">{{this.date}}</div>
          <div class="col-sm-2 no-padding">{{this.merchant_name}}</div>
          <div class="col-sm-2 no-padding">{{this.note}}</div>
          <div class="col-sm-1 no-padding text-right">$<span>{{amount_value}}</span></div>

          <div class="col-sm-2 no-padding text-right">
            {{#ifCond this.violations.expense_warning.note "||" this.violations.budget_warning.note}}
              <i class="fa fa-warning" style="color: yellow;"></i>
            {{else}}
              <i class="fa fa-check" style="color: green;"></i>
            {{/ifCond}}

            {{#ifCond this.violations.expense_blocking.note "||" this.violations.budget_blocking.note}}
              <i class="fa fa-ban" style="color: red;"></i>
            {{else}}
              <i class="fa fa-check" style="color: green;"></i>
            {{/ifCond}}
          </div>

          <div class="col-sm-2 no-padding text-right">
            <button data-item-id="{{this.id}}" class="btn btn-view-sub-item btn-xs btn-warning">View</button>
          {{#if ../../item.actions.editable}}
            <button data-item-id="{{this.id}}" class="btn-delete-sub-item btn btn-xs btn-danger">Delete</button>
          {{/if}}
          {{#if ../../item.actions.reject}}
            <button data-item-id="{{this.id}}" class="btn-reject-sub-item btn btn-xs btn-danger">Reject</button>
          {{/if}}
          </div>

          
        </div>
        {{/each}}
      </div>
      <hr />
      {{/each}}
    </div>

    {{#if item.receipts}}
    <div class="row no-margin"><h4>Receipt Thumbnails</h4></div>
    <div class="row no-margin receipts">
    {{#each item.receipts}}
      <div class="receipt col-sm-4 no-padding">
        <div class="receipt-container">
          <div class="receipt-image">
            <img class="img-responsive" src="{{this.url}}" style=""/>
          </div>
          <div class="row no-margin receipt-details">
            <div class="col-sm-12">
              <h6>{{this.merchant_name}}</h6>
            </div>
            <div class="col-sm-12">
              {{this.date}}
            </div>
            <div class="col-sm-12">
              {{this.value}}
            </div>
          </div>
        </div>  
      </div>
    {{/each}}
    </div>
    {{/if}}

  </div><!-- col-sm-8 -->

  <div class="col-sm-4 timeline show-details-panel">
    <div class="row no-margin"><h4>Timeline</h4></div>
    <div class="row no-margin">
      <div class="col-sm-2 no-padding">
        <span class="roundCircle">{{item.user_initial}}</span>
      </div>
      <div class="col-sm-10 no-padding text-right form-new-comment">
        <textarea class="form-control comment-content"></textarea>
        <button class="btn btn-navbar btn-sm btn-warning btn-post-comment" data-item-id="{{item.id}}">Post <img src="<%= image_url 'loading.png' %>"></button>
      </div>
    </div>
    <div class="comments">
    {{#if item.comments}}
      {{#each item.comments}}
      <div class="row no-margin comment">
        <div class="col-sm-2 no-padding">
          <span class="roundCircle">{{this.comment_user_initial}}</span>
        </div>
        <div class="col-sm-10 no-padding">
          <div class="row no-margin comment-content">
            <div class="col-sm-12 no-padding">
              {{this.content}}
            </div>
          </div>
          <div class="row no-margin comment-meta">
            <div class="col-sm-12 no-padding">
              {{this.comment_user_name}} - {{this.created_at}}
            </div>
          </div>
        </div>
      </div>
      {{/each}}
    {{/if}}  
    </div>
  </div><!-- col-sm-4 -->
</div><!-- .row -->

<style type="text/css">

  .item-attr-edit{
    display: none;
  }

  .item-title{
    background: aliceblue;
  }

  .item-body{
    margin-top: 50px;
  }


  .roundCircle{
    border-radius: 50%;
    line-height: 40px;
    width: 40px;
    /*height: 50px;*/
    height: 40px;
    background: #23fa8b;
  }

  .timeline{
    background: #F7F9FB;
  }

  textarea.comment-content{
    border-radius: 1.5px;
    margin-bottom: 5px;
  }

  .comment{
    /*background: #efefef;*/
    padding: 10px 0;
    /*margin-bottom: 10px;*/
  }

  .comment-meta{
    color: #aaa;
    font-size: 12px;
  }

  .item-details .expense-category {
    border: 1px solid #cdcdcd;
    margin-bottom: 20px;
    border-radius: 5px;
  }

  .item-details .expense-category:last-child{
    margin-bottom: 350px;
  }
</style>