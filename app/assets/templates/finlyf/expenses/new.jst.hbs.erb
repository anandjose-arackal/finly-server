<form id="new-item" enctype="multipart/form-data">

  <input name="utf8" type="hidden" value="&#x2713;"/>
  <input type="hidden" name="authenticity_token" value="" />
  <div class="row no-margin">
    <div class="col-sm-8 no-padding" style="border-right: 1px solid #ddd;">
      <div class="row no-margin form-group">
        <div class="col-sm-5 text-right">
          <label class="control-label">Amount</label>
        </div>
        <div class="col-sm-7">
          <input type="text" name="expense[amount_attributes][value]" class="form-control" />
          <input type="hidden" name="expense[amount_attributes][currency_id]" class="form-control" value="1" />
        </div>
      </div>

      <div class="row no-margin form-group">
        <div class="col-sm-5 text-right">
          <label class="control-label">Merchant</label>
        </div>
        <div class="col-sm-7">
          <input type="text" name="expense[manual_expense_attributes][merchant]" class="form-control" />
        </div>
      </div>

      <div class="row no-margin form-group">
        <div class="col-sm-5 text-right">
          <label class="control-label">Date</label>
        </div>
        <div class="col-sm-7">
          <input type="text" name="expense[date]" class="form-control" />
        </div>
      </div>


      <div class="row no-margin form-group">
        <div class="col-sm-5 text-right">
          <label class="control-label">Category</label>
        </div>
        <div class="col-sm-7">
          <select name="expense[category_id]" class="newExpenseCategory form-control">
          </select>
        </div>
      </div>

      <div class="row no-margin form-group">
        <div class="col-sm-5 text-right">
          <label class="control-label">Note</label>
        </div>
        <div class="col-sm-7">
          <textarea class="form-control" placeholder="Note..." name="expense[note]"></textarea>
        </div>
      </div>

      <div class="row no-margin form-group">
        <div class="col-sm-7 col-sm-offset-5">
          
          <buttun class="btn-create-expense btn btn-primary">Create</buttun>
        </div>
        
      </div>      
    </div>

    {{#if data}}
      <input type="hidden"  name="expense[report_id]" value="{{data.report_id}}" />
    {{/if}}

      
    <div class="col-sm-4 no-padding">
      <label for="expense-receipt-upload">
        <img class="preview-image img-responsive" id="preview-image" src="#" alt="Click to upload image"/>
      </label>
      <input type="file" id="expense-receipt-upload" name="expense[receipts_attributes][image]" class="form-control input-upload-image" onchange="document.getElementById('preview-image').src = window.URL.createObjectURL(this.files[0])" />
    </div>
  </div>
</form>


<style type="text/css">
  .form-group{
    margin-bottom: 10px;
  }

  .preview-image{
    height: 200px;
    margin-left: 10%;
    cursor: pointer;
  }

  .input-upload-image{
    display: none !important;
    /*position: absolute;*/
    background: transparent none repeat scroll 0% 0%;
    border: medium none !important;
    /*margin-left: 10%;*/
    /*top: 24%;*/
    box-shadow: none;
  }
</style>
