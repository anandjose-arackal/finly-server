<div class="row sidebar-element">
  <div class="col-sm-3">
    From
  </div>
  <div class="col-sm-9">
    <input type="text" class="datepicker filter-date-from" style="width: 100%;"/>
    <span class="fa fa-calendar input-icon "></span> 

  </div>
</div>
<div class="row sidebar-element">
  <div class="col-sm-3">
    To
  </div>
  <div class="col-sm-9">
    <input type="text" class="datepicker filter-date-to" style="width: 100%;"/>
    <span class="fa fa-calendar input-icon "></span> 
  </div>
</div>

<div class="row sidebar-element">

  <div class="col-sm-12">
    <input type="text" class="filter-merchant" style="width: 100%;" placeholder="Merchant" />
    <span class="fa fa-search input-icon"></span> 
  </div>
</div>

<div class="row sidebar-element">
  <div class="col-sm-12">Amount</div>
  <div class="col-sm-6">
    <select style="width: 100%;" class="filter-amount-type">
      <option value="lteq">Less Than</option>
      <option value="eq">Equal To</option>
      <option value="gteq">Greater Than</option>
    </select>
  </div>
  <div class="col-sm-6"><input type="text" style="width: 100%;" class="filter-amount-value" placeholder="Amount" /></div>
</div>

<div class="row sidebar-element">
  <div class="col-sm-12">Category</div>
  <div class="col-sm-12">
    <select style="width: 100%;" class="filter-category-id">
      <option value="">Select</option>
      <option value="1">Category 1</option>
      <option value="2">Category 2</option>
      <option value="3">Category 3</option>
    </select>
  </div>
</div>

<div class="row sidebar-element">
  <div class="col-sm-4">Receipt</div>
  <div class="col-sm-8">
    <select style="width: 100%;" class="filter-receipt">
      <option value="">Select</option>
      <option value="present">Has Receipt</option>
      <option>No Receipt</option>
    </select>
  </div>
</div>

<div class="row sidebar-element">
  <div class="col-sm-12 text-center">
    <button class="navbar-btn btn btn-sm btn-filter">Apply Filter</button>
  </div>
</div>