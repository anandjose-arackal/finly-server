<div class="row no-margin text-right" style="height: 60px;">
  {{#if item.editable}}
    <button class="btn btn-edit-expense btn-sm btn-warning"><i class='fa fa-edit'></i>&nbsp;&nbsp;Edit</button>
  {{/if}}
  {{#if item.deletable}}
    <button class="btn btn-delete-expense btn-sm btn-danger"><i class="fa fa-trash"></i>&nbsp;&nbsp;Delete</button>
  {{/if}}
  {{#if item.allow_upload_receipt}}
    <button class="btn btn-upload-expense-receipt btn-sm btn-warning"><i class="fa fa-edit"></i>&nbsp;&nbsp;Edit Receipt</button>
  {{/if}}
</div>

<div class="row no-margin expense-violations">
  {{#ifCond item.violations.blocking_present '||' item.violations.warning_present}}
    {{#each item.violations.items.expense_warning}}
      {{#if this.message}}
        <div class="violation violation-warning col-sm-10 text-center col-sm-offset-1 alert alert-warning" role="alert">{{this.message}}</div>
      {{/if}}
    {{/each}}
    {{#each item.violations.items.budget_warning}}
      {{#if this.message}}
        <div class="violation violation-warning col-sm-10 text-center col-sm-offset-1 alert alert-warning" role="alert">{{this.message}}</div>
      {{/if}}
    {{/each}}
    {{#each item.violations.items.expense_blocking}}
      {{#if this.message}}
        <div class="violation violation-blocking col-sm-10 text-center col-sm-offset-1 alert alert-danger" role="alert">{{this.message}}</div>
      {{/if}}
    {{/each}}
    {{#each item.violations.items.budget_blocking}}
      {{#if this.message}}
        <div class="violation violation-blocking col-sm-10 text-center col-sm-offset-1 alert alert-danger" role="alert">{{this.message}}</div>
      {{/if}}
    {{/each}}
  {{/ifCond}}
</div>

<form id="form-update-item" enctype="multipart/form-data">
<input type="hidden" name="view" value="{{item.view}}" />
<div class="row no-margin" style="">
  <div class="col-sm-7 no-padding">
    <div class="row no-margin item-attribute">
      <div class="col-sm-4 no-padding"><label class="control-label">Amount:</label></div>

      {{#if_eq item.expense_type_id 2}}
        <div class="col-sm-8 item-amount-value" style="font-size: 25px;line-height: 14px; color: #93C178;">&#8377;&nbsp;{{item.amount_value}}</div>
      {{else}}
        <div class="col-sm-8 item-amount-value item-attr-preview" style="font-size: 25px;line-height: 14px; color: #93C178;">&#8377;&nbsp;{{item.amount_value}}</div>
        <div class="col-sm-8 item-amount-value item-attr-edit" style="font-size: 25px;line-height: 14px; color: #93C178;">
          <input class="form-control" type="number" value="{{item.amount_value}}" name="expense[amount_attributes][value]"/>

          <input type="hidden" name="expense[amount_attributes][currency_id]" class="form-control" value="1" />
        </div>
      {{/if_eq}}
    </div>
    <div class="row no-margin item-attribute">
      <div class="col-sm-4 no-padding"><label class="control-label">Merchant:</label></div>

      <div class="col-sm-8 item-merchant-name item-attr-preview" style="font-size: 16px;line-height: 14px;">{{item.merchant_name}}</div>
      {{#if_eq item.expense_type_id 2}}
        <div class="col-sm-8 item-merchant-name item-attr-edit" style="font-size: 16px;line-height: 14px;"><input type="text" class="form-control filter-merchant" name="expense[card_expense_attributes][editable_merchant]" value="{{item.merchant_name}}" /></div>
      {{else}}
        <div class="col-sm-8 item-merchant-name item-attr-edit" style="font-size: 16px;line-height: 14px;"><input type="text" class="form-control filter-merchant" name="expense[manual_expense_attributes][merchant]" value="{{item.merchant_name}}" /></div>
      {{/if_eq}}
    </div>

    <div class="row no-margin item-attribute">
      <div class="col-sm-4 no-padding"><label class="control-label">Date:</label></div>

      {{#if_eq item.expense_type_id 2}}
        <div class="col-sm-8 item-date">{{item.date}}</div>
      {{else}}
        <div class="col-sm-8 item-date item-attr-preview">{{item.date}}</div>
        <div class="col-sm-8 item-date item-attr-edit"><input type="text" class="form-control datepicker" name="expense[date]" value="{{item.formatted_date}}"/></div>
      {{/if_eq}}
      
    </div>


    {{#if item.view}}
      {{#if_not_eq item.view 'personal'}}
        <div class="row no-margin item-attribute">
          <div class="col-sm-4 no-padding"><label class="control-label">User:</label></div>
          <div class="col-sm-8">{{item.user_name}}</div>
        </div>
      {{/if_not_eq}}
    {{/if}}

    <div class="row no-margin item-attribute">
      <div class="col-sm-4 no-padding"><label class="control-label">Category:</label></div>
      <div class="col-sm-8 item-attr-preview">{{item.category_name}}</div>
      <div class="col-sm-8 item-attr-edit">
        <select name="expense[category_id]" class="form-control editExpenseCategory">

        </select>
      </div>
    </div>

    
    

    <div class="row no-margin item-attribute">
      <div class="col-sm-4 no-padding"><label class="control-label">Note:</label></div>
      <div class="col-sm-8 item-attr-preview">{{item.note}}</div>
      <div class="col-sm-8 item-attr-edit"><textarea class="form-control" name="expense[note]">{{item.note}}</textarea> </div>
    </div>


  </div>

  <div class="receipt-area col-sm-5 no-padding">
    <div class="item-receipt text-center item-attr-preview">
      {{#each item.receipts}}
        <img src="{{this.image.thumb}}" class="receipt-image img-responsive" style="max-width: 200px; max-height: 200px; display: inline;" />
      {{else}}
        <div class="receipt-placeholder text-center" style="">
          <img src="<%= image_url('no-receipt-placeholder.png') %>" style="max-width: 200px; max-height: 200px;">
        </div>
      {{/each}}
    </div>

    <div class="item-receipt item-attr-edit text-center">
      <input type="hidden" name="receipt_id" class="attach-receipt-field" />
      
      {{#if item.receipts}}
        <i class="detach-uploaded-receipt fa fa-times-circle" style="font-size: 16px;color: rgba(231 , 76, 60,1.0);position: absolute;top: -14px;right: 20px;font-size: 18px;"></i>
        <label for="edit-expense-receipt-upload">

        <img class="preview-image img-responsive" id="edit-preview-image" src="{{item.receipts.0.image.thumb}}" alt="Click to upload image" style="max-height: 200px; max-width: 200px; cursor: pointer;"/>
        </label>
        <div class="text-center">
          <button class="btn btn-warning btn-sm btn-attach-existing-receipts hidden" data-attach-receipt-into="expenseShow">Add Existing Receipts</button>
        </div>
      {{else}}
        <i class="detach-uploaded-receipt fa fa-times-circle hidden" style="font-size: 16px;color: rgba(231 , 76, 60,1.0);position: absolute;top: -14px;right: 20px;font-size: 18px;"></i>
        <label for="edit-expense-receipt-upload">
        <img class="preview-image img-responsive" id="edit-preview-image" src="<%= image_url('receipt-placeholder.png') %>" style="max-height: 200px; max-width: 200px; cursor: pointer;"/>
        </label>
        <div class="text-center">
          <button class="btn btn-warning btn-sm btn-attach-existing-receipts" data-attach-receipt-into="expenseShow">Add Existing Receipts</button>
        </div>
      {{/if}}

      <input type="file" id="edit-expense-receipt-upload" accept=".png, .jpg, .jpeg, .pdf" name="expense[receipts_attributes][image]" class="form-control input-upload-image" />
    </div>
    
  </div>
</div>

{{#if_eq item.expense_type_id 2}}
  <input type="hidden" name="type" value="2" />
{{else}}
  <input type="hidden" name="type" value="1" />
{{/if_eq}}
</form>
<style type="text/css">
  
.input-upload-image{
  display: none !important;
  background: transparent none repeat scroll 0% 0%;
  border: medium none !important;
  box-shadow: none;
}
.expense-violations{
  margin-bottom: 10px;
}
</style>