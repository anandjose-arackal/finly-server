<div class="row sidebar-element">
  <div class="col-sm-3 sidebar-label">
    From
  </div>
  <div class="col-sm-9">
    <input type="text" class="form-control datepicker filter-date-from" style="width: 100%;" value="{{item.filter_date_from}}" />
    <span class="fa fa-calendar input-icon "></span> 

  </div>
</div>
<div class="row sidebar-element">
  <div class="col-sm-3 sidebar-label">
    To
  </div>
  <div class="col-sm-9">
    <input type="text" class="form-control datepicker filter-date-to" style="width: 100%;" value="{{item.filter_date_to}}" />
    <span class="fa fa-calendar input-icon "></span> 
  </div>
</div>

{{#unless item.indexOnly}}
  <div class="row sidebar-element">
    <div class="col-sm-12 text-center">
      <button class="btn btn-sm btn-default btn-filter-receipts" data-navigate="true">Apply Filter</button>
    </div>
  </div>
{{else}}
  <div class="row sidebar-element">
    <div class="col-sm-12 text-center">
      <button class="btn-default btn btn-sm btn-filter-receipts" data-navigate="false">Apply Filter</button>
    </div>
  </div>
{{/unless}}

<style type="text/css">
  ul.nav-stacked > li > a{
    color: #787878;
    /*text-transform: uppercase;*/
    padding: 5px 15px;
    background: transparent;
    border-radius: 0;
  }

  ul.nav-stacked > li > a.active{
    background: #3F51B5;
    color: white;
    text-decoration: none;
  }
</style>