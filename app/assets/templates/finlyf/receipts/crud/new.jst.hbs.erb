<form id="new-item" enctype="multipart/form-data">

  <input name="utf8" type="hidden" value="&#x2713;"/>
  <input type="hidden" name="authenticity_token" value="" />
  <div class="row no-margin">
    <div class="col-sm-12 no-padding text-center">
      
      <label for="receipt-image-upload">
        <img class="preview-image img-responsive" id="preview-image" src="<%= image_url('receipt-placeholder.png') %>" alt="Click to upload image"/>
      </label>
      <input type="file" id="receipt-image-upload" accept=".png, .jpg, .jpeg" name="receipt[image]" class="form-control input-upload-image" onchange="document.getElementById('preview-image').src = window.URL.createObjectURL(this.files[0])" />
        
      <textarea class="form-control" name="receipt[note]" placeholder="Add a Note. (Optional)" style="width: 50%;"></textarea>

          
          {{!-- <buttun class="btn-create btn btn-primary">Create</buttun> --}}
      {{!-- <input type="submit" name="Submit" value="Add Receipt" class="btn btn-primary"> --}}
      <button class="btn btn-primary btn-sm" type="submit" name="submit">Add Receipt</button>
        
    </div>
  </div>
</form>

<style type="text/css">
  /*.modal-dialog{
    width: 30% !important;
  }
*/  .form-group{
    margin-bottom: 10px;
  }

  .preview-image{
    max-height: 200px;
    max-width: 200px;
    /*height: 200px;
    margin-left: 10%;*/
    cursor: pointer;
    /*padding: 20px;
    border: 1px dotted rgb(187, 187, 187);*/
  }

  textarea.form-control{
    margin: 20px auto;
  }

  .input-upload-image{
    display: none !important;
    background: transparent none repeat scroll 0% 0%;
    border: medium none !important;
    box-shadow: none;
  }
</style>