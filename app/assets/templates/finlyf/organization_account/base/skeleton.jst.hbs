<div class="container-fluid container-main" style="margin-top: -18px; position: relative; height: calc(100vh - 53px); padding-left: 0; padding-right: 0; width: 100%;">
  <div class="col-sm-2 sidebar">
  </div>

  <div class="col-sm-10 col-sm-offset-2 main">
    <div class="row hidden no-margin" id="policies" data-url="organization_account/blah">
      <h1>Profile</h1>
    </div>
    <div class="row hidden no-margin" id="categories" data-url="organization_account/categories">
      <h1>Balance</h1>
    </div>
    <div class="row hidden no-margin" id="export_preferences" data-url="organization_account/export_preferences">
