              <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false"><span class="current-view-type">Personal View</span>&nbsp;&nbsp;<span class="caret"></span></a>
              <ul class="dropdown-menu menu-nav-views-dropdown">
                
