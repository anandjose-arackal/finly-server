<style type="text/css">

.navbar-inverse{
  color: white;
  margin-bottom: 0;
  border-bottom: none;
  background: #46568b;
  background: #423689;
  background: #594DA8;
}
.navbar-inverse .navbar-nav > li > a {
    color: white;
    border-bottom: 3px solid transparent;
}

.navbar-inverse .navbar-nav > .open > a, .navbar-inverse .navbar-nav > .open > a:hover, .navbar-inverse .navbar-nav > .open > a:focus {
    background-color: transparent;
}

.nav .open > a, .nav .open > a:hover, .nav .open > a:focus{
  border-color: #F4F560;
}

.navbar-inverse .navbar-nav > .active > a, .navbar-inverse .navbar-nav > .active > a:hover, .navbar-inverse .navbar-nav > .active > a:focus {
  /*color: #fff;*/
  /*font-weight: bold;*/
  border-bottom: 3px solid #CD925A;
  border-bottom: 3px solid #F4F560;
  background-color: transparent;
}
.container-fluid{
  padding: 0;
}

.no-margin{
  margin: 0;
}

.no-padding{
  padding: 0;
}

.main-header{
  padding: 16px 15px;
  text-transform: uppercase;
  color: #535353;
  font-size: 12px;
}
.item{
  padding: 15px;
  border: 0.5px solid #eee;
  /*border-bottom: none;*/
  background: white;
  color: #666;
  cursor: pointer;
  /*margin-bottom: 5px;*/
}

.item.selected{
  background: #FFF1DA;
}

.item.col-sm-3, .receipt{
  padding: 20px;
  border: none;
  background: transparent;
  color: #555;
  /*padding: 10px;*/
  /*background: red;*/
}

.item.col-sm-3 .receipt-container, .receipt .receipt-container {
  padding: 10px;
  background: white;
  box-shadow: 0 0 5px 1px rgba(0, 0, 0, 0.2);
}

.item.col-sm-3 .receipt-container .receipt-details, .receipt .receipt-container .receipt-details{
  /*padding: 10px;*/
  margin-top: 10px;
  border-top: 1px solid #ccc;
}
.item.col-sm-3 .receipt-container .receipt-details h4{
  font-size: 15px;
  padding-top: 0;
}
.receipt{
  height: 320px;
}

.receipt-container{
  height: 100%;
}

.item.col-sm-3 .receipt-container .receipt-image, .receipt .receipt-container .receipt-image{
  overflow:hidden;
  height: 250px;
  padding-bottom: 10px;
}

.item.col-sm-3 .receipt-container .receipt-image img, .receipt .receipt-container .receipt-image img{
  /*border: 3px solid #efefef;*/
  padding: 10px;
}

.sidebar{
  height: calc(100% - 100px);
  position:fixed;
  background: #fff;
  background: #F5F6F9;
  /*position: relative;*/
  height: calc(100%);
  overflow-y: scroll;
  z-index: 4;
}

.secondary-navbar{
  margin-top: 53px;
  border-color: transparent;
  z-index: 5;
}
.secondary-navbar li{
  margin-left: 10px;
}

.main{
  z-index: 4;
  position:fixed;
  overflow-y: scroll;
  background: rgb(252, 252, 252) none repeat scroll 0% 0%;
  background: #fff;
  max-height: calc(100%); 
  padding: 10px;
  box-shadow: 0 0 30px 0 rgba(0,0,0,.1);
  height: calc(100%);
}
.main.preview .col-md-8{
  /*display: none;*/
}

.sidebar-element{
  padding: 10px 0;
}
.close-item-details{
  position: absolute;
  z-index: 100;
  padding: 5px 15px;
  left: 0px;
  /*border: 0.5px solid #efefef;*/
  font-weight: 100;
  font-size: 20px;
}
#item-details{
  height: calc(100% - 103px);
  left: 100%;
  z-index: 100;
  background: #fff;
  box-shadow: 0 0 30px 0 rgba(0,0,0,.1);
  transition: all 0.5s;
  position: fixed;
  margin-top: -10px;
  display: block;

  /*width: 55.555%;*/
  width: 45.555%;
}

.show-details-panel{
  height: 100%;
  overflow-y: scroll;
}

.main.preview #item-details{
  /*left: 54.444%;*/
}

.details-header{
  padding: 16px 15px;
  height: 70px;
}

.navbar-btn{
  margin-top: 10px;
  margin-bottom: 10px;
  text-transform: uppercase;
  font-size: 11px;
  background: transparent none repeat scroll 0% 0%;
  border: 0.5px solid rgb(89, 77, 168);
  border-radius: 2px;
}

.btn-finly-danger:hover{
  background: rgb(234, 97, 83);
  color: white;
}

.btn-finly-default:hover{
  background: #594DA8;
  color: white;
}


/*Forms, Fiels, Labels*/
.input-icon {
  float: right;
  margin-right: 7px;
  margin-top: -24px;
  position: relative;
  z-index: 1;
  color: #676767;
  pointer-events: none;
}

.finly-backdrop{
  background: rgba(0,0,0, 0.5);
  position: fixed;
  height: calc(100% - 53px);
  width: 100%;
  top: 53px;
  z-index: 3;
}

.alert {
  padding: 5px;
  margin-bottom: 5px;
}

hr{
  margin-top: 10px;
  margin-bottom: 15px;
  border: 0;
  border-top: 1px solid #ddd;
}
</style>



