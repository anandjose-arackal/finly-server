branch_name = `git branch --no-color 2> /dev/null`[/^\* (.+)/, 1]

message_file = ARGV[0]
message = File.read(message_file)

unless branch_name.scan(/^(master|develop)/).any? or branch_name.scan(/^(feature|hotfix|release)\//).any?
	puts "Invalid branch name format. #{branch_name}"
	exit 1
end

unless message.scan(/^(fix|feat|docs|testcases|test|docs|merge)(\((.+)\))*:\s/).any? or message.scan(/^(Merge)/).any?
	puts "Invalid commit message format. #{message}"
	exit 1
end

