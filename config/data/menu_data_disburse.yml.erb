company:
  name: <%= current_company.name %>
  logo:
  <% if current_company.configuration.logo.present? %>
    url: <%= current_company.configuration.logo.url(:thumb)%>
  <% end %>
user:
  name: <%= current_user.name %>
  id: <%= current_user.id %>
  roles:
  <% if current_user.admin? %>
  - admin
  <% end %>
  <% if current_user.finance_manager? %>
  - finance_manager
  <% end %>
views:
  admin:
    menus:
      navbar:
      - name: Expenses
        url: expenses
        id: expenses
      - name: Users
        url: users
        id: users
      - name: Orders
        id: orders
        url: orders
      - name: Analytics
        url: analytics
        id: analytics
  finance:
    menus:
      navbar:
      - name: Expenses
        url: expenses
        id: expenses
      - name: Users
        url: users
        id: users
      - name: Analytics
        url: analytics
        id: analytics
