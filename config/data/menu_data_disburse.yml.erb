company:
  name: <%= current_company.name %>
  id: <%= current_company.id %>
  logo:
  <% if current_company.configuration.logo.present? %>
    url: <%= current_company.configuration.logo.url(:thumb)%>
  <% end %>
  features:
    <% if current_company.feature_subscription.expense_card_enabled %>
    expense_card: true
    <% end %>
    <% if current_company.feature_subscription.meal_card_enabled %>
    meal_card: true
    <% end %>
    <% if current_company.feature_subscription.medical_card_enabled %>
    medical_card: true
    <% end %>
    <% if current_company.feature_subscription.reimbursement_card_enabled %>
    reimbursement_card: true
    <% end %>
    <% if current_company.feature_subscription.expense_management_enabled %>
    expense_management: true
    <% end %>


user:
  name: <%= current_user.name %>
  id: <%= current_user.id %>
  email: <%= current_user.email %>
  mobile_number: <%= current_user.mobile_number %>
  roles:
  <% if current_user.admin? %>
  - admin
  <% end %>
  <% if current_user.finance_manager? %>
  - finance_manager
  <% end %>
views:
  <% if current_user.admin? %>
    admin:
      menus:
        navbar:
        - name: Expenses
          url: expenses
          id: expenses
        - name: ATM Withdrawals
          url: atm_withdrawals
          id: atm_withdrawals
        - name: Users
          url: users
          id: users
        - name: Orders
          id: orders
          url: orders
        - name: Analytics
          url: analytics
          id: analytics
        - name: Personal
          url: personal
          id: personal
          sub_menus:
            - name: Expenses
              id: personal_expenses
              url: personal/expenses
            - name: ATM Withdrawals
              id: personal_atm_withdrawals
              url: personal/atm_withdrawals
  <% elsif current_user.finance_manager? %>
    finance:
      menus:
        navbar:
        - name: Expenses
          url: expenses
          id: expenses
        - name: ATM Withdrawals
          url: atm_withdrawals
          id: atm_withdrawals
        - name: Users
          url: users
          id: users
        - name: Analytics
          url: analytics
          id: analytics
        - name: Personal
          url: personal
          id: personal
          sub_menus:
            - name: Personal Expenses
              id: personal_expenses
              url: personal/expenses
            - name: Personal ATM Withdrawals
              id: personal_atm_withdrawals
              url: personal/atm_withdrawals
  <% else %>
    personal:
      menus:
        navbar:
        - name: Personal
          url: expenses
          id: expenses
          sub_menus:
            - name: Personal Expenses
              id: personal_expenses
              url: personal/expenses
            - name: Personal ATM Withdrawals
              id: personal_atm_withdrawals
              url: personal/atm_withdrawals
            - name: Finly Money & Cards
              id: finly_money
              url: personal/accounts
  <% end %>


