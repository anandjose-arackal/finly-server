company:
  name: <%= current_company.name %>
  id: <%= current_company.id %>
  logo:
  <% if current_company.configuration.logo.present? %>
    url: <%= current_company.configuration.logo.url(:thumb)%>
  <% end %>
  features:
    <% if current_company.feature_subscription.expense_card_enabled && current_user.user_panel_subscription.disburse %>
    expense_card: true
    <% end %>
    <% if current_company.feature_subscription.meal_card_enabled && current_user.user_panel_subscription.disburse %>
    meal_card: true
    <% end %>
    <% if current_company.feature_subscription.medical_card_enabled && current_user.user_panel_subscription.disburse %>
    medical_card: true
    <% end %>
    <% if current_company.feature_subscription.reimbursement_card_enabled && current_user.user_panel_subscription.disburse %>
    reimbursement_card: true
    <% end %>
    <% if current_company.feature_subscription.expense_management_enabled && current_user.user_panel_subscription.expense_management %>
    expense_management: true
    <% end %>
    <% if current_company.feature_subscription.yes_bank_account && current_user.user_panel_subscription.yes_bank_account_transfer %>
    vendor_payments: true
    <% end %>
    <% if current_company.feature_subscription.invoicing_system && current_user.user_panel_subscription.invoicing_system %>
    invoicing_system: true
    <% end %>
    

user:
  name: <%= current_user.name %>
  initials: <%= current_user.initials %>
  id: <%= current_user.id %>
  email: <%= current_user.email %>
  mobile_number: <%= current_user.mobile_number %>
  roles:
  <% if current_user.admin? %>
  - admin
  <% end %>
  <% if current_user.finance_manager? %>
  - finance_manager
  <% end %>
  switchable_roles:
  <% if current_user.admin? %>
  - name: Admin
    id: admin
  <% elsif current_user.finance_manager? %>
  - name: Finance Manager
    id: finance_manager
  <% else %>
  <% if current_user.auditor? %>
  - name: Auditor
    id: auditor
  <% end %>
  - name: Personal
    id: personal
  <% end %>


views:
  <% if current_user.admin? %>
    admin:
      menus:
        navbar:
        - name: Expenses
          url: expenses
          id: expenses
        - name: ATM Withdrawals
          url: atm_withdrawals
          id: atm_withdrawals
        - name: Users
          url: users
          id: users
        - name: Orders
          id: orders
          url: orders
        - name: Analytics
          url: analytics
          id: analytics
        - name: Statements
          url: company_statements
          id: statements
        cog:
        <% unless current_company.kyc_completed? %>
        - name: Verify KYC
          url: '#documents'
        <% end %>
        - name: Organization Account
          url: '#organization_account'
        - name: Load Company Balance
          url: '/transfers/register'
          target: '_blank'
        - name: 'Company Statements'
          url: '#company_statements'
        <% if current_company.feature_subscription.yes_bank_account and current_user.user_panel_subscription.yes_bank_account_transfer %>
#        - name: Vendor Payments
#          url: '/payments'
#          target: '_blank'
        <% end %>

  <% elsif current_user.finance_manager? %>
    finance:
      menus:
        navbar:
        - name: Expenses
          url: expenses
          id: expenses
        - name: ATM Withdrawals
          url: atm_withdrawals
          id: atm_withdrawals
        - name: Orders
          id: orders
          url: orders
        - name: Users
          url: users
          id: users
        - name: Analytics
          url: analytics
          id: analytics
        - name: Statements
          url: company_statements
          id: statements
        # - name: Personal
        #   url: personal
        #   id: personal
        #   sub_menus:
        #     - name: Personal Expenses
        #       id: personal_expenses
        #       url: personal/expenses
        #     - name: Personal ATM Withdrawals
        #       id: personal_atm_withdrawals
        #       url: personal/atm_withdrawals
  <% end %>
    personal:
      menus:
        navbar:
        - name: Personal
          url: personal
          id: personal
          sub_menus:
            - name: Personal Expenses
