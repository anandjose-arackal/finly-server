company:
  name: <%= current_company.name %>
  id: <%= current_company.id %>
  logo:
  <% if current_company.configuration.logo.present? %>
    url: <%= current_company.configuration.logo.url(:thumb)%>
  <% end %>
  features:
    <% if current_company.feature_subscription.expense_card_enabled %>
    expense_card: true
    <% end %>
    <% if current_company.feature_subscription.meal_card_enabled %>
    meal_card: true
    <% end %>
    <% if current_company.feature_subscription.medical_card_enabled %>
    medical_card: true
    <% end %>
    <% if current_company.feature_subscription.reimbursement_card_enabled %>
    reimbursement_card: true
    <% end %>
    <% if current_company.feature_subscription.expense_management_enabled %>
    expense_management: true
    <% end %>


user:
  name: <%= current_user.name %>
  id: <%= current_user.id %>
  email: <%= current_user.email %>
  mobile_number: <%= current_user.mobile_number %>
  roles:
  <% if current_user.admin? %>
  - admin
  <% end %>
  <% if current_user.finance_manager? %>
  - finance_manager
  <% end %>
views:
  <%# if current_user.admin? %>
    admin:
      menus:
        navbar:
        - name: Payments
          url: payments
          id: payments
        - name: Payment Orders
          url: orders
          id: orders
        - name: Users
          url: users
          id: users
        - name: Analytics
          url: analytics
          id: analytics
        cog:
        - name: Organization Account
          url: '#organization_account'
        - name: Load Company Balance
          url: '#load-company-balance'
        - name: 'Company Statements'
          url: '#company_statements'
  <%# end %>