company:
  name: <%= current_company.name %>
  id: <%= current_company.id %>
  d_code_assigned: <%= current_company.d_code_enabled? ? 1 : 0 %>
  logo:
  <% if current_company.configuration.logo.present? %>
    url: <%= current_company.configuration.logo.url(:thumb)%>
  <% end %>
  features:
    <% if current_company.feature_subscription.expense_card_enabled && current_user.user_panel_subscription.disburse%>
    expense_card: true
    <% end %>
    <% if current_company.feature_subscription.meal_card_enabled && current_user.user_panel_subscription.disburse %>
    meal_card: true
    <% end %>
    <% if current_company.feature_subscription.medical_card_enabled && current_user.user_panel_subscription.disburse %>
    medical_card: true
    <% end %>
    <% if current_company.feature_subscription.reimbursement_card_enabled && current_user.user_panel_subscription.disburse %>
    reimbursement_card: true
    <% end %>
    <% if current_company.feature_subscription.expense_management_enabled && current_user.user_panel_subscription.expense_management %>
    expense_management: true
    <% end %>
    <% if current_company.feature_subscription.invoicing_system && current_user.user_panel_subscription.invoicing_system %>
    invoicing_system: true
    <% end %>

user:
  name: <%= current_user.name %>
  id: <%= current_user.id %>
  email: <%= current_user.email %>
  mobile_number: <%= current_user.mobile_number %>
  roles:
  <% if current_user.admin? %>
  - id: admin
    name: Admin
    default_url: 'expenses/params={"view":"admin"}'
  <% end %>
  <% if current_user.auditor? %>
  - id: auditor
    name: Auditor
    default_url: 'expenses/params={"view":"auditor"}'
  <% end %>
  <% if current_user.finance_manager? %>
  - id: finance_manager
    name: 'Finance Manager'
    default_url: 'reports/params={"view":"finance_manager"}'
  <% end %>
  <% if current_user.manager? %>
  - id: manager
    name: 'Manager'
    default_url: 'reports/params={"view":"manager"}'
  <% end %>
  <% if current_user.employee? %>
  - id: personal
    name: 'Personal'
    default_url: 'expenses/params={"view":"personal"}'
  <% end %>

views:
  <% if current_user.admin? %>
  admin:
    menus:
      navbar:
      - name: <span class="superscript">Company</span><br>Export
        url: 'export'
        id: 'export'
      - name: <span class="superscript">Company</span><br>Analytics
        url: analytics
        id: analytics
      - name: <span class="superscript">Company</span><br>Settlements
        url: settlements_dashboard
        id: settlements_dashboard
      - name: <span class="superscript">Company</span><br>Employees
        url: employees
        id: employees
      - name: <span class="superscript">Company</span><br>Money Requests
        url: requests
        id: requests
      - name: <span class="superscript">Company</span><br>Reports
        url: reports
        id: reports
      - name: <span class="superscript">Company</span><br>Expenses
        url: expenses
        id: expenses
      cog:
      - name: Organization Account
        url: '#organization_account/params={"view":"admin"}'
      - name: Company Statements
        url: '#company_statements/params={"view": "admin"}'
      <% if current_company.d_code_enabled? || current_company.bank_reimbursement_enabled? %>
      - name: Load Company Balance
        url: '/transfers/register'
      <% end %>
      <% unless current_company.kyc_completed? %>
      - name: Verify KYC
        url: '/#documents'
      <% end %>
#      - name: Policies
#        url: '/policies'
  <% end %>
  <% if current_user.finance_manager? %>
  finance_manager:
    menus:
      navbar:
      - name: <span class="superscript">Team</span><br>Export
        url: export
        id: export
      - name: <span class="superscript">Team</span><br>Members
        url: employees
        id: employees
      - name: <span class="superscript">Team</span><br>Settlements
        url: settlements_dashboard
        id: settlements_dashboard
      - name: <span class="superscript">Team</span><br>Money Requests
        url: requests
        id: requests
      - name: <span class="superscript">Team</span><br>Reports
        url: reports
        id: reports
      - name: <span class="superscript">Team</span><br>Expenses
        url: expenses
        id: expenses
      cog: []
  <% end %>
  <% if current_user.manager? %>
  manager:
    menus:
      navbar:
      - name: <span class="superscript">Team</span><br>Export
        url: export
        id: export
      - name: <span class="superscript">Team</span><br>Members
        url: employees
        id: employees
      - name: <span class="superscript">Team</span><br>Money Requests
        url: requests
        id: requests
      - name: <span class="superscript">Team</span><br>Reports
        url: reports
        id: reports
      - name: <span class="superscript">Team</span><br>Expenses
        url: expenses
        id: expenses
      cog: []
  <% end %>
  <% if current_user.employee? %>
  personal:
    menus:
      navbar:
      - name: Export
        url: export
        id: export
      - name: Analytics
        url: analytics
        id: analytics
      - name: Settlements
        url: settlements
        id: settlements
      - name: Money Requests
        url: requests
        id: requests
      - name: Reports
        url: reports
        id: reports
      - name: Receipts
        url: receipts
        id: receipts
      - name: Expenses
        url: expenses
        id: expenses
      cog: []
  <% end %>



