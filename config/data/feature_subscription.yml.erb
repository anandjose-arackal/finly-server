company:
  name: <%= current_company.name %>
  id: <%= current_company.id %>
  reporting_currency: 
    id: <%= current_company.reporting_currency.id %>
    country: <%= current_company.reporting_currency.country %>
    country_code: <%= current_company.reporting_currency.country_code %>
    symbol: <%= current_company.reporting_currency.symbol %>
      
  logo:
  <% if current_company.configuration.logo.present? %>
    url: <%= current_company.configuration.logo.url(:thumb)%>
  <% end %>

  features:
    expense_card: <%= current_company.feature_subscription.expense_card_enabled %>
    meal_card: <%= current_company.feature_subscription.meal_card_enabled %>
    medical_card: <%= current_company.feature_subscription.medical_card_enabled %>
    reimbursement_card: <%= current_company.feature_subscription.reimbursement_card_enabled %>
    expense_management: <%= current_company.feature_subscription.expense_management_enabled %>
    fuel_card: <%= current_company.feature_subscription.fuel_card_enabled %>
    hard_copy_receipt: <%= current_company.feature_subscription.hard_copy_receipt %>
user:
  default_subscribed_type: <%= current_user.user_panel_subscription.default_subscription %>
  expense_management: <%= current_user.user_panel_subscription.expense_management && current_user.company.expense_management_enabled? %>
  disburse: <%= current_user.user_panel_subscription.disburse && current_user.company.feature_subscription.cards_enabled %>
  vendor_payments: <%= current_user.user_panel_subscription.yes_bank_account_transfer && current_user.company.feature_subscription.yes_bank_account %>
  collect: <%= current_user.user_panel_subscription.invoicing_system && current_user.company.feature_subscription.invoicing_system %>
  insights: <%= current_user.company.feature_subscription.budgeting_system && (current_user.company_admin? || current_user.vendor_payments_admin? || current_user.is_budget_manager?) %>
  default:
  configurations:
    old_ui_enabled:
      vp: <%=  VpOldUiToggle.new(current_user).old_ui_enabled? %>
    export_manager:
      templates_enabled: <%=  ExportManagerToggle.new(current_user).templates_enabled? %>
    simple_masters:
      simple_masters_enabled: <%=  SimpleMastersToggle.new(current_user).simple_masters_enabled? %>
    theme:
      vp: <%= current_user.profile.vp_web_client_theme %>
      em: <%= current_user.profile.em_web_client_theme %>
    client_version:
      vp: <%= current_user.profile.vp_web_client_version %>
      em: <%= current_user.profile.em_web_client_version %>
    gstin_filing:
      gstin_filing_enabled: <%= GstinFilingToggle.new(current_user).enabled? %>
    performance_fix_flags:
      dependencies_ui_cache_enabled: <%= DependenciesUiCacheToggle.new(current_user).enabled? %>
      reviewal_chain_async: <%= ReviewalChainAsyncToggle.new(current_user).enabled? %>
      dynamic_comments_loading: <%= FormsDynamicCommentsLoadingToggle.new(current_user).enabled? %>
      dashboard_config_api_trim: <%= DashboardConfigApiTrim.new(current_user).enabled? %>
      pr_api_improvements: <%= PrApiImprovementsToggle.new(current_user).enabled? %>
      clone_deep_removed: <%= FormsRemoveClonedeepToggle.new(current_user).enabled? %>
      debounce_on_field: <%= FormsDebounceOnFieldToggle.new(current_user).enabled? %>
      dynamic_autocomplete_choices: <%= FormsDynamicAutocompleteChoicesEnabled.new(current_user).enabled? %>
    currency_flags:
      amount_prop_only_load_enabled: <%= AmountPropOnlyLoadToggle.new(current_user).enabled? %>
      currency_comma_separation_enabled: <%= CurrencyCommaSeparationToggle.new(current_user).enabled? %>
    common_imports:
      lurm_enabled: <%= LurmEnabledToggle.new(current_user).enabled? %>
      user_bulk_upload_enabled: <%= UserWorkFlowBulkUploadEnabledToggle.new(current_user).enabled? %>
    global_search:
      forms_config_enabled: <%= GlobalSearchFormsConfigToggle.new(current_user).enabled? %>
    form_features:
      forms_dropdown_autoselect_single_choice: <%= FormsDropdownAutoselectOnSingleChoice.new(current_user).enabled? %>
      forms_rich_text_editor_for_procurement_enabled: <%= FormsRichTextEditorProcurementTermToggle.new(current_user).enabled? %>
customer_specific:
  invoice_minimal_ui: <%=  MinimalInvoiceUiToggle.new(current_user).minimal_invoice_ui_enabled? %>
  dummy_bank_account: <%= current_company.yes_bank_vendors&.first&.id %>
