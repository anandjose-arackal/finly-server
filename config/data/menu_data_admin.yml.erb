      # - name: "Assigned Cards"
      #   id: assigned_cards
      #   url: assigned_cards
  <% end %>

  <% if current_user.itzcash_operations? %>
  itzcash_operations:
    menus:
      navbar:
      - name: "Companies"
        id: 'itzcash_companies'
        url: 'itzcash/companies'
