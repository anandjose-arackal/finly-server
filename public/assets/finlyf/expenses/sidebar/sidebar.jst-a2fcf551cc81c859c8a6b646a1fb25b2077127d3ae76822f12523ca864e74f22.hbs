<div class="row sidebar-element">
  <div class="col-sm-3">
    From
  </div>
  <div class="col-sm-9">
    <input type="text" class="form-control datepicker filter-date-from" style="width: 100%;" value="{{item.filter_date_from}}" />
    <span class="fa fa-calendar input-icon "></span> 

  </div>
</div>
<div class="row sidebar-element">
  <div class="col-sm-3">
    To
  </div>
  <div class="col-sm-9">
    <input type="text" class="form-control datepicker filter-date-to" style="width: 100%;" value="{{item.filter_date_to}}" />
    <span class="fa fa-calendar input-icon "></span> 
  </div>
</div>

<div class="row sidebar-element">

  <div class="col-sm-12">
    <input type="text" class="form-control filter-merchant" style="width: 100%;" placeholder="Merchant" value="{{item.filter_merchant}}" />
    <span class="fa fa-search input-icon"></span> 
  </div>
</div>
{{!-- {{item.filter_amount_type}} --}}
<div class="row sidebar-element">
  <div class="col-sm-12">Amount</div>
  <div class="col-sm-12" style="margin-bottom: 5px;">
    <select style="width: 100%;" class="form-control filter-amount-type">
      <option value="lteq">Less Than</option>
      <option value="eq">Equal To</option>
      <option value="gteq">Greater Than</option>
    </select>
  </div>
  <div class="col-sm-12"><input type="number" style="width: 100%;" class="form-control filter-amount-value" placeholder="Amount" value="{{item.filter_amount_value}}" /></div>
</div>

<div class="row sidebar-element">
  <div class="col-sm-12">Category</div>
  <div class="col-sm-12">
    <select style="width: 100%;" class="filter-category-id form-control">
      <option value="">Select</option>
    </select>
  </div>
</div>

<div class="row sidebar-element">
  <div class="col-sm-4">Receipt</div>
  <div class="col-sm-8">
    <select style="width: 100%;" class="filter-receipt form-control">
      <option value="select">Select</option>
      <option value="present">Has Receipt</option>
      <option value="absent">No Receipt</option>
    </select>
  </div>
</div>
{{!-- REF==2O --}}
{{#unless item.indexOnly}}
<div class="row sidebar-element">
  <div class="col-sm-12 text-center">
    <button class="btn btn-sm btn-warning btn-filter-expenses" data-navigate="true">Apply Filter</button>
  </div>
</div>
{{else}}
<div class="row sidebar-element">
  <div class="col-sm-12 text-center">
    <button class="btn-warning btn btn-sm btn-filter-expenses" data-navigate="false">Apply Filter</button>
  </div>
</div>
{{/unless}}