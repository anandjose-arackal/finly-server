<div class="row no-margin">
  <div class="col-sm-6 text-center">
    <h3 class="" style="margin-bottom: 0;">₹&nbsp;{{item.current_user_wallet}}</h3>
    <span style="font-size: 11px;=">(Your Wallet Balance)</span>
  </div>

  <div class="transfer-flow"><i class="fa fa-long-arrow-right"></i></div>

  <div class="col-sm-6 text-center">
    <h3 class="" style="margin-bottom: 0;">₹&nbsp;{{item.current_user_card}}</h3>
    <span style="font-size: 11px;=">(Your Card Balance)</span>
  </div>
</div>
<div class="col-sm-12"><hr></div>
<div class="row no-margin">
  <div class="col-sm-8 col-sm-offset-2">
    <div class="form-group">
      <label class="control-form">Amount:</label>
      <input name="amount" class="form-control card-funds-amount" type="number">
    </div>

    <div class="form-group">
      <label class="control-form">Password:</label>
      <input name="password" class="form-control password" type="password">
    </div>

    <div class="form-group text-center">
      <button class="btn btn-success btn-transfer-wallet-to-card" data-url="/cards/update_balance?action_type=1&from_account=wallet&to_account=card&view=personal">Transfer</button>
    </div>
  </div>
</div>