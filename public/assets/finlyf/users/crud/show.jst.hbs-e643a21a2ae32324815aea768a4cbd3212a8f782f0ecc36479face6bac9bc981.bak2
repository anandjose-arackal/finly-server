<section class="user-info">
  <div class="row">
    <div class="col-sm-6">
      <h4>User Info</h4>
    </div>
    <div class="col-sm-6 text-right">
      {{#if item.actions.delete_invite}}
        <button class="btn btn-danger btn-sm btn-user-action" data-method="DELETE" data-presence="false" data-type="" data-url="{{item.actions.delete_invite}}">Delete Invite</button>
      {{/if}}
      {{#if item.actions.resend_invite}}
        <button class="btn btn-success btn-sm btn-user-action" data-method="PUT" data-presence="true" data-type="resend" data-url="{{item.actions.resend_invite}}">Resend Invite</button>
      {{/if}}
      {{#if item.actions.deactivate}}
        <button class="btn btn-danger btn-sm btn-user-action" data-method="PUT" data-presence="true" data-type="state" data-state-active="false" data-url="{{item.actions.deactivate}}">Deactivate</button>
      {{/if}}
      {{#if item.actions.activate}}
        <button class="btn btn-success btn-sm btn-user-action" data-method="PUT" data-presence="true" data-type="state" data-state-active="true" data-url="{{item.actions.activate}}">Activate</button>
      {{/if}}
    </div>
  </div>
  <form class="form-user-info">
    <div class="row">
      <div class="col-sm-3">Name</div>
      <div class="col-sm-9">
        <label class="item-attr-preview">{{item.user.name}}</label>
        <input class="item-attr-edit form-control" type="text" name="user[name]" value="{{item.user.name}}" />
      </div>
    </div>

    <div class="row">
      <div class="col-sm-3">Email</div>
      <div class="col-sm-9">
        <label class="item-attr-preview">{{item.user.email}}</label>
        <input class="item-attr-edit form-control" type="text" disabled="disabled" name="" value="{{item.user.email}}" />
      </div>
    </div>

    <div class="row">
      <div class="col-sm-3">Mobile</div>
      <div class="col-sm-9">
        <label class="item-attr-preview">
          {{#if item.user.mobile_number}}
            {{item.user.mobile_number}}
          {{else}}
            Not Set
          {{/if}}
        </label>
        <input class="item-attr-edit form-control" type="text" name="user[mobile_number]" value="{{item.user.mobile_number}}" />
      </div>
    </div>

    <input type="hidden" name="type" value="details">
  </form>
</section>


<section class="user-roles">
  <div class="row">
    <div class="col-sm-6">
      <h4>User Roles</h4>
    </div>
    <div class="col-sm-6 text-right">
      <button class="btn btn-sm btn-warning btn-edit-user"><i class="fa fa-edit"></i>&nbsp;&nbsp;Edit</button>
    </div>
  </div> 
  <form class="form-user-roles">
    
  
    <div class="row">
      <div class="col-sm-3">Admin?</div>
      <div class="col-sm-9">
        <label class="item-attr-preview">{{#if item.role.admin}}Yes{{else}}No{{/if}}</label>

        {{#if item.role.editable.admin}}

          {{#if item.role.admin}}
            <label class="item-attr-edit">
              <input class="" type="radio" name="user_roles[admin]" value="1" checked="checked" />&nbsp;&nbsp;Yes
            </label>
            <label class="item-attr-edit">
              <input class="" type="radio" name="user_roles[admin]" value="0" />&nbsp;&nbsp;No  
            </label>
          {{else}}
            <label class="item-attr-edit">
              <input class="" type="radio" name="user_roles[admin]" value="1" />&nbsp;&nbsp;Yes
            </label>
            <label class="item-attr-edit">
              <input class="" type="radio" name="user_roles[admin]" value="0" checked="checked" />&nbsp;&nbsp;No  
            </label>
          {{/if}}

        {{else}}

          {{#if item.role.admin}}
            <label class="item-attr-edit">
              <input disabled="disabled" class="" type="radio" name="user_roles[admin]" value="1" checked="checked" />&nbsp;&nbsp;Yes
            </label>
            <label class="item-attr-edit">
              <input disabled="disabled" class="" type="radio" name="user_roles[admin]" value="0" />&nbsp;&nbsp;No  
            </label>
          {{else}}
            <label class="item-attr-edit">
              <input disabled="disabled" class="" type="radio" name="user_roles[admin]" value="1" />&nbsp;&nbsp;Yes
            </label>
            <label class="item-attr-edit">
              <input disabled="disabled" class="" type="radio" name="user_roles[admin]" value="0" checked="checked" />&nbsp;&nbsp;No  
            </label>
          {{/if}}

        {{/if}}

        
        
      </div>
    </div>

    <div class="row">
      <div class="col-sm-3">Manager?</div>
      <div class="col-sm-9">
        <label class="item-attr-preview">{{#if item.role.manager}}Yes{{else}}No{{/if}}</label>


        {{#if item.role.editable.manager}}
          {{#if item.role.manager}}
            <label class="item-attr-edit">
               <input class="" type="radio" name="user_roles[manager]" value="1" checked="checked" />&nbsp;&nbsp;Yes
            </label>
            <label class="item-attr-edit">
               <input class="" type="radio" name="user_roles[manager]" value="0" />&nbsp;&nbsp;No
            </label>
          {{else}}
            <label class="item-attr-edit">
               <input class="" type="radio" name="user_roles[manager]" value="1" />&nbsp;&nbsp;Yes
            </label>
            <label class="item-attr-edit">
               <input class="" type="radio" name="user_roles[manager]" value="0" checked="checked" />&nbsp;&nbsp;No
            </label>
          {{/if}}

        {{else}}

          {{#if item.role.manager}}
            <label class="item-attr-edit">
               <input disabled="disabled" class="" type="radio" name="user_roles[manager]" value="1" checked="checked" />&nbsp;&nbsp;Yes
            </label>
            <label class="item-attr-edit">
               <input disabled="disabled" class="" type="radio" name="user_roles[manager]" value="0" />&nbsp;&nbsp;No
            </label>
          {{else}}
            <label class="item-attr-edit">
               <input disabled="disabled" class="" type="radio" name="user_roles[manager]" value="1" />&nbsp;&nbsp;Yes
            </label>
            <label class="item-attr-edit">
               <input disabled="disabled" class="" type="radio" name="user_roles[manager]" value="0" checked="checked" />&nbsp;&nbsp;No
            </label>
          {{/if}}

        {{/if}}
        
      </div>
    </div>

    <div class="row">
      <div class="col-sm-3">Finance Manager?</div>
      <div class="col-sm-9">
        <label class="item-attr-preview">{{#if item.role.finance_manager}}Yes{{else}}No{{/if}}</label>

        {{#if item.role.editable.finance_manager}}

          {{#if item.role.finance_manager}}
            <label class="item-attr-edit">
               <input class="" type="radio" name="user_roles[finance_manager]" value="1" checked="checked" />&nbsp;&nbsp;Yes
            </label>
            <label class="item-attr-edit">
               <input class="" type="radio" name="user_roles[finance_manager]" value="0" />&nbsp;&nbsp;No
            </label>
          {{else}}
            <label class="item-attr-edit">
               <input class="" type="radio" name="user_roles[finance_manager]" value="1" />&nbsp;&nbsp;Yes
            </label>
            <label class="item-attr-edit">
               <input class="" type="radio" name="user_roles[finance_manager]" value="0" checked="checked" />&nbsp;&nbsp;No
            </label>
          {{/if}}

        {{else}}

          {{#if item.role.finance_manager}}
            <label class="item-attr-edit">
               <input disabled="disabled" class="" type="radio" name="user_roles[finance_manager]" value="1" checked="checked" />&nbsp;&nbsp;Yes
            </label>
            <label class="item-attr-edit">
               <input disabled="disabled" class="" type="radio" name="user_roles[finance_manager]" value="0" />&nbsp;&nbsp;No
            </label>
          {{else}}
            <label class="item-attr-edit">
               <input disabled="disabled" class="" type="radio" name="user_roles[finance_manager]" value="1" />&nbsp;&nbsp;Yes
            </label>
            <label class="item-attr-edit">
               <input disabled="disabled" class="" type="radio" name="user_roles[finance_manager]" value="0" checked="checked" />&nbsp;&nbsp;No
            </label>
          {{/if}}

        {{/if}}
        
      </div>
    </div>

    <input type="hidden" name="type" value="role">
  </form>

</section>
{{!-- ====================== --}}

<section class="user-policies">
  <div class="row">
    <div class="col-sm-6">
      <h4>POLICIES</h4>
    </div>
  </div>

  
  {{#each item.mapping}}
  <div class="policy">
    <div class="row policy-name no-margin">
      <div class="col-sm-6">
        <h4>
          {{#if this.company_default}}
            Default
          {{else}}
            <input type="hidden" name="user_manager_mapping[0][mapping][policy_id]" value="{{this.policy.id}}">
            {{this.policy.name}}{{!-- (PolicyName 0) --}}
          {{/if}}
        </h4>
      </div>

      <div class="col-sm-6 text-right">
        <button class="btn btn-sm btn-warning btn-edit-policy"><i class="fa fa-edit"></i>&nbsp;&nbsp;Edit</button>
      </div>
    </div>

    <div class="policy-rules row no-margin">
      <form>
        <div class="row no-margin" style="padding: 10px 10px 0;">
          <div class="col-sm-12 manager-data manager-container">
            <div class="row manager non-conditional no-margin">
              Submits reports To:&nbsp;&nbsp;

              <input type="hidden" name="user_manager_mapping[0][mapping_id]" value="{{this.default.mapping_id}}">{{!-- (Mapping ID 0) --}}
              <label class="control-label item-attr-preview">
                {{#if this.default.manager.name}}
                  {{this.default.manager.name}}
                {{else}}
                  Not Set
                {{/if}}
              </label>{{!-- Manager 0 --}}
              <select class="select-assign-manager form-control item-attr-edit" name="user_manager_mapping[0][mapping][manager_id]" data-default-value="{{this.default.manager.id}}">
                <option value="">None</option>
                {{#each ../item.team_managers}}
                  <option value="{{this.id}}">{{this.name}}</option>
                {{/each}}
              </select>
              {{!-- <input type="number" class="item-attr-edit" name="user_manager_mapping[0][mapping][manager_id]" value="{{this.default.manager.id}}"> --}}
            </div>
            
            <h1>{{this.conditional_manager.length}}</h1>
            {{#each this.conditional_manager}}
            <div class="row x conditional no-margin" data-condition-serial="{{@index}}">

              <div class="col-sm-12 hideme">
                {{#if ../this.company_default}}{{else}}
                  <input type="number" name="user_manager_mapping[{{increment @index 1}}][mapping][policy_id]" value="{{../this.policy.id}}">{{../this.policy.name}}(Policy Name 1)
                {{/if}}
                <input type="number" class="mapping-id" name="user_manager_mapping[{{increment @index 1}}][mapping_id]" value="{{this.mapping_id}}">(Mapping ID 1)
              </div>

              <div class="col-sm-3">If report total is greater than:</div>

              <div class="col-sm-2">
                <label class="control-label item-attr-preview">
                {{#if this.greater_than_amount.value}}
                  {{this.greater_than_amount.value}}
                {{else}}
                  Not Set
                {{/if}}
                </label>{{!-- (Greater than amount 1) --}}
                <input type="hidden" class="item-attr-edit" name="user_manager_mapping[1][mapping][greater_than_amount_attributes][currency_id]" value="1">
                <input type="number" class="form-control item-attr-edit" name="user_manager_mapping[1][mapping][greater_than_amount_attributes][value]" value="{{this.greater_than_amount.value}}">
              </div>

              <div class="col-sm-3">then submits report to:</div>

              <div class="col-sm-3">
                <label class="control-label item-attr-preview">
                {{#if this.manager.name}}
                  {{this.manager.name}}
                {{else}}
                  Not Set
                {{/if}}
                </label>{{!-- (Conditional Manager 1) --}}
                <select class="form-control item-attr-edit" name="user_manager_mapping[1][mapping][manager_id]" data-default-value="{{this.manager.id}}">
                  <option value="">None</option>
                  {{#each ../../item.team_managers}}
                    <option value="{{this.id}}">{{this.name}}</option>
                  {{/each}}
                </select>
                {{!-- <input type="number" class="item-attr-edit" name="user_manager_mapping[1][mapping][manager_id]" value="{{this.conditional_manager.manager.id}}"> --}}
              </div>
              <div class="col-sm-1">
                <button class="item-attr-edit btn btn-xs btn-danger btn-remove-condition">Remove</button>
              </div>
              
            </div><!-- .conditional -->
            {{/each}}
            <div class="col-sm-12 add-condition">
              <button class="btn btn-sm btn-default btn-add-condition item-attr-edit" data-policy-id="{{this.policy.id}}" data-manager-type="manager">Add Condition</button>
            </div>
          </div><!-- .col-sm-12 -->
          <hr />
          <div class="col-sm-12 finance-manager-data manager-container">
            <div class="row finance-manager non-conditional no-margin">
              Submits Report Finance to:&nbsp;&nbsp;

              <label class="control-label item-attr-preview">
                {{#if this.default.finance_manager.name}}
                  {{this.default.finance_manager.name}}
                {{else}}
                  Not Set
                {{/if}}
              </label>{{!-- (Finance Manager 0) --}}
              <select class="select-assign-manager form-control item-attr-edit" name="user_manager_mapping[0][mapping][finance_manager_id]" data-default-value="{{this.default.finance_manager.id}}">
                <option value="">None</option>
                {{#each ../item.team_finance_managers}}
                  <option value="{{this.id}}">{{this.name}}</option>
                {{/each}}
              </select>
              {{!-- <input type="number" class="item-attr-edit" name="user_manager_mapping[0][mapping][finance_manager_id]" value="{{this.default.finance_manager.id}}"> --}}
            </div>

            {{#each conditional_finance_manager}}
            <div class="row finance-manager conditional no-margin" data-condition-serial="2">
              <div class="col-sm-12 hideme">
                {{#if ../this.company_default}}{{else}}
                  <input type="number" name="user_manager_mapping[2][mapping][policy_id]" value="{{../this.policy.id}}">{{../this.policy.name}}(Policy Name 2)
                {{/if}}

                <input type="number" class="mapping-id" name="user_manager_mapping[2][mapping_id]" value="{{this.mapping_id}}">(Mapping ID 2)
              </div>

              <div class="col-sm-3">If report total is greater than:</div>

              <div class="col-sm-2">
                <label class="control-label item-attr-preview">
                  {{#if this.greater_than_amount.value}}
                    {{this.greater_than_amount.value}}
                  {{else}}
                    Not Set
                  {{/if}}
                </label>{{!-- (Greater than amount 2) --}}
                <input type="hidden" class="item-attr-edit" name="user_manager_mapping[2][mapping][greater_than_amount_attributes][currency_id]" value="1">
                <input type="number" class="form-control item-attr-edit" name="user_manager_mapping[2][mapping][greater_than_amount_attributes][value]" value="{{this.greater_than_amount.value}}">
              </div>

              
              <div class="col-sm-3">then submits report finance to:</div>



              <div class="col-sm-3">
                <label class="control-label item-attr-preview">
                {{#if this.finance_manager.name}}
                  {{this.finance_manager.name}}
                {{else}}
                  Not Set
                {{/if}}
                </label>{{!-- (Conditional Manager 2) --}}
                <select class="form-control item-attr-edit" name="user_manager_mapping[2][mapping][finance_manager_id]" data-default-value="{{this.finance_manager.id}}">
                  <option value="">None</option>
                  {{#each ../../item.team_finance_managers}}
                    <option value="{{this.id}}">{{this.name}}</option>
                  {{/each}}
                </select>
                {{!-- <input type="number" class="item-attr-edit" name="user_manager_mapping[2][mapping][finance_manager_id]" value="{{this.conditional_finance_manager.finance_manager.id}}"> --}}
              </div>

              <div class="col-sm-1"><button class="item-attr-edit btn btn-xs btn-danger btn-remove-condition">Remove</button></div>

            </div><!-- .conditional -->
            {{/each}}
            <div class="col-sm-12 add-condition">
              <button class="btn btn-sm btn-default btn-add-condition item-attr-edit" data-policy-id="{{this.policy.id}}" data-manager-type="finance_manager">Add Condition</button>
            </div>
          </div><!-- .col-sm-12 -->
        </div><!-- .row -->

        <div class="row no-margin" style="padding:0 10px;">
          {{#if ../item.role.manager}}
          <div class="col-sm-12 approves-to-data manager-container">
            <div class="row approves-to non-conditional no-margin">
              Approves To:&nbsp;&nbsp;
              <label class="control-label item-attr-preview">
              {{#if this.default.approves_to.name}}
                {{this.default.approves_to.name}}
              {{else}}
                Not Set
              {{/if}}
              </label>{{!-- (Approves_to 0) --}}

              <select class="select-assign-manager form-control item-attr-edit" name="user_manager_mapping[0][mapping][approves_to_id]" data-default-value="{{this.default.approves_to.id}}">
                <option value="">None</option>
                {{#each ../item.team_managers}}
                  <option value="{{this.id}}">{{this.name}}</option>
                {{/each}}
              </select>
              {{!-- <input type="number" class="item-attr-edit" name="user_manager_mapping[0][mapping][approves_to_id]" value="{{this.default.approves_to.id}}"> --}}
            </div>

            {{#each conditional_approves_to}}
            <div class="row conditional approves_to no-margin" data-condition-serial="3">

              <div class="col-sm-12 hideme">
                {{#if ../this.company_default}}{{else}}
                  <input type="number" name="user_manager_mapping[3][mapping][policy_id]" value="{{../this.policy.id}}">{{../this.policy.name}}(Policy Name 3)
                {{/if}}
                <input type="number" class="mapping-id" name="user_manager_mapping[3][mapping_id]" value="{{this.mapping_id}}">(Mapping ID 3)
              </div>

              <div class="col-sm-3">If report total is greater than:</div>

              <div class="col-sm-2">
                <label class="control-label item-attr-preview">
                  {{#if this.greater_than_amount.value}}
                    {{this.greater_than_amount.value}}
                  {{else}}
                    Not Set
                  {{/if}}
                </label>{{!-- (Greater than amount 3) --}}
                <input type="hidden" class="item-attr-edit" name="user_manager_mapping[3][mapping][greater_than_amount_attributes][currency_id]" value="1">
                <input type="number" class="form-control item-attr-edit" name="user_manager_mapping[3][mapping][greater_than_amount_attributes][value]" value="{{this.greater_than_amount.value}}">

              </div>

              <div class="col-sm-3">then approves report to:</div>

              <div class="col-sm-3">
                <label class="control-label item-attr-preview">
                  {{#if this.approves_to.name}}
                    {{this.approves_to.name}}
                  {{else}}
                    Not Set
                  {{/if}}
                </label>{{!-- (Conditional approves to 3) --}}

                <select class="form-control item-attr-edit" name="user_manager_mapping[3][mapping][approves_to_id]" data-default-value="{{this.approves_to.id}}">
                  <option value="">None</option>
                  {{#each ../../item.team_managers}}
                    <option value="{{this.id}}">{{this.name}}</option>
                  {{/each}}
                </select>
                {{!-- <input type="number" class="item-attr-edit" name="user_manager_mapping[3][mapping][approves_to_id]" value="{{this.conditional_approves_to.approves_to.id}}"> --}}
              </div>
              <div class="col-sm-1"><button class="item-attr-edit btn btn-xs btn-danger btn-remove-condition">Remove</button></div>
            </div>
            {{/each}}
            <div class="col-sm-12 add-condition">
              <button class="btn btn-sm btn-default btn-add-condition item-attr-edit" data-policy-id="{{this.policy.id}}" data-manager-type="approves_to">Add Condition</button>
            </div>
          </div><!-- .col-sm-12 -->
          {{/if}}


          {{#if ../item.role.finance_manager}}
          <div class="col-sm-12 approves-finance-to-data manager-container">
            <div class="row approves-finance-to non-conditional no-margin">
              Approves Finance To:&nbsp;&nbsp;

              <label class="control-label item-attr-preview">
                {{#if this.default.approves_finance_to.name}}
                  {{this.default.approves_finance_to.name}}
                {{else}}
                  Not Set
                {{/if}}
              </label>{{!-- (Approves Finance to 0) --}}

              <select class="select-assign-manager form-control item-attr-edit" name="user_manager_mapping[0][mapping][approves_finance_to_id]" data-default-value="{{this.default.approves_finance_to.id}}">
                <option value="">None</option>
                {{#each ../item.team_finance_managers}}
                  <option value="{{this.id}}">{{this.name}}</option>
                {{/each}}
              </select>
              {{!-- <input type="number" class="item-attr-edit" name="user_manager_mapping[0][mapping][approves_finance_to_id]" value="{{this.default.approves_finance_to.id}}"> --}}
            </div>

            {{#each this.conditional_approves_finance_to}}
            <div class="row conditional approves-finance-to no-margin" data-condition-serial="4">
              <div class="col-sm-12 hideme">
                {{#if ../this.company_default}}{{else}}
                  <input type="number" name="user_manager_mapping[4][mapping][policy_id]" value="{{../this.policy.id}}">{{../this.policy.name}}(Policy Name 4)
                {{/if}}

                <input type="number" class="mapping-id" name="user_manager_mapping[4][mapping_id]" value="{{this.mapping_id}}">(Mapping ID 4)
              </div>

              <div class="col-sm-3">If report total is greater than:</div>

              <div class="col-sm-2">
                <label class="item-attr-preview">
                  {{#if this.greater_than_amount.value}}
                    {{this.greater_than_amount.value}}
                  {{else}}
                    Not Set
                  {{/if}}
                </label>{{!-- (Greater than amount 4) --}}
                <input type="hidden" class="item-attr-edit" name="user_manager_mapping[4][mapping][greater_than_amount_attributes][currency_id]" value="1">
                <input type="number" class="form-control item-attr-edit" name="user_manager_mapping[4][mapping][greater_than_amount_attributes][value]" value="{{this.greater_than_amount.value}}">

              </div>

              <div class="col-sm-3">then approves report finance to:</div>

              <div class="col-sm-3">
                <label class="control-label item-attr-preview">
                  {{#if this.approves_finance_to.name}}
                    {{this.approves_finance_to.name}}
                  {{else}}
                    Not Set
                  {{/if}}
                </label>{{!-- (Conditional approves to 4) --}}
                <select class="form-control item-attr-edit" name="user_manager_mapping[4][mapping][approves_finance_to_id]" data-default-value="{{this.approves_finance_to.id}}">
                  <option value="">None</option>
                  {{#each ../../item.team_finance_managers}}
                    <option value="{{this.id}}">{{this.name}}</option>
                  {{/each}}
                </select>
                {{!-- <input type="number" class="item-attr-edit" name="user_manager_mapping[4][mapping][approves_finance_to_id]" value="{{this.conditional_approves_finance_to.approves_to.id}}"> --}}
              </div>
              <div class="col-sm-1"><button class="item-attr-edit btn btn-xs btn-danger btn-remove-condition">Remove</button></div>
            </div>
            {{/each}}
            <div class="col-sm-12 add-condition">
              <button class="btn btn-sm btn-default btn-add-condition item-attr-edit" data-policy-id="{{this.policy.id}}" data-manager-type="approves_finance_to">Add Condition</button>
            </div>

          </div><!-- .col-sm-12 -->
          {{/if}}
        </div>
        <input type="hidden" name="type" value="team">
      </form>
    </div>
  </div><!-- .policy -->
  {{/each}}
</section>


<style type="text/css">
  .policy{
    /*background: #423496;*/
    background: #F3F1FD;
  }
  .policy .policy-name{
    background: #D1CBF1;
  }
  .manager-container{
    border: 1px solid #D1CBF1;
    margin-bottom: 10px;
    padding: 10px;
  }

  .non-conditional{
    padding: 10px;
    margin-top: 5px;
  }

  .non-conditional .select-assign-manager{
    width: 250px;
  }

  .pad{
    padding: 10px;
    background: white;
    margin-bottom: 10px;
  }

  .btn-edit-policy, .btn-update-policy{
    margin-top: 5px;
  }

  .hideme{
    background: yellow;
    display: none;
  }
