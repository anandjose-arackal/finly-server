<div class="modal-dialog" role="document" style="width: 40%; margin-top: 113px;">
  <div class="modal-content">
    <div class="modal-header">
      <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
      <h4 class="modal-title">Load Funds into Card</h4>
    </div>
    <div class="modal-body">
      <div class="row no-margin">
        {{#switch item.type}}
          {{#case 'credit_wallet_from_virtual_account'}}
            <div class="col-sm-6 text-center">
              <h3 class="virtual_account_balance" style="margin-bottom: 0;">&nbsp;</h3>
              <span style="font-size: 11px;=">(Company Balance)</span>
            </div>

            <div class="transfer-flow"><i class="fa fa-long-arrow-right"></i></div>

            <div class="col-sm-6 text-center">
              <h3 class="target_user_wallet_balance" style="margin-bottom: 0;">&nbsp;</h3>
              <span style="font-size: 11px;=">(User's Wallet Balance)</span>
            </div>
          {{/case}}
          {{#case 'credit_card_from_virtual_account'}}
            <div class="col-sm-6 text-center">
              <h3 class="virtual_account_balance" style="margin-bottom: 0;">&nbsp;</h3>
              <span style="font-size: 11px;=">(Company Balance)</span>
            </div>

            <div class="transfer-flow"><i class="fa fa-long-arrow-right"></i></div>

            <div class="col-sm-6 text-center">
              <h3 class="target_user_card_balance" style="margin-bottom: 0;">&nbsp;</h3>
              <span style="font-size: 11px;=">(User's Card Balance)</span>
            </div>
          {{/case}}
          {{#case 'credit_wallet_from_wallet'}}
            <div class="col-sm-6 text-center">
              <h3 class="current_user_wallet_balance" style="margin-bottom: 0;">&nbsp;</h3>
              <span style="font-size: 11px;=">(Your Wallet Balance)</span>
            </div>

            <div class="transfer-flow"><i class="fa fa-long-arrow-right"></i></div>

            <div class="col-sm-6 text-center">
              <h3 class="target_user_wallet_balance" style="margin-bottom: 0;">&nbsp;</h3>
              <span style="font-size: 11px;=">(User's Wallet Balance)</span>
            </div>
          {{/case}}
          {{#case 'credit_card_from_wallet'}}
            <div class="col-sm-6 text-center">
              <h3 class="current_user_wallet_balance" style="margin-bottom: 0;">&nbsp;</h3>
              <span style="font-size: 11px;=">(Your Wallet Balance)</span>
            </div>

            <div class="transfer-flow"><i class="fa fa-long-arrow-right"></i></div>

            <div class="col-sm-6 text-center">
              <h3 class="target_user_card_balance" style="margin-bottom: 0;">&nbsp;</h3>
              <span style="font-size: 11px;=">(User's Card Balance)</span>
            </div>
          {{/case}}
        {{/switch}}
      </div>
      <div class="col-sm-12"><hr /></div>
      <div class="row no-margin">
        <div class="col-sm-8 col-sm-offset-2">
          <div class="form-group">
            <label class="control-form">Amount:</label>
            <input type="number" name="amount" class="form-control card-funds-amount"/>
          </div>

          <div class="form-group">
            <label class="control-form">Password:</label>
            <input type="password" name="password" class="form-control password"/>
          </div>

          <div class="form-group text-center">
            <button class="btn btn-success btn-confirm-card-action" data-action-type="{{item.type}}" data-url="{{item.url}}">Transfer</button>
          </div>
        </div>
      </div>
    </div>
  </div><!-- /.modal-content -->
</div><!-- /.modal-dialog -->