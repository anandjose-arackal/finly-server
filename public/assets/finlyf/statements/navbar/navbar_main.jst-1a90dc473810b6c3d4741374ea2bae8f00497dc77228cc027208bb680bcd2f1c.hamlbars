<div class="row no-margin no-padding">
  <div class="col-sm-8 no-padding">
     <ul class="nav navbar-nav">
      <li style="margin-top: 15px;">
        <span>From</span>
      </li>
      <li style="margin-top: 10px;">
        <input type="text" class="form-control datepicker filter-date-from" style="width: 100%;" value="{{item.filter_date_from}}" />
        <span class="fa fa-calendar input-icon "></span> 
      </li>
      <li class="divider-vertical"></li>

      <li style="margin-top: 15px;">
        <span>To</span>
      </li>
      <li style="margin-top: 10px;">
        <input type="text" class="form-control datepicker filter-date-to" style="width: 100%;" value="{{item.filter_date_to}}" />
        <span class="fa fa-calendar input-icon "></span> 
      </li>
    </ul>   
  </div>
  <div class="col-sm-4">
    <ul class="nav navbar-nav navbar-right">
      <li class="filter-statement-type {{#if_eq item.statement_type 'summary'}}active{{/if_eq}}" data-show-type="summary"><a href="#">Statements Summary</a></li>
      <li class="filter-statement-type {{#if_eq item.statement_type 'transactions'}}active{{/if_eq}}" data-show-type="transactions"><a href="#">Transactions</a></li>
    </ul>
  </div>
</div>
