  <li style="margin-top: 15px; margin-right: 10px;">
    <span>From</span>
  </li>
  <li style="margin-top: 10px;">
    <input type="text" class="form-control datepicker filter-date-statements filter-date-from" style="width: 100%;" value="{{item.filter_date_from}}" readonly/>
    <span class="fa fa-calendar input-icon "></span> 
  </li>
  <li class="divider-vertical"></li>

  <li style="margin-top: 15px; margin-right: 10px;">
    <span>To</span>
  </li>
  <li style="margin-top: 10px;">
    <input type="text" class="form-control datepicker filter-date-statements filter-date-to" style="width: 100%;" value="{{item.filter_date_to}}" readonly/>
    <span class="fa fa-calendar input-icon "></span> 
  </li>
</ul>