<div class="row no-margin">
  <div class="col-sm-3 col-sm-offset-2">
    <label class="grey-text">From:</label>
    
    {{#switch item.meta.from}}
      {{#case 'current_user_wallet'}}
        <h4 class="no-margin">Your Finly Money</h4>
        <h3 class="no-margin mt-5 current_user_wallet currency" style="margin-bottom: 0;">₹&nbsp;{{item.current_user_wallet}}</h3>
      {{/case}}
      {{#case 'virtual_account'}}
        <h4 class="no-margin">Company Balance</h4>
        <h3 class="no-margin mt-5 virtual_account_balance currency" style="margin-bottom: 0;">₹&nbsp;{{item.virtual_account}}</h3>
      {{/case}}
      {{#case 'target_user_card'}}
        <h4 class="no-margin">User's Card</h4>
        <h3 class="no-margin mt-5 target_user_card currency" style="margin-bottom: 0;">₹&nbsp;{{item.target_user_card}}</h3>
        <span style="color: #aaa;">Available Card Eligibility:</span>&nbsp;<label class="current_user_card_eligibility">&#8377;&nbsp;{{item.target_user_card_details.available_card_eligibility}}</label>
      {{/case}}
      {{#case 'target_user_wallet'}}
        <h4 class="no-margin">User's Finly Money</h4>
        <h3 class="no-margin mt-5 target_user_wallet currency" style="margin-bottom: 0;">₹&nbsp;{{item.target_user_wallet}}</h3>
      {{/case}}
      {{#case 'current_user_card'}}
        <h4 class="no-margin">Your Card</h4>
        <h3 class="no-margin mt-5 current_user_card currency" style="margin-bottom: 0;">₹&nbsp;{{item.current_user_card}}</h3>
      {{/case}}
    {{/switch}}
  </div>

  <div class="transfer-flow"><i class="fa fa-long-arrow-right"></i></div>

  <div class="col-sm-2 col-sm-offset-2">
    <label class="grey-text">To:</label>
    
    {{#switch item.meta.to}}
      {{#case 'current_user_wallet'}}
        <h4 class="no-margin">Your Finly Money</h4>
        <h3 class="no-margin mt-5 current_user_wallet currency" style="margin-bottom: 0;">₹&nbsp;{{item.current_user_wallet}}</h3>
      {{/case}}
      {{#case 'virtual_account'}}
        <h4 class="no-margin">Company Balance</h4>
        <h3 class="no-margin mt-5 virtual_account currency" style="margin-bottom: 0;">₹&nbsp;{{item.virtual_account}}</h3>
      {{/case}}
      {{#case 'target_user_card'}}
        <h4 class="no-margin">User's Card</h4>
        <h3 class="no-margin mt-5 target_user_card currency" style="margin-bottom: 0;">₹&nbsp;{{item.target_user_card}}</h3>
        <span style="color: #aaa;">Available Card Eligibility:</span>&nbsp;<label class="current_user_card_eligibility">&#8377;&nbsp;{{item.target_user_card_details.available_card_eligibility}}</label>
      {{/case}}
      {{#case 'target_user_wallet'}}
        <h4 class="no-margin">User's Finly Money</h4>
        <h3 class="no-margin mt-5 target_user_wallet currency" style="margin-bottom: 0;">₹&nbsp;{{item.target_user_wallet}}</h3>
      {{/case}}
      {{#case 'current_user_card'}}
        <h4 class="no-margin">Your Card</h4>
        <h3 class="no-margin mt-5 current_user_card currency" style="margin-bottom: 0;">₹&nbsp;{{item.current_user_card}}</h3>
        <span style="color: #aaa;">Your Available Card Eligibility:</span>&nbsp;<label class="current_user_card_eligibility">&#8377;&nbsp;{{item.current_user_card_details.available_card_eligibility}}</label>
      {{/case}}
    {{/switch}}
    </h4>
  </div>
</div>
<div class="col-sm-12"><hr></div>
<div class="row no-margin">
  <div class="col-sm-8 col-sm-offset-2">
    <div class="form-group">
      <label class="control-form">Amount:</label>
      <input name="amount" class="form-control" type="number">
    </div>

    <div class="form-group text-center">
      <button class="btn btn-success step-1-action" data-url="{{item.meta.current_action.url}}" data-action-type="{{item.meta.current_action.action}}">Proceed</button>
    </div>
  </div>
</div>