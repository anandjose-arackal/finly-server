<div class="process-screen col-sm-12">
  <div class="row no-margin">
    <label style="margin-top: 8px">Amount</label>
    <input name="payment[amount]" id="settlementAmount" class="form-control" style="margin-top: 4px; border-radius: 1px" type="text">
    <label style="margin-top: 8px">Date</label>

    <input name="payment[date]" id="settlementDate" class="form-control datepicker" min="'2000-01-01'" max="'2020-01-01'" style="margin-top: 4px;border-radius: 1px" type="text">
    <label style="margin-top: 8px">Note</label>

    <textarea id="settlementNote" name="payment[note]" class="form-control" placeholder="Write a note..." style="margin-top: 4px; border-radius: 1px;resize: vertical; margin-bottom: 10px;"></textarea>

    <button class="btn btn-success step-2-action" data-action-type="credit_cash_advance">Continue</button>
  </div>
</div>