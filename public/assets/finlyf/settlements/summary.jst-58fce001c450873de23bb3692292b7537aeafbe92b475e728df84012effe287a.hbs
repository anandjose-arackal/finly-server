<div class="col-sm-10 col-sm-offset-1">
  <div class="col-sm-4 text-center">
    <h4 class="text-center">Pending Reimbursement</h4>
    <h4 class="summary_pending_reimbursement text-center">{{item.pending_reimbursement}}</h4>
    <input type="hidden" name="pending_reimbursement" value="{{item.pending_reimbursement}}">
    
  </div>

  <div class="col-sm-4 text-center">
    <h4 class="text-center">Cash in Hand</h4>
    <h4 class="summary_cash_id_hand text-center">{{item.cash_in_hand}}</h4>
    <input type="hidden" name="cash_in_hand" value="{{item.cash_in_hand}}">
    
  </div>

  <div class="col-sm-4 text-center">
    {{#if item.actions.add_cash_advance}}
      <button class="btn btn-sm btn-success btn-process-payment btn-report-summary-action">Add Cash</button>
    {{/if}}
    {{#if item.actions.add_reimbursement}}
      <button class="btn btn-sm btn-warning btn-process-reimburse btn-report-summary-action" data-url="{{item.actions.add_reimbursement}}">Reimburse</button>
    {{/if}}
    {{#if item.actions.settle}}
      <button class="btn btn-sm btn-warning btn-process-debt btn-report-summary-action" data-url="{{item.actions.settle}}">Settle Debt</button>
    {{/if}}
  </div>
</div>
<style type="text/css">
.btn-report-summary-action{
  width: 150px;
  margin-bottom: 5px;
  display: block;
}
</style>
