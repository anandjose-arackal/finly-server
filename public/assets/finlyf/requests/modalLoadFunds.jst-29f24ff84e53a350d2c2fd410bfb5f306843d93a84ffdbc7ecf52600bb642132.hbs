<div class="modal-dialog" role="document" style="width: 40%; margin-top: 113px;">
  <div class="modal-content">
    <div class="modal-header">
      <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
      <h4 class="modal-title">Transfer Funds</h4>
    </div>
    <div class="modal-body">
      {{!-- <div class="row no-margin">
        <div class="col-sm-12 text-center">
          <h3 class="card-balance" style="margin-bottom: 0;">&nbsp;</h3>
          <span style="font-size: 11px;=">(Current Balance)</span>
        </div>
      </div>
      <div class="col-sm-12"><hr /></div> --}}
      <div class="row no-margin">
        <div class="col-sm-10 col-sm-offset-1">
          <div class="col-sm-6 text-center">
          {{#switch item.action_type}}
            {{#case 'credit_card_from_wallet'}}
              <h3 style="margin-bottom: 0;">&#8377;&nbsp;<span class="current_user_wallet_balance"><i class="fa fa-spin fa-spinner"></i></span></h3>
              <span style="font-size: 11px;=">(Your Wallet Balance)</span>
            {{/case}}

            {{#case 'credit_card_from_virtual_account'}}
              <h3 style="margin-bottom: 0;">&#8377;&nbsp;<span class="virtual_account_balance"><i class="fa fa-spin fa-spinner"></i></span></h3>
              <span style="font-size: 11px;=">(Company Credits)</span>
            {{/case}}
            {{#case 'credit_wallet_from_wallet'}}
              <h3 style="margin-bottom: 0;">&#8377;&nbsp;<span class="current_user_wallet_balance"><i class="fa fa-spin fa-spinner"></i></span></h3>
              <span style="font-size: 11px;=">(Your Wallet Balance)</span>
            {{/case}}
            {{#case 'credit_wallet_from_virtual_account'}}
              <h3 style="margin-bottom: 0;">&#8377;&nbsp;<span class="virtual_account_balance"><i class="fa fa-spin fa-spinner"></i></span></h3>
              <span style="font-size: 11px;=">(Company Credits)</span>
            {{/case}}
          {{/switch}}
          </div>


          <div class="transfer-flow"><i class="fa fa-long-arrow-right"></i></div>

          <div class="col-sm-6 text-center">
          {{#switch item.action_type}}
            {{#case 'credit_card_from_wallet'}}
              <h3 style="margin-bottom: 0;">&#8377;&nbsp;<span class="target_user_card_balance"><i class="fa fa-spin fa-spinner"></i></span></h3>
              <span style="font-size: 11px;=">(Employee's Card Balance)</span>
            {{/case}}

            {{#case 'credit_card_from_virtual_account'}}
              <h3 style="margin-bottom: 0;">&#8377;&nbsp;<span class="target_user_card_balance"><i class="fa fa-spin fa-spinner"></i></span></h3>
              <span style="font-size: 11px;=">(Employee's Card Balance)</span>
            {{/case}}
            {{#case 'credit_wallet_from_wallet'}}
              <h3 style="margin-bottom: 0;">&#8377;&nbsp;<span class="target_user_wallet_balance"><i class="fa fa-spin fa-spinner"></i></span></h3>
              <span style="font-size: 11px;=">(Employee's Wallet Balance)</span>
            {{/case}}
            {{#case 'credit_wallet_from_virtual_account'}}
              <h3 style="margin-bottom: 0;">&#8377;&nbsp;<span class="target_user_wallet_balance"><i class="fa fa-spin fa-spinner"></i></span></h3>
              <span style="font-size: 11px;=">(Employee's Wallet Balance)</span>
            {{/case}}
          {{/switch}}
          </div>
        </div>
      </div>
      <div class="row no-margin">
        <div class="col-sm-10 col-sm-offset-1"><hr /></div>
      </div>
      <div class="row no-margin">
        <div class="col-sm-8 col-sm-offset-2">
          <div class="form-group">
            <label class="control-form">Amount:</label>
            <input type="number" name="amount" class="form-control card-funds-amount" value="{{item.amount}}" readonly />
          </div>

          <div class="form-group">
            <label class="control-form">Password:</label>
            <input type="password" name="password" class="form-control password"/>
          </div>

          <div class="form-group text-center">
            <button class="btn btn-success btn-confirm-transfer" data-url="{{item.url}}" data-action-type="{{item.action_type}}">Confirm Transfer</button>
          </div>
        </div>
      </div>
    </div>
  </div><!-- /.modal-content -->
</div><!-- /.modal-dialog -->