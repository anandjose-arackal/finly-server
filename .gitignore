.DS_Store

# Ignore bundler config.
/.bundle
Gemfile.lock
/config/database.yml
/.byebug_history
dump.rdb

# Ignore all logfiles and tempfiles.
/log/*
!/log/.keep
/tmp
/public/system/receipts/*
/public/system/company_configurations/*
/public/system/company_kycs/*
/public/system/individual_kycs/*
/public/system/agreements/*
/public/common/files/temp_files/*
/sample_atm_transactions.txt
/junk_expenses.rb
/Sample transactions

# all local executables
/bin

.idea/*
.vagrant/
#Vagrantfile
#bootstrap.sh
vendor/bundle/

